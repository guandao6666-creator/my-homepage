---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Icon from "../components/Icon.astro";
import Clock from "../components/Clock.astro";
import { SITE, HOME_LATEST, formatShortDate } from "../lib/site";
import { getAllPosts, collectTags } from "../lib/posts";
import "../styles/blog-pixel.css";

const posts = await getAllPosts();
const tags = collectTags(posts).slice(0, 8);
const featured = posts.filter((post) => post.featured).slice(0, 2);
const hero = featured.length ? featured : posts.slice(0, 2);
const latest = posts.filter((post) => !hero.includes(post)).slice(0, HOME_LATEST);
const lastUpdated = posts[0]?.pubDate;
const totalMinutes = posts.reduce((sum, post) => sum + post.minutes, 0);
---

<BaseLayout>
  <div class="blog-pixel">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy rise">
        <span class="eyebrow">Est. {SITE.startYear} · 独立写作</span>
        <h1>
          写下来，<br />
          <em>才算真的想清楚。</em>
        </h1>
        <p class="lede">
          你好，我是{SITE.author}，大连理工大学的学生，河南固始人。
          喜欢骑行，正在用 AI 搭自己的网站——这里记录我的日常、学习，和一些还没想透的问题。
        </p>

        <div class="hero-actions">
          <a class="btn btn--solid" href="/blog/">
            开始阅读
            <Icon name="arrow-right" size={15} />
          </a>
          <a class="btn" href="/about/">关于我</a>
        </div>

        {posts.length > 0 ? (
          <dl class="stats">
            <div>
              <dt>文章</dt>
              <dd>{posts.length}<span>篇</span></dd>
            </div>
            <div>
              <dt>标签</dt>
              <dd>{collectTags(posts).length}<span>个</span></dd>
            </div>
            <div>
              <dt>阅读时长</dt>
              <dd>{totalMinutes}<span>分钟</span></dd>
            </div>
          </dl>
        ) : (
          <p class="hero-hint">
            第一批文章正在路上。想先认识我，可以看 <a href="/about/">关于我</a>。
          </p>
        )}
      </div>

      <aside class="hero-aside rise" style="animation-delay:.12s">
        <div class="now-card">
          <Clock />

          <div class="now-head">
            <span class="dot-live" aria-hidden="true"></span>
            此刻在做
          </div>

          <div class="now-weather" id="now-weather" hidden>
            <span class="wx-icon" id="wx-icon" aria-hidden="true"></span>
            <span class="wx-text" id="wx-text"></span>
          </div>
          <ul class="now-list">
            <li>
              <span class="now-tag">在做</span>
              用 AI 搭自己的博客和各种网站，边做边学。
            </li>
            <li>
              <span class="now-tag">在学</span>
              AI，还在很前面的阶段，欢迎指导。
            </li>
            <li>
              <span class="now-tag">在骑</span>
              <span>骑行总里程已过 4000 公里，<a class="now-link" href="/cycling/">看看骑过的路</a>。</span>
            </li>
          </ul>
          {lastUpdated && (
            <p class="now-foot">
              最近更新 · {formatShortDate(lastUpdated)}
            </p>
          )}
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ FEATURED ============ -->
  {hero.length > 0 && (
    <section class="section featured">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow">精选</span>
            <h2>{hero.length > 1 ? "值得先读的两篇" : "值得先读的"}</h2>
          </div>
          <a class="more" href="/blog/">
            全部文章
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div class="featured-grid">
          {hero.map((post) => (
            <PostCard post={post} variant="card" eager />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ LATEST ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">近期</span>
          <h2>最新写下的</h2>
        </div>
        <a class="more" href="/blog/">
          查看归档
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="post-list">
        {latest.map((post, i) => (
          <PostCard post={post} index={i} />
        ))}
        {latest.length === 0 && (
          <p class="empty">
            {posts.length === 0 ? (
              "还没有文章。第一篇正在路上，写完就会出现在这里。"
            ) : (
              <>还没有更多文章，去 <a href="/blog/">文章归档</a> 看看。</>
            )}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ============ NOTES ============ -->
  <section class="section" id="home-notes-section" hidden>
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">碎片</span>
          <h2>最近记下的</h2>
        </div>
        <a class="more" href="/notes/">
          全部笔记
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <div class="notes-strip" id="home-notes"></div>
    </div>
  </section>

  <!-- ============ TAGS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="tag-band">
        <div class="tag-band-copy">
          <span class="eyebrow">主题</span>
          <h2>沿着兴趣往下挖</h2>
          <p>文章按主题归档，点开任意标签就能看到同一线索下的全部内容。</p>
        </div>
        <div class="tag-cloud">
          {tags.map((tag) => (
            <a class="tag-chip" href={`/tags/${encodeURIComponent(tag.tag)}/`}>
              <span>{tag.tag}</span>
              <em>{tag.count}</em>
            </a>
          ))}
          <a class="tag-chip tag-chip--ghost" href="/tags/">
            全部标签
            <Icon name="arrow-right" size={13} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT TEASER ============ -->
  <section class="section">
    <div class="wrap">
      <div class="about-teaser">
        <div class="about-mark" aria-hidden="true">管</div>
        <div class="about-copy">
          <span class="eyebrow">关于</span>
          <h2>一个喜欢把东西做出来的人</h2>
          <p>
            在豫南的固始长大，现在在大连读书。喜欢长途骑行，也在研究 AI——
            喜欢亲手做过之后才真正理解的感觉。
          </p>
          <a class="btn" href="/about/">读完整介绍 <Icon name="arrow-right" size={14} /></a>
        </div>
        <ul class="about-facts">
          <li><span>坐标</span>大连 · 在校学生</li>
          <li><span>家乡</span>河南固始</li>
          <li><span>爱好</span>骑行 · AI 建站</li>
          <li><span>邮箱</span>{SITE.email}</li>
        </ul>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<script>
  import { cloudConfig, listCloudNotes } from "../lib/cloud";
    // 2.3：HTML 转义统一入口
    import { escapeHtml } from "../lib/html";

  (() => {
    const section = document.getElementById("home-notes-section");
    const box = document.getElementById("home-notes");
    if (!section || !box || !cloudConfig()) return;

    // 2.3：escapeHtml 已统一到 ../lib/html.ts，此处不再保留本地副本

    const dayLabel = (date: Date) => {
      const now = new Date();
      const startOf = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
      const diff = Math.round((startOf(now) - startOf(date)) / 86_400_000);
      if (diff === 0) return "今天";
      if (diff === 1) return "昨天";
      const pad = (n: number) => String(n).padStart(2, "0");
      return `${pad(date.getMonth() + 1)}.${pad(date.getDate())}`;
    };

    listCloudNotes(2)
      .then((notes) => {
        if (!notes.length) return;
        box.innerHTML = notes
          .map(
            (note) => `
            <a class="note-chip" href="/notes/">
              <time>${dayLabel(new Date(note.created_at))}</time>
              <p>${escapeHtml(note.body)}</p>
            </a>`,
          )
          .join("");
        section.hidden = false;
      })
      .catch(() => undefined);
  })();

  /* ---------------- 天气：大连实时 ---------------- */
  (() => {
    const box = document.getElementById("now-weather");
    const iconBox = document.getElementById("wx-icon");
    const textBox = document.getElementById("wx-text");
    if (!box || !iconBox || !textBox) return;

    const CACHE_KEY = "guandao.weather.v1";
    const TTL = 10 * 60 * 1000;
    const URL =
      "https://api.open-meteo.com/v1/forecast?latitude=38.914&longitude=121.6147" +
      "&current=temperature_2m,weather_code,wind_speed_10m&timezone=Asia%2FShanghai";

    const ICONS = {
      sun: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>',
      cloud:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.8 18h10.4a3.8 3.8 0 0 0 .4-7.6A6 6 0 0 0 6.4 11a3.6 3.6 0 0 0 .4 7z"/></svg>',
      rain: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.8 15h10.4a3.8 3.8 0 0 0 .4-7.6A6 6 0 0 0 6.4 8a3.6 3.6 0 0 0 .4 7z"/><path d="M8.6 18l-1 2.4M12.4 18l-1 2.4M16.2 18l-1 2.4"/></svg>',
      snow: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.8 15h10.4a3.8 3.8 0 0 0 .4-7.6A6 6 0 0 0 6.4 8a3.6 3.6 0 0 0 .4 7z"/><path d="M8.5 19h.01M12.5 19h.01M16.5 19h.01" stroke-width="2.4"/></svg>',
      fog: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 9h16M4 13h16M7 17h10"/></svg>',
    };

    const describe = ({ temp, code, wind }: { temp: number; code: number; wind: number }) => {
      const snow = (code >= 71 && code <= 77) || code === 85 || code === 86;
      const rain = (code >= 51 && code <= 67) || (code >= 80 && code <= 82) || code >= 95;
      const fog = code === 45 || code === 48;
      const clear = code <= 2;

      if (snow) return { icon: "snow", text: `今天 ${temp}°C，在下雪。路滑，别骑车。` };
      if (rain) return { icon: "rain", text: `今天 ${temp}°C，有雨。待屋里写代码更合适。` };
      if (wind >= 30) return { icon: "cloud", text: `今天 ${temp}°C，风 ${wind} km/h，逆风会很吃力。` };
      if (temp >= 28) return { icon: "sun", text: `今天 ${temp}°C，骑车记得带够水。` };
      if (temp <= 0) return { icon: "cloud", text: `今天 ${temp}°C，出门戴厚手套。` };
      if (fog) return { icon: "fog", text: `今天 ${temp}°C，有雾，路上慢一点。` };
      if (temp <= 12) return { icon: "cloud", text: `今天 ${temp}°C，有点凉，骑车加件外套。` };
      if (clear && wind < 18) {
        return { icon: "sun", text: `今天 ${temp}°C，晴，风不大。适合往海边骑。` };
      }
      return {
        icon: "cloud",
        text: `今天 ${temp}°C，${wind < 18 ? "风不大" : "有点风"}，适合骑车。`,
      };
    };

    const readCache = () => {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        return Date.now() - parsed.at < TTL ? parsed.data : null;
      } catch {
        return null;
      }
    };

    const writeCache = (data: unknown) => {
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), data }));
      } catch {
        /* 隐私模式写不进去就算了 */
      }
    };

    const show = (data: { temp: number; code: number; wind: number }) => {
      const { icon, text } = describe(data);
      iconBox.innerHTML = ICONS[icon as keyof typeof ICONS] ?? ICONS.cloud;
      textBox.textContent = text;
      box.hidden = false;
    };

    const cached = readCache();
    if (cached) {
      show(cached);
      return;
    }

    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), 4000);

    fetch(URL, { signal: controller.signal })
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then((json) => {
        const data = {
          temp: Math.round(json.current.temperature_2m),
          code: json.current.weather_code as number,
          wind: Math.round(json.current.wind_speed_10m),
        };
        writeCache(data);
        show(data);
      })
      .catch(() => undefined)
      .finally(() => window.clearTimeout(timer));
  })();
</script>

<style>
  /* ============================================================
     博客首页 · 深海像素风
     ============================================================ */
  .hero {
    position: relative;
    padding: 62px 0 46px;
    overflow: hidden;
  }

  .hero::after {
    content: "";
    position: absolute;
    top: -180px;
    right: -140px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(127, 230, 255, 0.1), transparent 68%);
    filter: blur(12px);
    z-index: -1;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: 52px;
    align-items: start;
  }

  .hero h1 {
    margin: 18px 0 0;
    font-family: var(--px-hand);
    font-size: clamp(36px, 5.2vw, 62px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 3px 3px 0 #1f4cb3, 6px 6px 0 var(--px-edge);
  }

  .hero h1 em {
    position: relative;
    font-style: normal;
    color: var(--px-gold);
  }

  /* 手写体下划线换成一条像素虚线 */
  .hero h1 em::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.16em;
    height: 3px;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 211, 77, 0.75) 0 10px,
      transparent 10px 20px
    );
  }

  .lede {
    margin: 22px 0 0;
    max-width: 33em;
    font-size: 15.5px;
    line-height: 2;
    color: var(--px-soft);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .stats {
    display: flex;
    gap: 12px;
    margin: 40px 0 0;
    padding: 0;
    border-top: 0;
  }

  .stats > div {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 12px 7px;
    background: rgba(4, 13, 38, 0.55);
    box-shadow: var(--px-frame-2);
  }

  .stats dt {
    order: 1;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--px-faint);
  }

  .stats dd {
    order: 2;
    margin: 0;
    font-family: var(--px-pix);
    font-size: 17px;
    line-height: 1;
    color: var(--px-gold);
  }

  .stats dd span {
    margin-left: 2px;
    font-family: var(--px-pix);
    font-size: 10.5px;
    color: var(--px-faint);
  }

  .hero-hint {
    margin: 38px 0 0;
    padding-top: 22px;
    border-top: 1px dashed #142a5c;
    max-width: 34em;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--px-faint);
  }

  .hero-hint a {
    color: var(--px-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------------- now card ---------------- */
  .now-card {
    /* 卡片里的模拟表盘沿用全站 token，这里局部改写成深色 */
    --ink: #eaf2ff;
    --ink-2: #c3d4f2;
    --muted: #8ea6d4;
    --line: #1b3a7a;
    --surface: #0a1a42;
    --paper: #071636;

    padding: 20px 22px 18px;
    background: rgba(7, 22, 54, 0.72);
    box-shadow: var(--px-frame-2);
    backdrop-filter: blur(2px);
  }

  .now-card :global(.digital) {
    font-family: var(--px-pix);
    letter-spacing: 0.04em;
  }

  .now-card :global(.date) {
    font-family: var(--px-pix);
    font-size: 11px;
  }

  .now-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--px-cyan);
  }

  .dot-live {
    width: 6px;
    height: 6px;
    background: #5fe08a;
    box-shadow: 0 0 0 2px rgba(95, 224, 138, 0.2);
    animation: pulse 2.6s steps(1, end) infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }

  .now-weather {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 12px;
    padding: 9px 11px;
    background: var(--px-panel-2);
    box-shadow: inset 2px 2px 0 0 var(--px-slot-lo);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--px-soft);
  }

  .wx-icon {
    flex: none;
    width: 15px;
    height: 15px;
    margin-top: 2px;
    color: var(--px-cyan);
  }

  .wx-icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .now-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .now-list li {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 10px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--px-soft);
  }

  .now-tag {
    height: 20px;
    margin-top: 2px;
    font-family: var(--px-pix);
    font-size: 10.5px;
    line-height: 20px;
    text-align: center;
    color: var(--px-cyan);
    background: var(--px-panel-2);
    box-shadow: inset 2px 2px 0 0 var(--px-slot-lo);
  }

  .now-link {
    color: var(--px-gold);
  }

  .now-link:hover {
    color: #fff;
  }

  .now-foot {
    margin: 18px 0 0;
    padding-top: 12px;
    border-top: 1px dashed #142a5c;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--px-faint);
  }

  /* ---------------- sections ---------------- */
  .section {
    padding: 46px 0 0;
  }

  .featured {
    padding-top: 8px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
  }

  /* ---------------- notes ---------------- */
  .notes-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  /* 卡片是脚本动态插入的，拿不到 scoped 属性 */
  :global(.note-chip) {
    display: block;
    padding: 18px 20px;
    background: var(--px-paper);
    box-shadow: var(--px-paper-frame);
    color: var(--px-paper-text);
    transition: transform 0.16s steps(2, end), background-color 0.16s linear;
  }

  :global(.note-chip:hover) {
    transform: translateY(-3px);
    background: var(--px-paper-2);
  }

  :global(.note-chip time) {
    font-family: var(--px-pix);
    font-size: 11px;
    color: #7a5c1c;
  }

  :global(.note-chip p) {
    margin: 8px 0 0;
    font-family: var(--px-hand);
    font-size: 15px;
    line-height: 1.9;
    color: var(--px-paper-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------------- tag band ---------------- */
  .tag-band {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 40px;
    padding: 34px 36px;
    background: rgba(7, 22, 54, 0.6);
    box-shadow: var(--px-frame-2);
  }

  .tag-band-copy h2 {
    margin: 10px 0 12px;
    font-family: var(--px-hand);
    font-size: 26px;
    font-weight: 600;
    color: #fff;
  }

  .tag-band-copy p {
    margin: 0;
    max-width: 26em;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--px-soft);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: start;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px 6px;
    font-family: var(--px-pix);
    font-size: 11.5px;
    color: var(--px-soft);
    background: var(--px-panel-2);
    box-shadow: inset 2px 2px 0 0 var(--px-slot-lo);
    transition: color 0.15s linear, background-color 0.15s linear;
  }

  .tag-chip em {
