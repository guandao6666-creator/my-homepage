---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getAllPosts, type Post } from "../lib/posts";
import { SITE, formatShortDate } from "../lib/site";
import "../styles/blog-pixel.css";

const posts = await getAllPosts();

/** 按「年 → 月」两级分组，两级都保持时间倒序 */
const yearMap = new Map<number, Map<number, Post[]>>();
for (const post of posts) {
  const date = new Date(post.pubDate);
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth() + 1;
  if (!yearMap.has(year)) yearMap.set(year, new Map());
  const monthMap = yearMap.get(year)!;
  if (!monthMap.has(month)) monthMap.set(month, []);
  monthMap.get(month)!.push(post);
}

const groups = [...yearMap.entries()]
  .sort((a, b) => b[0] - a[0])
  .map(([year, monthMap]) => ({
    year,
    count: [...monthMap.values()].reduce((sum, list) => sum + list.length, 0),
    months: [...monthMap.entries()]
      .sort((a, b) => b[0] - a[0])
      .map(([month, list]) => ({ month, posts: list })),
  }));

const totalMinutes = posts.reduce((sum, post) => sum + post.minutes, 0);
const firstPost = posts[posts.length - 1];
---

<BaseLayout
  title="归档"
  description={`${SITE.author}的全部文章归档：共 ${posts.length} 篇，跨越 ${groups.length} 个年份，按时间排列。`}
  canonical="/archive/"
>
  <div class="blog-pixel">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">
        Archive · {posts.length} 篇 · {groups.length} 年
      </span>
      <h1>归档</h1>
      <p class="page-lede">
        从 {firstPost ? formatShortDate(firstPost.pubDate) : "—"} 写到现在，一共 {posts.length} 篇、
        约 {totalMinutes} 分钟。按时间往下翻，能看到一条自己走过的线。
      </p>
    </div>
  </section>

  <div class="wrap">
    {groups.length === 0 ? (
      <p class="empty">还没有文章。第一篇写完之后，这里会自动出现时间轴。</p>
    ) : (
      <div class="archive-layout">
        <nav class="year-nav" aria-label="按年份跳转">
          {groups.map((group) => (
            <a href={`#y${group.year}`}>
              <span>{group.year}</span>
              <em>{group.count}</em>
            </a>
          ))}
        </nav>

        <div class="timeline">
          <div class="archive-filter">
            <input
              id="archive-search"
              type="search"
              placeholder="按标题或标签筛选归档文章…"
              autocomplete="off"
              aria-label="筛选归档文章"
            />
            <span class="archive-count" id="archive-count">共 {posts.length} 篇</span>
          </div>
          {groups.map((group) => (
            <section class="year" id={`y${group.year}`} data-arch-year>
              <h2 class="year-title">
                {group.year}
                <span>{group.count} 篇</span>
              </h2>

              {group.months.map((month) => (
                <div class="month" data-arch-month>
                  <h3>{String(month.month).padStart(2, "0")} 月</h3>
                  <ul>
                    {month.posts.map((post) => {
                      const day = String(new Date(post.pubDate).getUTCDate()).padStart(2, "0");
                      return (
                        <li data-arch-item data-arch-text={`${post.title} ${post.tags.join(" ")}`.toLowerCase()}>
                          <a href={`/blog/${post.slug}/`}>
                            <time datetime={new Date(post.pubDate).toISOString()}>{day}</time>
                            <span class="title">{post.title}</span>
                            <span class="meta">{post.minutes} 分钟</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </section>
          ))}
          <p class="empty" id="archive-empty" hidden>没有匹配的归档文章，换个关键词试试。</p>
        </div>
      </div>
    )}

    <a class="back" href="/blog/">
      回到文章列表
      <Icon name="arrow-right" size={13} />
    </a>
  </div>
  </div>
</BaseLayout>

<script>
  (() => {
    const input = document.getElementById("archive-search") as HTMLInputElement | null;
    const countEl = document.getElementById("archive-count");
    const emptyEl = document.getElementById("archive-empty");
    const years = [...document.querySelectorAll<HTMLElement>("[data-arch-year]")];
    if (!input || !years.length) return;

    const filter = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const year of years) {
        let yearShown = 0;
        for (const month of year.querySelectorAll<HTMLElement>("[data-arch-month]")) {
          let monthShown = 0;
          for (const item of month.querySelectorAll<HTMLElement>("[data-arch-item]")) {
            const match = !q || (item.dataset.archText || "").includes(q);
            item.hidden = !match;
            if (match) monthShown++;
          }
          month.hidden = monthShown === 0;
          yearShown += monthShown;
        }
        year.hidden = yearShown === 0;
        shown += yearShown;
      }
      if (countEl) countEl.textContent = q ? `匹配 ${shown} 篇` : `共 ${shown} 篇`;
      if (emptyEl) emptyEl.hidden = shown > 0;
    };

    input.addEventListener("input", filter);
  })();
</script>

<style>
  .archive-layout {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 40px;
    padding-top: 32px;
  }

  .archive-filter {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }

  .archive-filter input {
    flex: 1;
    max-width: 340px;
    padding: 8px 12px;
    border: 2px solid var(--px-slot-lo, #1c2c52);
    background: var(--px-panel-2, rgba(16, 26, 52, 0.7));
    color: var(--px-ink, #fff);
    font: inherit;
    font-size: 13.5px;
    outline: none;
  }

  .archive-filter input:focus {
    border-color: var(--px-gold, #f3c65d);
  }

  .archive-count {
    font-family: var(--px-pix);
    font-size: 11.5px;
    color: var(--px-faint);
  }

  [data-arch-year][hidden],
  [data-arch-month][hidden],
  [data-arch-item][hidden] {
    display: none;
  }

  .year-nav {
    position: sticky;
    top: 92px;
    align-self: start;
    display: grid;
    gap: 4px;
  }

  .year-nav a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 9px;
    font-family: var(--px-pix);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--px-faint);
    transition: background-color 0.15s linear, color 0.15s linear;
  }

  .year-nav a:hover {
    color: var(--px-gold);
    background: var(--px-panel-2);
  }

  .year-nav em {
    font-style: normal;
    font-size: 10px;
    opacity: 0.7;
  }

  .timeline {
    position: relative;
    padding-left: 26px;
    border-left: 2px solid #142a5c;
  }

  .year {
    position: relative;
    scroll-margin-top: 96px;
  }

  .year + .year {
    margin-top: 42px;
  }

  .year-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--px-hand);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .year-title::before {
    content: "";
    position: absolute;
    left: -32px;
    top: 11px;
    width: 12px;
    height: 12px;
    background: var(--px-gold);
    box-shadow: 0 0 0 3px #142a5c;
  }

  .year-title span {
    font-family: var(--px-pix);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--px-faint);
  }

  .month {
    margin-top: 20px;
  }

  .month h3 {
    font-family: var(--px-pix);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--px-cyan);
  }

  .month ul {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }

  .month li + li {
    border-top: 1px dashed #142a5c;
  }

  .month a {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: baseline;
    padding: 9px 2px;
    font-size: 14px;
    color: var(--px-soft);
    transition: color 0.15s linear, padding-left 0.15s linear;
  }

  .month a:hover {
    color: var(--px-gold);
    padding-left: 6px;
  }

  .month time {
    font-family: var(--px-pix);
    font-size: 11.5px;
    color: var(--px-faint);
  }

  .month .title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .month .meta {
    flex: none;
    font-family: var(--px-pix);
    font-size: 11px;
    color: var(--px-faint);
    opacity: 0.8;
  }

  @media (max-width: 760px) {
    .archive-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .year-nav {
      display: none;
    }
    .month .meta {
      display: none;
    }
    .month a {
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 10px;
    }
  }
</style>
