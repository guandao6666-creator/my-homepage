---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/site";

const routes = [
  { no: "01", from: "固始", to: "合肥" },
  { no: "02", from: "固始", to: "南京" },
  { no: "03", from: "大连", to: "沈阳" },
];

const topics = [
  {
    title: "日常",
    text: "有趣的、好玩的、好吃的，还有路上好看的风景。生活里那些值得停一下的瞬间。",
  },
  {
    title: "学习",
    text: "学习的过程和感悟，包括踩过的坑。写下来是为了让自己下次少走一遍。",
  },
  {
    title: "思考",
    text: "关于人生的一些还不成熟的想法。不一定对，但都是当时认真想过的。",
  },
];

const now = [
  { label: "在做", text: "用 AI 搭自己的博客和各种网站，边做边学。" },
  { label: "在学", text: "AI，还在很前面的阶段，欢迎指导。" },
  { label: "在骑", text: "只要有整块的时间，就想找一条没走过的路线。" },
];
---

<BaseLayout
  title="关于"
  description={`${SITE.author}，大连理工大学学生，河南固始人。喜欢骑行，正在用 AI 搭自己的网站。`}
  canonical="/about/"
  jsonLd={{
    "@type": "Person",
    name: SITE.author,
    jobTitle: "学生",
    url: `${SITE.url}/about/`,
    email: SITE.email,
    description: SITE.description,
  }}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">About</span>
        <h1>Hi，这里是<br /><em>管道</em></h1>
      </div>
      <div class="hero-side">
        <p class="hang">管</p>
        <p class="sig">学生 · 骑行者 · 正在学 AI</p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="intro">
      <p class="lead">
        大连理工大学的学生，2008 年 4 月 30 日出生，河南固始人。这里是我的博客，喜欢您来。
      </p>
      <p>
        我在豫南的固始长大，现在在大连读书。两地隔着一千多公里，后来我真的用车轮把其中的一段段路量过一遍。
      </p>
      <p>
        这个博客是我用 AI 一点一点搭起来的。除了写点东西，它也是我学习新事物的练习场——
        想做什么就先动手做出来，卡住了再回头补课。
      </p>
    </section>

    <section class="block split">
      <div>
        <div class="block-head">
          <span class="eyebrow">车轮</span>
          <h2>四千公里，是骑出来的</h2>
        </div>

        <ol class="routes">
          {routes.map((route) => (
            <li class="route">
              <span class="route-no">{route.no}</span>
              <span class="route-path">
                <span>{route.from}</span>
                <span class="route-arrow" aria-hidden="true">→</span>
                <span>{route.to}</span>
              </span>
            </li>
          ))}
        </ol>

        <p class="note">
          喜欢长途骑行。截至目前，骑行总里程已经突破 4000 公里。
          骑长途最好的部分是：路只有一条，你只需要一直往前。
        </p>
      </div>

      <div class="stat-card">
        <div class="stat">
          <span>长途线路</span>
          <strong>3 条</strong>
        </div>
        <div class="stat">
          <span>累计里程</span>
          <strong>4000<em>+</em></strong>
        </div>
        <div class="stat">
          <span>出发地</span>
          <strong class="stat-text">河南固始</strong>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="block-head">
        <span class="eyebrow">此刻</span>
        <h2>现在在做什么</h2>
      </div>
      <ul class="now">
        {now.map((item) => (
          <li>
            <strong>{item.label}</strong>
            {item.text}
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <div class="block-head">
        <span class="eyebrow">内容</span>
        <h2>你会在这里看到</h2>
      </div>
      <div class="topics">
        {topics.map((topic, index) => (
          <article class="topic">
            <span class="topic-no">{String(index + 1).padStart(2, "0")}</span>
            <h3>{topic.title}</h3>
            <p>{topic.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="contact">
      <div>
        <h2>有想法，欢迎来信</h2>
        <p>不管是纠正一个错误、约一次骑行，还是单纯想聊两句，我都会认真回复。</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn--solid" href={`mailto:${SITE.email}`}>
          <Icon name="mail" size={15} />
          {SITE.email}
        </a>
        <a class="btn" href="/rss.xml">
          <Icon name="rss" size={14} />
          订阅 RSS
        </a>
      </div>
    </section>

    <p class="colophon">
      本站使用 <strong>Astro</strong> 构建，文章数据存储在 <strong>Supabase</strong>（PostgreSQL），
      图片托管于对象存储，样式为手写 CSS，无前端框架运行时。
    </p>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 62px 0 44px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: end;
    padding-bottom: 34px;
    border-bottom: 1px solid var(--line);
  }

  .hero h1 {
    margin-top: 16px;
    font-size: clamp(36px, 5.4vw, 58px);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .hero-side {
    text-align: right;
  }

  .hang {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 76px;
    line-height: 0.9;
    color: var(--accent);
    opacity: 0.22;
  }

  .sig {
    margin: 10px 0 0;
    font-size: 12.5px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .intro {
    max-width: 40em;
    padding: 40px 0 10px;
  }

  .intro p {
    margin: 0 0 1.15em;
    font-size: 15.5px;
    line-height: 2;
    color: var(--ink-2);
  }

  .intro .lead {
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.85;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .block {
    padding: 44px 0;
    border-top: 1px solid var(--line);
  }

  .block-head h2 {
    margin-top: 10px;
    font-size: 24px;
  }

  /* ---------- 骑行路线 ---------- */

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 44px;
    align-items: start;
  }

  .routes {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .route {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px dashed var(--line);
  }

  .route:first-child {
    border-top: 1px dashed var(--line);
  }

  .route-no {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent-ink);
    opacity: 0.85;
  }

  .route-path {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--ink);
  }

  .route-arrow {
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 13px;
    opacity: 0.7;
  }

  .note {
    margin: 20px 0 0;
    font-size: 13.5px;
    line-height: 1.95;
    color: var(--muted);
    max-width: 40em;
  }

  .stat-card {
    display: grid;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--line);
  }

  .stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    background: var(--surface);
  }

  .stat span {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .stat strong {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    white-space: nowrap;
  }

  .stat strong em {
    font-style: normal;
    font-size: 14px;
    color: var(--accent);
    margin-left: 1px;
  }

  .stat strong.stat-text {
    font-size: 17px;
    letter-spacing: 0.02em;
  }

  /* ---------- 现在 / 内容 ---------- */

  .now {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    max-width: 42em;
  }

  .now li {
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--ink-2);
    padding-left: 18px;
    position: relative;
  }

  .now li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .now strong {
    color: var(--ink);
    margin-right: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 26px;
  }

  .topic {
    padding: 22px 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .topic-no {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    opacity: 0.7;
  }

  .topic h3 {
    margin: 10px 0 0;
    font-size: 17px;
  }

  .topic p {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
  }

  /* ---------- 联系 ---------- */

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 8px;
    padding: 36px 38px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: linear-gradient(135deg, var(--surface) 0%, var(--accent-wash) 130%);
  }

  .contact h2 {
    font-size: 24px;
  }

  .contact p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 13.5px;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .colophon {
    margin: 28px 0 0;
    font-size: 12px;
    line-height: 1.9;
    color: var(--muted);
  }

  .colophon strong {
    color: var(--ink-2);
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero-side {
      display: none;
    }
    .split,
    .topics {
      grid-template-columns: 1fr;
    }
    .stat-card {
      margin-top: 6px;
    }
    .contact {
      padding: 26px 22px;
    }
  }
</style>
