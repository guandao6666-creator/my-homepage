---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/site";
import "../styles/blog-pixel.css";

const routes = [
  { no: "01", from: "固始", to: "合肥" },
  { no: "02", from: "固始", to: "南京" },
  { no: "03", from: "大连", to: "沈阳" },
];

const topics = [
  {
    title: "日常",
    text: "有趣的、好玩的、好吃的，还有路上好看的风景。生活里那些值得停一下的瞬间。",
  },
  {
    title: "学习",
    text: "学习的过程和感悟，包括踩过的坑。写下来是为了让自己下次少走一遍。",
  },
  {
    title: "思考",
    text: "关于人生的一些还不成熟的想法。不一定对，但都是当时认真想过的。",
  },
];

const now = [
  { label: "在做", text: "用 AI 搭自己的博客和各种网站，边做边学。" },
  { label: "在学", text: "AI，还在很前面的阶段，欢迎指导。" },
  { label: "在骑", text: "只要有整块的时间，就想找一条没走过的路线。" },
];
---

<BaseLayout
  title="关于"
  description={`${SITE.author}，大连理工大学学生，河南固始人。喜欢骑行，正在用 AI 搭自己的网站。`}
  canonical="/about/"
  jsonLd={{
    "@type": "Person",
    name: SITE.author,
    jobTitle: "学生",
    url: `${SITE.url}/about/`,
    email: SITE.email,
    description: SITE.description,
  }}
>
  <div class="blog-pixel">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">About</span>
        <h1>Hi，这里是<br /><em>管道</em></h1>
      </div>
      <div class="hero-side">
        <p class="hang">管</p>
        <p class="sig">学生 · 骑行者 · 正在学 AI</p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="intro">
      <p class="lead">
        大连理工大学的学生，2008 年 4 月 30 日出生，河南固始人。这里是我的博客，喜欢您来。
      </p>
      <p>
        我在豫南的固始长大，现在在大连读书。两地隔着一千多公里，后来我真的用车轮把其中的一段段路量过一遍。
      </p>
      <p>
        这个博客是我用 AI 一点一点搭起来的。除了写点东西，它也是我学习新事物的练习场——
        想做什么就先动手做出来，卡住了再回头补课。
      </p>
    </section>

    <section class="block split">
      <div>
        <div class="block-head">
          <span class="eyebrow">车轮</span>
          <h2>四千公里，是骑出来的</h2>
        </div>

        <ol class="routes">
          {routes.map((route) => (
            <li class="route">
              <span class="route-no">{route.no}</span>
              <span class="route-path">
                <span>{route.from}</span>
                <span class="route-arrow" aria-hidden="true">→</span>
                <span>{route.to}</span>
              </span>
            </li>
          ))}
        </ol>

        <p class="note">
          喜欢长途骑行。截至目前，骑行总里程已经突破 4000 公里。
          骑长途最好的部分是：路只有一条，你只需要一直往前。
        </p>
      </div>

      <div class="stat-card">
        <div class="stat">
          <span>长途线路</span>
          <strong>3 条</strong>
        </div>
        <div class="stat">
          <span>累计里程</span>
          <strong>4000<em>+</em></strong>
        </div>
        <div class="stat">
          <span>出发地</span>
          <strong class="stat-text">河南固始</strong>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="block-head">
        <span class="eyebrow">此刻</span>
        <h2>现在在做什么</h2>
      </div>
      <ul class="now">
        {now.map((item) => (
          <li>
            <strong>{item.label}</strong>
            {item.text}
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <div class="block-head">
        <span class="eyebrow">内容</span>
        <h2>你会在这里看到</h2>
      </div>
      <div class="topics">
        {topics.map((topic, index) => (
          <article class="topic">
            <span class="topic-no">{String(index + 1).padStart(2, "0")}</span>
            <h3>{topic.title}</h3>
            <p>{topic.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="contact">
      <div>
        <h2>有想法，欢迎来信</h2>
        <p>不管是纠正一个错误、约一次骑行，还是单纯想聊两句，我都会认真回复。</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn--solid" href={`mailto:${SITE.email}`}>
          <Icon name="mail" size={15} />
          {SITE.email}
        </a>
        <a class="btn" href="/rss.xml">
          <Icon name="rss" size={14} />
          订阅 RSS
        </a>
      </div>
    </section>

    <p class="colophon">
      本站使用 <strong>Astro</strong> 构建，文章数据存储在 <strong>Supabase</strong>（PostgreSQL），
      图片托管于对象存储，样式为手写 CSS，无前端框架运行时。
    </p>
  </div>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 58px 0 40px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: end;
    padding-bottom: 30px;
    border-bottom: 4px dashed #142a5c;
  }

  .hero h1 {
    margin-top: 16px;
    font-family: var(--px-hand);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: 0.02em;
    color: #fff;
    text-shadow: 3px 3px 0 #1f4cb3, 6px 6px 0 var(--px-edge);
  }

  .hero h1 em {
    font-style: normal;
    color: var(--px-gold);
  }

  .hero-side {
    text-align: right;
  }

  .hang {
    margin: 0;
    font-family: var(--px-hand);
    font-size: 76px;
    line-height: 0.9;
    color: var(--px-gold);
    opacity: 0.2;
  }

  .sig {
    margin: 10px 0 0;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--px-faint);
  }

  .intro {
    max-width: 40em;
    padding: 38px 0 8px;
  }

  .intro p {
    margin: 0 0 1.2em;
    font-size: 15px;
    line-height: 2.05;
    color: var(--px-soft);
  }

  .intro .lead {
    font-family: var(--px-hand);
    font-size: 22px;
    line-height: 1.85;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .block {
    padding: 40px 0;
    border-top: 4px dashed #142a5c;
  }

  .block-head h2 {
    margin: 10px 0 0;
    font-family: var(--px-hand);
    font-size: 26px;
    font-weight: 600;
    color: #fff;
  }

  /* ---------- 骑行路线 ---------- */

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 44px;
    align-items: start;
  }

  .routes {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .route {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px dashed #142a5c;
  }

  .route:first-child {
    border-top: 1px dashed #142a5c;
  }

  .route-no {
    font-family: var(--px-pix);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--px-gold);
  }

  .route-path {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--px-hand);
    font-size: 19px;
    color: var(--px-ink);
  }

  .route-arrow {
    font-family: var(--px-pix);
    font-size: 13px;
    color: var(--px-cyan);
    opacity: 0.8;
  }

  .note {
    margin: 20px 0 0;
    max-width: 40em;
    font-size: 13.5px;
    line-height: 1.95;
    color: var(--px-soft);
  }

  .stat-card {
    display: grid;
    gap: 0;
    background: rgba(7, 22, 54, 0.6);
    box-shadow: var(--px-frame-2);
  }

  .stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 18px;
    border-bottom: 1px dashed #142a5c;
  }

  .stat:last-child {
    border-bottom: 0;
  }

  .stat span {
    font-family: var(--px-pix);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--px-faint);
  }

  .stat strong {
    font-family: var(--px-hand);
    font-size: 24px;
    font-weight: 600;
    color: var(--px-gold);
    white-space: nowrap;
  }

  .stat strong em {
    margin-left: 1px;
    font-style: normal;
    font-size: 14px;
    color: var(--px-cyan);
  }

  .stat strong.stat-text {
    font-size: 17px;
    color: #fff;
    letter-spacing: 0.02em;
  }

  /* ---------- 现在 / 内容 ---------- */

  .now {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    max-width: 42em;
  }

  .now li {
    position: relative;
    padding-left: 18px;
    font-size: 13.5px;
    line-height: 1.95;
    color: var(--px-soft);
  }

  .now li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    background: var(--px-gold);
  }

  .now strong {
    margin-right: 10px;
    font-family: var(--px-pix);
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--px-cyan);
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .topic {
    padding: 20px 22px 22px;
    background: rgba(7, 22, 54, 0.55);
    box-shadow: var(--px-frame-2);
  }

  .topic-no {
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--px-gold);
    opacity: 0.85;
  }

  .topic h3 {
    margin: 10px 0 0;
    font-family: var(--px-hand);
    font-size: 19px;
    font-weight: 600;
    color: #fff;
  }

  .topic p {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.95;
    color: var(--px-soft);
  }

  /* ---------- 联系 ---------- */

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 10px;
    padding: 32px 34px;
    background: rgba(7, 22, 54, 0.62);
    box-shadow: var(--px-frame-2), inset 4px 0 0 0 var(--px-gold);
  }

  .contact h2 {
    font-family: var(--px-hand);
    font-size: 26px;
    font-weight: 600;
    color: #fff;
  }

  .contact p {
    margin: 10px 0 0;
    max-width: 30em;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--px-soft);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .colophon {
    margin: 30px 0 0;
    font-family: var(--px-pix);
    font-size: 10.5px;
    line-height: 2;
    letter-spacing: 0.04em;
    color: var(--px-faint);
  }

  .colophon strong {
    color: var(--px-cyan);
    font-weight: 400;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero-side {
      display: none;
    }
    .split,
    .topics {
      grid-template-columns: 1fr;
    }
    .stat-card {
      margin-top: 6px;
    }
    .contact {
      padding: 24px 20px;
    }
  }
</style>
