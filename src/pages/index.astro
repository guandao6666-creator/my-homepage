    <script is:inline>
      // 首帧就决定外壳：避免先渲染桌面再跳到移动端。
      // 2.0 规则：手机尺寸访问站点 URL（/）默认进入手机伴侣；
      // 只有本次会话主动点过「桌面」（?desktop=1 或会话标记）才按桌面布局。
      // 不再把桌面前景写进 localStorage —— 否则一次点击会让之后每次打开网址都进桌面。
      (function () {
        try {
          var params = null;
          try {
            params = new URLSearchParams(location.search);
          } catch (e) {
            params = null;
          }
          var wantsDesktop = Boolean(params && params.get("desktop") === "1");
          if (wantsDesktop) {
            try {
              sessionStorage.setItem("guandao.shell.desktop-session", "1");
            } catch (e) {}
          }
          var sessionDesktop = false;
          try {
            sessionDesktop = sessionStorage.getItem("guandao.shell.desktop-session") === "1";
          } catch (e) {}

          var w = window.innerWidth || 1024;
          var h = window.innerHeight || 768;
          var coarse = false;
          try {
            coarse = window.matchMedia("(pointer: coarse)").matches || navigator.maxTouchPoints > 0;
          } catch (e) {}
          var screenShort = Math.min(
            (window.screen && window.screen.width) || w,
            (window.screen && window.screen.height) || h,
          );
          var phone = w < 640 || (coarse && screenShort < 500);

          var mode;
          if (phone) {
            mode = wantsDesktop || sessionDesktop ? "desktop" : "mobile";
          } else {
            var pref = localStorage.getItem("guandao.os18.shell.v1") || "auto";
            mode = pref;
            if (pref === "auto") {
              if (w < 1024 || (coarse && w < 1280)) mode = "tablet";
              else mode = "desktop";
            }
          }

          document.documentElement.setAttribute("data-shell", mode);
          document.documentElement.setAttribute("data-pointer", coarse ? "coarse" : "fine");
          if (mode === "mobile" && location.pathname.indexOf("/m/") !== 0 && location.pathname !== "/m") {
            location.replace("/m/" + location.search);
          }
        } catch (e) {}
      })();
    </script>
