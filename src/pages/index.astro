---
import "../styles/global.css";
import { existsSync, readdirSync } from "node:fs";
import { join } from "node:path";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();

// 扫 public/music 下的音频，文件名当歌名
const musicDir = join(process.cwd(), "public", "music");
const trackFiles = existsSync(musicDir)
  ? readdirSync(musicDir)
      .filter((name) => /\.(mp3|m4a|ogg|wav|flac)$/i.test(name))
      .sort((a, b) => a.localeCompare(b, "zh"))
  : [];

// 构建时把议会数据抓下来内联进页面：
// 国内访问 supabase.co 经常挂住，运行时再拉会一直转圈。
// 构建在 GitHub / Cloudflare 跑，那边网络是通的。
const sbUrlBuild = import.meta.env.PUBLIC_SUPABASE_URL;
const sbKeyBuild = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let councilSeed: { polls: unknown[]; counts: Record<string, Record<string, number>> } = {
  polls: [],
  counts: {},
};

if (sbUrlBuild && sbKeyBuild) {
  try {
    const headers = { apikey: sbKeyBuild, Authorization: `Bearer ${sbKeyBuild}` };
    const [pRes, vRes] = await Promise.all([
      fetch(`${sbUrlBuild}/rest/v1/polls?select=id,title,kind,options&active=eq.true&order=created_at.asc`, {
        headers,
      }),
      fetch(`${sbUrlBuild}/rest/v1/votes?select=poll_id,option_index`, { headers }),
    ]);

    if (pRes.ok && vRes.ok) {
      const polls = (await pRes.json()) as unknown[];
      const votes = (await vRes.json()) as Array<{ poll_id: string; option_index: number }>;

      const counts: Record<string, Record<string, number>> = {};
      for (const v of votes) {
        counts[v.poll_id] ??= {};
        counts[v.poll_id][v.option_index] = (counts[v.poll_id][v.option_index] ?? 0) + 1;
      }

      councilSeed = { polls, counts };
    }
  } catch {
    /* 构建时连不上就留空，前端会退回运行时请求 */
  }
}

const data = {
  posts: posts.map((post) => ({
    title: post.title,
    href: `/blog/${post.slug}/`,
    date: post.pubDate.toISOString().slice(0, 10),
    tags: post.tags,
    minutes: post.minutes,
  })),
  tracks: trackFiles.map((file) => ({
    src: `/music/${encodeURIComponent(file)}`,
    title: file.replace(/\.[^.]+$/, ""),
  })),
  site: {
    author: "管道",
    host: "guandao.xin",
  },
  council: councilSeed,
  // anon key 放前端是 Supabase 的正常用法，真正的权限由 RLS 兜
  // 生产环境走 /sb 同源反代（functions/sb/[[path]].js），避开国内直连 supabase.co 超时
  supabase: {
    url: import.meta.env.DEV ? (import.meta.env.PUBLIC_SUPABASE_URL ?? "") : "/sb",
    key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "",
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guandao OS · 管道</title>
    <meta name="description" content="把博客做成一个可以拖窗口的桌面。点「回博客」进入普通版。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <noscript>
      <style>
        .boot {
          display: none !important;
        }
      </style>
      <p style="padding: 24px; color: #eef1f7; font-size: 14px">
        这个桌面需要 JavaScript 才能运行。
        <a href="/home/" style="color: #9fb4ff">直接看博客 →</a>
      </p>
    </noscript>

    <div class="boot" id="boot">
      <div class="boot-inner">
        <span class="boot-logo">管</span>
        <div class="boot-track"><span class="boot-bar" id="boot-bar"></span></div>
        <p class="boot-text" id="boot-text">正在加载管道的数字世界……</p>
      </div>
    </div>

    <script is:inline>
      // 主脚本万一来不及执行，6 秒后也必须放人进桌面
      setTimeout(function () {
        var boot = document.getElementById("boot");
        if (boot) boot.style.display = "none";
      }, 6000);
    </script>

    <div class="os" id="os" data-wall="nebula">
      <div class="wallpaper"></div>

      <header class="menubar">
        <span class="mb-brand">Guandao OS</span>
        <nav class="mb-menu">
          <span>文件</span>
          <span>编辑</span>
          <span>视图</span>
          <span>窗口</span>
        </nav>
        <div class="mb-status">
          <span class="mb-dot"></span>
          <span id="mb-time">--:--</span>
          <button class="mb-power" id="mb-power" type="button" aria-label="电源">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3v9" stroke-linecap="round" />
              <path d="M6.5 6.6a8 8 0 1 0 11 0" stroke-linecap="round" />
            </svg>
          </button>
          <div class="power-menu" id="power-menu" hidden>
            <button type="button" data-power="restart">重新启动</button>
            <button type="button" data-power="shutdown">关机</button>
          </div>
        </div>
      </header>

      <main class="desk" id="desk">
        <div class="desk-icons">
          <button class="desk-icon" type="button" data-app="posts">
            <span class="di-glyph di-folder"></span>
            <span class="di-label">文章</span>
          </button>
          <button class="desk-icon" type="button" data-app="about">
            <span class="di-glyph di-person"></span>
            <span class="di-label">关于</span>
          </button>
          <button class="desk-icon" type="button" data-app="music">
            <span class="di-glyph di-music"></span>
            <span class="di-label">音乐</span>
          </button>
          <button class="desk-icon" type="button" data-app="terminal">
            <span class="di-glyph di-term"></span>
            <span class="di-label">终端</span>
          </button>
          <button class="desk-icon" type="button" data-app="achievements">
            <span class="di-glyph di-ach"></span>
            <span class="di-label">成就</span>
          </button>
          <button class="desk-icon" type="button" data-app="aquarium">
            <span class="di-glyph di-tank"></span>
            <span class="di-label">水族箱</span>
          </button>
          <button class="desk-icon" type="button" data-app="visitors">
            <span class="di-glyph di-wall"></span>
            <span class="di-label">访客墙</span>
          </button>
          <button class="desk-icon" type="button" data-app="rank">
            <span class="di-glyph di-rank"></span>
            <span class="di-label">排行榜</span>
          </button>
          <button class="desk-icon" type="button" data-app="draw">
            <span class="di-glyph di-draw"></span>
            <span class="di-label">每日抽奖</span>
          </button>
          <button class="desk-icon" type="button" data-app="council">
            <span class="di-glyph di-vote"></span>
            <span class="di-label">议会</span>
          </button>
          <button class="desk-icon" type="button" data-app="treehole">
            <span class="di-glyph di-hole"></span>
            <span class="di-label">树洞</span>
          </button>
          <button class="desk-icon" type="button" data-app="news">
            <span class="di-glyph di-tv"></span>
            <span class="di-label">新闻联播</span>
          </button>
          <button class="desk-icon" type="button" data-app="social">
            <span class="di-glyph di-net"></span>
            <span class="di-label">社会网络</span>
          </button>
          <a class="desk-icon" href="/home/">
            <span class="di-glyph di-home"></span>
            <span class="di-label">回博客</span>
          </a>
        </div>

        <div class="windows" id="windows"></div>

        <div class="desk-pet" id="desk-pet" title="摸摸">
          <p class="pet-say" id="pet-say"></p>
          <img class="pet-img" src="/pet/whale-girl.webp" alt="" draggable="false" />
        </div>

        <p class="desk-hint" id="desk-hint">双击图标，或从下方程序坞打开</p>
      </main>

      <footer class="dock" id="dock">
        <button class="dock-item" type="button" data-app="posts" title="文章">
          <span class="dock-glyph di-folder"></span>
        </button>
        <button class="dock-item" type="button" data-app="about" title="关于">
          <span class="dock-glyph di-person"></span>
        </button>
        <button class="dock-item" type="button" data-app="terminal" title="终端">
          <span class="dock-glyph di-term"></span>
        </button>
        <button class="dock-item" type="button" data-app="settings" title="设置">
          <span class="dock-glyph di-gear"></span>
        </button>
        <span class="dock-sep"></span>
        <a class="dock-item dock-link" href="/home/" title="回到博客">
          <span class="dock-glyph di-home"></span>
        </a>
      </footer>
    </div>

    <div class="toast-stack" id="toast-stack"></div>

    <div class="power-screen" id="power-screen" hidden>
      <div class="power-inner">
        <span class="power-logo">管</span>
        <p class="power-hint" id="power-hint"></p>
      </div>
    </div>

    <script is:inline define:vars={{ OS_DATA: data }}>
      window.__OS__ = OS_DATA;
    </script>

    <script>
      (() => {
        /* ---------------- 开机动画 ---------------- */

        const boot = document.getElementById("boot");
        const bootBar = document.getElementById("boot-bar");
        const bootText = document.getElementById("boot-text");

        if (boot && bootBar && bootText) {
          let booted = false;

          const finishBoot = () => {
            if (booted) return;
            booted = true;
            boot.classList.add("is-done");
            window.setTimeout(() => boot.remove(), 650);
          };

          window.setTimeout(() => {
            bootText.textContent = "加载完成";
            bootText.classList.add("is-ready");
          }, 1400);

          window.setTimeout(finishBoot, 1900);

          // 急着进去可以点一下跳过
          boot.addEventListener("click", finishBoot);
        }

        const DATA = window.__OS__;
        if (!DATA) return;

        /** 通用的登录 / 注册表单，树洞、议会、社会网络共用一份 */
        const authFormHtml = () => `
          <form class="auth-form" data-auth="1">
            <p class="auth-title">登录 / 注册</p>
            <p class="auth-note">邮箱加密码就行，不用收验证码，注册完直接能用。</p>
            <input class="social-input" data-auth-email type="email" placeholder="邮箱" autocomplete="username" />
            <input class="social-input" data-auth-password type="password" placeholder="密码（至少 6 位）" autocomplete="current-password" />
            <div class="auth-bar">
              <button class="auth-btn" type="submit">登录</button>
              <button class="auth-btn is-ghost" type="button" data-auth-signup>注册</button>
            </div>
            <p class="auth-msg" data-auth-msg></p>
          </form>`;

        /** 首次登录自动建一份空资料 */
        const ensureMyProfile = async (token: string, uid: string, email: string) => {
          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          if (!sb?.url || !sb?.key) return;

          const headers = { apikey: sb.key, Authorization: `Bearer ${token}` };

          try {
            const check = await fetchWithTimeout(
              `${sb.url}/rest/v1/profiles?id=eq.${encodeURIComponent(uid)}&select=id`,
              { headers },
              8000,
            );
            if (check.ok) {
              const rows = (await check.json()) as Array<{ id: string }>;
              if (rows.length) return;
            }

            const name = email.split("@")[0].slice(0, 16) || "访客";

            await fetchWithTimeout(
              `${sb.url}/rest/v1/profiles`,
              {
                method: "POST",
                headers: { ...headers, "Content-Type": "application/json", Prefer: "return=minimal" },
                body: JSON.stringify({
                  id: uid,
                  nickname: name,
                  avatar: "whale",
                  bio: "",
                  last_seen: new Date().toISOString(),
                }),
              },
              10000,
            );
          } catch {
            /* 建资料失败不影响登录 */
          }
        };

        /** 提交登录或注册，成功返回 true */
        const runAuth = async (win: HTMLElement, mode: "in" | "up"): Promise<boolean> => {
          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          const email = win.querySelector<HTMLInputElement>("[data-auth-email]")?.value.trim() ?? "";
          const password = win.querySelector<HTMLInputElement>("[data-auth-password]")?.value ?? "";
          const msg = win.querySelector("[data-auth-msg]");

          if (!email || !email.includes("@")) {
            if (msg) msg.textContent = "请填一个有效的邮箱";
            return false;
          }
          if (password.length < 6) {
            if (msg) msg.textContent = "密码至少 6 位";
            return false;
          }
          if (!sb?.url || !sb?.key) {
            if (msg) msg.textContent = "云端没接上";
            return false;
          }

          if (msg) msg.textContent = mode === "in" ? "正在登录…" : "正在注册…";

          try {
            const path = mode === "in" ? "/auth/v1/token?grant_type=password" : "/auth/v1/signup";
            const res = await fetchWithTimeout(
              `${sb.url}${path}`,
              {
                method: "POST",
                headers: { apikey: sb.key, "Content-Type": "application/json" },
                body: JSON.stringify({ email, password }),
              },
              15000,
            );

            const data = (await res.json()) as {
              access_token?: string;
              refresh_token?: string;
              user?: { id: string; email: string };
              error_description?: string;
              msg?: string;
              error?: string;
            };

            if (!res.ok) {
              const raw = data.error_description || data.msg || data.error || "操作失败";
              throw new Error(String(raw).replace(/^\w+:\s*/, ""));
            }
            if (!data.access_token || !data.user) {
              throw new Error("注册成功但没拿到登录状态，点一下登录试试");
            }

            writeAuth({
              token: data.access_token,
              refresh: data.refresh_token ?? "",
              uid: data.user.id,
              email: data.user.email ?? email,
              at: Date.now(),
            });

            await ensureMyProfile(data.access_token, data.user.id, data.user.email ?? email);
            return true;
          } catch (err) {
            if (msg) msg.textContent = (err as Error).message;
            return false;
          }
        };

        /**
         * 生成一个随机 ID。
         * crypto.randomUUID 要 Safari 15.4 以上才有，老浏览器会直接抛错，
         * 所以这里逐级降级，保证任何环境都能拿到一个唯一值。
         */
        const makeId = (): string => {
          if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
            return crypto.randomUUID();
          }
          if (typeof crypto !== "undefined" && typeof crypto.getRandomValues === "function") {
            const bytes = new Uint8Array(16);
            crypto.getRandomValues(bytes);
            bytes[6] = (bytes[6] & 0x0f) | 0x40;
            bytes[8] = (bytes[8] & 0x3f) | 0x80;
            const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
            return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
          }
          return `id-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
        };

        /**
         * 带超时的 fetch。
         * 国内访问 supabase.co 经常是「连接挂住」而不是报错，
         * 不设超时的话界面会永远停在「正在加载」。
         */
        const fetchWithTimeout = async (url: string, options: RequestInit = {}, ms = 7000) => {
          const controller = new AbortController();
          const timer = window.setTimeout(() => controller.abort(), ms);
          try {
            return await fetch(url, { ...options, signal: controller.signal });
          } finally {
            window.clearTimeout(timer);
          }
        };

        const os = document.getElementById("os");
        const windows = document.getElementById("windows");
        const hint = document.getElementById("desk-hint");
        if (!os || !windows || !hint) return;

        let zTop = 10;
        let cascade = 0;

        /* ---------------- 状态持久化 ---------------- */

        const STATE_KEY = "guandao.os.state.v1";

        interface WinState {
          left: number;
          top: number;
          minimized: boolean;
        }

        const readState = (): { wall?: string; windows?: Record<string, WinState> } => {
          try {
            return JSON.parse(localStorage.getItem(STATE_KEY) || "{}");
          } catch {
            return {};
          }
        };

        const writeState = (patch: Record<string, unknown>) => {
          try {
            localStorage.setItem(STATE_KEY, JSON.stringify({ ...readState(), ...patch }));
          } catch {
            /* 隐私模式写不进去，忽略即可 */
          }
        };

        const saveWindows = () => {
          const map: Record<string, WinState> = {};
          windows.querySelectorAll<HTMLElement>(".window").forEach((win) => {
            const app = win.dataset.app;
            if (!app) return;
            map[app] = {
              left: win.offsetLeft,
              top: win.offsetTop,
              minimized: win.classList.contains("is-minimized"),
            };
          });
          writeState({ windows: map });
        };

        /* ---------------- 程序坞配置 ---------------- */

        const DOCK_KEY = "guandao.os.dock";
        const DOCK_DEFAULT = ["posts", "about", "terminal", "settings"];

        const APP_ICON: Record<string, string> = {
          posts: "di-folder",
          about: "di-person",
          music: "di-music",
          terminal: "di-term",
          settings: "di-gear",
          achievements: "di-ach",
          aquarium: "di-tank",
          visitors: "di-wall",
          rank: "di-rank",
          draw: "di-draw",
          council: "di-vote",
          treehole: "di-hole",
          news: "di-tv",
          social: "di-net",
        };

        const readDock = (): string[] => {
          try {
            const raw = JSON.parse(localStorage.getItem(DOCK_KEY) || "null");
            if (Array.isArray(raw)) return raw.filter((id): id is string => typeof id === "string");
          } catch {
            /* 配置坏了就退回默认 */
          }
          return [...DOCK_DEFAULT];
        };

        const saveDock = (list: string[]) => {
          try {
            localStorage.setItem(DOCK_KEY, JSON.stringify(list));
          } catch {
            /* 忽略 */
          }
        };

        const renderDock = () => {
          const dock = document.getElementById("dock");
          if (!dock || !DATA) return;

          const items = readDock()
            .filter((id) => APPS[id])
            .map(
              (id) => `
                <button class="dock-item" type="button" data-app="${id}" title="${APPS[id].title}">
                  <span class="dock-glyph ${APP_ICON[id] ?? "di-folder"}"></span>
                </button>`,
            )
            .join("");

          dock.innerHTML = `${items}
            <span class="dock-sep"></span>
            <a class="dock-item dock-link" href="/home/" title="回到博客">
              <span class="dock-glyph di-home"></span>
            </a>`;

          // 重建后把运行中的小圆点补回去
          dock.querySelectorAll<HTMLElement>(".dock-item[data-app]").forEach((el) => {
            const id = el.dataset.app;
            if (!id) return;
            const win = windows.querySelector(`.window[data-app="${id}"]`);
            if (!win) return;
            el.classList.add(win.classList.contains("is-minimized") ? "has-hidden" : "has-open");
          });
        };

        /* ---------------- 成就 ---------------- */

        const ACH_KEY = "guandao.os.ach.v1";

        interface AchState {
          unlocked: Record<string, number>;
          visits: number;
          petClicks: number;
          apps: string[];
          reads: number;
        }

        interface Achievement {
          id: string;
          mark: string;
          name: string;
          desc: string;
        }

        const ACHIEVEMENTS: Achievement[] = [
          { id: "first", mark: "初", name: "第一位访客", desc: "第一次推开这扇门" },
          { id: "night", mark: "夜", name: "深夜探索者", desc: "凌晨还在这里逛" },
          { id: "dawn", mark: "晨", name: "赶早的人", desc: "天没亮就来了" },
          { id: "roam", mark: "游", name: "桌面漫游者", desc: "每个应用都打开过一遍" },
          { id: "hack", mark: ">_", name: "终端黑客", desc: "在终端敲下第一条命令" },
          { id: "music", mark: "♪", name: "音乐鉴赏家", desc: "听过「白饭时间」" },
          { id: "rice", mark: "饭", name: "白饭信徒", desc: "戳了鲸鲸十次" },
          { id: "power", mark: "关", name: "关机达人", desc: "认真把它关掉过一次" },
          { id: "regular", mark: "常", name: "常客", desc: "来过五次以上" },
          { id: "reader", mark: "读", name: "考古学家", desc: "翻过三篇文章" },
          { id: "draw", mark: "运", name: "手气不错", desc: "抽到过隐藏奖励" },
        ];

        const readAch = (): AchState => {
          try {
            const raw = JSON.parse(localStorage.getItem(ACH_KEY) || "{}");
            return {
              unlocked: raw.unlocked ?? {},
              visits: raw.visits ?? 0,
              petClicks: raw.petClicks ?? 0,
              apps: raw.apps ?? [],
              reads: raw.reads ?? 0,
            };
          } catch {
            return { unlocked: {}, visits: 0, petClicks: 0, apps: [], reads: 0 };
          }
        };

        const saveAch = (state: AchState) => {
          try {
            localStorage.setItem(ACH_KEY, JSON.stringify(state));
          } catch {
            /* 写不进去就算了 */
          }
        };

        const toastStack = document.getElementById("toast-stack");

        const showToast = (ach: Achievement) => {
          if (!toastStack) return;

          const el = document.createElement("div");
          el.className = "toast";

          const mark = document.createElement("span");
          mark.className = "toast-mark";
          mark.textContent = ach.mark;

          const body = document.createElement("span");
          body.className = "toast-body";

          const kicker = document.createElement("span");
          kicker.className = "toast-kicker";
          kicker.textContent = "解锁成就";

          const name = document.createElement("span");
          name.className = "toast-name";
          name.textContent = ach.name;

          body.append(kicker, name);
          el.append(mark, body);
          toastStack.appendChild(el);

          window.requestAnimationFrame(() => el.classList.add("is-in"));
          window.setTimeout(() => {
            el.classList.remove("is-in");
            window.setTimeout(() => el.remove(), 420);
          }, 3200);
        };

        const unlock = (id: string, silent = false) => {
          const state = readAch();
          if (state.unlocked[id]) return false;

          const ach = ACHIEVEMENTS.find((item) => item.id === id);
          if (!ach) return false;

          state.unlocked[id] = Date.now();
          saveAch(state);
          if (!silent) showToast(ach);
          return true;
        };

        /* ---------------- 窗口内容 ---------------- */

