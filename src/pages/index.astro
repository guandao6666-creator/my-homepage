        background:
          linear-gradient(#c02848, #c02848) center / 4px 100% no-repeat,
          linear-gradient(#c02848, #c02848) center / 100% 4px no-repeat,
          rgba(255, 255, 255, 0.94);
      }
      .di-draw::after {
        content: "";
        position: absolute;
        left: 4px;
        right: 4px;
        top: 8px;
        height: 4px;
        border-radius: 1px;
        background: rgba(255, 255, 255, 0.94);
      }

      /* 图标：投票箱 */
      .di-vote {
        background: linear-gradient(160deg, #a78bfa 0%, #6d28d9 100%);
      }
      .di-vote::before {
        content: "";
        position: absolute;
        left: 7px;
        top: 13px;
        width: 20px;
        height: 12px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.94);
      }
      .di-vote::after {
        content: "";
        position: absolute;
        left: 11px;
        top: 9px;
        width: 12px;
        height: 3px;
        border-radius: 1px;
        background: #6d28d9;
      }

      /* 图标：树洞 */
      .di-hole {
        background: linear-gradient(160deg, #a8bf85 0%, #3f5230 100%);
      }
      .di-hole::before {
        content: "";
        position: absolute;
        left: 9px;
        top: 10px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: radial-gradient(circle at 38% 32%, #2a1f16 0%, #0f0a06 78%);
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.85);
      }

      /* 图标：电视机 */
      .di-tv {
        background: linear-gradient(160deg, #7dd3fc 0%, #0369a1 100%);
      }
      .di-tv::before {
        content: "";
        position: absolute;
        inset: 11px 5px 7px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.94);
      }
      .di-tv::after {
        content: "";
        position: absolute;
        left: 8px;
        right: 8px;
        top: 14px;
        bottom: 10px;
        border-radius: 1px;
        background: #0369a1;
      }

      /* 图标：网络 */
      .di-net {
        background: linear-gradient(160deg, #f0abfc 0%, #7e22ce 100%);
      }
      .di-net::before {
        content: "";
        position: absolute;
        left: 9px;
        top: 9px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        box-shadow:
          9px 5px 0 rgba(255, 255, 255, 0.95),
          2px 13px 0 rgba(255, 255, 255, 0.95);
      }
      .di-net::after {
        content: "";
        position: absolute;
        left: 11px;
        top: 12px;
        width: 11px;
        height: 9px;
        border-top: 1.5px solid rgba(255, 255, 255, 0.45);
        border-right: 1.5px solid rgba(255, 255, 255, 0.45);
        transform: skewY(-32deg);
      }

      /* 图标：齿轮 */
      .di-gear {
        background: linear-gradient(180deg, #a9b4c9 0%, #6b7688 100%);
      }
      .di-gear::before {
        content: "";
        position: absolute;
        inset: 9px;
        border-radius: 50%;
        border: 3px solid rgba(255, 255, 255, 0.9);
      }
      .di-gear::after {
        content: "";
        position: absolute;
        inset: 15px;
        border-radius: 50%;
        background: rgba(40, 44, 56, 0.9);
      }

      /* 图标：房子 */
      .di-home {
        background: linear-gradient(180deg, #8fd8a8 0%, #3f9a68 100%);
      }
      .di-home::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 7px;
        width: 16px;
        height: 16px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%) rotate(45deg);
        border-radius: 2px;
      }
      .di-home::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 6px;
        width: 16px;
        height: 11px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%);
        border-radius: 0 0 3px 3px;
      }

      .desk-hint {
        position: absolute;
        left: 50%;
        bottom: 110px;
        transform: translateX(-50%);
        margin: 0;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.36);
        transition: opacity 0.4s ease;
      }

      /* ---------------- 桌面宠物 ---------------- */

      .desk-pet {
        position: absolute;
        right: 26px;
        bottom: 100px;
        z-index: 24;
        width: 86px;
        height: 122px;
        cursor: grab;
        touch-action: none;
        transition: transform 0.2s ease;
      }

      .desk-pet:hover {
        transform: translateY(-3px);
      }

      .desk-pet.is-dragging {
        cursor: grabbing;
        transition: none;
      }

      .pet-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.55));
      }

      .pet-say {
        position: absolute;
        right: 8px;
        bottom: calc(100% + 4px);
        max-width: 156px;
        margin: 0;
        padding: 6px 10px;
        border-radius: 10px 10px 2px 10px;
        background: #f5f7fc;
        box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.7);
        font-size: 11.5px;
        line-height: 1.5;
        color: #171a22;
        white-space: nowrap;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        pointer-events: none;
      }

      .pet-say.show {
        opacity: 1;
        transform: none;
      }

      .desk-hint.is-gone {
        opacity: 0;
      }

      /* ---------------- 窗口 ---------------- */

      .windows {
        position: absolute;
        inset: 0;
        pointer-events: none;
        transition: opacity 0.26s ease, transform 0.26s ease;
      }

      /* 工作区切换时，整个窗口层做一个短暂的位移淡出 */
      .windows.is-switching {
        opacity: 0.5;
        transform: translateX(18px);
      }

      .window {
        position: absolute;
        display: flex;
        flex-direction: column;
        border-radius: var(--os-r-md);
        overflow: hidden;
        pointer-events: auto;
        background: var(--os-panel);
        backdrop-filter: blur(26px) saturate(1.5);
        border: 1px solid var(--os-line);
        box-shadow: var(--os-shadow-lg);
        transition: transform 0.18s ease, opacity 0.18s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        animation: winIn 0.22s ease-out;
      }

      .window.is-front {
        border-color: var(--os-line-strong);
      }

      /* 非激活窗口：弱化边框与阴影，标题栏变暗 */
      .window:not(.is-front) {
        border-color: var(--os-line-soft);
        box-shadow: var(--os-shadow-md);
      }

      .window:not(.is-front) .titlebar {
        opacity: 0.66;
      }

      .window.is-dragging {
        transition: none;
      }

      .window.is-resizing {
        transition: none;
        user-select: none;
      }

      .window.is-maximized {
        border-radius: 0;
        border-left: 0;
        border-right: 0;
        border-bottom: 0;
      }

      /* 右下角调整大小手柄 */
      .resize-handle {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 18px;
        height: 18px;
        cursor: nwse-resize;
        touch-action: none;
        z-index: 6;
        background:
          linear-gradient(135deg, transparent 55%, rgba(255, 255, 255, 0.34) 55%) 6px 10px / 6px 6px no-repeat,
          linear-gradient(135deg, transparent 55%, rgba(255, 255, 255, 0.34) 55%) 2px 6px / 6px 6px no-repeat;
      }

      .window.is-maximized .resize-handle {
        display: none;
      }

      /* 虚拟桌面：属于另一个工作区的窗口淡出并禁用交互 */
      .window.is-hidden-space {
        opacity: 0;
        pointer-events: none;
      }

      /* ---------------- 窗口贴靠预览 ---------------- */
      .snap-preview {
        position: fixed;
        z-index: 5000;
        border-radius: 10px;
        border: 1.5px solid rgba(111, 140, 255, 0.65);
        background: rgba(111, 140, 255, 0.12);
        box-shadow: 0 0 0 1px rgba(111, 140, 255, 0.15), inset 0 0 60px rgba(111, 140, 255, 0.12);
        pointer-events: none;
        transition: all 0.12s ease;
      }

      .window.is-closing {
        transform: scale(0.94);
        opacity: 0;
      }

      .window.is-minimized {
        opacity: 0;
        pointer-events: none;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.6, 1), opacity 0.3s ease;
      }

      @keyframes winIn {
        from {
          transform: scale(0.96) translateY(8px);
          opacity: 0;
        }
        to {
          transform: none;
          opacity: 1;
        }
      }

      .titlebar {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 40px;
        padding: 0 14px;
        background: rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        cursor: grab;
        transition: opacity 0.2s ease;
      }

      .is-dragging .titlebar {
        cursor: grabbing;
      }

      .dots {
        display: flex;
        gap: 8px;
        flex: none;
      }

      .dot {
        position: relative;
        width: 12px;
        height: 12px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        cursor: pointer;
        box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
      }

      /* 悬停标题栏时，交通灯上浮现 × − + 符号 */
      .dot::before {
        content: "";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: system-ui, sans-serif;
        font-size: 8px;
        line-height: 1;
        font-weight: 700;
        color: rgba(0, 0, 0, 0.5);
        opacity: 0;
        transition: opacity 0.12s ease;
      }

      .dot-close::before { content: "×"; }
      .dot-min::before { content: "–"; }
      .dot-max::before { content: "+"; }

      .titlebar:hover .dot::before {
        opacity: 1;
      }

      .dot-close {
        background: #ff5f57;
      }
      .dot-min {
        background: #febc2e;
      }
      .dot-max {
        background: #28c840;
      }

      .win-title {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.72);
        pointer-events: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 60%;
      }

      .win-body {
        flex: 1;
        min-height: 0;
        overflow: auto;
        overscroll-behavior: contain;
      }

      /* ---------------- Finder ---------------- */

      .finder {
        display: grid;
        grid-template-columns: 148px minmax(0, 1fr);
        height: 100%;
      }

      .finder-side {
        padding: 14px 12px;
        background: rgba(255, 255, 255, 0.04);
        border-right: 1px solid rgba(255, 255, 255, 0.06);
      }

      .side-title {
        margin: 12px 0 6px;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.36);
      }

      .side-title:first-child {
        margin-top: 0;
      }

      .side-item {
        display: block;
        padding: 6px 9px;
        border-radius: 7px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.62);
      }

      .side-item.is-active {
        background: rgba(111, 140, 255, 0.24);
        color: #fff;
      }

      .finder-files {
        padding: 8px;
        overflow: auto;
      }

      .file-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 9px;
        color: inherit;
        text-decoration: none;
        transition: background-color 0.16s ease;
      }

      .file-row:hover {
        background: rgba(255, 255, 255, 0.08);
      }

      .file-icon {
        width: 26px;
        height: 30px;
        flex: none;
        border-radius: 3px;
        background: linear-gradient(180deg, #ffffff 0%, #d9dfea 100%);
        position: relative;
      }

      .file-icon::after {
        content: "";
        position: absolute;
        left: 5px;
        right: 5px;
        top: 9px;
        height: 2px;
        background: rgba(70, 84, 110, 0.45);
        box-shadow: 0 5px 0 rgba(70, 84, 110, 0.3), 0 10px 0 rgba(70, 84, 110, 0.2);
      }

      .file-main {
        min-width: 0;
        display: grid;
        gap: 3px;
      }

      .file-name {
        font-size: 13px;
        color: #f2f5fa;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .file-meta {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.42);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .file-index {
        margin-left: auto;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.28);
      }

      .finder-empty {
        padding: 24px 12px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.45);
      }

      /* ---------------- 关于 ---------------- */

      .about {
        padding: 24px 26px;
        font-size: 13px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.72);
      }

      .about-kicker {
        margin: 0 0 4px;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.38);
      }

      .about h2 {
        margin: 0 0 12px;
        font-size: 22px;
        color: #fff;
      }

      .about p {
        margin: 0 0 10px;
      }

      .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .about-links a {
        font-size: 12.5px;
        color: #9fb4ff;
        text-decoration: none;
      }

      .about-links a:hover {
        text-decoration: underline;
      }

      /* ---------------- 终端 ---------------- */

      .term {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: rgba(8, 10, 16, 0.82);
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 12.5px;
      }

      .term-out {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 14px 16px 6px;
        line-height: 1.7;
      }

      .term-line {
        margin: 0 0 2px;
        color: rgba(232, 240, 255, 0.82);
        white-space: pre-wrap;
      }

      .term-muted {
        color: rgba(232, 240, 255, 0.42);
      }

      .term-echo {
        color: #7ef0b0;
      }

      .term-error {
        color: #ff8f8f;
      }

      .term-input-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 16px 14px;
      }

      .term-prompt {
        color: #7ef0b0;
      }

      .term-input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: none;
        color: #eef1f7;
        font: inherit;
        outline: none;
        caret-color: #7ef0b0;
      }

      /* ---------------- 设置 ---------------- */

      .settings {
        padding: 20px 22px;
      }

      .wall-picks {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
      }

      .dock-picker {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 7px 12px;
        margin-bottom: 8px;
      }

      .dock-opt {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.72);
        cursor: pointer;
      }

      .dock-opt:hover {
        color: #fff;
      }

      .dock-opt input {
        width: 13px;
        height: 13px;
        accent-color: #6f8cff;
        cursor: pointer;
      }

      .settings-tip {
        margin: 0 0 18px;
        font-size: 10.5px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.34);
      }

      .wall-pick {
        flex: 1;
        padding: 9px 0;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.72);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .wall-pick:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      .wall-pick.is-active {
        border-color: var(--os-accent);
        background: rgba(111, 140, 255, 0.22);
        color: #fff;
      }

      .settings-note {
        margin: 0;
        font-size: 12px;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.46);
      }

      /* 设置：外观主题 */
      .theme-picks {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
      }

      .theme-pick {
        flex: 1;
        padding: 9px 0;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.72);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .theme-pick:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      .theme-pick.is-active {
        border-color: var(--os-accent);
        background: rgba(111, 140, 255, 0.22);
        color: #fff;
      }

      /* 设置：开关行 */
      .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 12px;
        margin-bottom: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.03);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.78);
        cursor: pointer;
      }

      .settings-row:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .settings-row input {
        width: 15px;
        height: 15px;
        accent-color: #6f8cff;
        cursor: pointer;
      }

      /* 设置：数据管理 */
      .data-actions {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
      }

      .data-btn {
        flex: 1;
        padding: 8px 0;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.72);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .data-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
      }

      .data-btn.is-danger {
        border-color: rgba(255, 95, 87, 0.4);
        color: #ff9b95;
      }

      .data-btn.is-danger:hover {
        background: rgba(255, 95, 87, 0.16);
      }

      /* 设置：系统信息 */
      .sys-info {
        display: grid;
        gap: 2px;
        margin-bottom: 8px;
        padding: 4px 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.03);
      }

      .sys-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 7px 0;
        font-size: 12px;
        border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
      }

      .sys-row:last-child {
        border-bottom: 0;
      }

      .sys-row span {
        color: rgba(255, 255, 255, 0.42);
      }

      .sys-row b {
        font-weight: 550;
        color: rgba(255, 255, 255, 0.82);
        font-variant-numeric: tabular-nums;
      }

      /* ---------------- 音乐 ---------------- */

      .music {
        display: grid;
        gap: 12px;
        padding: 18px 20px 20px;
      }

      .music-cover {
        position: relative;
        height: 88px;
        border-radius: 10px;
        overflow: hidden;
        background: linear-gradient(135deg, #6f8cff 0%, #b06eff 100%);
      }

      .cover-disc {
        position: absolute;
        right: 16px;
        top: 50%;
        width: 62px;
        height: 62px;
        margin-top: -31px;
        border-radius: 50%;
        background: radial-gradient(circle, #161922 0 16%, #262b38 16% 42%, #161922 42% 100%);
        animation: discSpin 9s linear infinite;
      }

      .music-title {
        margin: 0;
        font-size: 15px;
        color: #fff;
      }

      .music-sub {
        margin: 2px 0 0;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
      }

      .music-bar {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .music-play {
        flex: none;
        width: 36px;
        height: 36px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 50%;
        background: rgba(111, 140, 255, 0.26);
        color: #fff;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .music-play:hover {
        background: rgba(111, 140, 255, 0.44);
      }

      .music-wave {
        flex: 1;
        min-width: 0;
        height: 42px;
      }

      .music-note {
        margin: 0;
        font-size: 11px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.42);
      }

      .music-step {
        flex: none;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        padding: 0;
        border: 0;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.66);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.18s ease, color 0.18s ease;
      }

      .music-step:hover {
        background: rgba(255, 255, 255, 0.16);
        color: #fff;
      }

      .music-list {
        max-height: 152px;
        margin: 14px 0 0;
        padding: 0;
        overflow: auto;
        list-style: none;
        display: grid;
        gap: 2px;
      }

      .music-row {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 9px;
        border-radius: 7px;
        cursor: pointer;
        transition: background-color 0.15s ease;
      }

      .music-row:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .music-row.is-current {
        background: rgba(111, 140, 255, 0.16);
      }

      .music-row-no {
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.3);
      }

      .music-row.is-playing .music-row-no {
        color: #8fa6ff;
      }

      .music-row-name {
        flex: 1;
        overflow: hidden;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.78);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .music-row.is-current .music-row-name {
        color: #fff;
      }

      @keyframes discSpin {
        to {
          transform: rotate(360deg);
        }
      }

      /* ---------------- 成就 ---------------- */

      .ach-wrap {
        padding: 18px 20px 20px;
      }

      .ach-head {
        margin: 0 0 14px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .ach-head b {
        font-size: 15px;
        color: #ffd479;
      }

      .ach-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .ach {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 11px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
      }

      .ach.is-got {
        border-color: rgba(255, 212, 121, 0.32);
        background: rgba(255, 212, 121, 0.08);
      }

      .ach-mark {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        flex: none;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.07);
        font-family: var(--font-serif);
        font-size: 14px;
        color: rgba(255, 255, 255, 0.42);
      }

      .ach.is-got .ach-mark {
        background: linear-gradient(150deg, #ffd479, #d1902a);
        color: #3a2606;
      }

      .ach-body {
        display: grid;
        gap: 2px;
        min-width: 0;
      }

      .ach-name {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.5);
      }

      .ach.is-got .ach-name {
        color: #fff;
      }

      .ach-desc {
        overflow: hidden;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.3);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* ---------------- 成就提示 ---------------- */

      .toast-stack {
        position: fixed;
        right: 18px;
        bottom: calc(96px + env(safe-area-inset-bottom, 0px));
        z-index: 500;
        display: grid;
        gap: 8px;
        pointer-events: none;
      }

      .toast {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 196px;
        padding: 10px 14px 10px 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        background: rgba(26, 29, 38, 0.94);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(18px);
        opacity: 0;
        transform: translateX(24px) scale(0.96);
        transition: opacity 0.3s ease, transform 0.36s cubic-bezier(0.2, 0.9, 0.3, 1.2);
      }

      .toast.is-in {
        opacity: 1;
        transform: none;
      }

      .toast-mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        flex: none;
        border-radius: 9px;
        background: linear-gradient(150deg, #ffd479, #d1902a);
        font-family: var(--font-serif);
        font-size: 15px;
        color: #3a2606;
      }

      .toast-body {
        display: grid;
        gap: 2px;
      }

      .toast-kicker {
        font-size: 10px;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.4);
      }

      .toast-name {
        font-size: 13px;
        color: #fff;
      }

      /* ---------------- 通知中心 ---------------- */

      .notif-center {
        position: fixed;
        top: 46px;
        right: 12px;
        z-index: 600;
        width: 320px;
        max-width: calc(100vw - 24px);
        max-height: min(72vh, 520px);
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(26, 29, 38, 0.96);
        box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(24px) saturate(1.5);
        overflow: hidden;
        animation: notifIn 0.22s var(--os-ease);
      }

      .notif-center[hidden] {
        display: none;
      }

      @keyframes notifIn {
        from {
          opacity: 0;
          transform: translateY(-8px) translateX(12px) scale(0.98);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .notif-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .notif-head-title {
        font-size: 13px;
        font-weight: 650;
        color: #fff;
      }

      .notif-clear {
        padding: 4px 10px;
        border: 0;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.6);
        font: inherit;
        font-size: 11px;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
      }

      .notif-clear:hover {
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
      }

      .notif-list {
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 8px;
        display: grid;
        gap: 4px;
      }

      .notif-empty {
        margin: 0;
        padding: 32px 16px;
        text-align: center;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
      }

      .notif-empty[hidden] {
        display: none;
      }

      .notif-item {
        position: relative;
        display: flex;
        gap: 11px;
        padding: 11px 12px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid transparent;
      }

      .notif-item.is-new {
        background: rgba(111, 140, 255, 0.09);
        border-color: rgba(111, 140, 255, 0.16);
      }

      .notif-icon {
        flex: none;
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.07);
        font-family: var(--font-serif);
        font-size: 15px;
        color: rgba(255, 255, 255, 0.82);
      }

      .notif-item.is-new .notif-icon {
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        color: #fff;
      }

      .notif-body {
        min-width: 0;
        display: grid;
        gap: 2px;
      }

      .notif-title {
        margin: 0;
        font-size: 12.5px;
        font-weight: 600;
        color: #fff;
      }

      .notif-text {
        margin: 0;
        font-size: 11.5px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.55);
        overflow-wrap: break-word;
      }

      .notif-time {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.32);
        margin-top: 3px;
      }

      /* ---------------- Spotlight 全局搜索 ---------------- */

      .spotlight {
        position: fixed;
        inset: 0;
        z-index: 8000;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 16vh;
        background: rgba(6, 8, 14, 0.4);
        backdrop-filter: blur(6px);
        animation: spotFade 0.18s ease;
      }

      .spotlight[hidden] {
        display: none;
      }

      @keyframes spotFade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .spotlight-box {
        width: min(560px, 92vw);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(24, 27, 38, 0.92);
        box-shadow: 0 32px 80px -24px rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(28px) saturate(1.6);
        overflow: hidden;
        animation: spotIn 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.15);
      }

      @keyframes spotIn {
        from {
          opacity: 0;
          transform: translateY(-10px) scale(0.98);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .spotlight-input-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .spotlight-icon {
        width: 17px;
        height: 17px;
        color: rgba(255, 255, 255, 0.45);
        flex: none;
      }

      #spotlight-input {
        flex: 1;
        border: 0;
        background: none;
        outline: none;
        color: #fff;
        font-size: 16px;
      }

      .spotlight-kbd,
      .spotlight-foot kbd {
        padding: 2px 6px;
        border-radius: 5px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.06);
        font-family: ui-monospace, monospace;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.5);
      }

      .spotlight-results {
        max-height: 340px;
        overflow-y: auto;
        padding: 6px;
      }

      .spot-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px 12px;
        border: 0;
        border-radius: 9px;
        background: none;
        color: #eef1f7;
        text-align: left;
        cursor: pointer;
      }

      .spot-item.is-active {
        background: rgba(111, 140, 255, 0.24);
      }

      .spot-kind {
        flex: none;
        width: 34px;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
      }

      .spot-main {
        flex: 1;
        min-width: 0;
        display: grid;
        gap: 2px;
      }

      .spot-title {
        font-size: 13px;
        color: #fff;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .spot-sub {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.45);
      }

      .spot-enter {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.3);
      }

      .spot-empty {
        padding: 24px;
        text-align: center;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
      }

      .spotlight-foot {
        display: flex;
        justify-content: flex-end;
        gap: 14px;
        padding: 8px 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.4);
      }

      /* ---------------- Mission Control 任务视图 ---------------- */

      .mission {
        position: fixed;
        inset: 0;
        z-index: 7000;
        display: flex;
        flex-direction: column;
        padding: 44px 32px 32px;
        background: rgba(6, 8, 14, 0.62);
        backdrop-filter: blur(22px) saturate(1.4);
        animation: spotFade 0.2s ease;
      }

      .mission[hidden] {
        display: none;
      }

      .mission-top {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 24px;
      }

      .mission-title {
        font-size: 16px;
        font-weight: 650;
        color: #fff;
        flex: none;
      }

      .mission-desks {
        display: flex;
        gap: 10px;
        flex: 1;
        overflow-x: auto;
      }

      .mc-desk {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 96px;
        padding: 10px 14px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.06);
        color: #fff;
        cursor: pointer;
        transition: all 0.2s ease;
        flex: none;
      }

      .mc-desk.is-active {
        border-color: rgba(111, 140, 255, 0.7);
        background: rgba(111, 140, 255, 0.22);
      }

      .mc-desk-name {
        font-size: 12px;
        font-weight: 600;
      }
      .mc-desk-count {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.5);
      }

      .mc-desk-add {
        align-items: center;
        justify-content: center;
        min-width: 44px;
        font-size: 18px;
        color: rgba(255, 255, 255, 0.6);
      }

      .mc-desk-add:disabled {
        opacity: 0.3;
        cursor: default;
      }

      .mission-close {
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        font-size: 20px;
        cursor: pointer;
        flex: none;
      }

      .mission-grid {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 22px;
        align-content: start;
        overflow-y: auto;
      }

      .mc-card {
        position: relative;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(24, 27, 38, 0.9);
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
        animation: mcIn 0.24s var(--os-ease) both;
      }

      .mc-card:hover {
        transform: translateY(-4px) scale(1.02);
        border-color: rgba(111, 140, 255, 0.6);
        box-shadow: 0 16px 40px -16px rgba(0, 0, 0, 0.7);
      }

      .mc-card.is-other {
        opacity: 0.6;
      }

      @keyframes mcIn {
        from {
          opacity: 0;
          transform: translateY(12px) scale(0.96);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .mc-card-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
      }

      .mc-dots {
        display: flex;
        gap: 4px;
      }
      .mc-dots i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
      }

      .mc-card-title {
        flex: 1;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.7);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .mc-card-close {
        width: 18px;
        height: 18px;
        border: 0;
        border-radius: 5px;
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.7);
        font-size: 13px;
        line-height: 1;
        cursor: pointer;
      }

      .mc-card-close:hover {
        background: #ff5f57;
        color: #fff;
      }

      .mc-card-body {
        display: grid;
        place-items: center;
        height: 110px;
        background: rgba(255, 255, 255, 0.02);
      }

      .mc-glyph {
        width: 44px;
        height: 44px;
        border-radius: 11px;
      }

      .mc-card-space {
        position: absolute;
        bottom: 8px;
        right: 10px;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.4);
      }

      .mc-empty {
        grid-column: 1 / -1;
        padding: 60px 0;
        text-align: center;
        font-size: 13px;
        line-height: 2;
        color: rgba(255, 255, 255, 0.45);
      }

      /* ---------------- 桌面小组件 ---------------- */

      .widgets {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;
      }

      .widget {
        position: absolute;
        width: 172px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(20, 23, 33, 0.6);
        backdrop-filter: blur(20px) saturate(1.5);
        box-shadow: 0 12px 32px -14px rgba(0, 0, 0, 0.7);
        pointer-events: auto;
        overflow: hidden;
        animation: widgetIn 0.3s var(--os-ease);
      }

      .widget.is-dragging {
        opacity: 0.85;
        cursor: grabbing;
      }

      @keyframes widgetIn {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .widget-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px 0;
        cursor: grab;
        user-select: none;
      }

      .widget-title {
        font-size: 11px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
      }

      .widget-grip {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.3);
        letter-spacing: -2px;
      }

      .widget-body {
        padding: 8px 12px 12px;
      }

      /* 时钟 */
      .w-time {
        font-family: var(--font-mono);
        font-size: 30px;
        font-weight: 600;
        color: #fff;
        letter-spacing: 0.01em;
        font-variant-numeric: tabular-nums;
      }
      .w-date {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
        margin-top: 2px;
      }

      /* 日历 */
      .w-cal-title {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 6px;
        text-align: center;
      }
      .w-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
        text-align: center;
      }
      .w-cal-h {
        font-size: 9px;
        color: rgba(255, 255, 255, 0.35);
        padding-bottom: 3px;
      }
      .w-cal-grid span {
        font-size: 10px;
        padding: 3px 0;
        color: rgba(255, 255, 255, 0.72);
        border-radius: 4px;
      }
      .w-cal-grid span.is-today {
        background: var(--os-accent);
        color: #fff;
        font-weight: 700;
      }

      /* 天气 */
      .w-wx-main {
        display: flex;
        align-items: baseline;
        gap: 8px;
      }
      .w-wx-temp {
        font-family: var(--font-mono);
        font-size: 24px;
        font-weight: 600;
        color: #fff;
      }
      .w-wx-desc {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.6);
      }
      .w-wx-sub {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.4);
        margin-top: 4px;
      }
      .w-loading {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.4);
      }

      /* 待办 */
      .w-todo-input {
        width: 100%;
        padding: 5px 8px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font: inherit;
        font-size: 11px;
        outline: none;
      }
      .w-todo-input:focus {
        border-color: var(--os-accent);
      }
      .w-todo-list {
        list-style: none;
        margin: 8px 0 0;
        padding: 0;
        display: grid;
        gap: 4px;
        max-height: 110px;
        overflow-y: auto;
      }
      .w-todo-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.8);
      }
      .w-todo-check {
        width: 14px;
        height: 14px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 4px;
        cursor: pointer;
        font-size: 10px;
        line-height: 12px;
        text-align: center;
        flex: none;
      }
      .w-todo-item.is-done .w-todo-check {
        background: var(--os-success);
        border-color: var(--os-success);
        color: #0a2016;
      }
      .w-todo-item.is-done .w-todo-text {
        text-decoration: line-through;
        opacity: 0.5;
      }
      .w-todo-text {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .w-todo-del {
        border: 0;
        background: none;
        color: rgba(255, 255, 255, 0.35);
        cursor: pointer;
        font-size: 13px;
        padding: 0 2px;
      }
      .w-todo-del:hover {
        color: #ff5f57;
      }
      .w-todo-empty {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.35);
        text-align: center;
        padding: 8px 0;
      }

      /* 系统信息 */
      .w-sys-row {
        display: flex;
        justify-content: space-between;
        font-size: 10.5px;
        padding: 3px 0;
        color: rgba(255, 255, 255, 0.55);
      }
      .w-sys-row b {
        color: #fff;
        font-weight: 600;
      }

      /* ---------------- 水族箱 ---------------- */

      .tank {
        position: relative;
        height: 100%;
        overflow: hidden;
        cursor: pointer;
        --phase-speed: 1;
        --phase-bright: 1;
        --phase-saturate: 1;
        background: linear-gradient(180deg, #0a2f45 0%, #0e4762 48%, #071e2c 100%);
        transition: background 1.4s ease;
      }

      /* 清晨：水偏青，醒得快（时长倍率 <1 代表更快） */
      .tank[data-phase="dawn"] {
        background: linear-gradient(180deg, #0d3d4c 0%, #1a6478 48%, #0a2b36 100%);
        --phase-speed: 0.85;
        --phase-bright: 1.06;
      }

      /* 白天：常态 */
      .tank[data-phase="day"] {
        background: linear-gradient(180deg, #0a2f45 0%, #0e4762 48%, #071e2c 100%);
        --phase-speed: 1;
      }

      /* 傍晚：水偏紫，慢下来 */
      .tank[data-phase="dusk"] {
        background: linear-gradient(180deg, #321a4a 0%, #4d2760 48%, #1b0d28 100%);
        --phase-speed: 1.35;
        --phase-bright: 0.86;
        --phase-saturate: 0.82;
      }

      /* 深夜：熄灯，游得最慢 */
      .tank[data-phase="night"] {
        background: linear-gradient(180deg, #061622 0%, #0a2a3c 48%, #04101a 100%);
        --phase-speed: 2.1;
        --phase-bright: 0.66;
        --phase-saturate: 0.72;
      }

      .tank::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(120, 220, 255, 0.16), transparent 30%);
        pointer-events: none;
      }

      .bubbles {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .bubble {
        position: absolute;
        bottom: -14px;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: radial-gradient(circle at 32% 30%, rgba(255, 255, 255, 0.95), rgba(130, 215, 255, 0.3));
        animation: bubbleRise var(--dur) linear infinite;
        animation-delay: var(--delay);
      }

      @keyframes bubbleRise {
        to {
          transform: translateY(-520px);
          opacity: 0;
        }
      }

      .tank-floor {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 46px;
        background: radial-gradient(58% 100% at 50% 100%, rgba(36, 104, 104, 0.5), transparent 70%);
        pointer-events: none;
      }

      .fish-layer {
        position: absolute;
        inset: 0;
      }

      .fish {
        position: absolute;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background-image: var(--bg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow:
          0 0 0 2px rgba(180, 230, 255, 0.32),
          0 10px 22px -8px rgba(0, 0, 0, 0.65);
        animation-name: driftSoft;
        animation-duration: calc(var(--base-dur, 11s) * var(--phase-speed, 1));
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        animation-delay: var(--delay);
        filter: brightness(var(--phase-bright, 1)) saturate(var(--phase-saturate, 1));
        transition: filter 1.2s ease;
      }

      /* 按性格给每条不同的游法 */
      .fish[data-ai="chatgpt"] {
        --base-dur: 11s;
        animation-name: driftSoft;
      }
      .fish[data-ai="deepseek"] {
        --base-dur: 13s;
        animation-name: driftDeep;
      }
      .fish[data-ai="claude"] {
        --base-dur: 12s;
        animation-name: driftWide;
      }
      .fish[data-ai="grok"] {
        --base-dur: 9s;
        animation-name: dashAround;
        animation-direction: normal;
      }
      .fish[data-ai="gemini"] {
        --base-dur: 14s;
        animation-name: orbitPath;
        animation-direction: normal;
      }
      .fish[data-ai="wenxin"] {
        --base-dur: 19s;
        animation-name: driftSlow;
      }
      .fish[data-ai="qwen"] {
        --base-dur: 15s;
        animation-name: glideDiagonal;
      }

      .fish::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: linear-gradient(150deg, rgba(255, 255, 255, 0.26), transparent 46%);
        pointer-events: none;
      }

      /* ChatGPT：不紧不慢地上下浮 */
      @keyframes driftSoft {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(16px, -20px);
        }
      }

      /* DeepSeek：喜欢沉在下面，偶尔上来 */
      @keyframes driftDeep {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(26px, 24px);
        }
      }

      /* Claude：稳稳地横着走 */
      @keyframes driftWide {
        from {
          transform: translate(-16px, 2px);
        }
        to {
          transform: translate(16px, -12px);
        }
      }

      /* 文心：动得很轻，像懒得动 */
      @keyframes driftSlow {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(7px, -10px);
        }
      }

      /* Grok：横冲直撞 */
      @keyframes dashAround {
        0% {
          transform: translate(0, 0);
        }
        28% {
          transform: translate(104px, -32px);
        }
        52% {
          transform: translate(-64px, 38px);
        }
        78% {
          transform: translate(72px, 16px);
        }
        100% {
          transform: translate(0, 0);
        }
      }

      /* Gemini：绕着圈转 */
      @keyframes orbitPath {
        0% {
          transform: translate(0, 0);
        }
        25% {
          transform: translate(32px, -18px);
        }
        50% {
          transform: translate(0, -36px);
        }
        75% {
          transform: translate(-32px, -18px);
        }
        100% {
          transform: translate(0, 0);
        }
      }

      /* 千问：斜着滑，像摇扇子 */
      @keyframes glideDiagonal {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(-24px, -18px);
        }
      }

      .fish-name {
        position: absolute;
        left: 50%;
        bottom: -15px;
        transform: translateX(-50%);
        font-size: 9px;
        letter-spacing: 0.02em;
        color: rgba(215, 238, 255, 0.5);
        white-space: nowrap;
        pointer-events: none;
      }

      .food {
        position: absolute;
        width: 6px;
        height: 6px;
        margin: -3px 0 0 -3px;
        border-radius: 50%;
        background: #ffd479;
        box-shadow: 0 0 8px rgba(255, 212, 121, 0.85);
        animation: foodSink 0.82s ease-in forwards;
        pointer-events: none;
      }

      @keyframes foodSink {
        to {
          transform: translateY(24px);
          opacity: 0.35;
        }
      }

      .heart {
        position: absolute;
        left: 50%;
        top: -10px;
        font-size: 14px;
        color: #ff8fb1;
        pointer-events: none;
        animation: heartUp 1.7s ease-out forwards;
      }

      /* 深夜的瞌睡泡 */
      .zzz {
        position: absolute;
        right: -2px;
        top: -8px;
        font-family: var(--font-serif);
        font-size: 12px;
        font-weight: 600;
        color: rgba(190, 225, 255, 0.75);
        pointer-events: none;
        animation: zzzFloat 3s ease-out forwards;
      }

      @keyframes zzzFloat {
        0% {
          opacity: 0;
          transform: translate(0, 0) scale(0.7);
        }
        22% {
          opacity: 1;
        }
        100% {
          opacity: 0;
          transform: translate(9px, -28px) scale(1.1);
        }
      }

      @keyframes heartUp {
        0% {
          opacity: 0;
          transform: translate(-50%, 0) scale(0.6);
        }
        25% {
          opacity: 1;
          transform: translate(-50%, -10px) scale(1);
        }
        100% {
          opacity: 0;
          transform: translate(-50%, -40px) scale(1.1);
        }
      }

      .tank-hint {
        position: absolute;
        left: 50%;
        bottom: 12px;
        transform: translateX(-50%);
        margin: 0;
        font-size: 10.5px;
        color: rgba(200, 235, 255, 0.42);
        white-space: nowrap;
        pointer-events: none;
      }

      /* ---------------- 访客墙 ---------------- */

      .wall {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 20px 18px;
      }

      .wall-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
      }

      .wall-count {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .wall-add {
        margin-left: auto;
        padding: 7px 14px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 8px;
        background: rgba(111, 140, 255, 0.22);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .wall-add:hover {
        background: rgba(111, 140, 255, 0.38);
      }

      .wall-grid {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
        align-content: start;
        gap: 10px;
        overflow: auto;
      }

      .wall-item {
        display: grid;
        justify-items: center;
        gap: 6px;
        padding: 8px 4px;
        border-radius: 10px;
        transition: background-color 0.18s ease;
      }

      .wall-item:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .wall-item img {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.14);
        object-fit: cover;
      }

      .wall-item span {
        max-width: 78px;
        overflow: hidden;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.62);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .wall-empty {
        grid-column: 1 / -1;
        margin: 0;
        padding: 30px 0;
        font-size: 12.5px;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
      }

      .wall-form {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .wall-form[hidden] {
        display: none;
      }

      .wall-name {
        flex: 1;
        min-width: 140px;
        padding: 8px 10px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        outline: none;
      }

      .wall-name:focus {
        border-color: rgba(111, 140, 255, 0.6);
      }

      .wall-pick {
        max-width: 168px;
        overflow: hidden;
        padding: 8px 12px;
        border: 1px dashed rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.66);
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: pointer;
      }

      .wall-pick:hover {
        border-color: rgba(111, 140, 255, 0.5);
        color: #fff;
      }

      .wall-submit {
        padding: 8px 16px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(150deg, #6f8cff, #9b6bff);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .wall-submit:disabled {
        opacity: 0.6;
        cursor: default;
      }

      .wall-note {
        min-height: 16px;
        margin: 8px 0 0;
        font-size: 11px;
        color: rgba(255, 212, 121, 0.85);
      }

      /* ---------------- 排行榜 ---------------- */

      .rank {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 18px 14px;
      }

      .rank-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }

      .rank-status {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .rank-join {
        margin-left: auto;
        padding: 7px 14px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 8px;
        background: rgba(142, 230, 168, 0.18);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .rank-join:hover:not(:disabled) {
        background: rgba(142, 230, 168, 0.32);
      }

      .rank-join:disabled {
        cursor: default;
        opacity: 0.72;
      }

      .rank-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 4px;
        overflow: auto;
      }

      .rank-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: 8px;
      }

      .rank-row.is-top {
        background: rgba(255, 212, 121, 0.08);
      }

      .rank-no {
        width: 20px;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.32);
      }

      .rank-row.is-top .rank-no {
        color: #ffd479;
      }

      .rank-name {
        flex: 1;
        overflow: hidden;
        font-size: 12.5px;
        color: #f2f5fa;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .rank-time {
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.5);
      }

      .rank-empty {
        margin: 0;
        padding: 26px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
      }

      .rank-note {
        margin: 10px 0 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.32);
      }

      /* ---------------- 每日抽奖 ---------------- */

      .draw {
        display: grid;
        align-content: center;
        justify-items: center;
        gap: 16px;
        height: 100%;
        padding: 20px;
      }

      .draw-card {
        display: grid;
        place-items: center;
        width: 148px;
        height: 186px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 14px;
        background: linear-gradient(160deg, rgba(111, 140, 255, 0.28), rgba(155, 107, 255, 0.16));
        box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.8);
        transition: background 0.4s ease, border-color 0.4s ease;
      }

      .draw-card.is-shaking {
        animation: drawShake 0.12s linear infinite;
      }

      .draw-card.is-bonus {
        border-color: rgba(255, 212, 121, 0.5);
        background: linear-gradient(160deg, rgba(255, 212, 121, 0.34), rgba(209, 144, 42, 0.18));
      }

      @keyframes drawShake {
        0%,
        100% {
          transform: rotate(-1.6deg) translateY(0);
        }
        50% {
          transform: rotate(1.6deg) translateY(-3px);
        }
      }

      .draw-mark {
        font-family: var(--font-serif);
        font-size: 44px;
        line-height: 1;
        color: rgba(255, 255, 255, 0.85);
      }

      .draw-text {
        max-width: 320px;
        margin: 0;
        font-size: 13px;
        line-height: 1.9;
        color: rgba(255, 255, 255, 0.78);
        text-align: center;
      }

      .draw-btn {
        padding: 10px 22px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(150deg, #6f8cff, #9b6bff);
        color: #fff;
        font: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .draw-btn:disabled {
        cursor: default;
        opacity: 0.55;
      }

      /* ---------------- 民主议会 ---------------- */

      .council {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 20px 14px;
      }

      .council-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 12px;
      }

      .council-status {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .council-tip {
        margin-left: auto;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.3);
      }

      .council-retry {
        padding: 3px 10px;
        border: 1px solid rgba(167, 139, 250, 0.42);
        border-radius: 6px;
        background: rgba(167, 139, 250, 0.16);
        color: #d9c9ff;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .council-retry:hover {
        background: rgba(167, 139, 250, 0.3);
      }

      .council-retry[hidden] {
        display: none;
      }

      .council-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 16px;
        overflow: auto;
        padding-right: 6px;
      }

      .council-list::-webkit-scrollbar {
        width: 6px;
      }

      .council-list::-webkit-scrollbar-thumb {
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.14);
      }

      .council-list::-webkit-scrollbar-track {
        background: transparent;
      }

      .council-item {
        display: grid;
        gap: 7px;
      }

      .council-title {
        margin: 0;
        font-size: 13px;
        color: #fff;
      }

      .council-opts {
        display: grid;
        gap: 5px;
      }

      .council-opt {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        overflow: hidden;
        padding: 9px 11px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.03);
        color: inherit;
        font: inherit;
        font-size: 12px;
        text-align: left;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }

      .council-opt:not(:disabled):hover {
        border-color: rgba(167, 139, 250, 0.5);
        background: rgba(167, 139, 250, 0.1);
      }

      .council-opt:disabled {
        cursor: default;
      }

      .council-bar {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        background: linear-gradient(90deg, rgba(167, 139, 250, 0.32), rgba(109, 40, 217, 0.22));
        transition: width 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
      }

      .council-opt.is-mine {
        border-color: rgba(167, 139, 250, 0.6);
      }

      .council-opt.is-mine .council-bar {
        background: linear-gradient(90deg, rgba(167, 139, 250, 0.5), rgba(109, 40, 217, 0.36));
      }

      .council-label {
        position: relative;
        flex: 1;
        overflow: hidden;
        color: rgba(255, 255, 255, 0.85);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .council-num {
        position: relative;
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.45);
      }

      .council-opt.is-mine .council-num {
        color: #d9c9ff;
      }

      .council-meta {
        margin: 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.34);
      }

      .council-empty {
        margin: 0;
        padding: 40px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
      }

      /* ---------------- 匿名树洞 ---------------- */

      .hole {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 14px 18px 10px;
      }

      .hole-top {
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      }

      .hole-topic-label {
        margin: 0 0 4px;
        font-size: 10px;
        letter-spacing: 0.14em;
        color: rgba(255, 255, 255, 0.32);
      }

      .hole-topic {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 15px;
        color: #ffd479;
      }

      .hole-form {
        display: grid;
        gap: 6px;
        margin: 12px 0;
      }

      .hole-input {
        width: 100%;
        min-height: 56px;
        max-height: 140px;
        padding: 9px 11px;
        resize: vertical;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.04);
        color: #eef1f7;
        font: inherit;
        font-size: 12.5px;
        line-height: 1.7;
        outline: none;
      }

      .hole-input:focus {
        border-color: rgba(168, 191, 133, 0.6);
      }

      .hole-form-bar {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .hole-count {
        font-size: 10.5px;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.3);
      }

      .hole-send {
        margin-left: auto;
        padding: 7px 16px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(150deg, #7f9e5a, #4a6b34);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .hole-send:disabled {
        cursor: default;
        opacity: 0.5;
      }

      .hole-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 10px;
        overflow: auto;
        padding-right: 4px;
      }

      .hole-item {
        position: relative;
        padding: 11px 13px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
      }

      .hole-item.is-featured {
        border-color: rgba(255, 212, 121, 0.3);
        background: rgba(255, 212, 121, 0.05);
      }

      .hole-badge {
        position: absolute;
        top: -6px;
        right: 10px;
        padding: 2px 7px;
        border-radius: 4px;
        background: linear-gradient(150deg, #ffd479, #d19a2e);
        color: #3a2a08;
        font-size: 9px;
        font-weight: 600;
      }

      .hole-text {
        margin: 0 0 8px;
        font-size: 12.5px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.86);
        white-space: pre-wrap;
        word-break: break-word;
      }

      .hole-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.34);
      }

      .hole-nick {
        color: rgba(168, 191, 133, 0.9);
      }

      .hole-reply-toggle {
        margin-left: auto;
        padding: 2px 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 5px;
        background: none;
        color: rgba(255, 255, 255, 0.5);
        font: inherit;
        font-size: 10.5px;
        cursor: pointer;
      }

      .hole-reply-toggle:hover {
        border-color: rgba(255, 255, 255, 0.25);
        color: #fff;
      }

      .hole-replies {
        display: grid;
        gap: 7px;
        margin-top: 10px;
        padding-top: 9px;
        border-top: 1px dashed rgba(255, 255, 255, 0.08);
      }

      .hole-reply {
        font-size: 11.5px;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.7);
      }

      .hole-reply-nick {
        margin-right: 6px;
        color: rgba(168, 191, 133, 0.85);
      }

      .hole-reply-empty {
        margin: 0;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.28);
      }

      .hole-reply-form {
        display: flex;
        gap: 6px;
      }

      .hole-reply-input {
        flex: 1;
        min-width: 0;
        padding: 6px 9px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.04);
        color: #eef1f7;
        font: inherit;
        font-size: 11.5px;
        outline: none;
      }

      .hole-reply-form button {
        padding: 6px 12px;
        border: 0;
        border-radius: 6px;
        background: rgba(168, 191, 133, 0.3);
        color: #d9e8c2;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .hole-empty {
        margin: 0;
        padding: 40px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.35);
        text-align: center;
      }

      .hole-status {
        min-height: 14px;
        margin: 6px 0 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.32);
      }

      /* ---------------- 新闻联播 ---------------- */

      .news {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 18px 12px;
      }

      .news-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .news-avatar {
        width: 46px;
        height: 58px;
        object-fit: contain;
        filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.45));
      }

      .news-name {
        margin: 0 0 3px;
        font-family: var(--font-serif);
        font-size: 15px;
        color: #fff;
      }

      .news-date {
        margin: 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.42);
      }

      .news-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 13px;
        overflow: auto;
        padding: 14px 2px 8px;
      }

      .news-item {
        display: grid;
        gap: 5px;
        opacity: 0;
        animation: newsIn 0.5s ease forwards;
      }

      @keyframes newsIn {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .news-tag {
        justify-self: start;
        padding: 1px 7px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.08);
        font-size: 9.5px;
        color: rgba(255, 255, 255, 0.5);
      }

      .news-text {
        margin: 0;
        font-size: 12.5px;
        line-height: 1.9;
        color: rgba(255, 255, 255, 0.82);
      }

      .news-foot {
        margin: 6px 0 0;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 10px;
        color: rgba(255, 255, 255, 0.28);
        text-align: right;
      }

      /* ---------------- 社会网络 ---------------- */

      .social {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 14px 18px 10px;
      }

      .social-me {
        margin-bottom: 14px;
      }

      .social-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid rgba(240, 171, 252, 0.22);
        border-radius: 12px;
        background: linear-gradient(150deg, rgba(240, 171, 252, 0.13), rgba(126, 34, 206, 0.09));
      }

      .social-face {
        flex: none;
        width: 52px;
        height: 66px;
        object-fit: contain;
      }

      .social-info {
        flex: 1;
        min-width: 0;
      }

      .social-name {
        margin: 0 0 3px;
        font-size: 14px;
        color: #fff;
      }

      .social-bio {
        margin: 0 0 5px;
        overflow: hidden;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.55);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .social-meta {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.4);
      }

      .social-role {
        padding: 1px 6px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.62);
      }

      .social-edit {
        flex: none;
        padding: 5px 12px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 7px;
        background: none;
        color: rgba(255, 255, 255, 0.7);
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .social-edit:hover {
        border-color: rgba(240, 171, 252, 0.5);
        color: #fff;
      }

      .social-card-btns {
        display: grid;
        gap: 5px;
        flex: none;
      }

      .social-edit.is-quiet {
        border-color: transparent;
        color: rgba(255, 255, 255, 0.4);
        font-size: 10px;
      }

      .auth-form {
        display: grid;
        gap: 8px;
        padding: 14px 16px;
        border: 1px solid rgba(240, 171, 252, 0.26);
        border-radius: 12px;
        background: rgba(240, 171, 252, 0.07);
      }

      .auth-title {
        margin: 0;
        font-size: 14px;
        color: #fff;
      }

      .auth-note {
        margin: 0 0 2px;
        font-size: 10.5px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.42);
      }

      .auth-bar {
        display: flex;
        gap: 8px;
        margin-top: 2px;
      }

      .auth-btn {
        flex: 1;
        padding: 7px 0;
        border: 0;
        border-radius: 7px;
        background: linear-gradient(150deg, #c084fc, #7e22ce);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .auth-btn.is-ghost {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.72);
      }

      .auth-btn:disabled {
        cursor: default;
        opacity: 0.5;
      }

      .auth-msg {
        min-height: 14px;
        margin: 2px 0 0;
        font-size: 10.5px;
        color: #ffb4b4;
      }

      .hole-auth,
      .council-auth {
        margin-bottom: 12px;
      }

      .hole-auth:empty,
      .council-auth:empty {
        display: none;
      }

      .hole-auth-tip {
        margin: 8px 0 0;
        font-size: 10.5px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.4);
      }

      .social-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 10px;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.42);
      }

      .social-tip {
        margin-left: auto;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.28);
      }

      .social-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 7px;
        overflow: auto;
        padding-right: 4px;
      }

      .social-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 11px;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.03);
      }

      .social-row-face {
        flex: none;
        width: 32px;
        height: 40px;
        object-fit: contain;
      }

      .social-row-info {
        flex: 1;
        min-width: 0;
      }

      .social-row-name {
        margin: 0 0 2px;
        font-size: 12px;
        color: #fff;
      }

      .social-row-bio {
        margin: 0;
        overflow: hidden;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.4);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .social-row-role {
        flex: none;
        font-size: 9.5px;
        color: rgba(255, 255, 255, 0.35);
      }

      .social-follow {
        flex: none;
        padding: 4px 11px;
        border: 1px solid rgba(240, 171, 252, 0.4);
        border-radius: 6px;
        background: rgba(240, 171, 252, 0.14);
        color: #f3d9ff;
        font: inherit;
        font-size: 10.5px;
        cursor: pointer;
      }

      .social-follow.is-on {
        border-color: rgba(255, 255, 255, 0.14);
        background: transparent;
        color: rgba(255, 255, 255, 0.45);
      }

      .social-form {
        display: grid;
        gap: 8px;
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
      }

      .social-picks {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .social-pick {
        width: 38px;
        height: 46px;
        padding: 2px;
        border: 1px solid transparent;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
      }

      .social-pick img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .social-pick.is-on {
        border-color: rgba(240, 171, 252, 0.7);
        background: rgba(240, 171, 252, 0.15);
      }

      .social-input {
        padding: 7px 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.04);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        outline: none;
      }

      .social-input:focus {
        border-color: rgba(240, 171, 252, 0.6);
      }

      .social-form-bar {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
      }

      .social-cancel {
        padding: 6px 14px;
        border: 0;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.07);
        color: rgba(255, 255, 255, 0.6);
        font: inherit;
        font-size: 11.5px;
        cursor: pointer;
      }

      .social-save {
        padding: 6px 16px;
        border: 0;
        border-radius: 7px;
        background: linear-gradient(150deg, #c084fc, #7e22ce);
        color: #fff;
        font: inherit;
        font-size: 11.5px;
        cursor: pointer;
      }

      .social-empty {
        margin: 0;
        padding: 40px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.35);
        text-align: center;
      }

      /* ---------------- 关机画面 ---------------- */

      .power-screen {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: #000;
        opacity: 0;
        transition: opacity 0.55s ease;
        cursor: pointer;
      }

      /* display: grid 会盖掉 [hidden] 的默认样式，这里补回来 */
      .power-screen[hidden],
      .power-menu[hidden] {
        display: none;
      }

      .power-screen.is-on {
        opacity: 1;
      }

      .power-inner {
        display: grid;
        justify-items: center;
        gap: 18px;
      }

      .power-logo {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border-radius: 15px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        font-family: var(--font-serif);
        font-size: 27px;
        color: #fff;
        opacity: 0;
        transform: scale(0.9);
        transition: opacity 0.4s 0.25s ease, transform 0.5s 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.3);
      }

      .power-screen.is-on .power-logo {
        opacity: 1;
        transform: none;
      }

      .power-hint {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.42);
      }

      /* ---------------- 开机动画 ---------------- */

      .boot {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: grid;
        place-items: center;
        background: #05060a;
        transition: opacity 0.55s ease, visibility 0s 0.55s;
      }

      .boot.is-done {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .boot-inner {
        display: grid;
        justify-items: center;
        gap: 20px;
      }

      .boot-logo {
        display: grid;
        place-items: center;
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        box-shadow: 0 18px 40px -16px rgba(111, 140, 255, 0.6);
        font-family: var(--font-serif);
        font-size: 29px;
        color: #fff;
        animation: bootLogo 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.25) both;
      }

      .boot-track {
        width: 152px;
        height: 3px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.12);
        overflow: hidden;
      }

      .boot-bar {
        display: block;
        width: 0;
        height: 100%;
        border-radius: 2px;
        background: linear-gradient(90deg, #6f8cff, #b06eff);
        /* 用 CSS 动画而不是 JS 设宽度，脚本晚到也不影响进度条起步 */
        animation: bootFill 1.2s 0.15s cubic-bezier(0.3, 0.8, 0.4, 1) forwards;
      }

      @keyframes bootFill {
        to {
          width: 100%;
        }
      }

      .boot-text {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.45);
        transition: color 0.3s ease;
      }

      .boot-text.is-ready {
        color: rgba(255, 255, 255, 0.82);
      }

      @keyframes bootLogo {
        from {
          opacity: 0;
          transform: scale(0.86);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      /* ---------------- Dock ---------------- */

      .dock {
        position: absolute;
        left: 50%;
        bottom: calc(14px + env(safe-area-inset-bottom, 0px));
        transform: translateX(-50%);
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 13px;
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(30, 33, 43, 0.62), rgba(18, 20, 28, 0.55));
        backdrop-filter: blur(24px) saturate(1.7);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 18px 44px -18px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }

      .dock-item {
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 12px;
        background: none;
        cursor: pointer;
        will-change: transform;
        transition: transform 0.12s ease-out;
      }

      /* 点击按压反馈 */
      .dock-item:active {
        transform: translateY(-1px) scale(0.94) !important;
        transition-duration: 0.05s;
      }

      .dock-glyph {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 12px;
        position: relative;
      }

      .dock-glyph.di-folder::before,
      .dock-glyph.di-folder::after,
      .dock-glyph.di-person::before,
      .dock-glyph.di-person::after,
      .dock-glyph.di-music::before,
      .dock-glyph.di-music::after,
      .dock-glyph.di-ach::before,
      .dock-glyph.di-ach::after,
      .dock-glyph.di-tank::before,
      .dock-glyph.di-tank::after,
      .dock-glyph.di-wall::before,
      .dock-glyph.di-rank::before,
      .dock-glyph.di-draw::before,
      .dock-glyph.di-draw::after,
      .dock-glyph.di-vote::before,
      .dock-glyph.di-vote::after,
      .dock-glyph.di-hole::before,
      .dock-glyph.di-tv::before,
      .dock-glyph.di-tv::after,
      .dock-glyph.di-net::before,
      .dock-glyph.di-gear::before,
      .dock-glyph.di-gear::after,
      .dock-glyph.di-home::before,
      .dock-glyph.di-home::after {
        content: "";
        position: absolute;
      }

      .dock-glyph.di-folder::before {
        left: 5px;
        top: 9px;
        width: 19px;
        height: 6px;
        border-radius: 2px 2px 0 0;
        background: rgba(255, 255, 255, 0.55);
      }
      .dock-glyph.di-folder::after {
        inset: 14px 6px 8px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.88);
      }
      .dock-glyph.di-person::before {
        left: 50%;
        top: 9px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-person::after {
        left: 50%;
        bottom: 8px;
        width: 26px;
        height: 15px;
        border-radius: 13px 13px 4px 4px;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-term::before {
        content: ">_";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: ui-monospace, Consolas, monospace;
        font-size: 17px;
        color: #7ef0b0;
      }
      .dock-glyph.di-music {
        background: linear-gradient(140deg, #ff9ec2 0%, #a83f74 100%);
      }
      .dock-glyph.di-music::before {
        inset: 9px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
      }
      .dock-glyph.di-music::after {
        inset: 17px;
        border-radius: 50%;
        background: #a83f74;
      }

      .dock-glyph.di-ach {
        background: linear-gradient(160deg, #ffd479 0%, #d1902a 100%);
      }
      .dock-glyph.di-ach::before {
        left: 13px;
        top: 10px;
        width: 20px;
        height: 19px;
        border-radius: 0 0 11px 11px;
        background: rgba(255, 255, 255, 0.94);
      }
      .dock-glyph.di-ach::after {
        left: 18px;
        bottom: 9px;
        width: 10px;
        height: 9px;
        border-radius: 0 0 2px 2px;
        background: rgba(255, 255, 255, 0.94);
      }

      .dock-glyph.di-tank {
        background: linear-gradient(160deg, #66d6ff 0%, #1a72b8 100%);
      }
      .dock-glyph.di-tank::before {
        left: 12px;
        top: 10px;
        width: 22px;
        height: 16px;
        border-radius: 11px 11px 6px 6px;
        background: rgba(255, 255, 255, 0.92);
      }
      .dock-glyph.di-tank::after {
        left: 16px;
        top: 25px;
        width: 14px;
        height: 9px;
        border-radius: 0 0 7px 7px;
        background: rgba(255, 255, 255, 0.72);
      }

      .dock-glyph.di-wall {
        background: linear-gradient(160deg, #ffb47a 0%, #d9603a 100%);
      }
      .dock-glyph.di-wall::before {
        inset: 10px;
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.95) 4px, transparent 4.4px);
        background-size: 12px 12px;
      }

      .dock-glyph.di-rank {
        background: linear-gradient(160deg, #8ee6a8 0%, #2f9a5e 100%);
      }
      .dock-glyph.di-rank::before {
        left: 13px;
        bottom: 9px;
        width: 6px;
        height: 10px;
        border-radius: 1px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow:
          9px -7px 0 rgba(255, 255, 255, 0.95),
          18px -14px 0 rgba(255, 255, 255, 0.95);
      }

      .dock-glyph.di-draw {
        background: linear-gradient(160deg, #ff7a86 0%, #c02848 100%);
      }
      .dock-glyph.di-draw::before {
        inset: 17px 7px 8px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 -6px 0 -1px rgba(255, 255, 255, 0.92);
      }
      .dock-glyph.di-draw::after {
        left: 50%;
        top: 11px;
        width: 5px;
        height: 25px;
        margin-left: -2.5px;
        background: #c02848;
      }

      .dock-glyph.di-vote {
        background: linear-gradient(160deg, #a78bfa 0%, #6d28d9 100%);
      }

      .dock-glyph.di-hole {
        background: linear-gradient(160deg, #a8bf85 0%, #3f5230 100%);
      }
      .dock-glyph.di-hole::before {
        left: 12px;
        top: 13px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: radial-gradient(circle at 38% 32%, #2a1f16 0%, #0f0a06 78%);
      }

      .dock-glyph.di-net {
        background: linear-gradient(160deg, #f0abfc 0%, #7e22ce 100%);
      }
      .dock-glyph.di-net::before {
        left: 12px;
        top: 12px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        box-shadow:
          12px 7px 0 rgba(255, 255, 255, 0.95),
          3px 17px 0 rgba(255, 255, 255, 0.95);
      }

      .dock-glyph.di-tv {
        background: linear-gradient(160deg, #7dd3fc 0%, #0369a1 100%);
      }
      .dock-glyph.di-tv::before {
        inset: 15px 6px 9px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.94);
      }
      .dock-glyph.di-tv::after {
        left: 10px;
        right: 10px;
        top: 19px;
        bottom: 13px;
        border-radius: 1px;
        background: #0369a1;
      }
      .dock-glyph.di-vote::before {
        left: 11px;
        top: 17px;
        width: 24px;
        height: 15px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.94);
      }
      .dock-glyph.di-vote::after {
        left: 15px;
        top: 12px;
        width: 16px;
        height: 4px;
        border-radius: 1px;
        background: #6d28d9;
      }

      .dock-glyph.di-gear::before {
        inset: 11px;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.9);
      }
      .dock-glyph.di-gear::after {
        inset: 19px;
        border-radius: 50%;
        background: rgba(40, 44, 56, 0.92);
      }
      .dock-glyph.di-home::before {
        left: 50%;
        top: 9px;
        width: 21px;
        height: 21px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%) rotate(45deg);
        border-radius: 3px;
      }
      .dock-glyph.di-home::after {
        left: 50%;
        bottom: 8px;
        width: 21px;
        height: 14px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%);
        border-radius: 0 0 4px 4px;
      }

      .dock-sep {
        width: 1px;
        height: 30px;
        margin: 0 2px;
        background: rgba(255, 255, 255, 0.14);
      }

      .dock-link {
        display: block;
      }

      /* Dock 下方的运行指示点 */
      .dock-item {
        position: relative;
      }

      .dock-item.has-open::after,
      .dock-item.has-hidden::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -6px;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        transform: translateX(-50%);
      }

      .dock-item.has-open::after {
        background: rgba(255, 255, 255, 0.5);
      }

      .dock-item.has-hidden::after {
        background: #8fa6ff;
        box-shadow: 0 0 8px rgba(143, 166, 255, 0.9);
      }

      /* ---------------- 响应式 ---------------- */

      @media (max-width: 720px) {
        .desk-icons {
          display: flex;
          flex-direction: row;
          flex-wrap: wrap;
          top: 10px;
          left: 10px;
          right: 10px;
          gap: 6px;
        }

        .desk-icon {
          width: 58px;
          padding: 6px 2px;
        }

        .di-glyph {
          width: 30px;
          height: 30px;
        }

        .di-label {
          font-size: 10px;
        }

        .window {
          left: 8px !important;
          right: 8px;
          width: auto !important;
          max-width: none;
          max-height: calc(100dvh - 190px);
        }

        .finder {
          grid-template-columns: 1fr;
        }

        .finder-side {
          display: none;
        }

        .dock {
          gap: 6px;
          padding: 7px 10px;
          border-radius: 16px;
          max-width: calc(100vw - 20px);
          overflow-x: auto;
          overflow-y: hidden;
          scrollbar-width: none;
        }

        .dock::-webkit-scrollbar {
          display: none;
        }

        .dock-item {
          width: 38px;
          height: 38px;
        }

        .desk-pet {
          right: 10px;
          bottom: 78px;
          width: 64px;
          height: 92px;
          z-index: 8;
        }

        .ach-grid {
          grid-template-columns: 1fr;
        }

        .toast-stack {
          right: 10px;
          bottom: calc(86px + env(safe-area-inset-bottom, 0px));
        }

        .desk-hint {
          display: none;
        }

        .widgets {
          display: none;
        }
      }

      /* ---------------- 手机端：菜单栏收窄 ---------------- */
      @media (max-width: 640px) {
        .mb-menu {
          display: none;
        }
        .mb-version,
        #mb-date,
        .mb-sep-v,
        .spaces,
        .mb-dot {
          display: none;
        }
        .mb-brand-text {
          white-space: nowrap;
        }
        .menubar {
          gap: 10px;
        }
        .mb-time-btn {
          gap: 4px;
          padding: 3px 6px;
        }
      }

      /* ---------------- 减少动态效果 ---------------- */
      @media (prefers-reduced-motion: reduce) {
        .wallpaper::after,
        .wallpaper::before,
        .fish,
        .bubble,
        .cover-disc,
        .boot-bar,
        .boot-logo,
        .news-item {
          animation: none !important;
        }
        .wallpaper,
        .window,
        .dock-item,
        .toast,
        .boot,
        .power-screen,
        .menubar,
        .wallpaper::after {
          transition-duration: 0.001ms !important;
        }
      }

      /* 手动开关：减少动态效果 */
      .os-reduce-motion *,
      .os-reduce-motion *::before,
      .os-reduce-motion *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }

      /* ============================================================
         1.2 新应用：图标 + 界面
         ============================================================ */

      /* 图标：计算器 */
      .di-calc {
        background: linear-gradient(160deg, #9aa7bd 0%, #4a5568 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
      }
      .di-calc::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 18px;
        height: 22px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.94);
      }
      .di-calc::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 12px;
        height: 4px;
        margin-top: -7px;
        border-radius: 1px;
        background: #4a5568;
        box-shadow: 0 0 0 0 transparent;
      }

      /* 图标：便签 */
      .di-note {
        background: linear-gradient(160deg, #ffd479 0%, #e0a73e 100%);
      }
      .di-note::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) rotate(-4deg);
        width: 18px;
        height: 20px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.95);
      }
      .di-note::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) rotate(-4deg);
        width: 12px;
        height: 2px;
        margin-top: -4px;
        background: #caa14a;
        box-shadow: 0 4px 0 #caa14a, 0 8px 0 #caa14a;
      }

      /* 图标：监视器 */
      .di-mon {
        background: linear-gradient(160deg, #5eead4 0%, #0f766e 100%);
      }
      .di-mon::before {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 9px;
        transform: translateX(-50%);
        width: 3px;
        height: 8px;
        border-radius: 1px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: -8px 0 0 rgba(255, 255, 255, 0.9), 8px 0 0 rgba(255, 255, 255, 0.9), -4px -6px 0 rgba(255, 255, 255, 0.9), 4px -10px 0 rgba(255, 255, 255, 0.9);
      }

      /* 图标：日历 */
      .di-cal {
        background: linear-gradient(160deg, #f9a8d4 0%, #be3455 100%);
      }
      .di-cal::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 20px;
        height: 18px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.95);
      }
      .di-cal::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 20px;
        height: 6px;
        margin-top: -9px;
        border-radius: 3px 3px 0 0;
        background: #be3455;
      }

      /* 图标：图片查看器 */
      .di-viewer {
        background: linear-gradient(160deg, #a5b4fc 0%, #4338ca 100%);
      }
      .di-viewer::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 20px;
        height: 16px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.92);
      }
      .di-viewer::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 5px;
        height: 5px;
        margin: -5px 0 0 -5px;
        border-radius: 50%;
        background: #4338ca;
        box-shadow: 2px 5px 0 1px #6a5ae0;
      }

      /* 图标：浏览器 */
      .di-browser {
        background: linear-gradient(160deg, #7dd3fc 0%, #0369a1 100%);
      }
      .di-browser::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.92);
      }
      .di-browser::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 18px;
        height: 2px;
        background: rgba(255, 255, 255, 0.92);
      }

      /* 图标：文件管理器 */
      .di-files {
        background: linear-gradient(160deg, #fcd34d 0%, #d97706 100%);
      }
      .di-files::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 20px;
        height: 14px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: -2px -4px 0 -1px rgba(255, 255, 255, 0.75);
      }

      /* ---------------- 计算器 ---------------- */
      .calc {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 14px;
        height: 100%;
      }
      .calc-display {
        font-family: var(--font-mono);
        font-size: 30px;
        font-weight: 600;
        color: #fff;
        text-align: right;
        padding: 8px 6px;
        word-break: break-all;
        min-height: 46px;
      }
      .calc-history {
        max-height: 60px;
        overflow-y: auto;
        display: grid;
        gap: 2px;
      }
      .calc-h-item {
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.4);
        text-align: right;
      }
      .calc-pad {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
      }
      .calc-key {
        border: 0;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.08);
        color: #eef1f7;
        font: inherit;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.15s ease, transform 0.1s ease;
      }
      .calc-key:hover {
        background: rgba(255, 255, 255, 0.14);
      }
      .calc-key:active {
        transform: scale(0.94);
      }
      .calc-key.is-op {
        background: rgba(111, 140, 255, 0.28);
        color: #cdd8ff;
      }
      .calc-key.is-clear {
        background: rgba(255, 95, 87, 0.22);
        color: #ffb0aa;
      }

      /* ---------------- 便签 ---------------- */
      .notes-app {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 14px;
      }
      .notes-bar {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
      }
      .notes-search {
        flex: 1;
        padding: 7px 11px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font: inherit;
        font-size: 12px;
        outline: none;
      }
      .notes-add {
        padding: 7px 14px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }
      .notes-grid {
        flex: 1;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
        align-content: start;
      }
      .note-card {
        position: relative;
        display: flex;
        flex-direction: column;
        border-radius: 11px;
        padding: 10px;
        background: color-mix(in srgb, var(--note-color) 22%, transparent);
        border: 1px solid color-mix(in srgb, var(--note-color) 45%, transparent);
      }
      .note-card.is-pinned {
        border-color: var(--note-color);
      }
      .note-tools {
        display: flex;
        justify-content: space-between;
        margin-bottom: 4px;
      }
      .note-pin,
      .note-del {
        border: 0;
        background: none;
        cursor: pointer;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
        padding: 0;
      }
      .note-del:hover {
        color: #ff5f57;
      }
      .note-text {
        flex: 1;
        min-height: 60px;
        border: 0;
        background: none;
        resize: none;
        outline: none;
        color: #fff;
        font: inherit;
        font-size: 12px;
        line-height: 1.7;
      }
      .note-colors {
        display: flex;
        gap: 5px;
        margin-top: 6px;
      }
      .note-color {
        width: 13px;
        height: 13px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: var(--nc);
        cursor: pointer;
        padding: 0;
      }
      .note-color.is-on {
        box-shadow: 0 0 0 2px #fff;
      }
      .notes-empty {
        grid-column: 1 / -1;
        padding: 40px 0;
        text-align: center;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
      }

      /* ---------------- 系统监视器 ---------------- */
      .monitor {
        padding: 16px;
        height: 100%;
        overflow-y: auto;
      }
      .mon-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      .mon-card {
        padding: 12px;
        border-radius: 11px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
      }
      .mon-label {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
      }
      .mon-val {
        display: block;
        font-family: var(--font-mono);
        font-size: 24px;
        color: #fff;
        margin: 4px 0 6px;
      }
      .mon-bar {
        height: 5px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.1);
        overflow: hidden;
      }
      .mon-bar i {
        display: block;
        height: 100%;
        border-radius: 3px;
        background: linear-gradient(90deg, #6ee7a8, #6f8cff);
        transition: width 0.6s ease;
      }
      .mon-note {
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.35);
        margin: 10px 0 14px;
      }
      .mon-rows {
        display: grid;
        gap: 2px;
      }
      .mon-row {
        display: flex;
        justify-content: space-between;
        padding: 7px 0;
        border-bottom: 1px dashed rgba(255, 255, 255, 0.07);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
      }
      .mon-row b {
        color: #fff;
        font-weight: 600;
      }
      .mon-apps-label {
        margin: 14px 0 8px;
      }
      .mon-apps {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .mon-app-chip {
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(111, 140, 255, 0.2);
        color: #cdd8ff;
        font-size: 11px;
      }

      .mon-app-chip {
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(111, 140, 255, 0.2);
        color: #cdd8ff;
        font-size: 11px;
      }

      /* ---------------- 日历 ---------------- */
      .cal-app {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 14px;
      }
      .cal-head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
      }
      .cal-title {
        font-size: 15px;
        font-weight: 650;
        color: #fff;
        flex: 1;
        text-align: center;
      }
      .cal-nav,
      .cal-today,
      .cal-add {
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        border-radius: 7px;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        padding: 4px 10px;
      }
      .cal-nav {
        padding: 2px 11px;
        font-size: 15px;
      }
      .cal-week {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.4);
        padding-bottom: 6px;
      }
      .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 3px;
      }
      .cal-cell {
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 7px;
        background: none;
        color: rgba(255, 255, 255, 0.75);
        font-size: 12px;
        cursor: pointer;
        position: relative;
      }
      .cal-cell:hover {
        background: rgba(255, 255, 255, 0.08);
      }
      .cal-cell.is-empty {
        pointer-events: none;
      }
      .cal-cell.is-today {
        background: rgba(111, 140, 255, 0.3);
        color: #fff;
        font-weight: 700;
      }
      .cal-cell.is-selected {
        outline: 1.5px solid var(--os-accent);
      }
      .cal-cell.has-event::after {
        content: "";
        position: absolute;
        bottom: 4px;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--os-warning);
      }
      .cal-events {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        flex: 1;
        min-height: 0;
        overflow-y: auto;
      }
      .cal-events-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 8px;
      }
      .cal-event {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        margin-bottom: 6px;
        font-size: 12px;
      }
      .cal-event-time {
        font-family: var(--font-mono);
        color: var(--os-accent);
        font-size: 11px;
        flex: none;
      }
      .cal-event-title {
        flex: 1;
        color: rgba(255, 255, 255, 0.85);
      }
      .cal-event-del {
        border: 0;
        background: none;
        color: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        font-size: 14px;
      }
      .cal-event-del:hover {
        color: #ff5f57;
      }
      .cal-event-empty {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.35);
        text-align: center;
        padding: 12px 0;
      }

      /* ---------------- 图片查看器 ---------------- */
      .viewer {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .viewer-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
      }
      .view-btn {
        padding: 5px 11px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }
      .view-btn:hover {
        background: rgba(255, 255, 255, 0.12);
      }
      .view-sep {
        width: 1px;
        height: 16px;
        background: rgba(255, 255, 255, 0.1);
        margin: 0 2px;
      }
      .viewer-stage {
        flex: 1;
        min-height: 0;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.3);
      }
      .viewer-img {
        max-width: 100%;
        max-height: 100%;
        transition: transform 0.2s ease;
      }
      .viewer-empty {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
        line-height: 2;
      }
      .viewer-info {
        padding: 8px 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
      }

      /* ---------------- 浏览器 ---------------- */
      .browser {
        padding: 14px;
        height: 100%;
        overflow-y: auto;
      }
      .browser-bar {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
      }
      .browser-url {
        flex: 1;
        padding: 9px 13px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font: inherit;
        font-size: 12.5px;
        outline: none;
      }
      .browser-url:focus {
        border-color: var(--os-accent);
      }
      .browser-go {
        padding: 9px 16px;
        border: 0;
        border-radius: 9px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        color: #fff;
        font: inherit;
        font-size: 12.5px;
        cursor: pointer;
      }
      .browser-sec {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.4);
        margin: 14px 0 8px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
      .browser-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .browser-link {
        padding: 8px 14px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.8);
        font-size: 12px;
        text-decoration: none;
        transition: all 0.15s ease;
      }
      .browser-link:hover {
        border-color: var(--os-accent);
        color: #fff;
      }
      .browser-tip {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.35);
        margin-top: 12px;
        line-height: 1.8;
      }
      .browser-history {
        display: grid;
        gap: 4px;
      }
      .browser-h-item {
        padding: 8px 12px;
        border: 0;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.7);
        font: inherit;
        font-size: 11.5px;
        text-align: left;
        cursor: pointer;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .browser-h-item:hover {
        background: rgba(255, 255, 255, 0.09);
      }
      .browser-h-empty {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.35);
        padding: 8px 0;
      }

      .browser-h-empty {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.35);
        padding: 8px 0;
      }

      /* ---------------- 文件管理器 ---------------- */
      .fs-app {
        display: grid;
        grid-template-columns: 128px 1fr;
        height: 100%;
        min-height: 0;
      }
      .fs-side {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 14px 10px;
        border-right: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(255, 255, 255, 0.03);
      }
      .fs-side-item {
        padding: 7px 11px;
        border: 0;
        border-radius: 7px;
        background: none;
        color: rgba(255, 255, 255, 0.62);
        font: inherit;
        font-size: 12px;
        text-align: left;
        cursor: pointer;
      }
      .fs-side-item.is-active {
        background: rgba(111, 140, 255, 0.24);
        color: #fff;
      }
      .fs-main {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 12px 14px;
      }
      .fs-bar {
        display: flex;
        gap: 6px;
        margin-bottom: 8px;
      }
      .fs-search {
        flex: 1;
        min-width: 0;
        padding: 6px 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font: inherit;
        font-size: 11.5px;
        outline: none;
      }
      .fs-sort {
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.8);
        font: inherit;
        font-size: 11px;
        padding: 4px 6px;
      }
      .fs-new {
        padding: 6px 11px;
        border: 0;
        border-radius: 7px;
        background: rgba(111, 140, 255, 0.28);
        color: #cdd8ff;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
        white-space: nowrap;
      }
      .fs-crumb {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
        margin-bottom: 10px;
      }
      .fs-grid {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(86px, 1fr));
        gap: 8px;
        align-content: start;
      }
      .fs-node {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 12px 6px 10px;
        border-radius: 10px;
        border: 1px solid transparent;
        cursor: pointer;
        text-align: center;
      }
      .fs-node:hover {
        background: rgba(255, 255, 255, 0.06);
      }
      .fs-node.is-selected {
        border-color: rgba(111, 140, 255, 0.6);
        background: rgba(111, 140, 255, 0.14);
      }
      .fs-node-icon {
        font-size: 30px;
        line-height: 1;
      }
      .fs-node-name {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.8);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
      }
      .fs-star {
        position: absolute;
        top: 5px;
        right: 7px;
        font-size: 10px;
        color: var(--os-warning);
      }
      .fs-empty {
        grid-column: 1 / -1;
        padding: 40px 0;
        text-align: center;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.4);
      }
      .fs-detail {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 8px;
        margin-top: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        min-height: 0;
      }
      .fs-detail:empty {
        display: none;
      }
      .fs-detail-name {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.8);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .fs-detail-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }
      .fs-act {
        padding: 4px 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.75);
        font: inherit;
        font-size: 11px;
        cursor: pointer;
        text-decoration: none;
      }
      .fs-act:hover {
        background: rgba(255, 255, 255, 0.12);
      }
      .fs-act.is-danger {
        color: #ff9b95;
      }
      .fs-node.is-editing .fs-node-name,
      .fs-node.is-editing .fs-star {
        display: none;
      }
      .fs-rename-input {
        width: 100%;
        box-sizing: border-box;
        padding: 2px 4px;
        border: 1px solid var(--os-accent, rgba(143, 166, 255, 0.9));
        border-radius: 4px;
        background: rgba(20, 24, 40, 0.5);
        color: #fff;
        font: inherit;
        font-size: 11px;
        outline: none;
      }
      .fs-confirm-text {
        font-size: 11.5px;
        color: rgba(255, 255, 255, 0.65);
      }
      .fs-file-content {
        width: 100%;
        max-height: 180px;
        overflow: auto;
        margin: 0;
        padding: 8px 10px;
        border-radius: 6px;
        background: rgba(0, 0, 0, 0.28);
        color: rgba(255, 255, 255, 0.82);
        font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        white-space: pre-wrap;
        word-break: break-word;
      }

      /* ---------------- 终端：彩色输出 ---------------- */
      .term-line.term-ok {
        color: #6ee7a8;
