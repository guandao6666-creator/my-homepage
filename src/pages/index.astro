        height: 42px;
      }

      .music-note {
        margin: 0;
        font-size: 11px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.42);
      }

      @keyframes discSpin {
        to {
          transform: rotate(360deg);
        }
      }

      /* ---------------- 成就 ---------------- */

      .ach-wrap {
        padding: 18px 20px 20px;
      }

      .ach-head {
        margin: 0 0 14px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .ach-head b {
        font-size: 15px;
        color: #ffd479;
      }

      .ach-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .ach {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 11px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
      }

      .ach.is-got {
        border-color: rgba(255, 212, 121, 0.32);
        background: rgba(255, 212, 121, 0.08);
      }

      .ach-mark {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        flex: none;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.07);
        font-family: var(--font-serif);
        font-size: 14px;
        color: rgba(255, 255, 255, 0.42);
      }

      .ach.is-got .ach-mark {
        background: linear-gradient(150deg, #ffd479, #d1902a);
        color: #3a2606;
      }

      .ach-body {
        display: grid;
        gap: 2px;
        min-width: 0;
      }

      .ach-name {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.5);
      }

      .ach.is-got .ach-name {
        color: #fff;
      }

      .ach-desc {
        overflow: hidden;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.3);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* ---------------- 成就提示 ---------------- */

      .toast-stack {
        position: fixed;
        right: 18px;
        bottom: calc(96px + env(safe-area-inset-bottom, 0px));
        z-index: 500;
        display: grid;
        gap: 8px;
        pointer-events: none;
      }

      .toast {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 196px;
        padding: 10px 14px 10px 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        background: rgba(26, 29, 38, 0.94);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(18px);
        opacity: 0;
        transform: translateX(24px) scale(0.96);
        transition: opacity 0.3s ease, transform 0.36s cubic-bezier(0.2, 0.9, 0.3, 1.2);
      }

      .toast.is-in {
        opacity: 1;
        transform: none;
      }

      .toast-mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        flex: none;
        border-radius: 9px;
        background: linear-gradient(150deg, #ffd479, #d1902a);
        font-family: var(--font-serif);
        font-size: 15px;
        color: #3a2606;
      }

      .toast-body {
        display: grid;
        gap: 2px;
      }

      .toast-kicker {
        font-size: 10px;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.4);
      }

      .toast-name {
        font-size: 13px;
        color: #fff;
      }

      /* ---------------- 水族箱 ---------------- */

      .tank {
        position: relative;
        height: 100%;
        overflow: hidden;
        cursor: pointer;
        --phase-speed: 1;
        --phase-bright: 1;
        --phase-saturate: 1;
        background: linear-gradient(180deg, #0a2f45 0%, #0e4762 48%, #071e2c 100%);
        transition: background 1.4s ease;
      }

      /* 清晨：水偏青，醒得快（时长倍率 <1 代表更快） */
      .tank[data-phase="dawn"] {
        background: linear-gradient(180deg, #0d3d4c 0%, #1a6478 48%, #0a2b36 100%);
        --phase-speed: 0.85;
        --phase-bright: 1.06;
      }

      /* 白天：常态 */
      .tank[data-phase="day"] {
        background: linear-gradient(180deg, #0a2f45 0%, #0e4762 48%, #071e2c 100%);
        --phase-speed: 1;
      }

      /* 傍晚：水偏紫，慢下来 */
      .tank[data-phase="dusk"] {
        background: linear-gradient(180deg, #321a4a 0%, #4d2760 48%, #1b0d28 100%);
        --phase-speed: 1.35;
        --phase-bright: 0.86;
        --phase-saturate: 0.82;
      }

      /* 深夜：熄灯，游得最慢 */
      .tank[data-phase="night"] {
        background: linear-gradient(180deg, #061622 0%, #0a2a3c 48%, #04101a 100%);
        --phase-speed: 2.1;
        --phase-bright: 0.66;
        --phase-saturate: 0.72;
      }

      .tank::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(120, 220, 255, 0.16), transparent 30%);
        pointer-events: none;
      }

      .bubbles {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .bubble {
        position: absolute;
        bottom: -14px;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: radial-gradient(circle at 32% 30%, rgba(255, 255, 255, 0.95), rgba(130, 215, 255, 0.3));
        animation: bubbleRise var(--dur) linear infinite;
        animation-delay: var(--delay);
      }

      @keyframes bubbleRise {
        to {
          transform: translateY(-520px);
          opacity: 0;
        }
      }

      .tank-floor {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 46px;
        background: radial-gradient(58% 100% at 50% 100%, rgba(36, 104, 104, 0.5), transparent 70%);
        pointer-events: none;
      }

      .fish-layer {
        position: absolute;
        inset: 0;
      }

      .fish {
        position: absolute;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background-image: var(--bg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow:
          0 0 0 2px rgba(180, 230, 255, 0.32),
          0 10px 22px -8px rgba(0, 0, 0, 0.65);
        animation-name: driftSoft;
        animation-duration: calc(var(--base-dur, 11s) * var(--phase-speed, 1));
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        animation-delay: var(--delay);
        filter: brightness(var(--phase-bright, 1)) saturate(var(--phase-saturate, 1));
        transition: filter 1.2s ease;
      }

      /* 按性格给每条不同的游法 */
      .fish[data-ai="chatgpt"] {
        --base-dur: 11s;
        animation-name: driftSoft;
      }
      .fish[data-ai="deepseek"] {
        --base-dur: 13s;
        animation-name: driftDeep;
      }
      .fish[data-ai="claude"] {
        --base-dur: 12s;
        animation-name: driftWide;
      }
      .fish[data-ai="grok"] {
        --base-dur: 9s;
        animation-name: dashAround;
        animation-direction: normal;
      }
      .fish[data-ai="gemini"] {
        --base-dur: 14s;
        animation-name: orbitPath;
        animation-direction: normal;
      }
      .fish[data-ai="wenxin"] {
        --base-dur: 19s;
        animation-name: driftSlow;
      }
      .fish[data-ai="qwen"] {
        --base-dur: 15s;
        animation-name: glideDiagonal;
      }

      .fish::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: linear-gradient(150deg, rgba(255, 255, 255, 0.26), transparent 46%);
        pointer-events: none;
      }

      /* ChatGPT：不紧不慢地上下浮 */
      @keyframes driftSoft {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(16px, -20px);
        }
      }

      /* DeepSeek：喜欢沉在下面，偶尔上来 */
      @keyframes driftDeep {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(26px, 24px);
        }
      }

      /* Claude：稳稳地横着走 */
      @keyframes driftWide {
        from {
          transform: translate(-16px, 2px);
        }
        to {
          transform: translate(16px, -12px);
        }
      }

      /* 文心：动得很轻，像懒得动 */
      @keyframes driftSlow {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(7px, -10px);
        }
      }

      /* Grok：横冲直撞 */
      @keyframes dashAround {
        0% {
          transform: translate(0, 0);
        }
        28% {
          transform: translate(104px, -32px);
        }
        52% {
          transform: translate(-64px, 38px);
        }
        78% {
          transform: translate(72px, 16px);
        }
        100% {
          transform: translate(0, 0);
        }
      }

      /* Gemini：绕着圈转 */
      @keyframes orbitPath {
        0% {
          transform: translate(0, 0);
        }
        25% {
          transform: translate(32px, -18px);
        }
        50% {
          transform: translate(0, -36px);
        }
        75% {
          transform: translate(-32px, -18px);
        }
        100% {
          transform: translate(0, 0);
        }
      }

      /* 千问：斜着滑，像摇扇子 */
      @keyframes glideDiagonal {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(-24px, -18px);
        }
      }

      .fish-name {
        position: absolute;
        left: 50%;
        bottom: -15px;
        transform: translateX(-50%);
        font-size: 9px;
        letter-spacing: 0.02em;
        color: rgba(215, 238, 255, 0.5);
        white-space: nowrap;
        pointer-events: none;
      }

      .food {
        position: absolute;
        width: 6px;
        height: 6px;
        margin: -3px 0 0 -3px;
        border-radius: 50%;
        background: #ffd479;
        box-shadow: 0 0 8px rgba(255, 212, 121, 0.85);
        animation: foodSink 0.82s ease-in forwards;
        pointer-events: none;
      }

      @keyframes foodSink {
        to {
          transform: translateY(24px);
          opacity: 0.35;
        }
      }

      .heart {
        position: absolute;
        left: 50%;
        top: -10px;
        font-size: 14px;
        color: #ff8fb1;
        pointer-events: none;
        animation: heartUp 1.7s ease-out forwards;
      }

      /* 深夜的瞌睡泡 */
      .zzz {
        position: absolute;
        right: -2px;
        top: -8px;
        font-family: var(--font-serif);
        font-size: 12px;
        font-weight: 600;
        color: rgba(190, 225, 255, 0.75);
        pointer-events: none;
        animation: zzzFloat 3s ease-out forwards;
      }

      @keyframes zzzFloat {
        0% {
          opacity: 0;
          transform: translate(0, 0) scale(0.7);
        }
        22% {
          opacity: 1;
        }
        100% {
          opacity: 0;
          transform: translate(9px, -28px) scale(1.1);
        }
      }

      @keyframes heartUp {
        0% {
          opacity: 0;
          transform: translate(-50%, 0) scale(0.6);
        }
        25% {
          opacity: 1;
          transform: translate(-50%, -10px) scale(1);
        }
        100% {
          opacity: 0;
          transform: translate(-50%, -40px) scale(1.1);
        }
      }

      .tank-hint {
        position: absolute;
        left: 50%;
        bottom: 12px;
        transform: translateX(-50%);
        margin: 0;
        font-size: 10.5px;
        color: rgba(200, 235, 255, 0.42);
        white-space: nowrap;
        pointer-events: none;
      }

      /* ---------------- 访客墙 ---------------- */

      .wall {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 20px 18px;
      }

      .wall-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
      }

      .wall-count {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .wall-add {
        margin-left: auto;
        padding: 7px 14px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 8px;
        background: rgba(111, 140, 255, 0.22);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .wall-add:hover {
        background: rgba(111, 140, 255, 0.38);
      }

      .wall-grid {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
        align-content: start;
        gap: 10px;
        overflow: auto;
      }

      .wall-item {
        display: grid;
        justify-items: center;
        gap: 6px;
        padding: 8px 4px;
        border-radius: 10px;
        transition: background-color 0.18s ease;
      }

      .wall-item:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .wall-item img {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.14);
        object-fit: cover;
      }

      .wall-item span {
        max-width: 78px;
        overflow: hidden;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.62);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .wall-empty {
        grid-column: 1 / -1;
        margin: 0;
        padding: 30px 0;
        font-size: 12.5px;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
      }

      .wall-form {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .wall-form[hidden] {
        display: none;
      }

      .wall-name {
        flex: 1;
        min-width: 140px;
        padding: 8px 10px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        outline: none;
      }

      .wall-name:focus {
        border-color: rgba(111, 140, 255, 0.6);
      }

      .wall-pick {
        max-width: 168px;
        overflow: hidden;
        padding: 8px 12px;
        border: 1px dashed rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.66);
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: pointer;
      }

      .wall-pick:hover {
        border-color: rgba(111, 140, 255, 0.5);
        color: #fff;
      }

      .wall-submit {
        padding: 8px 16px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(150deg, #6f8cff, #9b6bff);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .wall-submit:disabled {
        opacity: 0.6;
        cursor: default;
      }

      .wall-note {
        min-height: 16px;
        margin: 8px 0 0;
        font-size: 11px;
        color: rgba(255, 212, 121, 0.85);
      }

      /* ---------------- 关机画面 ---------------- */

      .power-screen {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: #000;
        opacity: 0;
        transition: opacity 0.55s ease;
        cursor: pointer;
      }

      /* display: grid 会盖掉 [hidden] 的默认样式，这里补回来 */
      .power-screen[hidden],
      .power-menu[hidden] {
        display: none;
      }

      .power-screen.is-on {
        opacity: 1;
      }

      .power-inner {
        display: grid;
        justify-items: center;
        gap: 18px;
      }

      .power-logo {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border-radius: 15px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        font-family: var(--font-serif);
        font-size: 27px;
        color: #fff;
        opacity: 0;
        transform: scale(0.9);
        transition: opacity 0.4s 0.25s ease, transform 0.5s 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.3);
      }

      .power-screen.is-on .power-logo {
        opacity: 1;
        transform: none;
      }

      .power-hint {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.42);
      }

      /* ---------------- 开机动画 ---------------- */

      .boot {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: grid;
        place-items: center;
        background: #05060a;
        transition: opacity 0.55s ease, visibility 0s 0.55s;
      }

      .boot.is-done {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .boot-inner {
        display: grid;
        justify-items: center;
        gap: 20px;
      }

      .boot-logo {
        display: grid;
        place-items: center;
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        box-shadow: 0 18px 40px -16px rgba(111, 140, 255, 0.6);
        font-family: var(--font-serif);
        font-size: 29px;
        color: #fff;
        animation: bootLogo 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.25) both;
      }

      .boot-track {
        width: 152px;
        height: 3px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.12);
        overflow: hidden;
      }

      .boot-bar {
        display: block;
        width: 0;
        height: 100%;
        border-radius: 2px;
        background: linear-gradient(90deg, #6f8cff, #b06eff);
        /* 用 CSS 动画而不是 JS 设宽度，脚本晚到也不影响进度条起步 */
        animation: bootFill 1.2s 0.15s cubic-bezier(0.3, 0.8, 0.4, 1) forwards;
      }

      @keyframes bootFill {
        to {
          width: 100%;
        }
      }

      .boot-text {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.45);
        transition: color 0.3s ease;
      }

      .boot-text.is-ready {
        color: rgba(255, 255, 255, 0.82);
      }

      @keyframes bootLogo {
        from {
          opacity: 0;
          transform: scale(0.86);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      /* ---------------- Dock ---------------- */

      .dock {
        position: absolute;
        left: 50%;
        bottom: calc(14px + env(safe-area-inset-bottom, 0px));
        transform: translateX(-50%);
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 13px;
        border-radius: 18px;
        background: rgba(20, 22, 30, 0.55);
        backdrop-filter: blur(22px) saturate(1.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
      }

      .dock-item {
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 12px;
        background: none;
        cursor: pointer;
        transition: transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.4);
      }

      .dock-item:hover {
        transform: translateY(-8px) scale(1.12);
      }

      .dock-glyph {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 12px;
        position: relative;
      }

      .dock-glyph.di-folder::before,
      .dock-glyph.di-folder::after,
      .dock-glyph.di-person::before,
      .dock-glyph.di-person::after,
      .dock-glyph.di-music::before,
      .dock-glyph.di-music::after,
      .dock-glyph.di-ach::before,
      .dock-glyph.di-ach::after,
      .dock-glyph.di-tank::before,
      .dock-glyph.di-tank::after,
      .dock-glyph.di-wall::before,
      .dock-glyph.di-gear::before,
      .dock-glyph.di-gear::after,
      .dock-glyph.di-home::before,
      .dock-glyph.di-home::after {
        content: "";
        position: absolute;
      }

      .dock-glyph.di-folder::before {
        left: 5px;
        top: 9px;
        width: 19px;
        height: 6px;
        border-radius: 2px 2px 0 0;
        background: rgba(255, 255, 255, 0.55);
      }
      .dock-glyph.di-folder::after {
        inset: 14px 6px 8px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.88);
      }
      .dock-glyph.di-person::before {
        left: 50%;
        top: 9px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-person::after {
        left: 50%;
        bottom: 8px;
        width: 26px;
        height: 15px;
        border-radius: 13px 13px 4px 4px;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-term::before {
        content: ">_";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: ui-monospace, Consolas, monospace;
        font-size: 17px;
        color: #7ef0b0;
      }
      .dock-glyph.di-music {
        background: linear-gradient(140deg, #ff9ec2 0%, #a83f74 100%);
      }
      .dock-glyph.di-music::before {
        inset: 9px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
      }
      .dock-glyph.di-music::after {
        inset: 17px;
        border-radius: 50%;
        background: #a83f74;
      }

      .dock-glyph.di-ach {
        background: linear-gradient(160deg, #ffd479 0%, #d1902a 100%);
      }
      .dock-glyph.di-ach::before {
        left: 13px;
        top: 10px;
        width: 20px;
        height: 19px;
        border-radius: 0 0 11px 11px;
        background: rgba(255, 255, 255, 0.94);
      }
      .dock-glyph.di-ach::after {
        left: 18px;
        bottom: 9px;
        width: 10px;
        height: 9px;
        border-radius: 0 0 2px 2px;
        background: rgba(255, 255, 255, 0.94);
      }

      .dock-glyph.di-tank {
        background: linear-gradient(160deg, #66d6ff 0%, #1a72b8 100%);
      }
      .dock-glyph.di-tank::before {
        left: 12px;
        top: 10px;
        width: 22px;
        height: 16px;
        border-radius: 11px 11px 6px 6px;
        background: rgba(255, 255, 255, 0.92);
      }
      .dock-glyph.di-tank::after {
        left: 16px;
        top: 25px;
        width: 14px;
        height: 9px;
        border-radius: 0 0 7px 7px;
        background: rgba(255, 255, 255, 0.72);
      }

      .dock-glyph.di-wall {
        background: linear-gradient(160deg, #ffb47a 0%, #d9603a 100%);
      }
      .dock-glyph.di-wall::before {
        inset: 10px;
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.95) 4px, transparent 4.4px);
        background-size: 12px 12px;
      }

      .dock-glyph.di-gear::before {
        inset: 11px;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.9);
      }
      .dock-glyph.di-gear::after {
        inset: 19px;
        border-radius: 50%;
        background: rgba(40, 44, 56, 0.92);
      }
      .dock-glyph.di-home::before {
        left: 50%;
        top: 9px;
        width: 21px;
        height: 21px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%) rotate(45deg);
        border-radius: 3px;
      }
      .dock-glyph.di-home::after {
        left: 50%;
        bottom: 8px;
        width: 21px;
        height: 14px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%);
        border-radius: 0 0 4px 4px;
      }

      .dock-sep {
        width: 1px;
        height: 30px;
        margin: 0 2px;
        background: rgba(255, 255, 255, 0.14);
      }

      .dock-link {
        display: block;
      }

      /* Dock 下方的运行指示点 */
      .dock-item {
        position: relative;
      }

      .dock-item.has-open::after,
      .dock-item.has-hidden::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -5px;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        transform: translateX(-50%);
      }

      .dock-item.has-open::after {
        background: rgba(255, 255, 255, 0.42);
      }

      .dock-item.has-hidden::after {
        background: #8fa6ff;
      }

      /* ---------------- 响应式 ---------------- */

      @media (max-width: 720px) {
        .desk-icons {
          display: flex;
          flex-direction: row;
          flex-wrap: wrap;
          top: 10px;
          left: 10px;
          right: 10px;
          gap: 6px;
        }

        .desk-icon {
          width: 58px;
          padding: 6px 2px;
        }

        .di-glyph {
          width: 30px;
          height: 30px;
        }

        .di-label {
          font-size: 10px;
        }

        .window {
          left: 8px !important;
          right: 8px;
          width: auto !important;
          max-width: none;
          max-height: calc(100dvh - 190px);
        }

        .finder {
          grid-template-columns: 1fr;
        }

        .finder-side {
          display: none;
        }

        .dock {
          gap: 6px;
          padding: 7px 10px;
          border-radius: 16px;
        }

        .dock-item {
          width: 38px;
          height: 38px;
        }

        .desk-pet {
          right: 10px;
          bottom: 78px;
          width: 64px;
          height: 92px;
          z-index: 8;
        }

        .ach-grid {
          grid-template-columns: 1fr;
        }

        .toast-stack {
          right: 10px;
          bottom: calc(86px + env(safe-area-inset-bottom, 0px));
        }

        .desk-hint {
          display: none;
        }
      }
    </style>
