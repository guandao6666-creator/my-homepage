    <script is:inline define:vars={{ OS_DATA: data }}>
      window.__OS__ = OS_DATA;
    </script>

    <script>
      import { initOs13 } from "../lib/os13";
      import { initOs14 } from "../lib/os14";
      import { initAccount } from "../lib/account/client";
      import { initAdaptiveShell, resolveMode, setPreference } from "../lib/shell/adaptive";
      import { initPwa } from "../lib/shell/pwa";
      // 1.9 质量层：错误边界、在线状态、真实耗时记录、资源回收
      import { initConnectivity } from "../lib/quality/connectivity";
      import { boundary, crashCardHtml, installGlobalErrorHandlers, logDiagnostic } from "../lib/quality/errors";
      import { recordAppMetric } from "../lib/quality/perf";
      import { releaseWindowScope, trackWindowScope } from "../lib/quality/resources";
      // 2.2：已迁移的旧版应用（通过现有 registerApp 接入，不新建注册中心）
      import { createRankReporter, RANK_NAME_KEY, registerLegacyApps } from "../lib/legacy-apps";
      // 2.3：HTML 转义统一入口
      import { escapeHtml, safeUrl } from "../lib/html";

      (() => {
        // 移动端在模块加载前已被内联脚本带走；这里再兜一次，并写入 data-shell。
        if (resolveMode() === "mobile") {
          if (!location.pathname.startsWith("/m")) location.replace("/m/" + location.search);
          return;
        }
        initAdaptiveShell("desktop");
        initPwa();
        // 1.9：最先挂上全局错误捕获与在线状态，页面后续的异常都能被记录
        installGlobalErrorHandlers();
        initConnectivity();

        /* ---------------- 开机动画 ---------------- */

        const boot = document.getElementById("boot");
        const bootBar = document.getElementById("boot-bar");
        const bootText = document.getElementById("boot-text");

        if (boot && bootBar && bootText) {
          let booted = false;

          const finishBoot = () => {
            if (booted) return;
            booted = true;
            boot.classList.add("is-done");
            window.setTimeout(() => boot.remove(), 650);
          };

          /* 2.0 启动体验：进度来自内核的真实阶段（bus 桥接到 guandao:boot:*），
             拿不到事件时 3.4 秒兜底放人，绝不把用户卡在加载页。 */
          window.addEventListener("guandao:boot:stage:begin", (event) => {
            const detail = (event as CustomEvent<{ label?: string }>).detail;
            if (detail?.label) bootText.textContent = detail.label;
          });

          window.addEventListener("guandao:boot:stage:done", (event) => {
            const detail = (event as CustomEvent<{ index?: number; total?: number; status?: string; error?: string }>)
              .detail;
            const total = Number(detail?.total) || 0;
            const index = Number(detail?.index) || 0;
            if (total > 0) bootBar.style.width = `${Math.round(((index + 1) / total) * 100)}%`;
            if (detail?.status === "failed" && detail.error) bootText.textContent = `继续启动（${detail.error}）`;
          });

          window.addEventListener("guandao:boot:done", () => {
            bootBar.style.width = "100%";
            bootText.textContent = "准备就绪";
            bootText.classList.add("is-ready");
            finishBoot();
          });

          window.setTimeout(finishBoot, 3400);

          // 急着进去可以点一下跳过
          boot.addEventListener("click", finishBoot);
        }

        const DATA = (window as Window & { __OS__?: any }).__OS__;
        const OS_BOOT = Date.now();
        if (!DATA) return;

        /** 通用的登录 / 注册表单，树洞、议会、社会网络共用一份 */
        const authFormHtml = () => `
          <form class="auth-form" data-auth="1">
            <p class="auth-title">登录 / 注册</p>
            <p class="auth-note">邮箱加密码就行，不用收验证码，注册完直接能用。</p>
            <input class="social-input" data-auth-email type="email" placeholder="邮箱" autocomplete="username" />
            <input class="social-input" data-auth-password type="password" placeholder="密码（至少 6 位）" autocomplete="current-password" />
            <div class="auth-bar">
              <button class="auth-btn" type="submit">登录</button>
              <button class="auth-btn is-ghost" type="button" data-auth-signup>注册</button>
            </div>
            <p class="auth-msg" data-auth-msg></p>
          </form>`;

        /** 首次登录自动建一份空资料 */
        const ensureMyProfile = async (token: string, uid: string, email: string) => {
          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          if (!sb?.url || !sb?.key) return;

          const headers = { apikey: sb.key, Authorization: `Bearer ${token}` };

          try {
            const check = await fetchWithTimeout(
              `${sb.url}/rest/v1/profiles?id=eq.${encodeURIComponent(uid)}&select=id`,
              { headers },
              8000,
            );
            if (check.ok) {
              const rows = (await check.json()) as Array<{ id: string }>;
              if (rows.length) return;
            }

            const name = email.split("@")[0].slice(0, 16) || "访客";

            await fetchWithTimeout(
              `${sb.url}/rest/v1/profiles`,
              {
                method: "POST",
                headers: { ...headers, "Content-Type": "application/json", Prefer: "return=minimal" },
                body: JSON.stringify({
                  id: uid,
                  nickname: name,
                  avatar: "whale",
                  bio: "",
                  last_seen: new Date().toISOString(),
                }),
              },
              10000,
            );
          } catch {
            /* 建资料失败不影响登录 */
          }
        };

        /** 提交登录或注册，成功返回 true */
        const runAuth = async (win: HTMLElement, mode: "in" | "up"): Promise<boolean> => {
          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          const email = win.querySelector<HTMLInputElement>("[data-auth-email]")?.value.trim() ?? "";
          const password = win.querySelector<HTMLInputElement>("[data-auth-password]")?.value ?? "";
          const msg = win.querySelector("[data-auth-msg]");

          if (!email || !email.includes("@")) {
            if (msg) msg.textContent = "请填一个有效的邮箱";
            return false;
          }
          if (password.length < 6) {
            if (msg) msg.textContent = "密码至少 6 位";
            return false;
          }
          if (!sb?.url || !sb?.key) {
            if (msg) msg.textContent = "云端没接上";
            return false;
          }

          if (msg) msg.textContent = mode === "in" ? "正在登录…" : "正在注册…";

          try {
            const path = mode === "in" ? "/auth/v1/token?grant_type=password" : "/auth/v1/signup";
            const res = await fetchWithTimeout(
              `${sb.url}${path}`,
              {
                method: "POST",
                headers: { apikey: sb.key, "Content-Type": "application/json" },
                body: JSON.stringify({ email, password }),
              },
              15000,
            );

            const data = (await res.json()) as {
              access_token?: string;
              refresh_token?: string;
              user?: { id: string; email: string };
              error_description?: string;
              msg?: string;
              error?: string;
            };

            if (!res.ok) {
              const raw = data.error_description || data.msg || data.error || "操作失败";
              throw new Error(String(raw).replace(/^\w+:\s*/, ""));
            }
            if (!data.access_token || !data.user) {
              throw new Error("注册成功但没拿到登录状态，点一下登录试试");
            }

            // 先把资料建好再写登录状态：writeAuth 会广播 auth-change，
            // 各个窗口收到就立刻拉数据，如果资料还没建出来会显示「还没起名字」
            await ensureMyProfile(data.access_token, data.user.id, data.user.email ?? email);

            writeAuth({
              token: data.access_token,
              refresh: data.refresh_token ?? "",
              uid: data.user.id,
              email: data.user.email ?? email,
              at: Date.now(),
            });

            return true;
          } catch (err) {
            if (msg) msg.textContent = (err as Error).message;
            return false;
          }
        };

        /**
         * 生成一个随机 ID。
         * crypto.randomUUID 要 Safari 15.4 以上才有，老浏览器会直接抛错，
         * 所以这里逐级降级，保证任何环境都能拿到一个唯一值。
         */
        const makeId = (): string => {
          if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
            return crypto.randomUUID();
          }
          if (typeof crypto !== "undefined" && typeof crypto.getRandomValues === "function") {
            const bytes = new Uint8Array(16);
            crypto.getRandomValues(bytes);
            bytes[6] = (bytes[6] & 0x0f) | 0x40;
            bytes[8] = (bytes[8] & 0x3f) | 0x80;
            const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
            return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
          }
          return `id-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
        };

        /**
         * 带超时的 fetch。
         * 国内访问 supabase.co 经常是「连接挂住」而不是报错，
         * 不设超时的话界面会永远停在「正在加载」。
         */
        const fetchWithTimeout = async (url: string, options: RequestInit = {}, ms = 7000) => {
          const controller = new AbortController();
          const timer = window.setTimeout(() => controller.abort(), ms);
          try {
            return await fetch(url, { ...options, signal: controller.signal });
          } finally {
            window.clearTimeout(timer);
          }
        };

        /* ---------------- 通知中心 ---------------- */

        const NOTIF_KEY = "guandao.os.notif.v1";

        interface Notif {
          id: string;
          icon: string;
          title: string;
          body: string;
          at: number;
          read: boolean;
        }

        const readNotifs = (): Notif[] => {
          try {
            const raw = JSON.parse(localStorage.getItem(NOTIF_KEY) || "[]");
            return Array.isArray(raw) ? (raw as Notif[]) : [];
          } catch {
            return [];
          }
        };

        const writeNotifs = (list: Notif[]) => {
          try {
            localStorage.setItem(NOTIF_KEY, JSON.stringify(list.slice(0, 40)));
          } catch {
            /* 隐私模式忽略 */
          }
        };

        const notifTime = (at: number) => {
          const min = Math.floor((Date.now() - at) / 60000);
          if (min < 1) return "刚刚";
          if (min < 60) return `${min} 分钟前`;
          const hr = Math.floor(min / 60);
          if (hr < 24) return `${hr} 小时前`;
          const day = Math.floor(hr / 24);
          if (day < 30) return `${day} 天前`;
          return new Date(at).toLocaleDateString("zh-CN");
        };

        const notifListEl = document.getElementById("notif-list");
        const notifEmptyEl = document.getElementById("notif-empty");
        const notifClearBtn = document.getElementById("notif-clear");
        const bellDotEl = document.getElementById("mb-bell-dot");

        const renderNotifs = () => {
          const list = readNotifs();
          if (!notifListEl || !notifEmptyEl) return;
          if (!list.length) {
            notifListEl.innerHTML = "";
            notifEmptyEl.hidden = false;
            return;
          }
          notifEmptyEl.hidden = true;
          notifListEl.innerHTML = list
            .map(
              (n) => `
                <div class="notif-item ${n.read ? "" : "is-new"}">
                  <span class="notif-icon">${escapeHtml(n.icon)}</span>
                  <div class="notif-body">
                    <p class="notif-title">${escapeHtml(n.title)}</p>
                    <p class="notif-text">${escapeHtml(n.body)}</p>
                    <span class="notif-time">${notifTime(n.at)}</span>
                  </div>
                </div>`,
            )
            .join("");
        };

        const updateBell = () => {
          if (!bellDotEl) return;
          bellDotEl.hidden = !readNotifs().some((n) => !n.read);
        };

        const pushNotif = (n: { icon: string; title: string; body: string }) => {
          const list = readNotifs();
          list.unshift({ id: makeId(), icon: n.icon, title: n.title, body: n.body, at: Date.now(), read: false });
          writeNotifs(list);
          renderNotifs();
          updateBell();
        };

        const markNotifsRead = () => {
          const list = readNotifs();
          if (!list.some((n) => !n.read)) return;
          writeNotifs(list.map((n) => ({ ...n, read: true })));
          updateBell();
        };

        notifClearBtn?.addEventListener("click", () => {
          writeNotifs([]);
          renderNotifs();
          updateBell();
        });

        /* 首次进入：欢迎 + 博客概览；每日一条提醒 */
        const seedNotifications = () => {
          const welcomedKey = "guandao.os.welcomed";
          if (!localStorage.getItem(welcomedKey)) {
            try {
              localStorage.setItem(welcomedKey, "1");
            } catch {
              /* 忽略 */
            }
            pushNotif({ icon: "管", title: "欢迎来到 Guandao OS", body: "窗口可拖拽、可缩放，双击标题栏最大化，右上角铃铛是通知中心。" });
            const latest = DATA.posts[0];
            if (latest) pushNotif({ icon: "文", title: "博客更新", body: `最新一篇《${latest.title}》已经上线，点「文章」查看。` });
          }
          const today = new Date().toDateString();
          if (localStorage.getItem("guandao.os.remind") !== today) {
            try {
              localStorage.setItem("guandao.os.remind", today);
            } catch {
              /* 忽略 */
            }
            const hour = new Date().getHours();
            const remind =
              hour < 6
                ? "夜深了，早点休息。"
                : hour < 12
                  ? "早上好，今天也一起写点什么吧。"
                  : hour < 18
                    ? "下午了，记得站起来活动一下。"
                    : "晚上好，把今天的想法记下来再睡。";
            pushNotif({ icon: "✓", title: "今日提醒", body: remind });
          }
        };

        const os = document.getElementById("os");
        const windows = document.getElementById("windows");

        /* 自适应应用内部布局：窗口被拖窄时按容器宽度切换紧凑样式，
           不依赖视口宽度，也不使用 container-type 改变定位上下文。 */
        const winWidthObserver =
          typeof ResizeObserver !== "undefined"
            ? new ResizeObserver((entries) => {
                for (const entry of entries) {
                  const width = entry.contentRect.width;
                  const target = entry.target as HTMLElement;
                  // 已经离开文档的窗口不再处理，等 closeWin 里的 unobserve 收尾
                  if (!target.isConnected) continue;
                  target.dataset.w = width < 620 ? "sm" : width < 880 ? "md" : "lg";
                }
              })
            : null;
        /** 1.9：窗口关闭时必须 unobserve，否则 ResizeObserver 会一直持有整棵窗口子树 */
        const releaseWinObserver = (win: Element) => {
          try {
            winWidthObserver?.unobserve(win);
          } catch {
            /* 已断开观察 */
          }
        };

        if (winWidthObserver && windows) {
          // 观察窗口容器本身：只在这里挂一次 MutationObserver，窗口增删统一处理
          new MutationObserver((records) => {
            for (const record of records) {
              record.addedNodes.forEach((node) => {
                if (node instanceof HTMLElement && node.classList.contains("window")) {
                  winWidthObserver.observe(node);
                }
              });
              record.removedNodes.forEach((node) => {
                if (node instanceof HTMLElement && node.classList.contains("window")) {
                  releaseWinObserver(node);
                }
              });
            }
          }).observe(windows, { childList: true });
        }
        const hint = document.getElementById("desk-hint");
        if (!os || !windows || !hint) return;

        /* 输入框聚焦时，浏览器会把 overflow:hidden 的容器滚到「可见」位置，
           整个桌面会跟着上移（手机上打开终端最明显）。这里把它钉死在原点。 */
        const lockDeskScroll = () => {
          if (os.scrollTop !== 0) os.scrollTop = 0;
          if (os.scrollLeft !== 0) os.scrollLeft = 0;
        };
        os.addEventListener("scroll", lockDeskScroll, { passive: true });

        let zTop = 10;
        let cascade = 0;

        /* ---------------- 状态持久化 ---------------- */

        const STATE_KEY = "guandao.os.state.v1";

        interface WinState {
          left: number;
          top: number;
          width: number;
          height: number;
          minimized: boolean;
          maximized: boolean;
          space: number;
        }

        interface OsState {
          wall?: string;
          windows?: Record<string, WinState>;
          theme?: "dark" | "light";
          autoWall?: boolean;
          showIcons?: boolean;
          showPet?: boolean;
          reduceMotion?: boolean;
          space?: number;
          desks?: { id: number; name: string }[];
        }

        const readState = (): OsState => {
          try {
            return JSON.parse(localStorage.getItem(STATE_KEY) || "{}");
          } catch {
            return {};
          }
        };

        const writeState = (patch: Record<string, unknown>) => {
          try {
            localStorage.setItem(STATE_KEY, JSON.stringify({ ...readState(), ...patch }));
          } catch {
            /* 隐私模式写不进去，忽略即可 */
          }
        };

        /* ---------------- 数据持久化：导出 / 导入 / 恢复默认 ---------------- */

        const collectOsData = () => {
          const data: Record<string, unknown> = {};
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.startsWith("guandao.")) {
              const raw = localStorage.getItem(k);
              try {
                data[k] = JSON.parse(raw || "");
              } catch {
                data[k] = raw;
              }
            }
          }
          return data;
        };

        const exportData = () => {
          const payload = { version: "guandao-os/1.2", exportedAt: new Date().toISOString(), data: collectOsData() };
          const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `guandao-os-backup-${new Date().toISOString().slice(0, 10)}.json`;
          a.click();
          URL.revokeObjectURL(url);
          pushNotif({ icon: "↓", title: "数据已导出", body: "备份文件已下载到本地。" });
        };

        const importData = (file: File) => {
          const reader = new FileReader();
          reader.onload = () => {
            try {
              const parsed = JSON.parse(String(reader.result));
              if (!parsed || typeof parsed !== "object" || !parsed.data) throw new Error("bad");
              const entries = Object.entries(parsed.data as Record<string, unknown>).filter(([k]) => k.startsWith("guandao."));
              if (!entries.length) throw new Error("empty");
              for (const [k, v] of entries) {
                localStorage.setItem(k, typeof v === "string" ? v : JSON.stringify(v));
              }
              location.reload();
            } catch {
              pushNotif({ icon: "!", title: "导入失败", body: "文件格式不正确或不是 Guandao OS 备份。" });
            }
          };
          reader.readAsText(file);
        };

        const resetAllData = () => {
          const keys: string[] = [];
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k && k.startsWith("guandao.")) keys.push(k);
          }
          for (const k of keys) localStorage.removeItem(k);
          location.reload();
        };

        const saveWindows = () => {
          const map: Record<string, WinState> = {};
          windows.querySelectorAll<HTMLElement>(".window").forEach((win) => {
            const app = win.dataset.app;
            if (!app) return;
            map[app] = {
              left: win.offsetLeft,
              top: win.offsetTop,
              width: win.offsetWidth,
              height: win.offsetHeight,
              minimized: win.classList.contains("is-minimized"),
              maximized: win.classList.contains("is-maximized"),
              space: Number(win.dataset.space) || 1,
            };
          });
          writeState({ windows: map });
        };

        /* ---------------- 虚拟桌面 ---------------- */

        interface Desk {
          id: number;
          name: string;
        }

        const defaultDesks = (): Desk[] => [
          { id: 1, name: "日常桌面" },
          { id: 2, name: "学习空间" },
        ];

        let desks: Desk[] = readState().desks?.length ? readState().desks! : defaultDesks();
        let currentSpace = 1;

        const desksPersist = () => writeState({ desks, space: currentSpace });

        const refreshSpaceVisibility = () => {
          windows.querySelectorAll<HTMLElement>(".window").forEach((win) => {
            win.classList.toggle("is-hidden-space", Number(win.dataset.space) !== currentSpace);
          });
        };

        const renderSpaces = () => {
          const bar = document.getElementById("spaces");
          if (!bar) return;
          bar.innerHTML = desks
            .map(
              (d) => `<button class="space-dot ${d.id === currentSpace ? "is-active" : ""}" type="button" data-space="${d.id}" title="${escapeHtml(d.name)}" aria-label="${escapeHtml(d.name)}"></button>`,
            )
            .join("");
        };

        const applySpace = (n: number) => {
          if (!desks.some((d) => d.id === n)) n = desks[0]?.id ?? 1;
          currentSpace = n;
          os.dataset.space = String(n);
          refreshSpaceVisibility();
          renderSpaces();
          desksPersist();
        };

        const switchSpace = (n: number) => {
          if (n === currentSpace || !desks.some((d) => d.id === n)) return;
          const started = performance.now();
          windows.classList.add("is-switching");
          window.setTimeout(() => windows.classList.remove("is-switching"), 260);
          applySpace(n);
          recordAppMetric(`space:${n}`, "switch-space", performance.now() - started, true);
        };

        const addDesk = (name?: string) => {
          if (desks.length >= 4) return;
          const id = Math.max(...desks.map((d) => d.id), 0) + 1;
          desks.push({ id, name: name?.trim() || `桌面 ${id}` });
          desksPersist();
          switchSpace(id);
        };

        const deleteDesk = (id: number) => {
          if (desks.length <= 1) return;
          // 把该桌面的窗口移到主桌面
          windows.querySelectorAll<HTMLElement>(`.window[data-space="${id}"]`).forEach((w) => {
            w.dataset.space = String(desks[0].id);
          });
          desks = desks.filter((d) => d.id !== id);
          desksPersist();
          if (currentSpace === id) applySpace(desks[0].id);
          else {
            refreshSpaceVisibility();
            renderSpaces();
          }
          saveWindows();
        };

        const renameDesk = (id: number, name: string) => {
          const d = desks.find((d) => d.id === id);
          if (!d || !name.trim()) return;
          d.name = name.trim();
          renderSpaces();
          desksPersist();
        };

        document.getElementById("spaces")?.addEventListener("click", (event) => {
          const dot = (event.target as HTMLElement).closest<HTMLElement>(".space-dot");
          if (!dot) return;
          switchSpace(Number(dot.dataset.space));
        });

        /* ---------------- 程序坞配置 ---------------- */

        const DOCK_KEY = "guandao.os.dock";
        const DOCK_DEFAULT = ["posts", "about", "drive", "terminal", "settings"];

        const APP_ICON: Record<string, string> = {
          posts: "di-folder",
          about: "di-person",
          music: "di-music",
          terminal: "di-term",
          settings: "di-gear",
          achievements: "di-ach",
          aquarium: "di-tank",
          visitors: "di-wall",
          rank: "di-rank",
          draw: "di-draw",
          council: "di-vote",
          treehole: "di-hole",
          news: "di-tv",
          social: "di-net",
          calc: "di-calc",
          notes: "di-note",
          monitor: "di-mon",
          calendar: "di-cal",
          viewer: "di-viewer",
          browser: "di-browser",
          files: "di-files",
        };

        const readDock = (): string[] => {
          try {
            const raw = JSON.parse(localStorage.getItem(DOCK_KEY) || "null");
            if (Array.isArray(raw)) return raw.filter((id): id is string => typeof id === "string");
          } catch {
            /* 配置坏了就退回默认 */
          }
          return [...DOCK_DEFAULT];
        };

        const saveDock = (list: string[]) => {
          try {
            localStorage.setItem(DOCK_KEY, JSON.stringify(list));
          } catch {
            /* 忽略 */
          }
        };

        const renderDock = () => {
          const dock = document.getElementById("dock");
          if (!dock || !DATA) return;

          const items = readDock()
            .filter((id) => APPS[id] && (!dockFilter || dockFilter(id)))
            .map(
              (id) => `
                <button class="dock-item" type="button" data-app="${id}" title="${APPS[id].title}">
                  <span class="di-glyph ${APP_ICON[id] ?? "di-folder"}"></span>
                </button>`,
            )
            .join("");

          dock.innerHTML = `
            <button class="dock-item dock-launch" type="button" data-launchpad title="启动台">
              <span class="di-glyph di-grid"></span>
            </button>
            ${items}
            <span class="dock-sep"></span>
            <a class="dock-item dock-link" href="/home/" title="回到博客">
              <span class="di-glyph di-home"></span>
            </a>`;

          // 重建后把运行中的小圆点补回去
          dock.querySelectorAll<HTMLElement>(".dock-item[data-app]").forEach((el) => {
            const id = el.dataset.app;
            if (!id) return;
            const win = windows.querySelector(`.window[data-app="${id}"]`);
            if (!win) return;
            el.classList.add(win.classList.contains("is-minimized") ? "has-hidden" : "has-open");
          });
        };

        /* ---------------- 成就 ---------------- */

        const ACH_KEY = "guandao.os.ach.v1";

        interface AchState {
          unlocked: Record<string, number>;
          visits: number;
          petClicks: number;
          apps: string[];
          reads: number;
        }

        interface Achievement {
          id: string;
          mark: string;
          name: string;
          desc: string;
        }

        const ACHIEVEMENTS: Achievement[] = [
          { id: "first", mark: "初", name: "第一位访客", desc: "第一次推开这扇门" },
          { id: "night", mark: "夜", name: "深夜探索者", desc: "凌晨还在这里逛" },
          { id: "dawn", mark: "晨", name: "赶早的人", desc: "天没亮就来了" },
          { id: "roam", mark: "游", name: "桌面漫游者", desc: "每个应用都打开过一遍" },
          { id: "hack", mark: ">_", name: "终端黑客", desc: "在终端敲下第一条命令" },
          { id: "music", mark: "♪", name: "音乐鉴赏家", desc: "听过「白饭时间」" },
          { id: "rice", mark: "饭", name: "白饭信徒", desc: "戳了鲸鲸十次" },
          { id: "power", mark: "关", name: "关机达人", desc: "认真把它关掉过一次" },
          { id: "regular", mark: "常", name: "常客", desc: "来过五次以上" },
          { id: "reader", mark: "读", name: "考古学家", desc: "翻过三篇文章" },
          { id: "draw", mark: "运", name: "手气不错", desc: "抽到过隐藏奖励" },
        ];

        const readAch = (): AchState => {
          try {
            const raw = JSON.parse(localStorage.getItem(ACH_KEY) || "{}");
            return {
              unlocked: raw.unlocked ?? {},
              visits: raw.visits ?? 0,
              petClicks: raw.petClicks ?? 0,
              apps: raw.apps ?? [],
              reads: raw.reads ?? 0,
            };
          } catch {
            return { unlocked: {}, visits: 0, petClicks: 0, apps: [], reads: 0 };
          }
        };

        const saveAch = (state: AchState) => {
          try {
            localStorage.setItem(ACH_KEY, JSON.stringify(state));
          } catch {
            /* 写不进去就算了 */
          }
        };

        const toastStack = document.getElementById("toast-stack");

        const showToast = (ach: Achievement) => {
          if (!toastStack) return;

          const el = document.createElement("div");
          el.className = "toast";

          const mark = document.createElement("span");
          mark.className = "toast-mark";
          mark.textContent = ach.mark;

          const body = document.createElement("span");
          body.className = "toast-body";

          const kicker = document.createElement("span");
          kicker.className = "toast-kicker";
          kicker.textContent = "解锁成就";

          const name = document.createElement("span");
          name.className = "toast-name";
          name.textContent = ach.name;

          body.append(kicker, name);
          el.append(mark, body);
          toastStack.appendChild(el);

          window.requestAnimationFrame(() => el.classList.add("is-in"));
          window.setTimeout(() => {
            el.classList.remove("is-in");
            window.setTimeout(() => el.remove(), 420);
          }, 3200);
        };

        const unlock = (id: string, silent = false) => {
          const state = readAch();
          if (state.unlocked[id]) return false;

          const ach = ACHIEVEMENTS.find((item) => item.id === id);
          if (!ach) return false;

          state.unlocked[id] = Date.now();
          saveAch(state);
          if (!silent) {
            showToast(ach);
            pushNotif({ icon: ach.mark, title: `解锁成就：${ach.name}`, body: ach.desc });
          }
          return true;
        };

        /* ---------------- 窗口内容 ---------------- */

        /* 2.3：escapeHtml 已统一到 src/lib/html.ts（模块顶部导入），此处不再保留本地副本 */

        const renderTerminal = () => `
          <div class="term">
            <div class="term-out" id="term-out">
              <p class="term-line term-muted">Guandao OS 2.0 · 输入 help 看可用命令</p>
            </div>
            <label class="term-input-row">
              <span class="term-prompt">~ $</span>
              <input class="term-input" id="term-input" type="text" autocomplete="off" spellcheck="false" />
            </label>
          </div>`;

        const renderSettings = () => {
          const st = readState();
          const isLight = document.body.dataset.osTheme === "light";
          const showIcons = st.showIcons !== false;
          const showPet = st.showPet !== false;
          const reduceMotion = st.reduceMotion === true;
          const autoWall = st.autoWall === true;

          return `
          <div class="settings">
            <p class="side-title">外观</p>
            <div class="theme-picks">
              <button class="theme-pick ${isLight ? "" : "is-active"}" type="button" data-theme-pick="dark">深色</button>
              <button class="theme-pick ${isLight ? "is-active" : ""}" type="button" data-theme-pick="light">浅色</button>
            </div>

            <p class="side-title">壁纸</p>
            <div class="wall-picks">
              <button class="wall-pick ${os.dataset.wall === "nebula" || !os.dataset.wall ? "is-active" : ""}" type="button" data-wall="nebula">星云</button>
              <button class="wall-pick ${os.dataset.wall === "dusk" ? "is-active" : ""}" type="button" data-wall="dusk">暮色</button>
              <button class="wall-pick ${os.dataset.wall === "deep" ? "is-active" : ""}" type="button" data-wall="deep">深海</button>
            </div>
            <label class="settings-row">
              <span>壁纸随昼夜自动变化</span>
              <input type="checkbox" id="opt-auto-wall" ${autoWall ? "checked" : ""} />
            </label>

            <p class="side-title">程序坞显示</p>
            <div class="dock-picker" id="dock-picker">
              ${Object.entries(APPS)
                .map(
                  ([id, app]) => `
                    <label class="dock-opt">
                      <input type="checkbox" data-dock="${id}" ${readDock().includes(id) ? "checked" : ""} />
                      <span>${escapeHtml(app.title)}</span>
                    </label>`,
                )
                .join("")}
            </div>
            <p class="settings-tip">回博客固定在最右边。取消勾选只是从程序坞拿掉，桌面上还在。</p>

            <p class="side-title">桌面</p>
            <label class="settings-row">
              <span>显示桌面图标</span>
              <input type="checkbox" id="opt-show-icons" ${showIcons ? "checked" : ""} />
            </label>
            <label class="settings-row">
              <span>显示桌面宠物「鲸鲸」</span>
              <input type="checkbox" id="opt-show-pet" ${showPet ? "checked" : ""} />
            </label>

            <p class="side-title">桌面小组件</p>
            ${["clock", "calendar", "weather", "todo", "sys"]
              .map(
                (id) => `
              <label class="settings-row">
                <span>${WIDGET_TITLES[id]}</span>
                <input type="checkbox" data-widget-toggle="${id}" ${widgetOn(id) ? "checked" : ""} />
              </label>`,
              )
              .join("")}

            <p class="side-title">动效</p>
            <label class="settings-row">
              <span>减少动态效果</span>
              <input type="checkbox" id="opt-reduce-motion" ${reduceMotion ? "checked" : ""} />
            </label>

            <p class="side-title">快捷键</p>
            <div class="sys-info">
              <div class="sys-row"><span>Spotlight 搜索</span><b>Ctrl / ⌘ + K</b></div>
              <div class="sys-row"><span>任务视图</span><b>F3</b></div>
              <div class="sys-row"><span>显示桌面</span><b>Ctrl + Shift + D</b></div>
              <div class="sys-row"><span>切换窗口</span><b>Ctrl + &#96;</b></div>
              <div class="sys-row"><span>关闭弹层</span><b>Esc</b></div>
            </div>

            <p class="side-title">数据管理</p>
            <div class="data-actions">
              <button class="data-btn" type="button" id="data-export">导出备份</button>
              <button class="data-btn" type="button" id="data-import">导入备份</button>
              <button class="data-btn is-danger" type="button" id="data-reset">恢复默认</button>
            </div>
            <p class="settings-tip">导出会下载 JSON 备份（含桌面布局/主题/成就等）；恢复默认会清空本机所有 Guandao 数据并刷新。</p>

            <p class="side-title">系统信息</p>
            <div class="sys-info">
              <div class="sys-row"><span>版本</span><b>Guandao OS 2.0</b></div>
              <div class="sys-row"><span>代号</span><b>Desktop Evolution</b></div>
              <div class="sys-row"><span>引擎</span><b>Astro 静态渲染</b></div>
              <div class="sys-row"><span>环境</span><b>浏览器桌面</b></div>
            </div>
            <p class="settings-note">Guandao OS 2.0 · The Platform Era. One Unified Platform.</p>
          </div>`;
        };

        const renderAchievements = () => {
          const state = readAch();

          const rows = ACHIEVEMENTS.map((ach) => {
            const got = Boolean(state.unlocked[ach.id]);
            return `
              <div class="ach ${got ? "is-got" : "is-locked"}">
                <span class="ach-mark">${got ? ach.mark : "?"}</span>
                <span class="ach-body">
                  <span class="ach-name">${got ? ach.name : "未解锁"}</span>
                  <span class="ach-desc">${got ? ach.desc : "继续逛逛看"}</span>
                </span>
              </div>`;
          }).join("");

          const count = ACHIEVEMENTS.filter((ach) => state.unlocked[ach.id]).length;

          return `
            <div class="ach-wrap">
              <p class="ach-head">已解锁 <b>${count}</b> / ${ACHIEVEMENTS.length}</p>
              <div class="ach-grid">${rows}</div>
            </div>`;
        };

        /* ---------------- 水族箱 ---------------- */

        const AI_FISH = [
          { id: "chatgpt", name: "ChatGPT" },
          { id: "deepseek", name: "DeepSeek" },
          { id: "claude", name: "Claude" },
          { id: "grok", name: "Grok" },
          { id: "gemini", name: "Gemini" },
          { id: "wenxin", name: "文心一言" },
          { id: "qwen", name: "千问" },
        ];

        const PHASE_TEXT: Record<string, string> = {
          dawn: "天刚亮，它们醒过来了 · 点水里投喂",
          day: "点水里投喂 · 七只都在",
          dusk: "日头下去了，游得慢些",
          night: "熄灯了，它们都安静下来",
        };

        /** 按时辰算当前档位 */
        const phaseNow = () => {
          const hour = new Date().getHours();
          if (hour >= 5 && hour < 9) return "dawn";
          if (hour >= 9 && hour < 17) return "day";
          if (hour >= 17 && hour < 21) return "dusk";
          return "night";
        };

        /** 壁纸随昼夜变化：自动模式下给壁纸叠加时段光效 */
        const applyTimeWallpaper = () => {
          if (os.dataset.autoWall === "1") {
            os.dataset.wallPhase = phaseNow();
          } else {
            delete os.dataset.wallPhase;
          }
        };

        const renderAquarium = () => {
          const phase = phaseNow();

          const fish = AI_FISH.map(
            (ai, i) => `
              <div class="fish" data-ai="${ai.id}"
                style="--bg: url(/aquarium/${ai.id}.webp); --delay: ${-i * 1.3}s; left: ${5 + i * 12.5}%; top: ${16 + (i % 3) * 24}%">
                <span class="fish-name">${ai.name}</span>
              </div>`,
          ).join("");

          const bubbles = Array.from(
            { length: 10 },
            (_, i) =>
              `<span class="bubble" style="--size: ${4 + (i % 3) * 3}px; --dur: ${9 + i * 1.3}s; --delay: ${-i * 1.6}s; left: ${6 + i * 9}%"></span>`,
          ).join("");

          return `
            <div class="tank" id="tank" data-phase="${phase}">
              <div class="bubbles">${bubbles}</div>
              <div class="tank-floor"></div>
              <div class="fish-layer" id="fish-layer">${fish}</div>
              <p class="tank-hint" id="tank-hint">${PHASE_TEXT[phase]}</p>
            </div>`;
        };

        const initAquarium = (win: HTMLElement) => {
          const tank = win.querySelector("#tank") as HTMLElement | null;
          const layer = win.querySelector("#fish-layer");
          const hint = win.querySelector("#tank-hint");
          if (!tank || !layer || !hint) return;

          let fed = 0;

          tank.addEventListener("click", (event) => {
            const rect = tank.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;

            const food = document.createElement("span");
            food.className = "food";
            food.style.left = `${x}px`;
            food.style.top = `${y}px`;
            tank.appendChild(food);

            window.setTimeout(() => {
              food.remove();

              const fishes = Array.from(layer.querySelectorAll<HTMLElement>(".fish"));
              const target = fishes[Math.floor(Math.random() * fishes.length)];

              if (target) {
                const heart = document.createElement("span");
                heart.className = "heart";
                heart.textContent = "♥";
                target.appendChild(heart);
                window.setTimeout(() => heart.remove(), 1700);
              }

              fed += 1;
              hint.textContent =
                fed >= 6 ? "吃饱了，谢谢你" : `投喂了 ${fed} 次 · 它们很开心`;
            }, 820);
          });

          // 页面开着跨过时段时，自己跟着换档
          const watcher = window.setInterval(() => {
            if (!document.body.contains(tank)) {
              window.clearInterval(watcher);
              return;
            }
            const next = phaseNow();
            if (tank.dataset.phase === next) return;
            tank.dataset.phase = next;
            hint.textContent = PHASE_TEXT[next];
          }, 60_000);

          // 深夜随机冒一个瞌睡泡
          const zzzTimer = window.setInterval(() => {
            if (!document.body.contains(tank)) {
              window.clearInterval(zzzTimer);
              return;
            }
            if (tank.dataset.phase !== "night") return;

            const fishes = Array.from(layer.querySelectorAll<HTMLElement>(".fish"));
            const target = fishes[Math.floor(Math.random() * fishes.length)];
            if (!target) return;

            const z = document.createElement("span");
            z.className = "zzz";
            z.textContent = Math.random() > 0.45 ? "z" : "Z";
            target.appendChild(z);
            window.setTimeout(() => z.remove(), 3100);
          }, 2300);
        };

        /* ---------------- 访客墙 ---------------- */

        const renderVisitors = () => `
          <div class="wall">
            <div class="wall-head">
              <span class="wall-count" id="wall-count">正在加载…</span>
              <button class="wall-add" id="wall-add" type="button">留下我的头像</button>
            </div>
            <div class="wall-grid" id="wall-grid"></div>
            <form class="wall-form" id="wall-form" hidden>
              <input class="wall-name" id="wall-name" maxlength="16" placeholder="你的名字，最多 16 字" />
              <label class="wall-pick">
                <input type="file" id="wall-file" accept="image/*" hidden />
                <span id="wall-file-label">选一张图</span>
              </label>
              <button class="wall-submit" id="wall-submit" type="submit">上传</button>
            </form>
            <p class="wall-note" id="wall-note"></p>
          </div>`;

        const initVisitors = (win: HTMLElement) => {
          const grid = win.querySelector("#wall-grid");
          const countEl = win.querySelector("#wall-count");
          const addBtn = win.querySelector("#wall-add");
          const form = win.querySelector("#wall-form") as HTMLFormElement | null;
          const nameInput = win.querySelector("#wall-name") as HTMLInputElement | null;
          const fileInput = win.querySelector("#wall-file") as HTMLInputElement | null;
          const fileLabel = win.querySelector("#wall-file-label");
          const submitBtn = win.querySelector("#wall-submit") as HTMLButtonElement | null;
          const note = win.querySelector("#wall-note");

          if (!grid || !countEl || !form || !nameInput || !fileInput || !submitBtn || !note) return;

          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          const ready = Boolean(sb?.url && sb?.key);

          const setNote = (text: string) => {
            note.textContent = text;
          };

          const renderList = (list: Array<{ name: string; avatar_url: string }>) => {
            if (!list.length) {
              countEl.textContent = "还没有人";
              grid.innerHTML = '<p class="wall-empty">墙还是空的，来做第一个。</p>';
              return;
            }
            countEl.textContent = `${list.length} 位访客`;
            grid.innerHTML = list
              .map(
                (v) => `
                  <div class="wall-item">
                    <img src="${escapeHtml(v.avatar_url)}" alt="" />
                    <span>${escapeHtml(v.name)}</span>
                  </div>`,
              )
              .join("");
          };

          const loadWall = async () => {
            if (!ready) {
              countEl.textContent = "未连接";
              grid.innerHTML =
                '<p class="wall-empty">云端还没接上，需要先在 Supabase 执行 visitors.sql。</p>';
              return;
            }

            try {
              const res = await fetchWithTimeout(
                `${sb!.url}/rest/v1/visitor_avatars?select=name,avatar_url&order=created_at.desc&limit=60`,
                { headers: { apikey: sb!.key!, Authorization: `Bearer ${sb!.key}` } },
              );
              if (!res.ok) throw new Error(String(res.status));
              renderList(await res.json());
            } catch {
              countEl.textContent = "连不上";
              grid.innerHTML = '<p class="wall-empty">数据库连不上，可能是网络到不了 supabase.co。</p>';
            }
          };

          const compress = (file: File) =>
            new Promise<Blob>((resolve, reject) => {
              const img = new Image();
              img.onload = () => {
                const size = 240;
                const canvas = document.createElement("canvas");
                canvas.width = size;
                canvas.height = size;
                const ctx = canvas.getContext("2d");
                if (!ctx) return reject(new Error("no ctx"));

                const side = Math.min(img.width, img.height);
                ctx.drawImage(
                  img,
                  (img.width - side) / 2,
                  (img.height - side) / 2,
                  side,
                  side,
                  0,
                  0,
                  size,
                  size,
                );

                canvas.toBlob(
                  (blob) => (blob ? resolve(blob) : reject(new Error("blob"))),
                  "image/webp",
                  0.86,
                );
              };
              img.onerror = () => reject(new Error("img"));
              img.src = URL.createObjectURL(file);
            });

          addBtn?.addEventListener("click", () => {
            form.hidden = !form.hidden;
            if (!form.hidden) nameInput.focus();
          });

          fileInput.addEventListener("change", () => {
            const file = fileInput.files?.[0];
            if (fileLabel) fileLabel.textContent = file ? file.name.slice(0, 18) : "选一张图";
          });

          form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!ready) {
              setNote("云端还没配好");
              return;
            }

            const name = nameInput.value.trim();
            const file = fileInput.files?.[0];

            if (name.length < 1 || name.length > 16) {
              setNote("名字写 1 到 16 个字");
              return;
            }
            if (!file) {
              setNote("先选一张图");
              return;
            }

            const lastKey = "guandao.wall.last";
            const last = Number(localStorage.getItem(lastKey) ?? 0);
            if (Date.now() - last < 86_400_000) {
              setNote("一天只能留一次，明天再来");
              return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = "上传中…";

            try {
              const blob = await compress(file);
              const key = `${makeId()}.webp`;

              const up = await fetchWithTimeout(`${sb!.url}/storage/v1/object/visitors/${key}`, {
                method: "POST",
                headers: {
                  apikey: sb!.key!,
                  Authorization: `Bearer ${sb!.key}`,
                  "Content-Type": "image/webp",
                  "x-upsert": "false",
                },
                body: blob,
              });
              if (!up.ok) throw new Error(`upload ${up.status}`);

              const publicUrl = `${sb!.url}/storage/v1/object/public/visitors/${key}`;

              const ins = await fetchWithTimeout(`${sb!.url}/rest/v1/visitor_avatars`, {
                method: "POST",
                headers: {
                  apikey: sb!.key!,
                  Authorization: `Bearer ${sb!.key}`,
                  "Content-Type": "application/json",
                  Prefer: "return=minimal",
                },
                body: JSON.stringify({ name, avatar_url: publicUrl }),
              });
              if (!ins.ok) throw new Error(`insert ${ins.status}`);

              localStorage.setItem(lastKey, String(Date.now()));
              form.reset();
              form.hidden = true;
              if (fileLabel) fileLabel.textContent = "选一张图";
              setNote("已经挂上墙了");
              await loadWall();
            } catch {
              setNote("上传失败，稍后再试");
            } finally {
              submitBtn.disabled = false;
              submitBtn.textContent = "上传";
            }
          });

          void loadWall();
        };

        /* ---------------- 每日抽奖 ---------------- */

        const DRAW_KEY = "guandao.draw.v1";

        const QUOTES = [
          "写下来，才算真的想清楚。",
          "今天也在认真吃白饭。",
          "骑到坡顶之前，别老回头看还差多少。",
          "代码跑通的那一秒，比什么都值。",
          "把复杂的事拆开，就没那么吓人了。",
          "慢慢来，比较快。",
          "会做题不等于会做事，但总得先会一样。",
          "今天比昨天多懂一点点，就够了。",
          "下坡爽是因为上坡苦，反过来也成立。",
          "记笔记的意义在于，三个月后还能看懂自己。",
          "别急着优化，先让它跑起来。",
          "早睡这件事，明天再说。",
          "看不进去的时候，就去骑一圈。",
          "所有让人羡慕的结果，背后都是无聊的重复。",
          "先把碗里的吃完。",
          "遇到不会的，先猜一个再查。",
          "写代码最费时间的不是写，是想清楚要写什么。",
          "今天的太阳不错，别忘了抬头。",
          "比起聪明，我更信手熟。",
          "困了就睡，别硬撑。",
          "一个能跑的原型胜过十个完美的设想。",
          "把喜欢的事做久一点，就会有点不一样。",
          "风大的时候，低着头骑也行。",
          "别把时间都花在挑工具上。",
          "记得喝水。",
          "想不通就先放下，脑子会自己接着转。",
          "路是自己选的，慢一点也没关系。",
          "今年的目标：少立 flag，多干活。",
        ];

        const BONUS = "今日幸运：解锁隐藏成就「手气不错」";

        const renderDraw = () => `
          <div class="draw">
            <div class="draw-card" id="draw-card">
              <span class="draw-mark" id="draw-mark">?</span>
            </div>
            <p class="draw-text" id="draw-text">每天可以抽一张，明天再来</p>
            <button class="draw-btn" id="draw-btn" type="button">抽一张</button>
          </div>`;

        const initDraw = (win: HTMLElement) => {
          const card = win.querySelector("#draw-card");
          const mark = win.querySelector("#draw-mark");
          const text = win.querySelector("#draw-text");
          const btn = win.querySelector("#draw-btn") as HTMLButtonElement | null;
          if (!card || !mark || !text || !btn) return;

          const today = new Date().toISOString().slice(0, 10);

          const show = (content: string, isBonus: boolean) => {
            mark.textContent = isBonus ? "★" : "“";
            text.textContent = content;
            card.classList.toggle("is-bonus", isBonus);
            btn.disabled = true;
            btn.textContent = "明天再来";
          };

          try {
            const saved = JSON.parse(localStorage.getItem(DRAW_KEY) || "null");
            if (saved && saved.date === today) {
              show(saved.text, Boolean(saved.bonus));
              return;
            }
          } catch {
            /* 记录坏了就重抽 */
          }

          btn.addEventListener("click", () => {
            btn.disabled = true;
            btn.textContent = "抽取中…";
            card.classList.add("is-shaking");

            window.setTimeout(() => {
              card.classList.remove("is-shaking");

              const isBonus = Math.random() < 0.1;
              const content = isBonus ? BONUS : QUOTES[Math.floor(Math.random() * QUOTES.length)];

              localStorage.setItem(DRAW_KEY, JSON.stringify({ date: today, text: content, bonus: isBonus }));
              show(content, isBonus);

              if (isBonus) unlock("draw");
            }, 900);
          });
        };

        /* ---------------- 民主议会 ---------------- */

        const COUNCIL_VOTER_KEY = "guandao.council.voter";

        // 投票人 = 登录用户的 uid；没登录返回空串，界面会拦住不让投
        const councilVoter = (): string => {
          const auth = readAuth();
          return auth ? auth.uid : "";
        };

        const renderCouncil = () => `
          <div class="council">
            <div class="council-head">
              <span class="council-status" id="council-status">正在加载…</span>
              <button class="council-retry" id="council-retry" type="button" hidden>重试</button>
              <span class="council-tip">一人一票 · 投完看结果</span>
            </div>
            <div class="council-auth" id="council-auth"></div>
            <div class="council-list" id="council-list"></div>
          </div>`;

        const COUNCIL_MINE_KEY = "guandao.council.mine";

        /**
         * 投票记录按账号分开存。
         * 之前是一个固定 key，换个号登录还会读到上一个号的「已投」，导致新号投不了票。
         */
        const councilMineKey = () => {
          const auth = readAuth();
          return auth ? `${COUNCIL_MINE_KEY}.${auth.uid}` : `${COUNCIL_MINE_KEY}.anon`;
        };

        interface CouncilMineEntry {
          opt: number;
          at: number;
        }

        /** 兼容旧格式（直接存数字）和新格式（{opt, at}） */
        const readCouncilMine = (): Record<string, CouncilMineEntry> => {
          try {
            const raw = JSON.parse(localStorage.getItem(councilMineKey()) || "{}") as Record<string, unknown>;
            const out: Record<string, CouncilMineEntry> = {};

            for (const [k, v] of Object.entries(raw)) {
              if (typeof v === "number") {
                out[k] = { opt: v, at: 0 };
              } else if (v && typeof v === "object") {
                const obj = v as { opt?: number; at?: number };
                if (typeof obj.opt === "number") out[k] = { opt: obj.opt, at: obj.at ?? 0 };
              }
            }

            return out;
          } catch {
            return {};
          }
        };

        const writeCouncilMine = (mine: Record<string, CouncilMineEntry>) => {
          try {
            localStorage.setItem(councilMineKey(), JSON.stringify(mine));
          } catch {
            /* 隐私模式忽略 */
          }
        };

        const initCouncil = (win: HTMLElement) => {
          const list = win.querySelector("#council-list");
          const status = win.querySelector("#council-status");
          const retryBtn = win.querySelector<HTMLButtonElement>("#council-retry");
          if (!list || !status) return;

          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          const ready = Boolean(sb?.url && sb?.key);
          const voter = councilVoter();

          interface Poll {
            id: string;
            title: string;
            kind: string;
            options: string[];
          }

          // 议题和票数在构建时就写进页面了，打开即有内容，不等网络
          const seed = (DATA.council ?? { polls: [], counts: {} }) as {
            polls: Poll[];
            counts: Record<string, Record<string, number>>;
            builtAt?: number;
          };

          const polls: Poll[] = seed.polls ?? [];
          const baseCounts = seed.counts ?? {};
          // 构建时间：晚于这个时间投的票，还没进 baseCounts
          const builtAt = seed.builtAt ?? 0;

          // 我投过哪些，记在本地（含投票时间，用来判断要不要补这一票）
          let mine: Record<string, CouncilMineEntry> = readCouncilMine();

          let lastAuthed: boolean | null = null;

          const countOf = (pollId: string, optIdx: number) => {
            let n = baseCounts[pollId]?.[String(optIdx)] ?? 0;
            const entry = mine[pollId];
            // 构建之后投的票还没算进 baseCounts，这里补上，刷新也不会丢
            if (entry && entry.opt === optIdx && entry.at > builtAt) n += 1;
            return n;
          };

          const totalOf = (poll: Poll) => poll.options.reduce((sum, _, i) => sum + countOf(poll.id, i), 0);

          const render = () => {
            // 登录账号可能换了，重读一次投票记录
            mine = readCouncilMine();

            if (!polls.length) {
              status.textContent = "暂无议题";
              list.innerHTML =
                '<p class="council-empty">页面里没有议题数据，可能是构建时没连上数据库。</p>';
              return;
            }

            const authed = Boolean(councilVoter());
            const canVote = authed;

            const authBox = win.querySelector("#council-auth");
            if (authBox && authed !== lastAuthed) {
              authBox.innerHTML = authed ? "" : authFormHtml();
              lastAuthed = authed;
            }

            const grand = polls.reduce((sum, p) => sum + totalOf(p), 0);
            status.textContent = canVote
              ? `${polls.length} 项在议 · ${grand} 票`
              : `${polls.length} 项在议 · 登录后才能投票`;

            list.innerHTML = polls
              .map((poll) => {
                const total = totalOf(poll);
                const chosen = mine[poll.id]?.opt;
                const locked = chosen !== undefined;

                const rows = poll.options
                  .map((label, i) => {
                    const n = countOf(poll.id, i);
                    const pct = total ? Math.round((n / total) * 100) : 0;
                    return `
                      <button class="council-opt ${chosen === i ? "is-mine" : ""}" type="button"
                        data-poll="${poll.id}" data-opt="${i}" ${locked || !canVote ? "disabled" : ""}>
                        <span class="council-bar" style="width:${pct}%"></span>
                        <span class="council-label">${escapeHtml(label)}</span>
                        <span class="council-num">${n}</span>
                      </button>`;
                  })
                  .join("");

                const myLabel = locked && poll.options[chosen] ? ` · 你投了「${escapeHtml(poll.options[chosen])}」` : "";

                return `
                  <section class="council-item">
                    <p class="council-title">${escapeHtml(poll.title)}</p>
                    <div class="council-opts">${rows}</div>
                    <p class="council-meta">${total} 票${myLabel}</p>
                  </section>`;
              })
              .join("");
          };

          const vote = async (pollId: string, optIdx: number) => {
            if (mine[pollId] !== undefined) return;

            if (!readAuth()) {
              status.textContent = "先登录才能投票";
              return;
            }

            // token 可能已经过期，先换一个可用的再用
            const token = await ensureFreshToken();
            const auth = readAuth();
            if (!token || !auth) {
              status.textContent = "登录过期了，重新登录一下";
              render();
              return;
            }

            // 先在本地记下并刷新，网络再慢也不耽误
            mine[pollId] = { opt: optIdx, at: Date.now() };
            try {
              writeCouncilMine(mine);
            } catch {
              /* 隐私模式忽略 */
            }
            render();

            if (!ready) {
              status.textContent = "已记在本地，但云端没连上";
              return;
            }

            void fetchWithTimeout(
              `${sb!.url}/rest/v1/votes`,
              {
                method: "POST",
                headers: {
                  apikey: sb!.key!,
                  Authorization: `Bearer ${token}`,
                  "Content-Type": "application/json",
                  Prefer: "return=minimal",
                },
                body: JSON.stringify({ poll_id: pollId, option_index: optIdx, voter: auth.uid }),
              },
              8000,
            )
              .then((res) => {
                if (!res.ok && res.status !== 409) throw new Error(String(res.status));
              })
              .catch(() => {
                // 没提交成功就撤销这票，让人还能重投
                delete mine[pollId];
                try {
                  writeCouncilMine(mine);
                } catch {
                  /* 忽略 */
                }
                render();
                status.textContent = "投票没提交上，再点一次试试";
                if (retryBtn) retryBtn.hidden = false;
              });
          };

          list.addEventListener("click", (event) => {
            const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(".council-opt");
            if (!btn || btn.disabled) return;

            const pollId = btn.dataset.poll;
            const optIdx = Number(btn.dataset.opt);
            if (!pollId || Number.isNaN(optIdx)) return;

            vote(pollId, optIdx);
          });

          // 手动拉最新票数，失败也不影响已经显示的内容
          retryBtn?.addEventListener("click", async () => {
            if (!ready || !retryBtn) return;

            retryBtn.hidden = true;
            status.textContent = "正在拉最新票数…";

            try {
              const res = await fetchWithTimeout(
                `${sb!.url}/rest/v1/votes?select=poll_id,option_index`,
                { headers: { apikey: sb!.key!, Authorization: `Bearer ${sb!.key}` } },
                8000,
              );
              if (!res.ok) throw new Error("bad status");

              const votes = (await res.json()) as Array<{ poll_id: string; option_index: number }>;

              for (const k of Object.keys(baseCounts)) delete baseCounts[k];
              for (const v of votes) {
                if (!baseCounts[v.poll_id]) baseCounts[v.poll_id] = {};
                const cur = baseCounts[v.poll_id][v.option_index];
                baseCounts[v.poll_id][v.option_index] = (typeof cur === "number" ? cur : 0) + 1;
              }

              render();
              status.textContent = "已更新到最新";
            } catch {
              status.textContent = "还是连不上，先看页面里的结果";
              retryBtn.hidden = false;
            }
          });

          render();
          window.addEventListener("guandao:auth-change", () => {
            render();
          });
        };


        /* ---------------- 匿名树洞 ---------------- */

        const HOLE_ADJ = ["安静的", "路过的", "深夜的", "迷路的", "加班的", "刚睡醒的", "在骑车的", "写代码的", "晒太阳的"];
        const HOLE_NOUN = ["鲸鱼", "海豚", "猫", "海鸥", "风", "路灯", "路人", "大肥鱼", "土豆"];

        const holeNick = () =>
          `${HOLE_ADJ[Math.floor(Math.random() * HOLE_ADJ.length)]}${HOLE_NOUN[Math.floor(Math.random() * HOLE_NOUN.length)]}`;

        const timeAgo = (iso: string) => {
          const diff = Date.now() - new Date(iso).getTime();
          const min = Math.floor(diff / 60000);
          if (min < 1) return "刚刚";
          if (min < 60) return `${min} 分钟前`;
          const hr = Math.floor(min / 60);
          if (hr < 24) return `${hr} 小时前`;
          const day = Math.floor(hr / 24);
          if (day < 30) return `${day} 天前`;
          return new Date(iso).toLocaleDateString("zh-CN");
        };

        const renderTreehole = () => `
          <div class="hole">
            <div class="hole-top">
              <p class="hole-topic-label">今日话题</p>
              <p class="hole-topic" id="hole-topic">今天有什么小事让你开心？</p>
            </div>
            <div class="hole-auth" id="hole-auth"></div>
            <form class="hole-form" id="hole-form">
              <textarea class="hole-input" id="hole-input" rows="2" maxlength="500" placeholder="想说什么就说，没人知道你是谁"></textarea>
              <div class="hole-form-bar">
                <span class="hole-count" id="hole-count">0 / 500</span>
                <button class="hole-send" id="hole-send" type="submit">说出去</button>
              </div>
            </form>
            <div class="hole-list" id="hole-list"></div>
            <p class="hole-status" id="hole-status"></p>
          </div>`;

        const initTreehole = (win: HTMLElement) => {
          const list = win.querySelector("#hole-list");
          const form = win.querySelector<HTMLFormElement>("#hole-form");
          const input = win.querySelector<HTMLTextAreaElement>("#hole-input");
          const send = win.querySelector<HTMLButtonElement>("#hole-send");
          const count = win.querySelector("#hole-count");
          const status = win.querySelector("#hole-status");
          const topicEl = win.querySelector("#hole-topic");
          if (!list || !form || !input || !send || !count || !status) return;

          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          const ready = Boolean(sb?.url && sb?.key);

          interface Hole {
            id: string;
            content: string;
            nick: string;
            featured: boolean;
            created_at: string;
          }
          interface Reply {
            id: string;
            hole_id: string;
            content: string;
            nick: string;
            created_at: string;
          }

          let holes: Hole[] = [];
          let replies: Reply[] = [];
          const openReplies = new Set<string>();

          const authBox = win.querySelector("#hole-auth");
          let lastAuthed: boolean | null = null;

          const render = () => {
            const authed = Boolean(readAuth());
            // 只在登录状态真正变化时重绘，否则会把正在输入的邮箱密码清掉
            if (authBox && authed !== lastAuthed) {
              authBox.innerHTML = authed
                ? ""
                : `${authFormHtml()}<p class="hole-auth-tip">登录后才能说话和回应，页面上仍只显示随机昵称。</p>`;
              lastAuthed = authed;
            }

            if (!holes.length) {
              list.innerHTML = '<p class="hole-empty">还没有人说话。做第一个吧。</p>';
              return;
            }

            list.innerHTML = holes
              .map((h) => {
                const rs = replies.filter((r) => r.hole_id === h.id);
                const open = openReplies.has(h.id);

                const replyBlock = open
                  ? `
                    <div class="hole-replies">
                      ${
                        rs.length
                          ? rs
                              .map(
                                (r) => `
                                  <div class="hole-reply">
                                    <span class="hole-reply-nick">${escapeHtml(r.nick)}</span>
                                    <span class="hole-reply-text">${escapeHtml(r.content)}</span>
                                  </div>`,
                              )
                              .join("")
                          : '<p class="hole-reply-empty">还没有回应，说点什么？</p>'
                      }
                      <form class="hole-reply-form" data-hole="${h.id}">
                        <input class="hole-reply-input" maxlength="300" placeholder="回应一句…" />
                        <button type="submit">发送</button>
                      </form>
                    </div>`
                  : "";

                return `
                  <article class="hole-item ${h.featured ? "is-featured" : ""}">
                    ${h.featured ? '<span class="hole-badge">精选</span>' : ""}
                    <p class="hole-text">${escapeHtml(h.content)}</p>
                    <div class="hole-meta">
                      <span class="hole-nick">${escapeHtml(h.nick)}</span>
                      <span class="hole-time">${timeAgo(h.created_at)}</span>
                      <button class="hole-reply-toggle" data-hole="${h.id}" type="button">
                        ${rs.length ? `${rs.length} 条回应` : "回应"}
                      </button>
                    </div>
                    ${replyBlock}
                  </article>`;
              })
              .join("");
          };

          const load = async () => {
            if (!ready) {
              status.textContent = "云端没接上，只能看不能发";
              return;
            }

            // 未登录也要能看到别人说的，所以照常拉数据


            status.textContent = "正在连…";

            try {
              const headers = { apikey: sb!.key!, Authorization: `Bearer ${sb!.key}` };

              const [tRes, hRes, rRes] = await Promise.all([
                fetchWithTimeout(
                  `${sb!.url}/rest/v1/hole_topics?select=day,topic&order=day.desc&limit=1`,
                  { headers },
                  8000,
                ),
                fetchWithTimeout(
                  `${sb!.url}/rest/v1/holes?select=id,content,nick,featured,created_at&order=featured.desc,created_at.desc&limit=40`,
                  { headers },
                  10000,
                ),
                fetchWithTimeout(
                  `${sb!.url}/rest/v1/hole_replies?select=id,hole_id,content,nick,created_at&order=created_at.asc&limit=300`,
                  { headers },
                  10000,
                ),
              ]);

              if (tRes.ok) {
                const topics = (await tRes.json()) as Array<{ topic: string }>;
                if (topics.length && topicEl) topicEl.textContent = topics[0].topic;
              }

              if (!hRes.ok || !rRes.ok) throw new Error("bad status");

              holes = (await hRes.json()) as Hole[];
              replies = (await rRes.json()) as Reply[];

              status.textContent = holes.length ? `共 ${holes.length} 条` : "";
              render();
            } catch {
              status.textContent = "连不上，可能是网络问题，关掉重开试试";
            }
          };

          // 没登录就锁住输入框
          const syncInputState = () => {
            const auth = readAuth();
            input.disabled = !auth;
            send.disabled = !auth;
            input.placeholder = auth
              ? "想说什么就说，页面上只显示随机昵称"
              : "登录后就能在这里说话";
          };
          syncInputState();
          window.addEventListener("guandao:auth-change", () => {
            syncInputState();
            render();
          });

          input.addEventListener("input", () => {
            count.textContent = `${input.value.length} / 500`;
          });

          form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const text = input.value.trim();
            if (!text) return;

            if (!readAuth()) {
              status.textContent = "登录后才能说话";
              return;
            }

            const token = await ensureFreshToken();
            const auth = readAuth();
            if (!token || !auth) {
              status.textContent = "登录过期了，重新登录一下";
              return;
            }

            const nick = holeNick();
            const optimistic: Hole = {
              id: `local-${Date.now()}`,
              content: text,
              nick,
              featured: false,
              created_at: new Date().toISOString(),
            };

            // 先插进列表，网络慢也不耽误看到自己说的话
            holes.unshift(optimistic);
            input.value = "";
            count.textContent = "0 / 500";
            render();
            list.scrollTop = 0;

            if (!ready) {
              status.textContent = "显示在本地了，但云端没连上";
              return;
            }

            send.disabled = true;

            try {
              const res = await fetchWithTimeout(
                `${sb!.url}/rest/v1/holes`,
                {
                  method: "POST",
                  headers: {
                    apikey: sb!.key!,
                    Authorization: `Bearer ${token}`,
                    "Content-Type": "application/json",
                    Prefer: "return=minimal",
                  },
                  body: JSON.stringify({ content: text, nick, author_id: auth.uid }),
                },
                10000,
              );
              if (!res.ok) throw new Error(String(res.status));
              status.textContent = "说完了";
            } catch {
              holes = holes.filter((h) => h.id !== optimistic.id);
              render();
              status.textContent = "没发出去，再试一次";
            } finally {
              send.disabled = false;
            }
          });

          list.addEventListener("click", (event) => {
            const btn = (event.target as HTMLElement).closest<HTMLElement>(".hole-reply-toggle");
            if (!btn) return;

            const id = btn.dataset.hole;
            if (!id) return;

            if (openReplies.has(id)) openReplies.delete(id);
            else openReplies.add(id);

            render();
          });

          list.addEventListener("submit", async (event) => {
            const formEl = event.target as HTMLFormElement;
            if (!formEl.classList.contains("hole-reply-form")) return;
            event.preventDefault();

            const holeId = formEl.dataset.hole;
            const inputEl = formEl.querySelector<HTMLInputElement>(".hole-reply-input");
            const text = inputEl?.value.trim();
            if (!holeId || !text || !ready) return;

            if (!readAuth()) {
              status.textContent = "登录后才能回应";
              return;
            }

            const token = await ensureFreshToken();
            const auth = readAuth();
            if (!token || !auth) {
              status.textContent = "登录过期了，重新登录一下";
              return;
            }

            const nick = holeNick();
            const optimistic: Reply = {
              id: `local-${Date.now()}`,
              hole_id: holeId,
              content: text,
              nick,
              created_at: new Date().toISOString(),
            };

            if (inputEl) inputEl.value = "";
            replies.push(optimistic);
            render();

            try {
              const res = await fetchWithTimeout(
                `${sb!.url}/rest/v1/hole_replies`,
                {
                  method: "POST",
                  headers: {
                    apikey: sb!.key!,
                    Authorization: `Bearer ${token}`,
                    "Content-Type": "application/json",
                    Prefer: "return=minimal",
                  },
                  body: JSON.stringify({ hole_id: holeId, content: text, nick, author_id: auth.uid }),
                },
                10000,
              );
              if (!res.ok) throw new Error(String(res.status));
            } catch {
              replies = replies.filter((r) => r.id !== optimistic.id);
              render();
              status.textContent = "回应没发出去，再试一次";
            }
          });

          render();
          void load();
        };

        /* ---------------- 大肥鱼新闻联播 ---------------- */

        const renderNews = () => `
          <div class="news">
            <div class="news-head">
              <img class="news-avatar" src="/pet/whale-girl.webp" alt="" />
              <div class="news-title-block">
                <p class="news-name">大肥鱼新闻联播</p>
                <p class="news-date" id="news-date"></p>
              </div>
            </div>
            <div class="news-list" id="news-list"></div>
            <p class="news-foot">本台记者 大肥鱼 · 发自桌面右下角</p>
          </div>`;

        const initNews = (win: HTMLElement) => {
          const list = win.querySelector("#news-list");
          const dateEl = win.querySelector("#news-date");
          if (!list || !dateEl) return;

          const now = new Date();
          // 用日期当种子，同一天打开内容一致，隔天才会换
          const seed = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
          const pick = (arr: string[], salt: number) => arr[(seed + salt) % arr.length];

          dateEl.textContent = now.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
            weekday: "long",
          });

          const posts = ((DATA.posts ?? []) as Array<{ title: string; date: string }>).slice();
          posts.sort((a, b) => b.date.localeCompare(a.date));

          const items: Array<{ tag: string; text: string }> = [];

          // 头条：更新情况
          if (!posts.length) {
            items.push({ tag: "头条", text: "本站目前还没有文章，编辑部正在等待第一份稿件。" });
          } else {
            const last = posts[0];
            const gap = Math.floor((Date.now() - new Date(last.date).getTime()) / 86400000);

            if (gap <= 0) {
              items.push({ tag: "头条", text: `博主今日发布了《${last.title}》，编辑室全体起立鼓掌。` });
            } else if (gap <= 2) {
              items.push({ tag: "头条", text: `距离上一篇更新已 ${gap} 天，博主表示「在写了在写了」。` });
            } else if (gap <= 9) {
              items.push({ tag: "头条", text: `今日博主依然没有更新文章，距离上一篇已经 ${gap} 天。` });
            } else {
              items.push({ tag: "头条", text: `博主已连续 ${gap} 天没有更新，本台记者多次联系未果。` });
            }
          }

          // 数据
          items.push({
            tag: "数据",
            text: posts.length
              ? `本站累计 ${posts.length} 篇文章，最近一篇是《${posts[0].title}》。`
              : `本站累计 ${posts.length} 篇文章。`,
          });

          // 互动
          items.push({
            tag: "互动",
            text: pick(
              [
                "树洞持续营业中，欢迎匿名说点什么。",
                "议会正在为下一篇文章的选题投票，目前还没有定论。",
                "访客墙在等第一个愿意露脸的人。",
                "排行榜上还没人，先去逛两圈就能上榜。",
              ],
              3,
            ),
          });

          // 花絮
          items.push({
            tag: "花絮",
            text: pick(
              [
                "大肥鱼今天心情不错，在桌面右下角坐了一整天。",
                "大肥鱼表示：摸可以，别戳太用力。",
                "大肥鱼今日无排班，但在岗。",
                "据大肥鱼本人透露，她更喜欢白天，因为晚上看不清键盘。",
                "大肥鱼今天试图打开音乐播放器，未果。",
                "大肥鱼对本次更新表示满意，并要了一条小鱼干。",
              ],
              11,
            ),
          });

          list.innerHTML = items
            .map(
              (n, i) => `
                <article class="news-item" style="animation-delay:${i * 90}ms">
                  <span class="news-tag">${n.tag}</span>
                  <p class="news-text">${escapeHtml(n.text)}</p>
                </article>`,
            )
            .join("");
        };

        /* ---------------- 社会网络 ---------------- */

        const AUTH_KEY = "guandao.auth";

        interface AuthState {
          token: string;
          refresh: string;
          uid: string;
          email: string;
          at: number;
        }

        const readAuth = (): AuthState | null => {
          try {
            const raw = JSON.parse(localStorage.getItem(AUTH_KEY) || "null");
            if (raw && raw.token && raw.uid) return raw as AuthState;
          } catch {
            /* 坏数据当没登录 */
          }
          return null;
        };

        const writeAuth = (state: AuthState | null) => {
          try {
            if (state) localStorage.setItem(AUTH_KEY, JSON.stringify(state));
            else localStorage.removeItem(AUTH_KEY);
          } catch {
            /* 隐私模式忽略 */
          }
          // 同一个页面里 localStorage 的改动不会触发 storage 事件，
          // 所以自己广播一下，让树洞 / 议会这些窗口即时刷新状态。
          window.dispatchEvent(new CustomEvent("guandao:auth-change"));
        };

        /**
         * 拿一个还能用的 token。
         * Supabase 的 access_token 默认 1 小时过期，过期后写操作会被 RLS 拒掉，
         * 表现就是「点了投票但没投上」。这里在快过期前用 refresh_token 换新的。
         */
        const ensureFreshToken = async (): Promise<string | null> => {
          const cur = readAuth();
          if (!cur) return null;
          if (!cur.refresh) return cur.token;

          // 50 分钟内直接复用，超过就先刷新
          if (Date.now() - cur.at < 50 * 60 * 1000) return cur.token;

          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          if (!sb?.url || !sb?.key) return cur.token;

          try {
            const res = await fetchWithTimeout(
              `${sb.url}/auth/v1/token?grant_type=refresh_token`,
              {
                method: "POST",
                headers: { apikey: sb.key, "Content-Type": "application/json" },
                body: JSON.stringify({ refresh_token: cur.refresh }),
              },
              15000,
            );

            if (!res.ok) throw new Error("refresh failed");

            const data = (await res.json()) as {
              access_token?: string;
              refresh_token?: string;
              user?: { id: string; email: string };
            };
            if (!data.access_token) throw new Error("no token");

            const next: AuthState = {
              token: data.access_token,
              refresh: data.refresh_token ?? cur.refresh,
              uid: data.user?.id ?? cur.uid,
              email: data.user?.email ?? cur.email,
              at: Date.now(),
            };

            writeAuth(next);
            return next.token;
          } catch {
            // 连 refresh 都失败，说明会话彻底没了，清掉让用户重新登录
            writeAuth(null);
            return null;
          }
        };

        const SOCIAL_AVATARS: Record<string, string> = {
          whale: "/pet/whale-girl.webp",
          tshirt: "/pet/tshirt.webp",
          hoodie: "/pet/hoodie.webp",
          suit: "/pet/suit.webp",
          pajamas: "/pet/pajamas.webp",
          swimsuit: "/pet/swimsuit.webp",
          yukata: "/pet/yukata.webp",
          uniform: "/pet/uniform.webp",
        };

        const socialRole = (createdAt: string) => {
          const days = Math.floor((Date.now() - new Date(createdAt).getTime()) / 86400000);
          if (days < 1) return "刚来";
          if (days < 7) return "新面孔";
          if (days < 30) return "常客";
          return "老熟人";
        };

        const renderSocial = () => `
          <div class="social">
            <div class="social-me" id="social-me"></div>
            <div class="social-head">
              <span class="social-count" id="social-count">正在加载…</span>
              <span class="social-tip">认识一下常来的人</span>
            </div>
            <div class="social-list" id="social-list"></div>
          </div>`;

        const initSocial = (win: HTMLElement) => {
          const meEl = win.querySelector("#social-me");
          const listEl = win.querySelector("#social-list");
          const countEl = win.querySelector("#social-count");
          if (!meEl || !listEl || !countEl) return;

          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          const ready = Boolean(sb?.url && sb?.key);
          let auth = readAuth();

          interface Person {
            id: string;
            nickname: string;
            avatar: string;
            bio: string;
            created_at: string;
            last_seen: string;
          }

          let me: Person | null = null;
          let people: Person[] = [];
          let following = new Set<string>();
          let editing = false;

          const headers = (extra: Record<string, string> = {}) => {
            // 每次都重新读，续期之后能立刻拿到新 token
            const cur = readAuth();
            return {
              apikey: sb!.key!,
              Authorization: `Bearer ${cur ? cur.token : sb!.key}`,
              ...extra,
            };
          };

          const renderMe = () => {
            if (!auth) {
              meEl.innerHTML = authFormHtml();
              return;
            }

            if (editing) {
              const avatarBtns = Object.entries(SOCIAL_AVATARS)
                .map(
                  ([key, src]) => `
                    <button class="social-pick ${me?.avatar === key ? "is-on" : ""}" type="button" data-avatar="${key}">
                      <img src="${safeUrl(src)}" alt="" />
                    </button>`,
                )
                .join("");

              meEl.innerHTML = `
                <form class="social-form" id="social-form">
                  <div class="social-picks" id="social-picks">${avatarBtns}</div>
                  <input class="social-input" id="social-name" maxlength="16" placeholder="昵称（1–16 字）" value="${escapeHtml(me?.nickname ?? "")}" />
                  <input class="social-input" id="social-bio" maxlength="80" placeholder="一句话介绍自己（可不填）" value="${escapeHtml(me?.bio ?? "")}" />
                  <div class="social-form-bar">
                    <button class="social-cancel" type="button" id="social-cancel">算了</button>
                    <button class="social-save" type="submit">保存</button>
                  </div>
                </form>`;
              return;
            }

            const src = SOCIAL_AVATARS[me?.avatar ?? "whale"] ?? SOCIAL_AVATARS.whale;

            meEl.innerHTML = `
              <div class="social-card">
                <img class="social-face" src="${safeUrl(src)}" alt="" />
                <div class="social-info">
                  <p class="social-name">${escapeHtml(me?.nickname ?? "还没起名字")}</p>
                  <p class="social-bio">${escapeHtml(me?.bio || "这个人很懒，什么都没写")}</p>
                  <p class="social-meta">
                    <span class="social-role">${me ? socialRole(me.created_at) : "新面孔"}</span>
                    <span>关注 ${following.size}</span>
                  </p>
                </div>
                <div class="social-card-btns">
                  <button class="social-edit" type="button" id="social-edit">${me ? "改" : "起名"}</button>
                  <button class="social-edit is-quiet" type="button" id="social-signout">退出</button>
                </div>
              </div>`;
          };

          const renderList = () => {
            const others = people.filter((p) => p.id !== (auth ? auth.uid : ""));

            if (!others.length) {
              listEl.innerHTML = '<p class="social-empty">还没有别的访客留下名字。</p>';
              countEl.textContent = "0 位访客";
              return;
            }

            countEl.textContent = `${others.length} 位访客`;

            listEl.innerHTML = others
              .map((p) => {
                const src = SOCIAL_AVATARS[p.avatar] ?? SOCIAL_AVATARS.whale;
                const isFollowing = following.has(p.id);
                return `
                  <div class="social-row">
                    <img class="social-row-face" src="${safeUrl(src)}" alt="" />
                    <div class="social-row-info">
                      <p class="social-row-name">${escapeHtml(p.nickname)}</p>
                      <p class="social-row-bio">${escapeHtml(p.bio || "没写介绍")}</p>
                    </div>
                    <span class="social-row-role">${socialRole(p.created_at)}</span>
                    <button class="social-follow ${isFollowing ? "is-on" : ""}" type="button" data-follow="${p.id}">
                      ${isFollowing ? "已关注" : "关注"}
                    </button>
                  </div>`;
              })
              .join("");
          };

          const signOut = () => {
            writeAuth(null);
            auth = null;
            me = null;
            following = new Set();
            renderMe();
            renderList();
            countEl.textContent = "已退出";
          };

          const load = async () => {
            if (!ready) {
              countEl.textContent = "云端没接上";
              return;
            }

            try {
              // 我的资料
              const meRes = await fetchWithTimeout(
                `${sb!.url}/rest/v1/profiles?id=eq.${encodeURIComponent(auth ? auth.uid : "")}&select=*`,
                { headers: headers() },
                8000,
              );
              if (meRes.ok) {
                const rows = (await meRes.json()) as Person[];
                me = rows[0] ?? null;
              }

              // 所有人
              const pRes = await fetchWithTimeout(
                `${sb!.url}/rest/v1/profiles?select=*&order=last_seen.desc&limit=50`,
                { headers: headers() },
                10000,
              );
              if (pRes.ok) people = (await pRes.json()) as Person[];

              // 我关注了谁
              const fRes = await fetchWithTimeout(
                `${sb!.url}/rest/v1/follows?select=to_id&from_id=eq.${encodeURIComponent(auth ? auth.uid : "")}`,
                { headers: headers() },
                8000,
              );
              if (fRes.ok) {
                const rows = (await fRes.json()) as Array<{ to_id: string }>;
                following = new Set(rows.map((r) => r.to_id));
              }

              renderMe();
              renderList();
            } catch {
              countEl.textContent = "连不上，关掉重开试试";
            }
          };

          const saveProfile = async (nickname: string, bio: string, avatar: string) => {
            if (!ready) return;

            await ensureFreshToken();
            auth = readAuth();
            if (!auth) {
              countEl.textContent = "登录过期了，重新登录一下";
              renderMe();
              return;
            }

            const body = {
              id: auth.uid,
              nickname,
              bio,
              avatar,
              last_seen: new Date().toISOString(),
            };

            try {
              await fetchWithTimeout(
                `${sb!.url}/rest/v1/profiles?on_conflict=id`,
                {
                  method: "POST",
                  headers: headers({
                    "Content-Type": "application/json",
                    Prefer: "resolution=merge-duplicates,return=minimal",
                  }),
                  body: JSON.stringify(body),
                },
                10000,
              );

              me = {
                ...(me ?? { created_at: new Date().toISOString() }),
                ...body,
              } as Person;
              editing = false;
              renderMe();
              renderList();
              countEl.textContent = "资料已保存";
            } catch {
              countEl.textContent = "保存失败，再试一次";
            }
          };

          const toggleFollow = async (toId: string) => {
            if (!ready) return;

            await ensureFreshToken();
            auth = readAuth();
            if (!auth) {
              countEl.textContent = "登录过期了，重新登录一下";
              renderMe();
              return;
            }

            const on = following.has(toId);

            // 先改界面
            if (on) following.delete(toId);
            else following.add(toId);
            renderMe();
            renderList();

            try {
              if (on) {
                await fetchWithTimeout(
                  `${sb!.url}/rest/v1/follows?from_id=eq.${encodeURIComponent(auth ? auth.uid : "")}&to_id=eq.${encodeURIComponent(toId)}`,
                  { method: "DELETE", headers: headers({ Prefer: "return=minimal" }) },
                  8000,
                );
              } else {
                await fetchWithTimeout(
                  `${sb!.url}/rest/v1/follows`,
                  {
                    method: "POST",
                    headers: headers({ "Content-Type": "application/json", Prefer: "return=minimal" }),
                    body: JSON.stringify({ from_id: auth ? auth.uid : "", to_id: toId }),
                  },
                  8000,
                );
              }
            } catch {
              // 回滚
              if (on) following.add(toId);
              else following.delete(toId);
              renderMe();
              renderList();
              countEl.textContent = "操作没成功，再试一次";
            }
          };

          // 事件：编辑 / 保存 / 选头像 / 关注
          win.addEventListener("click", (event) => {
            const target = event.target as HTMLElement;

            if (target.closest("#social-signout")) {
              signOut();
              return;
            }

            if (target.closest("#social-edit")) {
              editing = true;
              renderMe();
              return;
            }

            if (target.closest("#social-cancel")) {
              editing = false;
              renderMe();
              return;
            }

            const pick = target.closest<HTMLElement>(".social-pick");
            if (pick) {
              const key = pick.dataset.avatar;
              if (!key) return;
              meEl.querySelectorAll(".social-pick").forEach((el) => el.classList.remove("is-on"));
              pick.classList.add("is-on");
              return;
            }

            const followBtn = target.closest<HTMLElement>(".social-follow");
            if (followBtn) {
              const id = followBtn.dataset.follow;
              if (id) void toggleFollow(id);
            }
          });

          win.addEventListener("submit", (event) => {
            const form = event.target as HTMLFormElement;

            if (!form.classList.contains("social-form")) return;
            event.preventDefault();

            const name = win.querySelector<HTMLInputElement>("#social-name")?.value.trim() ?? "";
            const bio = win.querySelector<HTMLInputElement>("#social-bio")?.value.trim() ?? "";
            const avatar = meEl.querySelector<HTMLElement>(".social-pick.is-on")?.dataset.avatar ?? "whale";

            if (!name) return;
            void saveProfile(name, bio, avatar);
          });

          // 登录状态变了（比如在这个窗口切号），重新读身份并拉数据
          window.addEventListener("guandao:auth-change", () => {
            auth = readAuth();
            void load();
          });

          void load();
        };

        /* ---------------- 系统监视器 ---------------- */
        const renderMonitor = () => `
          <div class="monitor">
            <div class="mon-cards">
              <div class="mon-card"><span class="mon-label">CPU（模拟）</span><b class="mon-val" data-mon-cpu>—</b><div class="mon-bar"><i data-mon-cpu-bar></i></div></div>
              <div class="mon-card"><span class="mon-label">内存（模拟）</span><b class="mon-val" data-mon-mem>—</b><div class="mon-bar"><i data-mon-mem-bar></i></div></div>
            </div>
            <p class="mon-note">CPU/内存为模拟数据，浏览器无法读取真实硬件占用。</p>
            <div class="mon-rows">
              <div class="mon-row"><span>运行窗口</span><b data-mon-win>0</b></div>
              <div class="mon-row"><span>虚拟桌面</span><b data-mon-desks>0</b></div>
              <div class="mon-row"><span>已开启</span><b data-mon-uptime>0 分钟</b></div>
              <div class="mon-row"><span>本地存储（真实）</span><b data-mon-storage>—</b></div>
            </div>
            <p class="mon-label mon-apps-label">运行中的应用</p>
            <div class="mon-apps" data-mon-apps></div>
          </div>`;

        const initMonitor = (win: HTMLElement) => {
          const cpuEl = win.querySelector("[data-mon-cpu]");
          const memEl = win.querySelector("[data-mon-mem]");
          const cpuBar = win.querySelector("[data-mon-cpu-bar]") as HTMLElement | null;
          const memBar = win.querySelector("[data-mon-mem-bar]") as HTMLElement | null;
          let cpu = 18;
          let mem = 42;
          const tick = () => {
            if (!win.isConnected) {
              window.clearInterval(timer);
              return;
            }
            cpu = Math.max(4, Math.min(92, cpu + (Math.random() - 0.5) * 16));
            mem = Math.max(28, Math.min(88, mem + (Math.random() - 0.5) * 8));
            if (cpuEl) cpuEl.textContent = `${Math.round(cpu)}%`;
            if (memEl) memEl.textContent = `${Math.round(mem)}%`;
            if (cpuBar) cpuBar.style.width = `${cpu}%`;
            if (memBar) memBar.style.width = `${mem}%`;
          };
          const timer = window.setInterval(tick, 1500);
          tick();

          let bytes = 0;
          try {
            for (let i = 0; i < localStorage.length; i++) {
              const k = localStorage.key(i) || "";
              if (k.startsWith("guandao.")) bytes += (localStorage.getItem(k) || "").length;
            }
          } catch {
            /* 忽略 */
          }
          const storageEl = win.querySelector("[data-mon-storage]");
          if (storageEl) storageEl.textContent = `${(bytes / 1024).toFixed(1)} KB`;

          const update = () => {
            if (!win.isConnected) {
              window.clearInterval(infoTimer);
              return;
            }
            const w = win.querySelector("[data-mon-win]");
            const d = win.querySelector("[data-mon-desks]");
            const u = win.querySelector("[data-mon-uptime]");
            if (w) w.textContent = String(windows.querySelectorAll(".window").length);
            if (d) d.textContent = String(desks.length);
            if (u) u.textContent = `${Math.max(1, Math.floor((Date.now() - OS_BOOT) / 60000))} 分钟`;
            const appsEl = win.querySelector("[data-mon-apps]");
            if (appsEl) {
              const list = Array.from(windows.querySelectorAll<HTMLElement>(".window")).map(
                (el) => APPS[el.dataset.app ?? ""]?.title ?? el.dataset.app ?? "",
              );
              appsEl.innerHTML = list.length
                ? list.map((t) => `<span class="mon-app-chip">${escapeHtml(t)}</span>`).join("")
                : `<span class="mon-note">暂无</span>`;
            }
          };
          const infoTimer = window.setInterval(update, 2000);
          update();
        };

        /* ---------------- 浏览器 ---------------- */
        const BROWSER_HISTORY_KEY = "guandao.os.browser.v1";

        const renderBrowser = () => `
          <div class="browser">
            <div class="browser-bar">
              <input class="browser-url" data-browser-url placeholder="输入网址或搜索关键词…" />
              <button class="browser-go" data-browser-go type="button">前往</button>
            </div>
            <div class="browser-home">
              <p class="browser-sec">快捷入口</p>
              <div class="browser-links">
                <a class="browser-link" href="/home/">我的博客</a>
                <a class="browser-link" href="/blog/">文章</a>
                <a class="browser-link" href="https://github.com/" target="_blank" rel="noreferrer">GitHub</a>
                <a class="browser-link" href="https://www.bilibili.com/" target="_blank" rel="noreferrer">Bilibili</a>
                <a class="browser-link" href="https://www.bing.com/" target="_blank" rel="noreferrer">必应</a>
              </div>
              <p class="browser-tip">外部网站会在新标签页打开，浏览器安全策略不允许嵌入第三方页面。</p>
            </div>
            <p class="browser-sec">历史记录</p>
            <div class="browser-history" data-browser-history></div>
          </div>`;

        const initBrowser = (win: HTMLElement) => {
          const urlEl = win.querySelector("[data-browser-url]") as HTMLInputElement | null;
          const historyEl = win.querySelector("[data-browser-history]");

          const readHistory = (): { url: string; at: number }[] => {
            try {
              return JSON.parse(localStorage.getItem(BROWSER_HISTORY_KEY) || "[]");
            } catch {
              return [];
            }
          };
          const paint = () => {
            if (!historyEl) return;
            const list = readHistory();
            historyEl.innerHTML = list.length
              ? list.map((h) => `<button class="browser-h-item" data-h="${escapeHtml(h.url)}">${escapeHtml(h.url)}</button>`).join("")
              : `<div class="browser-h-empty">暂无历史</div>`;
          };
          const go = (raw: string) => {
            const q = raw.trim();
            if (!q) return;
            const isUrl = /^(https?:\/\/)/i.test(q) || /^[\w-]+(\.[\w-]+)+/.test(q);
            const url = isUrl ? (/^https?:\/\//i.test(q) ? q : `https://${q}`) : `https://www.bing.com/search?q=${encodeURIComponent(q)}`;
            window.open(url, "_blank", "noreferrer");
            const list = readHistory();
            list.unshift({ url, at: Date.now() });
            try {
              localStorage.setItem(BROWSER_HISTORY_KEY, JSON.stringify(list.slice(0, 30)));
            } catch {
              /* 忽略 */
            }
            paint();
          };
          win.querySelector("[data-browser-go]")?.addEventListener("click", () => go(urlEl?.value ?? ""));
          urlEl?.addEventListener("keydown", (e) => {
            if (e.key === "Enter") go(urlEl.value);
          });
          historyEl?.addEventListener("click", (e) => {
            const b = (e.target as HTMLElement).closest("[data-h]");
            if (b) window.open(b.getAttribute("data-h") ?? "", "_blank", "noreferrer");
          });
          paint();
        };

        /** 1.9：应用可以声明 load()，只在用户真正打开时才下载它的模块 */
        type LazyAppModule = { body: () => string; init?: (win: HTMLElement) => void | (() => void) };
        type AppEntry = {
          title: string;
          width: number;
          height: number;
          body: () => string;
          glyph?: string;
          load?: () => Promise<LazyAppModule>;
        };

        const APPS: Record<string, AppEntry> = {
          terminal: { title: "终端", width: 560, height: 360, body: renderTerminal, glyph: "di-term" },
          settings: { title: "设置", width: 460, height: 470, body: renderSettings, glyph: "di-gear" },
          achievements: { title: "成就", width: 540, height: 476, body: renderAchievements, glyph: "di-ach" },
          aquarium: { title: "水族箱", width: 720, height: 480, body: renderAquarium, glyph: "di-tank" },
          visitors: { title: "访客墙", width: 640, height: 460, body: renderVisitors, glyph: "di-wall" },
          draw: { title: "每日抽奖", width: 440, height: 420, body: renderDraw, glyph: "di-draw" },
          council: { title: "议会", width: 600, height: 540, body: renderCouncil, glyph: "di-vote" },
          treehole: { title: "树洞", width: 560, height: 620, body: renderTreehole, glyph: "di-hole" },
          news: { title: "新闻联播", width: 500, height: 560, body: renderNews, glyph: "di-tv" },
          social: { title: "社会网络", width: 560, height: 600, body: renderSocial, glyph: "di-net" },
          monitor: { title: "系统监视器", width: 420, height: 500, body: renderMonitor, glyph: "di-mon" },
          browser: { title: "浏览器", width: 560, height: 480, body: renderBrowser, glyph: "di-browser" },
        };

        /* ---------------- 应用扩展点（1.4） ----------------
           生态应用由 src/lib/os14 注册进来，复用同一套窗口 / 焦点 / 最小化逻辑。
           这里只留最小的注册口与守卫，避免每个应用各写一套窗口管理。 */
        const APP_INIT: Record<string, (win: HTMLElement) => void | (() => void)> = {};
        const APP_GUARD = {
          blocked: (_id: string) => false,
          onBlocked: (_id: string) => undefined,
        };
        const EXT_WIDGETS: Record<string, { title: string; desc: string; body: () => string; init?: (el: HTMLElement) => void }> = {};
        let dockFilter: ((id: string) => boolean) | null = null;
        const beforeCloseHooks: Array<(win: HTMLElement) => void> = [];

        const registerApp = (spec: {
          id: string;
          title: string;
          width: number;
          height: number;
          glyph?: string;
          body?: () => string;
          init?: (win: HTMLElement) => void | (() => void);
          load?: () => Promise<LazyAppModule>;
        }) => {
          APPS[spec.id] = {
            title: spec.title,
            width: spec.width,
            height: spec.height,
            // 懒加载应用先给一个骨架，真实内容在窗口打开后填充
            body: spec.body ?? (() => loadingSkeleton(spec.title)),
            glyph: spec.glyph,
            load: spec.load,
          };
          if (spec.glyph) APP_ICON[spec.id] = spec.glyph;
          if (spec.init) APP_INIT[spec.id] = spec.init;
        };

        /** 懒加载应用等待时显示的骨架屏（真实 DOM，不闪白） */
        const loadingSkeleton = (title: string) => `
          <div class="g19-loading" data-g19-loading>
            <div class="g19-loading-bar"></div>
            <div class="g19-loading-bar is-short"></div>
            <p class="g19-loading-text">正在加载「${escapeHtml(title)}」…</p>
          </div>`;

        /* ---------------- 2.2 旧版应用注册 ---------------- */
        /* 已迁出的应用只在 src/lib/legacy-apps/ 里实现一份；
           这里把外壳能力显式传进去（这就是适配器），不暴露闭包。
           必须在 renderDock() 之前执行，否则程序坞会漏掉这些应用。 */
        registerLegacyApps({
          escapeHtml,
          data: DATA,
          fetchWithTimeout,
          register: registerApp,
        });

        /* ---------------- 窗口系统 ---------------- */

        const focusWin = (win: HTMLElement) => {
          win.style.zIndex = String(++zTop);
          windows.querySelectorAll(".window").forEach((el) => el.classList.toggle("is-front", el === win));
        };

        const closeWin = (win: HTMLElement) => {
          const closeStarted = performance.now();
          // 1.4：窗口级清理必须在移除 DOM 之前跑，游戏循环 / 计时器才能真的停
          try {
            win.dispatchEvent(new CustomEvent("guandao:before-close"));
            const cleanup = (win as unknown as { __gosCleanup?: () => void }).__gosCleanup;
            if (typeof cleanup === "function") cleanup();
            (win as unknown as { __gosCleanup?: () => void }).__gosCleanup = undefined;
            for (const hook of beforeCloseHooks) hook(win);
          } catch (err) {
            logDiagnostic({ scope: "window", code: "WINDOW_CLEANUP_FAILED", message: "窗口清理失败", error: err });
          }
          // 1.9：释放这个窗口登记过的所有资源（定时器 / 监听 / 观察器 / Object URL）
          try {
            releaseWindowScope(win);
          } catch (err) {
            logDiagnostic({ scope: "window", code: "SCOPE_DISPOSE_FAILED", message: "资源域释放失败", error: err });
          }
          win.classList.add("is-closing");
          const dockItem = document.querySelector(`.dock-item[data-app="${win.dataset.app}"]`);
          dockItem?.classList.remove("has-open", "has-hidden");
          window.setTimeout(() => {
            win.remove();
            saveWindows();
            recordAppMetric(win.dataset.app ?? "unknown", "close", performance.now() - closeStarted, true);
          }, 180);
        };

        /** 缩到 Dock 图标里，图标下方亮一个小点 */
        const minimizeWin = (win: HTMLElement) => {
          const dockItem = document.querySelector<HTMLElement>(`.dock-item[data-app="${win.dataset.app}"]`);

          if (dockItem) {
            const rect = win.getBoundingClientRect();
            const target = dockItem.getBoundingClientRect();
            const dx = target.left + target.width / 2 - (rect.left + rect.width / 2);
            const dy = target.top + target.height / 2 - (rect.top + rect.height / 2);

            win.style.transformOrigin = "center center";
            win.style.transform = `translate(${dx}px, ${dy}px) scale(0.06)`;

            dockItem.classList.remove("has-open");
            dockItem.classList.add("has-hidden");
          }

          win.classList.add("is-minimized");
          saveWindows();
        };

        const restoreWin = (win: HTMLElement) => {
          win.classList.remove("is-minimized");

          // 下一帧再清 transform，才有从 Dock 弹回来的动画
          window.requestAnimationFrame(() => {
            win.style.transform = "";
          });

          const dockItem = document.querySelector(`.dock-item[data-app="${win.dataset.app}"]`);
          dockItem?.classList.remove("has-hidden");
          dockItem?.classList.add("has-open");

          focusWin(win);
          saveWindows();
        };

        /* ---------------- 窗口最大化 / 调整大小 ---------------- */

        // 最大化前的几何位置，还原时用（仅当前会话内保留）
        const preMax = new WeakMap<HTMLElement, { left: string; top: string; width: string; height: string }>();

        const MIN_W = 320;
        const MIN_H = 240;

        const maximizeWin = (win: HTMLElement) => {
          if (win.classList.contains("is-maximized")) return;
          preMax.set(win, {
            left: win.style.left,
            top: win.style.top,
            width: win.style.width,
            height: win.style.height,
          });
          win.classList.add("is-maximized");
          win.style.left = "0px";
          win.style.top = "0px";
          win.style.width = "100%";
          win.style.height = "100%";
          saveWindows();
        };

        const restoreMax = (win: HTMLElement) => {
          if (!win.classList.contains("is-maximized")) return;
          const prev = preMax.get(win);
          win.classList.remove("is-maximized");
          if (prev) {
            win.style.left = prev.left;
            win.style.top = prev.top;
            win.style.width = prev.width;
            win.style.height = prev.height;
          } else {
            const app = APPS[win.dataset.app ?? ""];
            win.style.width = `${app?.width ?? 520}px`;
            win.style.height = `${app?.height ?? 380}px`;
          }
          saveWindows();
        };

        const toggleMaximize = (win: HTMLElement) => {
          if (win.classList.contains("is-maximized")) restoreMax(win);
          else maximizeWin(win);
        };

        const bindResize = (win: HTMLElement) => {
          const handle = win.querySelector<HTMLElement>(".resize-handle");
          if (!handle) return;

          let startX = 0;
          let startY = 0;
          let startW = 0;
          let startH = 0;
          // 1.9：拖动缩放时把写样式合并到一帧一次。pointermove 频率可能高于刷新率，
          // 直接写 width/height 会每个事件都触发布局（forced layout）。
          let resizeX = 0;
          let resizeY = 0;
          let resizeFrame = 0;

          const flushResize = () => {
            resizeFrame = 0;
            win.style.width = `${resizeX}px`;
            win.style.height = `${resizeY}px`;
          };

          const onMove = (event: PointerEvent) => {
            resizeX = Math.max(MIN_W, startW + event.clientX - startX);
            resizeY = Math.max(MIN_H, startH + event.clientY - startY);
            if (!resizeFrame) resizeFrame = window.requestAnimationFrame(flushResize);
          };

          const onUp = () => {
            win.classList.remove("is-resizing");
            if (resizeFrame) {
              window.cancelAnimationFrame(resizeFrame);
              resizeFrame = 0;
            }
            // resizeX 为 0 表示这次按下后没有真正拖动，不要写回 0 宽
            if (resizeX > 0) flushResize();
            window.removeEventListener("pointermove", onMove);
            window.removeEventListener("pointerup", onUp);
            window.removeEventListener("pointercancel", onUp);
            saveWindows();
          };

          handle.addEventListener("pointerdown", (event) => {
            if (win.classList.contains("is-maximized")) return;
            event.preventDefault();
            event.stopPropagation();
            startX = event.clientX;
            startY = event.clientY;
            startW = win.offsetWidth;
            startH = win.offsetHeight;
            win.classList.add("is-resizing");
            window.addEventListener("pointermove", onMove);
            window.addEventListener("pointerup", onUp);
            window.addEventListener("pointercancel", onUp);
          });
        };

        /* ---------------- 窗口贴靠 Snap ---------------- */

        const snapPreview = document.getElementById("snap-preview");

        /* 手机「桌面模式」：屏宽只有几百像素，窗口必须接近满宽才可用 */
        const phoneDesktopMode = () =>
          document.body.classList.contains("is-touch-desktop") && window.innerWidth <= 720;

        // 计算当前指针指向的贴靠区域（null 表示不贴靠）
        const snapZone = (x: number, y: number) => {
          const W = window.innerWidth;
          const H = window.innerHeight;
          const EDGE = 26;
          const CORNER = 48;
          const TOP = 42;
          let zone: string | null = null;
          if (x < CORNER && y < TOP) zone = "tl";
          else if (x > W - CORNER && y < TOP) zone = "tr";
          else if (x < CORNER && y > H - 60) zone = "bl";
          else if (x > W - CORNER && y > H - 60) zone = "br";
          else if (x < EDGE) zone = "left";
          else if (x > W - EDGE) zone = "right";
          else if (y < TOP) zone = "full";
          // 手机桌面模式下左右半屏只有 190px 宽，吸过去反而不可用，只保留全屏吸附
          if (zone && zone !== "full" && phoneDesktopMode()) return null;
          return zone;
        };

        // 贴靠目标矩形（桌面坐标，顶栏下方）
        const snapRect = (zone: string) => {
          const W = window.innerWidth;
          const H = window.innerHeight - 36;
          const halfW = W / 2;
          const halfH = H / 2;
          switch (zone) {
            case "left":
              return { x: 0, y: 0, w: halfW, h: H };
            case "right":
              return { x: halfW, y: 0, w: halfW, h: H };
            case "full":
              return { x: 0, y: 0, w: W, h: H };
            case "tl":
              return { x: 0, y: 0, w: halfW, h: halfH };
            case "tr":
              return { x: halfW, y: 0, w: halfW, h: halfH };
            case "bl":
              return { x: 0, y: halfH, w: halfW, h: halfH };
            case "br":
              return { x: halfW, y: halfH, w: halfW, h: halfH };
            default:
              return null;
          }
        };

        const showSnapPreview = (zone: string | null) => {
          if (!snapPreview) return;
          const r = zone ? snapRect(zone) : null;
          if (!r) {
            snapPreview.hidden = true;
            return;
          }
          snapPreview.style.left = `${r.x}px`;
          snapPreview.style.top = `${r.y + 36}px`;
          snapPreview.style.width = `${r.w}px`;
          snapPreview.style.height = `${r.h}px`;
          snapPreview.hidden = false;
        };

        const hideSnapPreview = () => {
          if (snapPreview) snapPreview.hidden = true;
        };

        const applySnap = (win: HTMLElement, zone: string) => {
          const r = snapRect(zone);
          if (!r) return;
          if (zone === "full") {
            maximizeWin(win);
            return;
          }
          win.classList.remove("is-maximized");
          win.style.left = `${r.x}px`;
          win.style.top = `${r.y}px`;
          win.style.width = `${r.w}px`;
          win.style.height = `${r.h}px`;
        };

        /* ---------------- 通用指针拖拽 ----------------
           1. 4~5px 阈值：轻点不会把元素挪走，也不会误触发
           2. setPointerCapture：手指滑出元素/窗口边界也不断线
           3. 拖动用 transform 跟随（GPU 合成，不触发布局），松手才写回 left/top
           4. pointercancel 兜底，不会卡在「拖动中」状态 */
        interface DragOptions {
          threshold?: number;
          ignore?: string;
          canStart?: () => boolean;
          clamp: (x: number, y: number) => { x: number; y: number };
          onStart?: (event: PointerEvent) => void;
          onMove?: (event: PointerEvent, pos: { x: number; y: number }) => void;
          onEnd?: (moved: boolean) => void;
        }

        const makeDraggable = (handle: HTMLElement, target: HTMLElement, opts: DragOptions) => {
          let active = false;
          let moved = false;
          let pointerId = -1;
          let startX = 0;
          let startY = 0;
          let lastX = 0;
          let lastY = 0;
          let baseX = 0;
          let baseY = 0;

          const onMove = (event: PointerEvent) => {
            if (!active || event.pointerId !== pointerId) return;
            lastX = event.clientX;
            lastY = event.clientY;
            const dx = lastX - startX;
            const dy = lastY - startY;
            if (!moved) {
              if (Math.hypot(dx, dy) < (opts.threshold ?? 4)) return;
              moved = true;
              target.classList.add("is-dragging");
            }
            const p = opts.clamp(baseX + dx, baseY + dy);
            target.style.transform = `translate3d(${p.x - baseX}px, ${p.y - baseY}px, 0)`;
            opts.onMove?.(event, p);
          };

          const finish = (event: PointerEvent) => {
            if (!active) return;
            active = false;
            if (pointerId >= 0) {
              try {
                handle.releasePointerCapture(pointerId);
              } catch {
                /* 指针已释放 */
              }
            }
            window.removeEventListener("pointermove", onMove);
            window.removeEventListener("pointerup", finish);
            window.removeEventListener("pointercancel", finish);

            if (moved) {
              // pointercancel 的坐标可能是 0，退回最后一次有效位置
              const dx = (event.type === "pointercancel" ? lastX : event.clientX) - startX;
              const dy = (event.type === "pointercancel" ? lastY : event.clientY) - startY;
              const p = opts.clamp(baseX + dx, baseY + dy);
              // 先落位再清 transform，避免松手瞬间闪一下
              target.style.left = `${p.x}px`;
              target.style.top = `${p.y}px`;
              target.style.transform = "";
              // 下一帧才解除 dragging：这一帧里 transition 仍是 none，
              // 否则 transform 复位会被 window 的过渡动画播一遍
              window.requestAnimationFrame(() => target.classList.remove("is-dragging"));
            } else {
              target.style.transform = "";
              target.classList.remove("is-dragging");
            }
            opts.onEnd?.(moved);
            moved = false;
            pointerId = -1;
          };

          handle.addEventListener("pointerdown", (event) => {
            if (opts.ignore && (event.target as HTMLElement).closest(opts.ignore)) return;
            if (opts.canStart && !opts.canStart()) return;
            if (event.button > 0) return;
            event.preventDefault();

            active = true;
            moved = false;
            pointerId = event.pointerId;
            startX = lastX = event.clientX;
            startY = lastY = event.clientY;
            baseX = target.offsetLeft;
            baseY = target.offsetTop;
            try {
              handle.setPointerCapture(pointerId);
            } catch {
              /* 某些环境不支持捕获，退回 window 监听 */
            }
            window.addEventListener("pointermove", onMove);
            window.addEventListener("pointerup", finish);
            window.addEventListener("pointercancel", finish);
            opts.onStart?.(event);
          });
        };

        const bindDrag = (win: HTMLElement) => {
          const bar = win.querySelector(".titlebar") as HTMLElement | null;
          if (!bar) return;

          let snapTarget: string | null = null;
          let allowSnap = true;

          makeDraggable(bar, win, {
            threshold: 4,
            ignore: ".dot",
            canStart: () => !win.classList.contains("is-maximized"),
            clamp: (x, y) => {
              // 手机桌面模式窗口接近满宽，左边界不允许拖出屏幕，
              // 否则标题栏上的三个按钮会被推出可视区
              const phone = phoneDesktopMode();
              return {
                x: Math.max(phone ? 0 : -40, Math.min(window.innerWidth - 140, x)),
                y: Math.max(phone ? 36 : 32, Math.min(window.innerHeight - 110, y)),
              };
            },
            onStart: (event) => {
              // 只有鼠标才参与贴边吸附：手指往上滑一点就触发全屏，手感很差
              // 平板允许手指拖到边缘贴靠；鼠标始终允许。
              allowSnap =
                event.pointerType === "mouse" ||
                document.documentElement.dataset.shell === "tablet";
            },
            onMove: (event) => {
              if (!allowSnap) return;
              snapTarget = snapZone(event.clientX, event.clientY);
              showSnapPreview(snapTarget);
            },
            onEnd: (moved) => {
              if (moved && snapTarget) applySnap(win, snapTarget);
              hideSnapPreview();
              snapTarget = null;
              if (moved) saveWindows();
            },
          });

          bar.addEventListener("dblclick", (event) => {
            if ((event.target as HTMLElement).closest(".dot")) return;
            toggleMaximize(win);
          });
        };

        /* 手机「桌面模式」下的窗口摆放：屏幕只有几百像素宽，
           窗口按接近满宽打开才有可用性，靠纵向错位体现是多个窗口 */
        const placePhoneDesktopWin = (
          win: HTMLElement,
          app: { width: number; height: number },
          step: number,
          saved?: { width?: number; height?: number },
        ) => {
          const vw = window.innerWidth;
          const vh = window.innerHeight;
          const top = 44 + (step % 4) * 32;
          const w = Math.min(Math.max(saved?.width ?? app.width, 240), vw - 24);
          const maxH = vh - top - 36 - 96; // 36 状态栏 + 96 程序坞
          const h = Math.min(saved?.height ?? app.height, maxH);
          win.style.width = `${w}px`;
          // 极矮的屏幕上宁可比 240 更矮，也不要顶出屏幕
          win.style.height = `${Math.max(Math.min(240, maxH), h)}px`;
          win.style.left = "12px";
          win.style.right = "auto";
          win.style.top = `${top}px`;
        };

        /* ---------------- 应用挂载（1.9：按需加载 + 错误隔离） ---------------- */

        /**
         * 把应用内容挂进已经创建好的窗口。
         * - 有 load()：先渲染骨架，模块到齐后替换并初始化；
         * - 无 load()：同步渲染 + 初始化；
         * - 任何一步失败都只影响这个窗口，并给出可操作的崩溃卡片。
         */
        const mountApp = (win: HTMLElement, id: string) => {
          const app = APPS[id];
          if (!app) return;
          if (win.dataset.mounting === "1") return;

          const bodyHost = win.querySelector<HTMLElement>(".win-body");
          const started = performance.now();
          const mountScope = trackWindowScope(win, `app:${id}`);

          const runInit = () => {
            const init = APP_INIT[id];
            if (init) {
              try {
                const cleanup = init(win);
                if (typeof cleanup === "function") {
                  (win as unknown as { __gosCleanup?: () => void }).__gosCleanup = cleanup;
                }
              } catch (err) {
                logDiagnostic({
                  scope: `app:${id}`,
                  code: "APP_INIT_FAILED",
                  message: `应用「${app.title}」初始化失败`,
                  error: err,
                });
                showAppCrash(win, id, "初始化时出错", "界面已经画出来了，但绑定交互时失败了。可以重新加载这个应用。");
                recordAppMetric(id, "open", performance.now() - started, false);
                return;
              }
              recordAppMetric(id, "open", performance.now() - started, true);
              return;
            }
            // 1.0–1.3 的旧应用：每个 init 都在这里按 id 分派
            // 2.2 已迁出 rank / calc / viewer：它们的 init 由 registerLegacyApps 注册进 APP_INIT，
            // 走上面的 `const init = APP_INIT[id]` 分支，不再出现在这张表里。
            const legacyInit: Record<string, ((w: HTMLElement) => void) | undefined> = {
              terminal: initTerminal,
              settings: initSettings,
              aquarium: initAquarium,
              visitors: initVisitors,
              draw: initDraw,
              council: initCouncil,
              treehole: initTreehole,
              news: initNews,
              social: initSocial,
              monitor: initMonitor,
              browser: initBrowser,
            };
            const legacy = legacyInit[id];
            try {
              legacy?.(win);
              recordAppMetric(id, "open", performance.now() - started, true);
            } catch (err) {
              logDiagnostic({
                scope: `app:${id}`,
                code: "APP_INIT_FAILED",
                message: `应用「${app.title}」初始化失败`,
                error: err,
              });
              showAppCrash(win, id, "初始化时出错", "界面已经画出来了，但绑定交互时失败了。可以重新加载这个应用。");
              recordAppMetric(id, "open", performance.now() - started, false);
            }
          };

          if (!app.load) {
            runInit();
            return;
          }

          // 懒加载：先给骨架，模块到了再替换
          win.dataset.mounting = "1";
          if (bodyHost) bodyHost.innerHTML = loadingSkeleton(app.title);
          mountScope.timeout(() => {
            // 兜底：12 秒还没加载完，明确告诉用户，而不是永远转圈
            if (win.dataset.mounting === "1" && win.isConnected) {
              delete win.dataset.mounting;
              showAppCrash(win, id, "加载超时", "应用代码在 12 秒内没有下载完成，可能是网络很慢。可以点击重试。");
            }
          }, 12000);

          void app
            .load()
            .then((mod) => {
              delete win.dataset.mounting;
              if (!win.isConnected) return; // 加载期间窗口已被关闭，不再渲染
              app.body = mod.body;
              if (mod.init) APP_INIT[id] = mod.init;
              const html = boundary({ scope: `app:${id}`, code: "APP_RENDER_FAILED" }, () => mod.body(), "");
              if (!html) {
                showAppCrash(win, id, "渲染失败", "应用模块加载成功，但生成界面时出错。");
                recordAppMetric(id, "open", performance.now() - started, false);
                return;
              }
              if (bodyHost) bodyHost.innerHTML = html;
              runInit();
            })
            .catch((err) => {
              delete win.dataset.mounting;
              logDiagnostic({
                scope: `app:${id}`,
                code: "APP_CHUNK_FAILED",
                message: `应用「${app.title}」的代码加载失败`,
                error: err,
              });
              showAppCrash(
                win,
                id,
                "应用加载失败",
                "这个应用的代码没能下载下来，可能是网络中断或部署刚更新。重试通常就能解决。",
              );
              recordAppMetric(id, "open", performance.now() - started, false);
            });
        };

        /** 崩溃占位：说明发生了什么、数据在哪、可以点哪里恢复 */
        const showAppCrash = (win: HTMLElement, id: string, title: string, message: string) => {
          const host = win.querySelector<HTMLElement>(".win-body");
          if (!host) return;
          const app = APPS[id];
          host.innerHTML = crashCardHtml({
            title: `${app?.title ?? id} · ${title}`,
            message,
            hint: "这个窗口之外的一切都还在正常运行。",
          });
          host.querySelector("[data-g19-retry]")?.addEventListener("click", (event) => {
            event.stopPropagation();
            if (win.dataset.mounting === "1") return;
            host.innerHTML = loadingSkeleton(app?.title ?? id);
            mountApp(win, id);
          });
          host.querySelector("[data-g19-close]")?.addEventListener("click", (event) => {
            event.stopPropagation();
            closeWin(win);
          });
          host.querySelector("[data-g19-diag]")?.addEventListener("click", (event) => {
            event.stopPropagation();
            openApp("diagnostics");
          });
        };

        const openApp = (id: string) => {
          const app = APPS[id];
          if (!app) return;

          // 1.4：未安装的应用不允许被图标 / 搜索直接启动
          if (APP_GUARD.blocked(id)) {
            APP_GUARD.onBlocked(id);
            return;
          }

          const existing = windows.querySelector(`.window[data-app="${id}"]`) as HTMLElement | null;
          if (existing) {
            // 窗口在另一个工作区：先切过去，再还原 / 聚焦
            const inSpace = Number(existing.dataset.space) || 1;
            if (inSpace !== currentSpace) switchSpace(inSpace);
            if (existing.classList.contains("is-minimized")) restoreWin(existing);
            else focusWin(existing);
            return;
          }

          hint?.classList.add("is-gone");

          const win = document.createElement("div");
          win.className = "window";
          win.dataset.app = id;
          win.dataset.space = String(currentSpace);

          const step = cascade++;
          const offset = (step % 5) * 26;
          // 手机上「桌面模式」开启时，按真正的桌面窗口来摆放，而非强制全宽
          const touchDesktop = document.body.classList.contains("is-touch-desktop");
          const narrow = window.innerWidth <= 720 && !touchDesktop;
          const saved = readState().windows?.[id];

          if (saved?.space) win.dataset.space = String(saved.space);

          const shellMode = document.documentElement.dataset.shell;

          if (shellMode === "tablet") {
            // 平板：接近全屏但不铺满，保留可以点到的桌面边缘与 Dock。
            const vw = window.innerWidth;
            const vh = window.innerHeight;
            const w = Math.min(saved?.width ?? app.width, vw - 32, 1180);
            const h = Math.min(Math.max(saved?.height ?? app.height, 640), vh - 132);
            win.style.width = `${Math.max(320, w)}px`;
            win.style.height = `${Math.max(280, h)}px`;
            win.style.left = `${Math.round((vw - Math.max(320, w)) / 2)}px`;
            win.style.top = `${Math.min(58 + (step % 2) * 10, Math.max(58, vh - h - 116))}px`;
          } else {
            win.style.width = `${saved?.width ?? app.width}px`;
            win.style.height = `${saved?.height ?? app.height}px`;

            if (narrow) {
              // 紧凑模式：位置固定，不要级联偏移，否则窗口会一路往下跑
              win.style.top = "110px";
            } else if (phoneDesktopMode()) {
              placePhoneDesktopWin(win, app, step, saved);
            } else if (saved) {
              // 沿用上次的位置，越界就拉回可视范围
              win.style.left = `${Math.max(-40, Math.min(window.innerWidth - 140, saved.left))}px`;
              win.style.top = `${Math.max(32, Math.min(window.innerHeight - 110, saved.top))}px`;
            } else {
              win.style.left = `${Math.max(16, (window.innerWidth - app.width) / 2 + offset - 60)}px`;
              // 矮屏（横屏手机）没有多余的纵向空间，窗口贴着状态栏往下排
              win.style.top = `${Math.max(52, window.innerHeight < 520 ? 48 : 96 + offset)}px`;
            }
          }

          /* 统一收口：窗口不能超出可视区。
             横屏手机只有 390px 高，按默认高度开出来会顶到屏幕外。 */
          const winTop = Number.parseFloat(win.style.top) || 0;
          const maxH = window.innerHeight - 36 - winTop - 88;
          const curH = Number.parseFloat(win.style.height) || 0;
          if (maxH >= 120 && curH > maxH) win.style.height = `${maxH}px`;
          const curW = Number.parseFloat(win.style.width) || 0;
          if (curW > window.innerWidth - 24) win.style.width = `${window.innerWidth - 24}px`;

          // 1.9：懒加载应用先显示骨架，模块到了再渲染；已加载过的直接复用缓存
          const lazyLoad = app.load;
          let bodyHtml = "";
          if (lazyLoad) {
            bodyHtml = loadingSkeleton(app.title);
          } else {
            try {
              bodyHtml = app.body();
            } catch (err) {
              logDiagnostic({
                scope: `app:${id}`,
                code: "APP_RENDER_FAILED",
                message: `应用「${app.title}」渲染失败`,
                error: err,
              });
              bodyHtml = crashCardHtml({
                title: `「${app.title}」没有正常加载`,
                message: "这个应用在生成界面时出错了。其它应用不受影响。",
                hint: "本地数据仍然保留，可以先重试，或关闭这个窗口。",
              });
            }
          }

          win.innerHTML = `
            <div class="titlebar">
              <span class="dots">
                <button class="dot dot-close" type="button" aria-label="关闭"></button>
                <button class="dot dot-min" type="button" aria-label="收起"></button>
                <button class="dot dot-max" type="button" aria-label="最大化"></button>
              </span>
              <span class="win-title">${escapeHtml(app.title)}</span>
            </div>
            <div class="win-body" data-app-body="${id}">${bodyHtml}</div>
            <span class="resize-handle" aria-hidden="true"></span>`;

          windows.appendChild(win);
          focusWin(win);
          bindDrag(win);
          bindResize(win);
          refreshSpaceVisibility();

          // 上次关闭时是最大化，就原样恢复到全屏
          if (saved?.maximized && !narrow) {
            win.classList.add("is-maximized");
            win.style.left = "0px";
            win.style.top = "0px";
            win.style.width = "100%";
            win.style.height = "100%";
          }

          document.querySelector(`.dock-item[data-app="${id}"]`)?.classList.add("has-open");
          saveWindows();

          // 1.4：打开次数用于应用中心的「热门」排序（真实使用记录）
          try {
            (window as unknown as { GOS14?: { onOpen?: (id: string) => void } }).GOS14?.onOpen?.(id);
            window.dispatchEvent(new CustomEvent("guandao:app-open", { detail: { id } }));
          } catch {
            /* 忽略 */
          }

          // 1.3：记录最近打开，供「最近打开」组件使用
          try {
            const recent = JSON.parse(localStorage.getItem("guandao.os.recent") || "[]") as string[];
            const next = [id, ...recent.filter((x) => x !== id)].slice(0, 6);
            localStorage.setItem("guandao.os.recent", JSON.stringify(next));
          } catch {
            /* 忽略 */
          }
          document.querySelectorAll("[data-widget]").forEach((w) => {
            if (w.getAttribute("data-widget") === "recent") renderWidget("recent");
          });

          // 成就：记录打开过哪些应用，全部打开过就是「桌面漫游者」
          const achState = readAch();
          if (!achState.apps.includes(id)) {
            achState.apps.push(id);
            saveAch(achState);
          }
          const ALL_APPS = [
            "posts",
            "about",
            "music",
            "terminal",
            "settings",
            "achievements",
            "aquarium",
            "visitors",
            "rank",
            "draw",
            "council",
            "treehole",
            "news",
            "social",
          ];
          if (ALL_APPS.every((app) => achState.apps.includes(app))) unlock("roam");

          win.querySelector(".dot-close")?.addEventListener("click", () => closeWin(win));
          win.querySelector(".dot-min")?.addEventListener("click", () => minimizeWin(win));
          win.querySelector(".dot-max")?.addEventListener("click", () => toggleMaximize(win));
          win.addEventListener("pointerdown", () => focusWin(win));

          mountApp(win, id);
        };

        /* ---------------- 统一诊断中心 ---------------- */

        /* ---------------- 终端 ---------------- */

        const initTerminal = (win: HTMLElement) => {
          const out = win.querySelector("#term-out") as HTMLElement | null;
          const input = win.querySelector("#term-input") as HTMLInputElement | null;
          if (!out || !input) return;

          const print = (text: string, className = "") => {
            const line = document.createElement("p");
            line.className = `term-line ${className}`.trim();
            line.textContent = text;
            out.appendChild(line);
            out.scrollTop = out.scrollHeight;
          };

          const COMMANDS = [
            "help",
            "ls",
            "open",
            "whoami",
            "date",
            "time",
            "version",
            "apps",
            "theme",
            "wallpaper",
            "neofetch",
            "matrix",
            "echo",
            "about",
            "clear",
            "exit",
          ];

          const history: string[] = [];
          let historyIdx = -1;

          const neofetch = () => {
            const art = [
              "   ██████╗  ",
              "  ██╔════╝  ",
              "  ██║  ███╗ ",
              "  ██║   ██║ ",
              "  ╚██████╔╝ ",
              "   ╚═════╝  ",
            ];
            const info = [
              `${DATA.site.author}@guandao.xin`,
              "-----------------",
              "OS: Guandao OS 2.0 (The Platform Era)",
              "引擎: Astro 静态渲染",
              `运行窗口: ${windows.querySelectorAll(".window").length}`,
              `虚拟桌面: ${desks.length}`,
              `已开启: ${Math.max(1, Math.floor((Date.now() - OS_BOOT) / 60000))} 分钟`,
            ];
            for (let i = 0; i < Math.max(art.length, info.length); i++) {
              print(`${art[i] ?? "          "}  ${info[i] ?? ""}`, "term-ok");
            }
          };

          const matrix = () => {
            const chars = "アイウエオカキクケコサシスセソ01";
            for (let r = 0; r < 8; r++) {
              let line = "";
              for (let c = 0; c < 34; c++) line += chars[Math.floor(Math.random() * chars.length)];
              print(line, "term-matrix");
            }
          };

          const run = (raw: string) => {
            const cmd = raw.trim();
            if (!cmd) return;
            unlock("hack");
            history.push(cmd);
            historyIdx = history.length;
            print(`~ $ ${cmd}`, "term-echo");

            const [name, ...rest] = cmd.split(/\s+/);
            const arg = rest.join(" ");
            switch (name) {
              case "help":
                print("ls / open <n>   列出并打开文章");
                print("whoami / about  关于我");
                print("apps            全部应用");
                print("theme <dark|light>  切换外观");
                print("wallpaper <nebula|dusk|deep>  换壁纸");
                print("date / time     当前时间");
                print("version         系统版本");
                print("neofetch        系统信息");
                print("matrix          黑客帝国");
                print("echo <文本>     回声");
                print("clear / exit    清空 / 关闭");
                break;
              case "ls":
                DATA.posts.forEach((post: any, index: number) => print(`${String(index + 1).padStart(2, "0")}  ${post.title}`));
                break;
              case "open": {
                const index = Number(rest[0]) - 1;
                const post = DATA.posts[index];
                if (!post) {
                  print("没有这一篇，先用 ls 看看。", "term-error");
                  break;
                }
                print(`正在打开：${post.title}`);
                window.location.href = post.href;
                break;
              }
              case "whoami":
              case "about":
                print(`${DATA.site.author} · 大连理工大学 · 智能制造`);
                break;
              case "date":
                print(new Date().toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric", weekday: "long" }));
                break;
              case "time":
                print(new Date().toLocaleTimeString("zh-CN", { hour12: false }));
                break;
              case "version":
                print("Guandao OS 2.0 · The Platform Era", "term-accent");
                break;
              case "apps":
                print(Object.values(APPS).map((a) => a.title).join("  "), "term-accent");
                break;
              case "theme": {
                const t = arg === "light" ? "light" : "dark";
                applyOsTheme(t);
                print(`已切换到${t === "light" ? "浅色" : "深色"}模式。`, "term-ok");
                break;
              }
              case "wallpaper": {
                const w = ["nebula", "dusk", "deep"].includes(arg) ? arg : "nebula";
                os.dataset.wall = w;
                writeState({ wall: w });
                print(`壁纸已切换：${w}`, "term-ok");
                break;
              }
              case "neofetch":
                neofetch();
                break;
              case "matrix":
                matrix();
                break;
              case "echo":
                print(arg);
                break;
              case "clear":
                out.innerHTML = "";
                break;
              case "exit":
                closeWin(win);
                break;
              default: {
                // 1.4：生态层的隐藏命令交给 os14 处理，未命中再报未知命令
                const hook = (window as unknown as { GOS14?: { terminal?: (cmd: string) => string | null } }).GOS14;
                const extra = hook?.terminal?.(name);
                if (extra) print(extra, "term-accent");
                else print(`未知命令：${name}，试试 help`, "term-error");
              }
            }
          };

          input.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
              run(input.value);
              input.value = "";
            } else if (event.key === "ArrowUp") {
              event.preventDefault();
              if (history.length) {
                historyIdx = Math.max(0, historyIdx - 1);
                input.value = history[historyIdx] ?? "";
              }
            } else if (event.key === "ArrowDown") {
              event.preventDefault();
              if (history.length) {
                historyIdx = Math.min(history.length, historyIdx + 1);
                input.value = history[historyIdx] ?? "";
              }
            } else if (event.key === "Tab") {
              event.preventDefault();
              const v = input.value.trim();
              const hit = COMMANDS.filter((c) => c.startsWith(v));
              if (hit.length === 1) input.value = hit[0] + " ";
              else if (hit.length > 1) print(hit.join("  "), "term-muted");
            }
          });

          // preventScroll：否则浏览器会把 overflow:hidden 的桌面容器整体滚上去
          input.focus({ preventScroll: true });
        };

        /* ---------------- 设置 ---------------- */

        const initSettings = (win: HTMLElement) => {
          win.querySelectorAll<HTMLButtonElement>(".wall-pick").forEach((button) => {
            button.addEventListener("click", () => {
              const wall = button.dataset.wall ?? "nebula";
              os.dataset.wall = wall;
              writeState({ wall });
              win.querySelectorAll(".wall-pick").forEach((el) => el.classList.toggle("is-active", el === button));
            });
          });

          // 外观主题
          win.querySelectorAll<HTMLButtonElement>(".theme-pick").forEach((button) => {
            button.addEventListener("click", () => {
              applyOsTheme(button.dataset.themePick ?? "dark");
              win.querySelectorAll(".theme-pick").forEach((el) => el.classList.toggle("is-active", el === button));
            });
          });

          // 程序坞勾选：改完立刻重建
          win.querySelectorAll<HTMLInputElement>("[data-dock]").forEach((box) => {
            box.addEventListener("change", () => {
              const picked = Array.from(win.querySelectorAll<HTMLInputElement>("[data-dock]"))
                .filter((el) => el.checked)
                .map((el) => el.dataset.dock ?? "")
                .filter(Boolean);
              saveDock(picked);
              renderDock();
            });
          });

          // 壁纸随昼夜变化
          win.querySelector<HTMLInputElement>("#opt-auto-wall")?.addEventListener("change", (e) => {
            const on = (e.target as HTMLInputElement).checked;
            writeState({ autoWall: on });
            if (on) os.dataset.autoWall = "1";
            else delete os.dataset.autoWall;
            applyTimeWallpaper();
          });

          // 桌面图标 / 宠物显示
          const iconsEl = document.querySelector<HTMLElement>(".desk-icons");
          const petEl = document.getElementById("desk-pet");
          win.querySelector<HTMLInputElement>("#opt-show-icons")?.addEventListener("change", (e) => {
            const on = (e.target as HTMLInputElement).checked;
            writeState({ showIcons: on });
            if (iconsEl) iconsEl.hidden = !on;
          });
          win.querySelector<HTMLInputElement>("#opt-show-pet")?.addEventListener("change", (e) => {
            const on = (e.target as HTMLInputElement).checked;
            writeState({ showPet: on });
            if (petEl) petEl.hidden = !on;
          });

          // 减少动态效果
          win.querySelector<HTMLInputElement>("#opt-reduce-motion")?.addEventListener("change", (e) => {
            const on = (e.target as HTMLInputElement).checked;
            writeState({ reduceMotion: on });
            document.body.classList.toggle("os-reduce-motion", on);
          });

          // 桌面小组件开关（统一的 setWidgetEnabled，手机卡片选择器会同步）
          win.querySelectorAll<HTMLInputElement>("[data-widget-toggle]").forEach((box) => {
            box.addEventListener("change", () => {
              setWidgetEnabled(box.dataset.widgetToggle ?? "", box.checked);
            });
          });
          // 在手机卡片选择器里改过之后，回到设置面板要显示最新状态
          const syncWidgetBoxes = () => {
            win.querySelectorAll<HTMLInputElement>("[data-widget-toggle]").forEach((box) => {
              box.checked = widgetOn(box.dataset.widgetToggle ?? "");
            });
          };
          window.addEventListener("guandao:widgets-change", syncWidgetBoxes);

          // 数据管理
          win.querySelector("#data-export")?.addEventListener("click", exportData);
          win.querySelector("#data-reset")?.addEventListener("click", () => {
            if (window.confirm("确定清空本机所有 Guandao 数据并恢复默认吗？此操作不可撤销。")) resetAllData();
          });
          win.querySelector("#data-import")?.addEventListener("click", () => {
            const input = document.createElement("input");
            input.type = "file";
            input.accept = "application/json";
            input.onchange = () => {
              if (input.files?.[0]) importData(input.files[0]);
            };
            input.click();
          });
        };

        /* ---------------- 入口 ---------------- */

        // 用事件委托，程序坞重建后不用重新绑定
        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          // 窗口本身也带 data-app，窗口内部的点击不能再走一遍 openApp，
          // 否则点「收起」时会被随后的 openApp 立刻还原
          if (target.closest(".window")) return;
          const trigger = target.closest<HTMLElement>("[data-app]");
          if (!trigger) return;
          const id = trigger.dataset.app;
          if (!id) return;
          // 1.9：记录从图标 / 程序坞到窗口出现的真实响应时间
          const started = performance.now();
          openApp(id);
          if (trigger.classList.contains("dock-item")) {
            recordAppMetric(id, "dock", performance.now() - started, true);
          }
        });

        // 登录 / 注册表单在各个窗口里都可能出现，统一在 document 层处理
        document.addEventListener("submit", async (event) => {
          const form = (event.target as HTMLElement).closest("[data-auth]");
          if (!form) return;
          event.preventDefault();

          const win = form.closest(".window") as HTMLElement | null;
          if (win) await runAuth(win, "in");
        });

        document.addEventListener("click", async (event) => {
          const btn = (event.target as HTMLElement).closest("[data-auth-signup]");
          if (!btn) return;

          const win = btn.closest(".window") as HTMLElement | null;
          if (win) await runAuth(win, "up");
        });

        // 按保存的配置重建程序坞
        renderDock();

        /* Dock 放大效果由 1.3 的 dock 引擎（src/lib/os13.ts）统一提供：
           它读取用户设置里的放大倍数与尺寸，并处理左/右停靠。
           1.0 这里曾经也挂过一套 pointermove 放大，两套同时写 transform，
           每移动一次要跑两遍 getBoundingClientRect，属于纯浪费，1.9 已删除。 */

        // 支持 guandao.xin/#council 这种直达
        const openFromHash = () => {
          const id = location.hash.replace(/^#/, "");
          if (id && APPS[id]) openApp(id);
        };
        openFromHash();
        window.addEventListener("hashchange", openFromHash);

        /* ---------------- 桌面宠物 ---------------- */

        const pet = document.getElementById("desk-pet");
        const petSay = document.getElementById("pet-say");

        if (pet && petSay) {
          const LINES = [
            "别戳，在摸鱼",
            "今天吃白饭了吗",
            "我不是胖，是圆",
            "窗口可以拖，试试",
            "这个桌面还行吧",
          ];

          let sayTimer: number | undefined;

          const say = (text: string) => {
            petSay.textContent = text;
            petSay.classList.add("show");
            window.clearTimeout(sayTimer);
            sayTimer = window.setTimeout(() => petSay.classList.remove("show"), 2400);
          };

          makeDraggable(pet, pet, {
            threshold: 4,
            clamp: (x, y) => ({
              x: Math.max(0, Math.min(window.innerWidth - 110, x)),
              y: Math.max(34, Math.min(window.innerHeight - 150, y)),
            }),
            onEnd: (moved) => {
              if (moved) {
                // 拖过之后改用 left/top 定位，免得和 right/bottom 打架
                pet.style.right = "auto";
                pet.style.bottom = "auto";
                return;
              }
              // 没拖动 = 点了一下，说句话并记一次互动
              say(LINES[Math.floor(Math.random() * LINES.length)]);

              const ach = readAch();
              ach.petClicks += 1;
              saveAch(ach);
              if (ach.petClicks >= 10) unlock("rice");
            },
          });
        }

        // 成就：翻过三篇文章就记一笔（跳转前写入，来不及弹提示，静默解锁）
        windows.addEventListener("click", (event) => {
          const row = (event.target as HTMLElement).closest(".file-row");
          if (!row) return;

          const ach = readAch();
          ach.reads += 1;
          saveAch(ach);
          if (ach.reads >= 3) unlock("reader", true);
        });

        /* ---------------- 宠物换装 ---------------- */

        const OUTFIT_MAP: Record<string, string> = {
          白T恤: "/pet/tshirt.webp",
          连帽卫衣: "/pet/hoodie.webp",
          小西装: "/pet/suit.webp",
          睡衣: "/pet/pajamas.webp",
          泳装: "/pet/swimsuit.webp",
          浴衣: "/pet/yukata.webp",
          水手服: "/pet/uniform.webp",
          "原版（深蓝裙）": "/pet/whale-girl.webp",
        };

        // 议会里「大肥鱼穿什么」票数最高的那项决定穿哪套
        const applyOutfit = async () => {
          const img = document.querySelector<HTMLImageElement>(".pet-img");
          if (!img) return;

          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          if (!sb?.url || !sb?.key) return;

          try {
            const headers = { apikey: sb.key, Authorization: `Bearer ${sb.key}` };

            const pRes = await fetchWithTimeout(
              `${sb.url}/rest/v1/polls?select=id,options&kind=eq.outfit&active=eq.true&limit=1`,
              { headers },
            );
            if (!pRes.ok) return;

            const polls = (await pRes.json()) as Array<{ id: string; options: string[] }>;
            if (!polls.length) return;

            const poll = polls[0];
            const vRes = await fetchWithTimeout(
              `${sb.url}/rest/v1/votes?select=option_index&poll_id=eq.${poll.id}`,
              { headers },
            );
            if (!vRes.ok) return;

            const votes = (await vRes.json()) as Array<{ option_index: number }>;
            if (!votes.length) return;

            const counts = poll.options.map(
              (_, i) => votes.filter((v) => v.option_index === i).length,
            );
            const max = Math.max(...counts);
            if (max === 0) return;

            const label = poll.options[counts.indexOf(max)];
            // 选项文字里的空格可能被省略，两种写法都认
            const src = OUTFIT_MAP[label] ?? OUTFIT_MAP[label.replace(/\s+/g, "")];
            if (!src) return;

            img.src = src;
            img.alt = `鲸鲸穿着${label}`;

            const host = document.getElementById("desk-pet");
            if (host) host.title = `今天穿：${label}（议会投票结果）`;
          } catch {
            /* 拿不到就保持默认那套 */
          }
        };

        window.setTimeout(() => void applyOutfit(), 1600);

        /* ---------------- 菜单栏：时间 / 菜单 / 通知入口 ---------------- */

        const mbTime = document.getElementById("mb-time");
        const mbDate = document.getElementById("mb-date");
        const clockDate = document.getElementById("clock-date");
        const clockTime = document.getElementById("clock-time");
        const clockMsg = document.getElementById("clock-msg");
        const clockPanel = document.getElementById("clock-panel");
        const timeBtn = document.getElementById("mb-time-btn");
        const notifCenter = document.getElementById("notif-center");
        const bell = document.getElementById("mb-bell");
        const pad = (n: number) => String(n).padStart(2, "0");

        const PHASE_LABEL: Record<string, string> = {
          dawn: "清晨 · 新的一天",
          day: "白天 · 精力满满",
          dusk: "傍晚 · 该歇一歇了",
          night: "深夜 · 早点休息",
        };

        const tickClock = () => {
          const now = new Date();
          const hh = pad(now.getHours());
          const mm = pad(now.getMinutes());
          // 2.0：系统设置里的「时钟显示秒」直接作用于菜单栏时钟
          const withSeconds = document.documentElement.dataset.clockSeconds === "1";
          if (mbTime) mbTime.textContent = withSeconds ? `${hh}:${mm}:${pad(now.getSeconds())}` : `${hh}:${mm}`;
          if (clockTime) clockTime.textContent = `${hh}:${mm}:${pad(now.getSeconds())}`;

          const dateLabel = now.toLocaleDateString("zh-CN", { month: "long", day: "numeric", weekday: "short" });
          if (mbDate) mbDate.textContent = dateLabel;
          if (clockDate)
            clockDate.textContent = now.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
              weekday: "long",
            });
          if (clockMsg) clockMsg.textContent = PHASE_LABEL[phaseNow()] ?? "";
        };

        tickClock();
        window.setInterval(tickClock, 1000);

        /* ---- 外观主题 ---- */
        const THEME_KEY = "guandao.os.theme";
        try {
          if (localStorage.getItem(THEME_KEY) === "light") document.body.dataset.osTheme = "light";
        } catch {}

        /* ---- 手机端桌面模式（持久化） ---- */
        const MOBILE_DESKTOP_KEY = "guandao.os.mobileDesktop";
        const applyMobileDesktop = (on: boolean) => {
          document.body.classList.toggle("is-touch-desktop", on);
          const btn = document.getElementById("mb-desktop-toggle") as HTMLButtonElement | null;
          if (btn) {
            btn.setAttribute("aria-pressed", on ? "true" : "false");
            const txt = btn.querySelector<HTMLElement>(".mbdt-text");
            if (txt) txt.textContent = on ? "标准模式" : "桌面模式";
            btn.title = on ? "已开启桌面模式 · 点此切回手机布局" : "切换为桌面布局";
          }
        };
        try {
          if (localStorage.getItem(MOBILE_DESKTOP_KEY) === "1") applyMobileDesktop(true);
        } catch {}

        /* 切换布局模式后，重新摆放已打开的窗口 */
        const relayoutWindows = () => {
          const phoneDesktop = phoneDesktopMode();
          const narrow = window.innerWidth <= 720 && !phoneDesktop;
          let i = 0;
          windows.querySelectorAll<HTMLElement>(".window").forEach((win) => {
            if (win.classList.contains("is-maximized")) return;
            const app = APPS[win.dataset.app ?? ""];
            if (!app) return;
            if (narrow) {
              win.style.left = "8px";
              win.style.right = "8px";
              win.style.top = "110px";
            } else if (phoneDesktop) {
              // 切到桌面模式时把窗口按新规则重摆一遍，越界的自然回位
              placePhoneDesktopWin(win, app, i);
            } else {
              const offset = (i % 5) * 26;
              win.style.left = `${Math.max(16, (window.innerWidth - app.width) / 2 + offset - 60)}px`;
              win.style.top = `${Math.max(52, 96 + offset)}px`;
              win.style.right = "auto";
            }
            i++;
          });
        };

        /* 桌面模式开关 */
        const desktopToggle = document.getElementById("mb-desktop-toggle") as HTMLButtonElement | null;
        desktopToggle?.addEventListener("click", (event) => {
          event.stopPropagation();
          const on = !document.body.classList.contains("is-touch-desktop");
          applyMobileDesktop(on);
          try {
            localStorage.setItem(MOBILE_DESKTOP_KEY, on ? "1" : "0");
          } catch {}
          relayoutWindows();
          // 两套布局的图标列数、卡片堆叠都不一样，切完重新算一遍
          window.setTimeout(() => window.dispatchEvent(new Event("resize")), 40);
          pushNotif({
            icon: on ? "🖥" : "📱",
            title: on ? "桌面模式已开启" : "已切回手机布局",
            body: on ? "现在以桌面形态呈现，可自由拖动、缩放窗口。" : "已恢复紧凑的手机布局。",
          });
        });

        /* 手机端汉堡菜单（紧凑模式下替代顶部菜单） */
        const mobileMenuBtn = document.getElementById("mb-mobile-menu") as HTMLButtonElement | null;
        const mobilePanel = document.getElementById("mb-mobile-panel");
        const closeMobilePanel = () => {
          if (mobilePanel) mobilePanel.hidden = true;
          mobileMenuBtn?.setAttribute("aria-expanded", "false");
        };
        mobileMenuBtn?.addEventListener("click", (event) => {
          event.stopPropagation();
          if (!mobilePanel) return;
          const show = mobilePanel.hidden;
          mobilePanel.hidden = !show;
          mobileMenuBtn.setAttribute("aria-expanded", show ? "true" : "false");
        });
        const applyOsTheme = (theme: string) => {
          document.body.dataset.osTheme = theme;
          try {
            localStorage.setItem(THEME_KEY, theme);
          } catch {}
        };
        const toggleOsTheme = () => {
          const next = document.body.dataset.osTheme === "light" ? "dark" : "light";
          applyOsTheme(next);
          pushNotif({ icon: "◐", title: "外观已切换", body: next === "light" ? "已切换到浅色模式。" : "已切换到深色模式。" });
        };

        /* ---- 下拉菜单 ---- */
        const closeMenus = () => {
          document.querySelectorAll<HTMLElement>(".mb-dropdown").forEach((p) => (p.hidden = true));
          document.querySelectorAll<HTMLElement>(".mb-menu-btn").forEach((b) => b.classList.remove("is-open"));
        };

        document.querySelectorAll<HTMLElement>(".mb-menu-btn").forEach((btn) => {
          btn.addEventListener("click", (event) => {
            event.stopPropagation();
            const name = btn.dataset.menuBtn;
            const panel = document.querySelector<HTMLElement>(`[data-menu-panel="${name}"]`);
            const wasOpen = panel ? !panel.hidden : false;
            closeMenus();
            if (panel && !wasOpen) {
              panel.hidden = false;
              btn.classList.add("is-open");
            }
          });

          // 已有菜单展开时，移入其它菜单直接切换
          btn.addEventListener("mouseenter", () => {
            const anyOpen = document.querySelector<HTMLElement>(".mb-dropdown:not([hidden])");
            if (!anyOpen) return;
            const name = btn.dataset.menuBtn;
            const panel = document.querySelector<HTMLElement>(`[data-menu-panel="${name}"]`);
            if (panel && panel.hidden) {
              closeMenus();
              panel.hidden = false;
              btn.classList.add("is-open");
            }
          });
        });

        document.addEventListener("click", (event) => {
          if (!(event.target as HTMLElement).closest(".mb-menu-item")) closeMenus();
        });

        /* ---- 菜单动作 ---- */
        const WALLS = ["nebula", "dusk", "deep"];

        const nextWallpaper = () => {
          const cur = os.dataset.wall ?? "nebula";
          const next = WALLS[(WALLS.indexOf(cur) + 1) % WALLS.length];
          os.dataset.wall = next;
          writeState({ wall: next });
        };

        const resetLayout = () => {
          windows.querySelectorAll<HTMLElement>(".window").forEach((w) => w.remove());
          desks = defaultDesks();
          writeState({ windows: {}, wall: "nebula", space: 1, desks });
          try {
            localStorage.removeItem(DOCK_KEY);
          } catch {}
          renderDock();
          os.dataset.wall = "nebula";
          applySpace(1);
          pushNotif({ icon: "↺", title: "桌面已重置", body: "窗口位置、虚拟桌面与程序坞配置已恢复默认。" });
        };

        const minimizeAll = () =>
          windows.querySelectorAll<HTMLElement>(".window:not(.is-minimized)").forEach(minimizeWin);
        const restoreAll = () =>
          windows.querySelectorAll<HTMLElement>(".window.is-minimized").forEach(restoreWin);
        const closeAll = () => windows.querySelectorAll<HTMLElement>(".window").forEach(closeWin);

        const toggleFullscreen = () => {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen?.().catch(() => undefined);
          } else {
            document.exitFullscreen?.().catch(() => undefined);
          }
        };

        /* ---------------- 启动台（全屏应用网格） ---------------- */
        const launchpad = document.getElementById("launchpad");
        const lpGrid = document.getElementById("lp-grid");
        const lpClose = document.getElementById("lp-close");

        const LP_ORDER_KEY = "guandao.os.lp.order.v1";
        const LP_HIDDEN_KEY = "guandao.os.lp.hidden.v1";
        const LP_LONGPRESS = 420;
        let lpOrder: string[] = [];
        let lpHidden: string[] = [];
        let lpEditing = false;
        let lpDidDrag = false;
        let lpDragEl: HTMLElement | null = null;
        let lpPlaceholder: HTMLElement | null = null;
        let lpDragFromEdit = false;
        let lpGrabX = 0, lpGrabY = 0;
        let lpLongTimer: number | null = null;
        let lpStartX = 0, lpStartY = 0;
        let lpPointerY = 0;
        let lpScrollRaf = 0;
        const lpDone = document.getElementById("lp-done");
        const lpReset = document.getElementById("lp-reset");
        const lpHint = document.getElementById("lp-hint");

        try { lpOrder = JSON.parse(localStorage.getItem(LP_ORDER_KEY) || "[]"); } catch {}
        try { lpHidden = JSON.parse(localStorage.getItem(LP_HIDDEN_KEY) || "[]"); } catch {}

        const persistLpOrder = () => { try { localStorage.setItem(LP_ORDER_KEY, JSON.stringify(lpOrder)); } catch {} };
        const persistLpHidden = () => { try { localStorage.setItem(LP_HIDDEN_KEY, JSON.stringify(lpHidden)); } catch {} };

        const orderedApps = (): string[] => {
          const ids = Object.keys(APPS).filter((id) => APPS[id] && APPS[id].title);
          const seen = new Set<string>();
          const out: string[] = [];
          for (const id of lpOrder) if (ids.includes(id) && !seen.has(id)) { out.push(id); seen.add(id); }
          for (const id of ids) if (!seen.has(id)) out.push(id);
          return out.filter((id) => !lpHidden.includes(id));
        };

        const fillLaunchpad = () => {
          if (!lpGrid) return;
          lpGrid.innerHTML = orderedApps()
            .map((id, i) => {
              const icon = APP_ICON[id] ?? "di-folder";
              return `<button class="lp-icon" type="button" data-app="${id}" data-idx="${i}">
                <span class="lp-remove" aria-label="从启动台移除">✕</span>
                <span class="di-glyph ${icon}"></span>
                <span class="lp-label">${APPS[id].title}</span>
              </button>`;
            })
            .join("");
        };
        fillLaunchpad();

        const exitEditMode = () => {
          lpEditing = false;
          launchpad?.classList.remove("lp-editing");
          if (lpDone) lpDone.hidden = true;
          if (lpReset) lpReset.hidden = true;
          if (lpHint) lpHint.hidden = true;
        };

        const enterEditMode = () => {
          if (lpEditing) return;
          lpEditing = true;
          launchpad?.classList.add("lp-editing");
          if (lpDone) lpDone.hidden = false;
          if (lpReset) lpReset.hidden = false;
          if (lpHint) lpHint.hidden = false;
        };

        const closeLaunchpad = () => {
          if (!launchpad) return;
          exitEditMode();
          launchpad.hidden = true;
          launchpad.setAttribute("aria-hidden", "true");
        };

        const openLaunchpad = () => {
          if (!launchpad) return;
          closeMenus();
          closeMobilePanel();
          fillLaunchpad();
          launchpad.hidden = false;
          launchpad.setAttribute("aria-hidden", "false");
          layoutLaunchpad();
        };

        const resetLpDragEl = () => {
          if (!lpDragEl) return;
          lpDragEl.classList.remove("lp-dragging");
          lpDragEl.style.position = "";
          lpDragEl.style.left = lpDragEl.style.top = lpDragEl.style.width = lpDragEl.style.height = "";
          lpDragEl.style.zIndex = lpDragEl.style.pointerEvents = "";
        };

        const onLpMove = (e: PointerEvent) => {
          if (!lpDragEl || !lpPlaceholder || !lpGrid) return;
          lpPointerY = e.clientY;
          lpDragEl.style.left = `${e.clientX - lpGrabX}px`;
          lpDragEl.style.top = `${e.clientY - lpGrabY}px`;
          const siblings = Array.from(lpGrid.querySelectorAll<HTMLElement>(".lp-icon:not(.lp-dragging)"));
          const pKey = Math.round(e.clientY) * 10000 + Math.round(e.clientX);
          let ref: HTMLElement | null = null;
          for (const s of siblings) {
            const r = s.getBoundingClientRect();
            const key = Math.round(r.top + r.height / 2) * 10000 + Math.round(r.left + r.width / 2);
            if (pKey < key) { ref = s; break; }
          }
          if (ref) lpGrid.insertBefore(lpPlaceholder, ref);
          else lpGrid.appendChild(lpPlaceholder);
        };

        const onLpUp = () => {
          document.removeEventListener("pointermove", onLpMove);
          document.removeEventListener("pointercancel", onLpUp);
          document.removeEventListener("touchmove", lpBlockScroll);
          if (lpScrollRaf) {
            cancelAnimationFrame(lpScrollRaf);
            lpScrollRaf = 0;
          }
          if (lpDragEl && lpPlaceholder) {
            lpPlaceholder.parentNode?.insertBefore(lpDragEl, lpPlaceholder);
            lpPlaceholder.remove();
            resetLpDragEl();
            lpOrder = Array.from(lpGrid?.querySelectorAll<HTMLElement>(".lp-icon") ?? []).map((el) => el.dataset.app ?? "");
            persistLpOrder();
          }
          lpDragEl = null;
          lpPlaceholder = null;
          lpDragFromEdit = false;
        };

        // 拖动期间禁止原生滚动：手指一动页面就跟着走，图标会「粘」在原地
        const lpBlockScroll = (e: TouchEvent) => {
          if (lpDragEl) e.preventDefault();
        };

        // 拖到屏幕上下边缘时自动滚一屏，手机上才能把图标移到看不见的位置
        const lpAutoScroll = () => {
          if (!lpDragEl || !launchpad) {
            lpScrollRaf = 0;
            return;
          }
          const r = launchpad.getBoundingClientRect();
          const edge = 96;
          let dv = 0;
          if (lpPointerY < r.top + edge) dv = -Math.ceil((r.top + edge - lpPointerY) / 7);
          else if (lpPointerY > r.bottom - edge) dv = Math.ceil((lpPointerY - (r.bottom - edge)) / 7);
          if (dv) launchpad.scrollTop += dv;
          lpScrollRaf = requestAnimationFrame(lpAutoScroll);
        };

        const beginLpDrag = (iconEl: HTMLElement, ev: PointerEvent) => {
          if (!lpGrid || lpDragEl) return;
          lpDidDrag = true;
          const rect = iconEl.getBoundingClientRect();
          lpGrabX = ev.clientX - rect.left;
          lpGrabY = ev.clientY - rect.top;
          const ph = document.createElement("div");
          ph.className = "lp-icon lp-ph";
          ph.style.width = `${rect.width}px`;
          ph.style.height = `${rect.height}px`;
          iconEl.parentNode?.insertBefore(ph, iconEl);
          iconEl.classList.add("lp-dragging");
          iconEl.style.position = "fixed";
          iconEl.style.width = `${rect.width}px`;
          iconEl.style.height = `${rect.height}px`;
          iconEl.style.left = `${rect.left}px`;
          iconEl.style.top = `${rect.top}px`;
          iconEl.style.zIndex = "300";
          iconEl.style.pointerEvents = "none";
          lpDragEl = iconEl;
          lpPlaceholder = ph;
          lpPointerY = ev.clientY;
          document.addEventListener("pointermove", onLpMove);
          document.addEventListener("pointerup", onLpUp, { once: true });
          document.addEventListener("pointercancel", onLpUp, { once: true });
          document.addEventListener("touchmove", lpBlockScroll, { passive: false });
          if (!lpScrollRaf) lpScrollRaf = requestAnimationFrame(lpAutoScroll);
        };

        if (lpGrid) {
          // 触摸屏：手指按下不能立刻进入拖动，否则想往下滑一屏时会先拖走图标。
          // 规则改成「长按 420ms 才拖」，手指只要先动起来就判定为滚动并彻底放弃拖动。
          lpGrid.addEventListener("pointerdown", (event) => {
            if (lpDragEl) return;
            const target = event.target as HTMLElement;
            if (target.closest(".lp-remove")) return;
            const icon = target.closest<HTMLElement>(".lp-icon");
            if (!icon) return;
            const startIcon = icon;
            // 只有手指需要「长按才拖」；鼠标和触控笔仍然按下即拖
            const touch = event.pointerType === "touch";
            lpDidDrag = false;
            lpStartX = event.clientX;
            lpStartY = event.clientY;
            let moved = false;

            const cleanup = () => {
              if (lpLongTimer) {
                clearTimeout(lpLongTimer);
                lpLongTimer = null;
              }
              document.removeEventListener("pointermove", onMove);
              document.removeEventListener("pointerup", cleanup);
              document.removeEventListener("pointercancel", cleanup);
            };

            const onMove = (e: PointerEvent) => {
              const dist = Math.hypot(e.clientX - lpStartX, e.clientY - lpStartY);
              if (touch) {
                // 超过 10px 就是滑动手势，直接收工，交给浏览器滚动
                if (dist > 10) cleanup();
                return;
              }
              if (moved) return;
              if (dist > 8) {
                moved = true;
                cleanup();
                beginLpDrag(startIcon, e);
              }
            };

            lpLongTimer = window.setTimeout(() => {
              lpLongTimer = null;
              document.removeEventListener("pointermove", onMove);
              document.removeEventListener("pointerup", cleanup);
              document.removeEventListener("pointercancel", cleanup);
              if (touch) navigator.vibrate?.(12);
              enterEditMode();
              beginLpDrag(startIcon, event);
            }, LP_LONGPRESS);

            // 鼠标 / 触控笔保留「按下即可拖」的桌面手感
            if (!touch) event.preventDefault();
            document.addEventListener("pointermove", onMove);
            document.addEventListener("pointerup", cleanup, { once: true });
            document.addEventListener("pointercancel", cleanup, { once: true });
          });

          lpGrid.addEventListener("click", (event) => {
            const rm = (event.target as HTMLElement).closest(".lp-remove");
            if (rm) {
              const icon = rm.closest<HTMLElement>(".lp-icon");
              const id = icon?.dataset.app;
              if (id && !lpHidden.includes(id)) { lpHidden.push(id); persistLpHidden(); fillLaunchpad(); }
              return;
            }
            if (lpDidDrag) { lpDidDrag = false; return; }
            if (lpEditing) return;
            const btn = (event.target as HTMLElement).closest<HTMLElement>("[data-app]");
            if (!btn) return;
            openApp(btn.dataset.app ?? "");
            closeLaunchpad();
          });
        }

        if (lpDone) lpDone.addEventListener("click", exitEditMode);
        if (lpReset) lpReset.addEventListener("click", () => {
          lpOrder = [];
          lpHidden = [];
          persistLpOrder();
          persistLpHidden();
          fillLaunchpad();
          exitEditMode();
        });
        if (lpClose) lpClose.addEventListener("click", closeLaunchpad);
        if (launchpad) {
          launchpad.addEventListener("click", (event) => {
            if (event.target === launchpad) closeLaunchpad();
          });
        }
        document.addEventListener("click", (event) => {
          if ((event.target as HTMLElement).closest("[data-launchpad]")) openLaunchpad();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && launchpad && !launchpad.hidden) closeLaunchpad();
        });

        const runMenuAction = (action: string) => {
          closeMenus();
          closeMobilePanel();
          switch (action) {
            case "mission":
              openMission();
              break;
            case "posts":
              openApp("posts");
              break;
            case "terminal":
              openApp("terminal");
              break;
            case "settings":
              openApp("settings");
              break;
            case "shutdown":
              shutdown();
              break;
            case "reset":
              resetLayout();
              break;
            case "wallpaper":
              nextWallpaper();
              break;
            case "theme":
              toggleOsTheme();
              break;
            case "fullscreen":
              toggleFullscreen();
              break;
            case "shell-auto":
              setPreference("auto");
              break;
            case "shell-desktop":
              setPreference("desktop");
              break;
            case "shell-tablet":
              setPreference("tablet");
              break;
            case "shell-mobile":
              setPreference("mobile");
              break;
            case "minimize-all":
              minimizeAll();
              break;
            case "restore-all":
              restoreAll();
              break;
            case "close-all":
              closeAll();
              break;
            case "search":
              openSpot();
              break;
            case "launchpad":
              openLaunchpad();
              break;
            case "appcenter":
            case "community":
            case "themes":
            case "widgetstore":
            case "playground":
            case "workspaces":
            case "tasks":
            case "continuity":
            case "control":
            case "datacenter":
            case "perflab":
            case "diagnostics":
              openApp(action);
              break;
          }
        };

        document.querySelectorAll<HTMLElement>("[data-menu-action]").forEach((el) => {
          el.addEventListener("click", () => runMenuAction(el.dataset.menuAction ?? ""));
        });

        /* ---- 时钟面板 ---- */
        timeBtn?.addEventListener("click", (event) => {
          event.stopPropagation();
          if (clockPanel) clockPanel.hidden = !clockPanel.hidden;
          if (powerMenu) powerMenu.hidden = true;
          if (notifCenter) notifCenter.hidden = true;
        });

        /* ---- 通知中心入口（内容逻辑见下方「通知中心」） ---- */
        bell?.addEventListener("click", (event) => {
          event.stopPropagation();
          if (notifCenter) {
            notifCenter.hidden = !notifCenter.hidden;
            if (!notifCenter.hidden) markNotifsRead();
          }
          if (clockPanel) clockPanel.hidden = true;
          if (powerMenu) powerMenu.hidden = true;
        });

        document.addEventListener("click", (event) => {
          const t = event.target as HTMLElement;
          if (clockPanel && !t.closest("#mb-time-btn") && !t.closest("#clock-panel")) clockPanel.hidden = true;
          if (notifCenter && !t.closest("#mb-bell") && !t.closest("#notif-center")) notifCenter.hidden = true;
          if (mobilePanel && !mobilePanel.hidden && !t.closest("#mb-mobile-menu") && !t.closest("#mb-mobile-panel"))
            closeMobilePanel();
        });

        /* ---------------- 电源 ---------------- */

        const powerBtn = document.getElementById("mb-power");
        const powerMenu = document.getElementById("power-menu");
        const powerScreen = document.getElementById("power-screen");
        const powerHint = document.getElementById("power-hint");

        const setHint = (text: string) => {
          if (powerHint) powerHint.textContent = text;
        };

        const screenOn = () => {
          if (!powerScreen) return;
          powerScreen.hidden = false;
          window.requestAnimationFrame(() => powerScreen.classList.add("is-on"));
        };

        const shutdown = () => {
          unlock("power");
          setHint("");
          screenOn();
          window.setTimeout(() => {
            setHint("已关机 · 点一下开机");
            // 黑屏铺满后再藏起桌面，避免 Dock 的毛玻璃层叠上来透出轮廓
            os.classList.add("is-off");
          }, 700);
        };

        const restart = () => {
          setHint("正在重新启动…");
          screenOn();
          window.setTimeout(() => window.location.reload(), 1000);
        };

        powerBtn?.addEventListener("click", (event) => {
          event.stopPropagation();
          if (powerMenu) powerMenu.hidden = !powerMenu.hidden;
        });

        powerMenu?.querySelectorAll<HTMLButtonElement>("[data-power]").forEach((button) => {
          button.addEventListener("click", () => {
            if (powerMenu) powerMenu.hidden = true;
            if (button.dataset.power === "restart") restart();
            if (button.dataset.power === "shutdown") shutdown();
          });
        });

        document.addEventListener("click", () => {
          if (powerMenu) powerMenu.hidden = true;
        });

        powerScreen?.addEventListener("click", () => {
          os.classList.remove("is-off");
          powerScreen.classList.remove("is-on");
          window.setTimeout(() => {
            powerScreen.hidden = true;
            setHint("");
          }, 620);
        });

        // 恢复上次的外观设置（壁纸 / 主题 / 图标 / 宠物 / 动效）
        const savedWall = readState().wall;
        if (savedWall) os.dataset.wall = savedWall;

        (() => {
          const st = readState();
          if (st.showIcons === false) {
            document.querySelector<HTMLElement>(".desk-icons")?.setAttribute("hidden", "");
          }
          if (st.showPet === false) {
            document.getElementById("desk-pet")?.setAttribute("hidden", "");
          }
          if (st.reduceMotion === true) {
            document.body.classList.add("os-reduce-motion");
          }
          renderSpaces();
          if (st.space) applySpace(st.space);
          if (st.autoWall === true) {
            os.dataset.autoWall = "1";
          }
          applyTimeWallpaper();
          // 开着页面跨时段时，自动壁纸也跟上
          window.setInterval(applyTimeWallpaper, 60_000);
        })();

        /* ---------------- 成就初始化 ---------------- */

        // 等开机动画结束再弹，免得和 logo 叠在一起
        window.setTimeout(() => {
          const state = readAch();
          state.visits += 1;
          saveAch(state);

          unlock("first");

          const hour = new Date().getHours();
          if (hour < 5) unlock("night");
          else if (hour < 7) unlock("dawn");

          if (state.visits >= 5) unlock("regular");

          // 通知中心：首次欢迎 + 博客概览 + 每日提醒
          seedNotifications();
        }, 2200);

        // 有名字就每 60 秒报一次停留时长，只在前台时算
        // 2.2：请求实现来自 legacy-apps/leaderboard/report.ts，和排行榜窗口共用一份
        const rankUser = localStorage.getItem(RANK_NAME_KEY);
        if (rankUser) {
          const reportRankTime = createRankReporter(DATA.supabase, fetchWithTimeout);
          window.setInterval(() => {
            if (document.visibilityState === "visible") void reportRankTime(rankUser, 60);
          }, 60_000);
        }

        /* ---------------- Spotlight 全局搜索 ---------------- */

        const spotlightEl = document.getElementById("spotlight");
        const spotInput = document.getElementById("spotlight-input") as HTMLInputElement | null;
        const spotResults = document.getElementById("spotlight-results");

        interface SpotItem {
          title: string;
          subtitle: string;
          kind: string;
          action: () => void;
        }

        const spotIndex = (): SpotItem[] => {
          const items: SpotItem[] = [];
          for (const [id, app] of Object.entries(APPS)) {
            items.push({ title: app.title, subtitle: "应用", kind: "应用", action: () => openApp(id) });
          }
          for (const post of DATA.posts) {
            items.push({ title: post.title, subtitle: `文章 · ${post.date}`, kind: "文章", action: () => { location.href = post.href; } });
          }
          const settings: [string, () => void][] = [
            ["切换深色 / 浅色", () => toggleOsTheme()],
            ["更换壁纸", () => nextWallpaper()],
            ["导出数据备份", () => exportData()],
            ["重置桌面布局", () => resetLayout()],
            ["打开设置", () => openApp("settings")],
          ];
          for (const [label, fn] of settings) {
            items.push({ title: label, subtitle: "系统设置", kind: "设置", action: fn });
          }
          return items;
        };

        let spotItems: SpotItem[] = [];
        let spotActive = 0;

        const renderSpot = () => {
          if (!spotResults) return;
          if (!spotItems.length) {
            spotResults.innerHTML = `<div class="spot-empty">没有找到「${escapeHtml(spotInput?.value ?? "")}」</div>`;
            return;
          }
          spotResults.innerHTML = spotItems
            .map(
              (it, i) => `
                <button class="spot-item ${i === spotActive ? "is-active" : ""}" data-i="${i}">
                  <span class="spot-kind">${escapeHtml(it.kind)}</span>
                  <span class="spot-main">
                    <span class="spot-title">${escapeHtml(it.title)}</span>
                    <span class="spot-sub">${escapeHtml(it.subtitle)}</span>
                  </span>
                  <span class="spot-enter">↵</span>
                </button>`,
            )
            .join("");
        };

        const spotRefresh = () => {
          const q = (spotInput?.value ?? "").trim().toLowerCase();
          const all = spotIndex();
          spotItems = (q ? all.filter((i) => (i.title + i.subtitle).toLowerCase().includes(q)) : all).slice(0, 12);
          spotActive = 0;
          renderSpot();
        };

        const openSpot = () => {
          if (!spotlightEl) return;
          spotlightEl.hidden = false;
          if (spotInput) spotInput.value = "";
          spotRefresh();
          spotInput?.focus();
        };

        const closeSpot = () => {
          if (spotlightEl) spotlightEl.hidden = true;
          spotInput?.blur();
        };

        const spotChoose = (i: number) => {
          const it = spotItems[i];
          if (!it) return;
          closeSpot();
          it.action();
        };

        spotInput?.addEventListener("input", spotRefresh);
        spotInput?.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            spotActive = Math.min(spotActive + 1, spotItems.length - 1);
            renderSpot();
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            spotActive = Math.max(spotActive - 1, 0);
            renderSpot();
          } else if (e.key === "Enter") {
            e.preventDefault();
            spotChoose(spotActive);
          } else if (e.key === "Escape") {
            e.preventDefault();
            closeSpot();
          }
        });
        spotResults?.addEventListener("click", (e) => {
          const b = (e.target as HTMLElement).closest<HTMLElement>(".spot-item");
          if (b) spotChoose(Number(b.dataset.i));
        });
        spotlightEl?.addEventListener("click", (e) => {
          if (e.target === spotlightEl) closeSpot();
        });

        document.addEventListener("keydown", (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            if (spotlightEl?.hidden) openSpot();
            else closeSpot();
          }
          if (e.key === "Escape" && spotlightEl && !spotlightEl.hidden) closeSpot();
        });

        /* ---------------- Mission Control 任务视图 ---------------- */

        const missionEl = document.getElementById("mission");
        const missionGrid = document.getElementById("mission-grid");
        const missionDesks = document.getElementById("mission-desks");

        const renderMissionDesks = () => {
          if (!missionDesks) return;
          missionDesks.innerHTML =
            desks
              .map((d) => {
                const count = windows.querySelectorAll(`.window[data-space="${d.id}"]`).length;
                return `<button class="mc-desk ${d.id === currentSpace ? "is-active" : ""}" data-desk="${d.id}">
                  <span class="mc-desk-name">${escapeHtml(d.name)}</span>
                  <span class="mc-desk-count">${count} 窗口</span>
                </button>`;
              })
              .join("") +
            `<button class="mc-desk mc-desk-add" data-desk-add title="新建桌面" ${desks.length >= 4 ? "disabled" : ""}>＋</button>`;
        };

        const renderMission = () => {
          if (!missionGrid) return;
          renderMissionDesks();
          const wins = Array.from(windows.querySelectorAll<HTMLElement>(".window"));
          if (!wins.length) {
            missionGrid.innerHTML = `<div class="mc-empty">还没有打开的窗口。<br/>双击桌面图标，或从程序坞启动应用。</div>`;
            return;
          }
          missionGrid.innerHTML = wins
            .map((w) => {
              const id = w.dataset.app ?? "";
              const app = APPS[id];
              const glyph = app?.glyph ?? "di-folder";
              const title = app?.title ?? id;
              const inOther = Number(w.dataset.space) !== currentSpace;
              return `
                <div class="mc-card ${inOther ? "is-other" : ""}" data-app="${id}" data-space="${w.dataset.space}">
                  <div class="mc-card-bar">
                    <span class="mc-dots"><i></i><i></i><i></i></span>
                    <span class="mc-card-title">${escapeHtml(title)}</span>
                    <button class="mc-card-close" data-close="${id}" title="关闭">×</button>
                  </div>
                  <div class="mc-card-body"><span class="mc-glyph di-glyph ${glyph}"></span></div>
                  <span class="mc-card-space">${escapeHtml(desks.find((d) => d.id === Number(w.dataset.space))?.name ?? "")}</span>
                </div>`;
            })
            .join("");
        };

        const openMission = () => {
          if (!missionEl) return;
          renderMission();
          missionEl.hidden = false;
        };
        const closeMission = () => {
          if (missionEl) missionEl.hidden = true;
        };

        missionGrid?.addEventListener("click", (e) => {
          const closeBtn = (e.target as HTMLElement).closest<HTMLElement>("[data-close]");
          if (closeBtn) {
            const id = closeBtn.dataset.close;
            const w = windows.querySelector<HTMLElement>(`.window[data-app="${id}"]`);
            if (w) closeWin(w);
            window.setTimeout(renderMission, 200);
            return;
          }
          const card = (e.target as HTMLElement).closest<HTMLElement>(".mc-card");
          if (card) {
            const id = card.dataset.app ?? "";
            const space = Number(card.dataset.space);
            if (space !== currentSpace) switchSpace(space);
            closeMission();
            window.setTimeout(() => {
              const w = windows.querySelector<HTMLElement>(`.window[data-app="${id}"]`);
              if (w) {
                if (w.classList.contains("is-minimized")) restoreWin(w);
                else focusWin(w);
              }
            }, 280);
          }
        });

        missionDesks?.addEventListener("click", (e) => {
          const add = (e.target as HTMLElement).closest("[data-desk-add]");
          if (add) {
            addDesk();
            window.setTimeout(renderMission, 100);
            return;
          }
          const d = (e.target as HTMLElement).closest<HTMLElement>("[data-desk]");
          if (d) {
            switchSpace(Number(d.dataset.desk));
            window.setTimeout(renderMission, 280);
          }
        });

        document.getElementById("mission-close")?.addEventListener("click", closeMission);
        missionEl?.addEventListener("click", (e) => {
          if (e.target === missionEl) closeMission();
        });

        /* ---------------- 全局快捷键 ---------------- */

        document.addEventListener("keydown", (e) => {
          // F3 → 任务视图
          if (e.key === "F3") {
            e.preventDefault();
            if (missionEl?.hidden) openMission();
            else closeMission();
            return;
          }
          // Esc → 关闭当前弹层
          if (e.key === "Escape") {
            closeMenus();
            closeMission();
            if (notifCenter) notifCenter.hidden = true;
            if (clockPanel) clockPanel.hidden = true;
            return;
          }
          // Ctrl+Shift+D → 显示桌面（Win+D 为系统保留键，用此替代）
          if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === "d") {
            e.preventDefault();
            minimizeAll();
            return;
          }
          // Ctrl+` → 切换窗口（Alt+Tab 为系统保留键，用此替代）
          if ((e.ctrlKey || e.metaKey) && e.key === "`") {
            e.preventDefault();
            const wins = Array.from(
              windows.querySelectorAll<HTMLElement>(".window:not(.is-minimized):not(.is-hidden-space)"),
            );
            if (!wins.length) return;
            const front = wins.find((w) => w.classList.contains("is-front"));
            const idx = front ? wins.indexOf(front) : -1;
            focusWin(wins[(idx + 1) % wins.length]);
          }
        });

        /* ---------------- 桌面小组件 ---------------- */

        const WIDGET_KEY = "guandao.os.widgets.v1";
        const TODO_KEY = "guandao.os.todo.v1";

        interface WidgetState {
          x?: number;
          y?: number;
          enabled?: boolean;
          size?: "s" | "m" | "l";
          style?: string;
        }

        const readWidgets = (): Record<string, WidgetState> => {
          try {
            return JSON.parse(localStorage.getItem(WIDGET_KEY) || "{}");
          } catch {
            return {};
          }
        };

        const widgetHost = document.getElementById("widgets");

        const WIDGET_IDS = ["clock", "calendar", "weather", "todo", "sys", "welcome", "quote", "world", "launch", "recent", "profile"];
        const WIDGET_TITLES: Record<string, string> = {
          clock: "时钟",
          calendar: "日历",
          weather: "天气",
          todo: "待办",
          sys: "系统信息",
          welcome: "欢迎语",
          quote: "每日一句",
          world: "世界时钟",
          launch: "快捷启动",
          recent: "最近打开",
          profile: "个人简介",
        };
        const WIDGET_DESC: Record<string, string> = {
          clock: "时间与日期",
          calendar: "当月日历",
          weather: "大连实时天气",
          todo: "每天的小任务",
          sys: "存储与运行状态",
          welcome: "按时段打招呼",
          quote: "每个清晨换一句",
          world: "四座城市的时间",
          launch: "常用应用一排直达",
          recent: "刚刚打开过什么",
          profile: "一张名片",
        };
        // 1.3 新增组件默认不占桌面，避免一升级就挤满右栏
        const WIDGET_OFF_BY_DEFAULT = ["welcome", "quote", "world", "launch", "recent", "profile"];

        const widgetOn = (id: string) => {
          const st = readWidgets()[id];
          if (st?.enabled !== undefined) return st.enabled;
          return !WIDGET_OFF_BY_DEFAULT.includes(id);
        };

        /* ---- 手机桌面模式的卡片入口：角标显示被屏幕高度挤掉的张数 ---- */
        const cardTools = document.getElementById("card-tools");
        const ctBadge = document.getElementById("ct-badge");
        const cardPicker = document.getElementById("card-picker");
        const cpList = document.getElementById("cp-list");
        const cpNote = document.getElementById("cp-note");

        const widgetShown = (id: string) => {
          const el = widgetHost?.querySelector(`[data-widget="${id}"]`);
          return !!el && !el.classList.contains("is-squeezed");
        };
        const hiddenWidgets = () => WIDGET_IDS.filter((id) => widgetOn(id) && !widgetShown(id));

        const refreshCardTools = () => {
          const hidden = hiddenWidgets().length;
          if (ctBadge) {
            ctBadge.textContent = hidden ? `+${hidden}` : "";
            ctBadge.hidden = !hidden;
          }
          if (cardTools) {
            cardTools.title = hidden ? `有 ${hidden} 张卡片被屏幕高度收起，点此调整` : "选择桌面卡片";
          }
          if (cpNote) {
            const names = hiddenWidgets().map((id) => WIDGET_TITLES[id]).join("、");
            cpNote.textContent = names ? `屏幕高度放不下：${names} 已自动收起` : "";
            cpNote.hidden = !names;
          }
        };

        const widgetBody = (id: string) => {
          switch (id) {
            case "clock":
              return `<div class="w-clock">
                <div class="w-time" data-w-clock>--:--</div>
                <div class="w-date" data-w-date></div>
                <div class="w-analog">
                  <svg viewBox="0 0 100 100" data-w-analog aria-hidden="true">
                    <circle class="an-face" cx="50" cy="50" r="46" />
                    ${Array.from({ length: 12 }, (_, i) => `<line class="an-tick" x1="50" y1="8.5" x2="50" y2="${i % 3 === 0 ? 14 : 11.5}" transform="rotate(${i * 30} 50 50)" />`).join("")}
                    <circle class="an-dot" cx="50" cy="9" r="1.6" />
                    <circle class="an-dot" cx="50" cy="91" r="1.6" />
                    <circle class="an-dot" cx="9" cy="50" r="1.6" />
                    <circle class="an-dot" cx="91" cy="50" r="1.6" />
                    <line class="an-hand an-hour" data-hand="h" x1="50" y1="55" x2="50" y2="29" />
                    <line class="an-hand an-min" data-hand="m" x1="50" y1="57" x2="50" y2="19" />
                    <line class="an-hand an-sec" data-hand="s" x1="50" y1="60" x2="50" y2="14" />
                    <circle class="an-cap" cx="50" cy="50" r="3.2" />
                  </svg>
                  <span class="w-analog-date" data-w-date2></span>
                </div>
              </div>`;
            case "calendar":
              return `<div class="w-cal" data-w-cal></div>`;
            case "weather":
              return `<div class="w-weather" data-w-weather><span class="w-loading">加载中…</span></div>`;
            case "todo":
              return `<div class="w-todo"><input class="w-todo-input" data-w-todo-input placeholder="添加待办，回车保存" maxlength="40"/><ul class="w-todo-list" data-w-todo-list></ul></div>`;
            case "sys":
              return `<div class="w-sys" data-w-sys></div>`;
            case "welcome":
              return `<div class="w-hello">
                <span class="w-hello-greet" data-w-greet>你好</span>
                <span class="w-hello-sub" data-w-hellosub></span>
                <span class="w-hello-line"></span>
              </div>`;
            case "quote":
              return `<div class="w-quote">
                <p class="w-quote-text" data-w-quote></p>
                <span class="w-quote-from" data-w-quotefrom></span>
              </div>`;
            case "world":
              return `<div class="w-world" data-w-world></div>`;
            case "launch":
              return `<div class="w-launch" data-w-launch></div>`;
            case "recent":
              return `<div class="w-recent" data-w-recent></div>`;
            case "profile":
              return `<div class="w-profile">
                  <span class="w-profile-avatar">管</span>
                  <div class="w-profile-meta"><b>管道</b><span>大连理工 · 智能制造</span></div>
                </div>
                <div class="w-profile-tags"><i>骑行</i><i>写作</i><i>AI</i><i>Vic3</i></div>`;
            default:
              // 1.4：组件中心注册的扩展组件
              return EXT_WIDGETS[id]?.body() ?? "";
          }
        };

        /* 没被手动拖过的卡片：右对齐，自上而下依次堆叠。
           以前用固定 120px 步长，日历比这个高，天气就会压在日历身上。
           现在按每张卡的实际高度累加，任何屏幕都不会重叠。
           竖向空间不足时按优先级从后往前收起，卡片不会掉到屏幕外。 */
        const WIDGET_GAP = 12;
        const WIDGET_MARGIN = 20;
        const WIDGET_PRIORITY = ["clock", "calendar", "weather", "todo", "sys", "welcome", "quote", "world", "launch", "recent", "profile"];

        const stackWidgets = () => {
          if (!widgetHost) return;
          // 手机紧凑模式下卡片区是 display:none，量不到高度，
          // 这时候排版只会把卡片全叠在同一个坐标上
          if (widgetHost.offsetParent === null) return;
          const vw = window.innerWidth;
          const deskH = document.getElementById("desk")?.clientHeight ?? window.innerHeight;
          const dockPos = os.dataset.dockPos || "bottom";
          // 底部给程序坞留出真实高度，卡片不会再压到 Dock 上
          const dockReserve = phoneDesktopMode() ? 120 : dockPos === "bottom" ? 104 : 24;
          const bottomLimit = deskH - dockReserve;
          // 手机桌面模式下与图标栏同一条基线，窗口盖上来时不会露出半截卡片
          const startY = phoneDesktopMode() ? 44 : 24;
          let y = startY;
          const leftRoom = dockPos === "left" ? 86 : 0;
          const dockRoom = dockPos === "right" ? 86 : 0;
          // 1.3：竖向放不下时向左开新的一栏，而不是把后面的卡片全收起来
          let colRight = vw - WIDGET_MARGIN - dockRoom;
          let colWidth = 0;
          let squeezed = false;
          for (const id of WIDGET_PRIORITY) {
            const el = widgetHost.querySelector<HTMLElement>(`[data-widget="${id}"]`);
            if (!el) continue;
            const st = readWidgets()[id];
            const w = el.offsetWidth || 184;
            const h = el.offsetHeight;
            /* 手动拖过位置的不参与自动排版，也不该被收起。
               但宽屏上拖出来的坐标搬到手机上会落到屏幕外，这种要重新排版。 */
            const outside = st?.y != null && (st.x == null || st.x > vw - 60 || st.y > deskH - 60 || st.x < -40);
            if (st?.y != null && !outside) {
              el.classList.remove("is-squeezed");
              y = Math.max(y, el.offsetTop + el.offsetHeight + WIDGET_GAP);
              continue;
            }

            // 当前栏放不下 → 换到左边一栏
            if (y + h > bottomLimit && y > startY) {
              colRight -= colWidth + WIDGET_GAP;
              colWidth = 0;
              y = startY;
            }

            const left = Math.max(12 + leftRoom, colRight - w);
            if (squeezed || y + h > bottomLimit || left < 12 + leftRoom) {
              squeezed = true;
              el.classList.add("is-squeezed");
              continue;
            }

            el.classList.remove("is-squeezed");
            el.style.top = `${y}px`;
            el.style.left = `${left}px`;
            colWidth = Math.max(colWidth, w);
            y += h + WIDGET_GAP;
          }
          refreshCardTools();
        };

        const renderWidget = (id: string) => {
          if (!widgetHost) return;
          const old = widgetHost.querySelector(`[data-widget="${id}"]`);
          old?.remove();
          if (!widgetOn(id)) {
            // 关掉一张卡后其余卡片要补位，否则会留下一条空档
            requestAnimationFrame(stackWidgets);
            return;
          }

          const st = readWidgets()[id];

          const el = document.createElement("div");
          el.className = "widget";
          el.dataset.widget = id;
          el.dataset.size = st?.size ?? "m";
          if (id === "clock") el.dataset.style = st?.style ?? "digital";
          // 只有手动拖过的卡片才认坐标，其余交给 stackWidgets 统一排版
          if (st?.x != null) el.style.left = `${st.x}px`;
          if (st?.y != null) el.style.top = `${st.y}px`;
          el.innerHTML = `
            <div class="widget-head">
              <span class="widget-title">${WIDGET_TITLES[id]}</span>
              <span class="widget-grip" aria-hidden="true">⋮⋮</span>
            </div>
            <div class="widget-body">${widgetBody(id)}</div>`;
          widgetHost.appendChild(el);
          initWidget(id, el);
          // 内容渲染完高度才算得准（天气是异步来的）
          requestAnimationFrame(stackWidgets);
        };

        const renderAllWidgets = () => {
          if (!widgetHost) return;
          widgetHost.innerHTML = "";
          for (const id of WIDGET_IDS) renderWidget(id);
          requestAnimationFrame(stackWidgets);
        };

        /* 统一的卡片开关：设置面板和手机卡片选择器都走这里 */
        const setWidgetEnabled = (id: string, on: boolean) => {
          const all = readWidgets();
          all[id] = { ...all[id], enabled: on };
          try {
            localStorage.setItem(WIDGET_KEY, JSON.stringify(all));
          } catch {
            /* 忽略 */
          }
          renderWidget(id);
          window.dispatchEvent(new CustomEvent("guandao:widgets-change", { detail: { id, on } }));
        };

        /** 1.4：组件中心注册新组件。同一 id 只认第一次，避免热重载式重复注册 */
        const registerWidget = (spec: {
          id: string;
          title: string;
          desc: string;
          body: () => string;
          init?: (el: HTMLElement) => void;
          defaultOn?: boolean;
        }) => {
          if (!spec.id || WIDGET_IDS.includes(spec.id)) return;
          WIDGET_IDS.push(spec.id);
          WIDGET_TITLES[spec.id] = spec.title;
          WIDGET_DESC[spec.id] = spec.desc;
          if (!spec.defaultOn) WIDGET_OFF_BY_DEFAULT.push(spec.id);
          WIDGET_PRIORITY.push(spec.id);
          EXT_WIDGETS[spec.id] = { title: spec.title, desc: spec.desc, body: spec.body, init: spec.init };
          renderWidget(spec.id);
        };

        /* ---------------- 卡片选择器（手机桌面模式） ---------------- */

        /* 手机端默认只摆最常用的三张卡：时钟 / 天气 / 待办。
           只在触屏小屏设备上写入一次，之后完全以用户的选择为准；
           电脑端默认仍是五张全开。 */
        const WIDGET_PRESET_KEY = "guandao.os.widgetPreset.v1";
        const PHONE_WIDGET_PRESET = ["clock", "weather", "todo"];
        const applyPhoneWidgetPreset = () => {
          const touchable = window.matchMedia?.("(pointer: coarse)").matches || navigator.maxTouchPoints > 0;
          if (!touchable || window.innerWidth > 720) return;
          try {
            if (localStorage.getItem(WIDGET_PRESET_KEY) === "1") return;
          } catch {
            return;
          }
          const all = readWidgets();
          for (const id of WIDGET_IDS) {
            // 保留已有的坐标，只改开关
            all[id] = { ...all[id], enabled: PHONE_WIDGET_PRESET.includes(id) };
          }
          try {
            localStorage.setItem(WIDGET_KEY, JSON.stringify(all));
            localStorage.setItem(WIDGET_PRESET_KEY, "1");
          } catch {
            /* 隐私模式写不进去就按默认五张走 */
          }
        };

        const renderCardPicker = () => {
          if (!cpList) return;
          const all = readWidgets();
          cpList.innerHTML = WIDGET_IDS.map(
            (id) => `
              <label class="cp-row">
                <span class="cp-main">
                  <span class="cp-name">${WIDGET_TITLES[id]}</span>
                  <span class="cp-desc">${WIDGET_DESC[id] ?? ""}</span>
                </span>
                <span class="cp-switch">
                  <input type="checkbox" data-cp-toggle="${id}" ${all[id]?.enabled !== false ? "checked" : ""} />
                  <i aria-hidden="true"></i>
                </span>
              </label>`,
          ).join("");
          cpList.querySelectorAll<HTMLInputElement>("[data-cp-toggle]").forEach((box) => {
            box.addEventListener("change", () => {
              setWidgetEnabled(box.dataset.cpToggle ?? "", box.checked);
              window.setTimeout(refreshCardTools, 60);
            });
          });
          refreshCardTools();
        };

        const openCardPicker = () => {
          if (!cardPicker) return;
          renderCardPicker();
          cardPicker.hidden = false;
          cardPicker.setAttribute("aria-hidden", "false");
        };
        const closeCardPicker = () => {
          if (!cardPicker || cardPicker.hidden) return;
          cardPicker.hidden = true;
          cardPicker.setAttribute("aria-hidden", "true");
        };

        cardTools?.addEventListener("click", openCardPicker);
        document.getElementById("cp-backdrop")?.addEventListener("click", closeCardPicker);
        document.getElementById("cp-done")?.addEventListener("click", closeCardPicker);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeCardPicker();
        });
        // 手机桌面模式之外没有这个入口，模式切走时顺手关掉
        window.addEventListener("resize", () => {
          if (!phoneDesktopMode()) closeCardPicker();
        });
        // 设置面板里改了开关，选择器开着时同步勾选状态
        window.addEventListener("guandao:widgets-change", (e) => {
          const id = (e as CustomEvent<{ id: string; on: boolean }>).detail?.id;
          const box = cpList?.querySelector<HTMLInputElement>(`[data-cp-toggle="${id}"]`);
          if (box) box.checked = widgetOn(id);
          refreshCardTools();
        });

        /* 小组件拖动 */
        const initWidgetDrag = (el: HTMLElement) => {
          const head = el.querySelector<HTMLElement>(".widget-head");
          if (!head) return;
          makeDraggable(head, el, {
            threshold: 5,
            canStart: () => !os.classList.contains("wg-locked"),
            clamp: (x, y) => ({
              x: Math.max(0, Math.min(window.innerWidth - el.offsetWidth, x)),
              y: Math.max(36, Math.min(window.innerHeight - 60, y)),
            }),
            onEnd: (moved) => {
              if (!moved) return;
              const id = el.dataset.widget ?? "";
              const all = readWidgets();
              all[id] = { ...all[id], x: el.offsetLeft, y: el.offsetTop };
              try {
                localStorage.setItem(WIDGET_KEY, JSON.stringify(all));
              } catch {
                /* 忽略 */
              }
            },
          });
        };

        const initWidget = (id: string, el: HTMLElement) => {
          initWidgetDrag(el);
          if (id === "clock") {
            const timeEl = el.querySelector("[data-w-clock]");
            const dateEl = el.querySelector("[data-w-date]");
            const dateEl2 = el.querySelector("[data-w-date2]");
            const tick = () => {
              const now = new Date();
              const p = (n: number) => String(n).padStart(2, "0");
              if (timeEl) timeEl.textContent = `${p(now.getHours())}:${p(now.getMinutes())}`;
              const label = now.toLocaleDateString("zh-CN", { month: "long", day: "numeric", weekday: "short" });
              if (dateEl) dateEl.textContent = label;
              if (dateEl2) dateEl2.textContent = label;
            };
            tick();
          }
          if (id === "calendar") {
            const box = el.querySelector("[data-w-cal]");
            if (box) {
              const now = new Date();
              const y = now.getFullYear();
              const m = now.getMonth();
              const first = new Date(y, m, 1).getDay();
              const days = new Date(y, m + 1, 0).getDate();
              const today = now.getDate();
              const heads = ["日", "一", "二", "三", "四", "五", "六"];
              let html = `<div class="w-cal-title">${y}年${m + 1}月</div><div class="w-cal-grid">`;
              for (const h of heads) html += `<span class="w-cal-h">${h}</span>`;
              for (let i = 0; i < first; i++) html += `<span></span>`;
              for (let d = 1; d <= days; d++) html += `<span class="${d === today ? "is-today" : ""}">${d}</span>`;
              html += `</div>`;
              box.innerHTML = html;
            }
          }
          if (id === "weather") {
            const box = el.querySelector("[data-w-weather]");
            if (box) {
              const CACHE = "guandao.widget.weather";
              const show = (d: { temp: number; code: number; wind: number }) => {
                const clear = d.code <= 2;
                const rain = (d.code >= 51 && d.code <= 67) || d.code >= 95;
                box.innerHTML = `<div class="w-wx-main"><span class="w-wx-temp">${d.temp}°C</span><span class="w-wx-desc">${clear ? "晴" : rain ? "有雨" : "多云"} · 大连</span></div><div class="w-wx-sub">风 ${d.wind} km/h</div>`;
                requestAnimationFrame(stackWidgets);
              };
              try {
                const raw = localStorage.getItem(CACHE);
                if (raw) {
                  const c = JSON.parse(raw);
                  if (Date.now() - c.at < 10 * 60 * 1000) {
                    show(c.data);
                    return;
                  }
                }
              } catch {
                /* 忽略 */
              }
              fetch(
                "https://api.open-meteo.com/v1/forecast?latitude=38.914&longitude=121.6147&current=temperature_2m,weather_code,wind_speed_10m&timezone=Asia%2FShanghai",
              )
                .then((r) => r.json())
                .then((j) => {
                  const d = {
                    temp: Math.round(j.current.temperature_2m),
                    code: j.current.weather_code,
                    wind: Math.round(j.current.wind_speed_10m),
                  };
                  try {
                    localStorage.setItem(CACHE, JSON.stringify({ at: Date.now(), data: d }));
                  } catch {
                    /* 忽略 */
                  }
                  show(d);
                })
                .catch(() => {
                  box.innerHTML = `<span class="w-loading">天气加载失败</span>`;
                });
            }
          }
          if (id === "todo") {
            const listEl = el.querySelector("[data-w-todo-list]");
            const inputEl = el.querySelector("[data-w-todo-input]") as HTMLInputElement | null;
            const readTodos = (): { id: string; text: string; done: boolean }[] => {
              try {
                return JSON.parse(localStorage.getItem(TODO_KEY) || "[]");
              } catch {
                return [];
              }
            };
            const renderTodos = () => {
              if (!listEl) return;
              const todos = readTodos();
              listEl.innerHTML = todos.length
                ? todos
                    .map(
                      (t) => `<li class="w-todo-item ${t.done ? "is-done" : ""}">
                        <span class="w-todo-check" data-todo-check="${t.id}">${t.done ? "✓" : ""}</span>
                        <span class="w-todo-text">${escapeHtml(t.text)}</span>
                        <button class="w-todo-del" data-todo-del="${t.id}" title="删除">×</button>
                      </li>`,
                    )
                    .join("")
                : `<li class="w-todo-empty">还没有待办</li>`;
              requestAnimationFrame(stackWidgets);
            };
            inputEl?.addEventListener("keydown", (e) => {
              if (e.key !== "Enter" || !inputEl.value.trim()) return;
              const todos = readTodos();
              todos.unshift({ id: makeId(), text: inputEl.value.trim(), done: false });
              localStorage.setItem(TODO_KEY, JSON.stringify(todos));
              inputEl.value = "";
              renderTodos();
            });
            el.addEventListener("click", (e) => {
              const t = e.target as HTMLElement;
              const check = t.closest("[data-todo-check]");
              const del = t.closest("[data-todo-del]");
              const todos = readTodos();
              if (check) {
                const it = todos.find((x) => x.id === check.getAttribute("data-todo-check"));
                if (it) it.done = !it.done;
                localStorage.setItem(TODO_KEY, JSON.stringify(todos));
                renderTodos();
              } else if (del) {
                localStorage.setItem(TODO_KEY, JSON.stringify(todos.filter((x) => x.id !== del.getAttribute("data-todo-del"))));
                renderTodos();
              }
            });
            renderTodos();
          }
          if (id === "sys") {
            const box = el.querySelector("[data-w-sys]");
            if (box) {
              const start = OS_BOOT;
              const mins = Math.max(1, Math.floor((Date.now() - start) / 60000));
              const winCount = windows.querySelectorAll(".window").length;
              let storage = "—";
              try {
                let bytes = 0;
                for (let i = 0; i < localStorage.length; i++) {
                  const k = localStorage.key(i) || "";
                  if (k.startsWith("guandao.")) bytes += (localStorage.getItem(k) || "").length;
                }
                storage = `${(bytes / 1024).toFixed(1)} KB`;
              } catch {
                /* 忽略 */
              }
              box.innerHTML = `<div class="w-sys-row"><span>运行窗口</span><b>${winCount}</b></div>
                <div class="w-sys-row"><span>已开启</span><b>${mins} 分钟</b></div>
                <div class="w-sys-row"><span>本地存储</span><b>${storage}</b></div>`;
            }
          }
          if (id === "welcome") {
            const greet = el.querySelector("[data-w-greet]");
            const sub = el.querySelector("[data-w-hellosub]");
            const now = new Date();
            const h = now.getHours();
            const text = h < 5 ? "还没睡？" : h < 9 ? "早上好" : h < 12 ? "上午好" : h < 14 ? "中午好" : h < 18 ? "下午好" : h < 23 ? "晚上好" : "夜深了";
            if (greet) greet.textContent = `${text}，管道`;
            if (sub)
              sub.textContent = now.toLocaleDateString("zh-CN", { month: "long", day: "numeric", weekday: "long" }) + " · 今天也慢慢来";
          }
          if (id === "quote") {
            const text = el.querySelector("[data-w-quote]");
            const from = el.querySelector("[data-w-quotefrom]");
            if (text && QUOTES.length) {
              const day = Math.floor((Date.now() - new Date(new Date().getFullYear(), 0, 0).getTime()) / 86400000);
              text.textContent = QUOTES[day % QUOTES.length];
              if (from) from.textContent = "今日一句";
            }
          }
          if (id === "world") {
            const box = el.querySelector("[data-w-world]");
            if (box) {
              const zones: Array<[string, string]> = [
                ["大连", "Asia/Shanghai"],
                ["东京", "Asia/Tokyo"],
                ["伦敦", "Europe/London"],
                ["纽约", "America/New_York"],
              ];
              box.innerHTML = zones
                .map(([city, tz]) => `<div class="w-world-row"><span>${city}</span><b data-tz="${tz}">--:--</b></div>`)
                .join("");
              box.querySelectorAll<HTMLElement>("[data-tz]").forEach((node) => {
                try {
                  node.textContent = new Intl.DateTimeFormat("zh-CN", {
                    timeZone: node.dataset.tz || "Asia/Shanghai",
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false,
                  }).format(new Date());
                } catch {
                  node.textContent = "--:--";
                }
              });
            }
          }
          if (id === "launch") {
            const box = el.querySelector("[data-w-launch]");
            if (box) {
              const picks = ["posts", "notes", "terminal", "files"];
              box.innerHTML = picks
                .filter((appId) => APPS[appId])
                .map(
                  (appId) => `<button class="w-launch-item" type="button" data-app="${appId}">
                    <span class="di-glyph ${APP_ICON[appId] ?? "di-folder"}"></span>
                    <span>${APPS[appId].title}</span>
                  </button>`,
                )
                .join("");
              box.addEventListener("click", (e) => {
                const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-app]");
                if (btn?.dataset.app) openApp(btn.dataset.app);
              });
            }
          }
          if (id === "recent") {
            const box = el.querySelector("[data-w-recent]");
            if (box) {
              let list: string[] = [];
              try {
                list = JSON.parse(localStorage.getItem("guandao.os.recent") || "[]");
              } catch {
                list = [];
              }
              const items = list.filter((appId) => APPS[appId]).slice(0, 4);
              box.innerHTML = items.length
                ? items
                    .map(
                      (appId) => `<button class="w-recent-item" type="button" data-app="${appId}">
                        <span class="w-recent-dot"></span><span>${APPS[appId].title}</span>
                      </button>`,
                    )
                    .join("")
                : `<span class="w-recent-empty">还没有打开过应用</span>`;
              box.addEventListener("click", (e) => {
                const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-app]");
                if (btn?.dataset.app) openApp(btn.dataset.app);
              });
            }
          }
          // 1.4：扩展组件自己的初始化
          try {
            EXT_WIDGETS[id]?.init?.(el);
          } catch (err) {
            console.error(`[Guandao OS] 组件「${id}」初始化失败`, err);
          }
        };

        // 小组件定时刷新：时钟每秒、系统信息每秒
        window.setInterval(() => {
          if (!widgetHost) return;
          const now = new Date();
          const p = (n: number) => String(n).padStart(2, "0");
          widgetHost.querySelectorAll("[data-w-clock]").forEach((t) => {
            t.textContent = `${p(now.getHours())}:${p(now.getMinutes())}`;
          });
          // 指针时钟：只改 transform，不触发布局
          widgetHost.querySelectorAll("[data-w-analog]").forEach((svg) => {
            const sec = now.getSeconds();
            const min = now.getMinutes() + sec / 60;
            const hr = (now.getHours() % 12) + min / 60;
            const h = svg.querySelector<SVGElement>('[data-hand="h"]');
            const m = svg.querySelector<SVGElement>('[data-hand="m"]');
            const s = svg.querySelector<SVGElement>('[data-hand="s"]');
            if (h) h.style.transform = `rotate(${hr * 30}deg)`;
            if (m) m.style.transform = `rotate(${min * 6}deg)`;
            if (s) s.style.transform = `rotate(${sec * 6}deg)`;
          });
          const mins = Math.max(1, Math.floor((Date.now() - OS_BOOT) / 60000));
          const winCount = windows.querySelectorAll(".window").length;
          widgetHost.querySelectorAll("[data-w-sys]").forEach((box) => {
            box.innerHTML = `<div class="w-sys-row"><span>运行窗口</span><b>${winCount}</b></div>
              <div class="w-sys-row"><span>已开启</span><b>${mins} 分钟</b></div>
              <div class="w-sys-row"><span>虚拟桌面</span><b>${desks.length} 个</b></div>`;
          });
          // 世界时钟：每 20 秒对齐一次即可，不必每秒格式化四次
          if (now.getSeconds() % 20 === 0) {
            widgetHost.querySelectorAll<HTMLElement>("[data-tz]").forEach((node) => {
              try {
                node.textContent = new Intl.DateTimeFormat("zh-CN", {
                  timeZone: node.dataset.tz || "Asia/Shanghai",
                  hour: "2-digit",
                  minute: "2-digit",
                  hour12: false,
                }).format(now);
              } catch {
                node.textContent = "--:--";
              }
            });
          }
        }, 1000);

        // 通知中心：先渲染已保存的通知，铃铛红点即时可见
        renderNotifs();
        updateBell();
        // 1.4 的任务中心 / 勿扰模式也会改同一份通知数据，收到广播就重绘
        window.addEventListener("guandao:notif-change", () => {
          renderNotifs();
          updateBell();
        });

        // 桌面小组件：在全部定义之后渲染，避免 TDZ
        applyPhoneWidgetPreset();
        renderAllWidgets();

        /* ---------------- 桌面排版 ----------------
           图标列数、启动台列数都跟着可视区算，不再写死，
           换台显示器 / 转个屏幕方向都不会溢出或留一大片空白。 */

        const layoutDeskIcons = () => {
          const host = document.querySelector<HTMLElement>(".desk-icons");
          const desk = document.getElementById("desk");
          if (!host || !desk) return;
          // 手机端固定 5 列，交给 CSS
          if (window.innerWidth <= 720) {
            host.style.removeProperty("--di-rows");
            return;
          }
          const n = host.children.length;
          if (!n) return;
          const cell = host.querySelector<HTMLElement>(".desk-icon");
          const rowH = (cell?.offsetHeight || 80) + 12;
          // 顶部留白 22，底部给程序坞和提示语让位
          const avail = desk.clientHeight - 22 - 92;
          const maxRows = Math.max(3, Math.floor(avail / rowH));
          // 尽量找能把图标平均分满的列数（21 个 → 3 列 × 7 行）
          let rows = Math.ceil(n / Math.ceil(n / maxRows));
          for (let cols = Math.ceil(n / maxRows); cols <= Math.min(5, n); cols++) {
            if (n % cols === 0) {
              rows = n / cols;
              break;
            }
          }
          host.style.setProperty("--di-rows", String(rows));
        };

        const layoutLaunchpad = () => {
          const grid = document.querySelector<HTMLElement>(".lp-grid");
          if (!grid) return;
          const n = grid.children.length;
          if (!n) return;
          const vw = window.innerWidth;
          // 桌面上 7 列正好 3 行排满 21 个应用，手机上 4 列更好点按
          let cols = vw >= 900 ? 7 : vw >= 700 ? 6 : vw >= 520 ? 5 : 4;
          while (cols > 3 && vw / cols < 76) cols--;
          grid.style.setProperty("--lp-cols", String(cols));
          // 最后一行只剩一个图标时居中，别让它孤零零挂在最左边
          grid.classList.toggle("is-orphan", n % cols === 1);
        };

        let layoutRaf = 0;
        const relayout = () => {
          if (layoutRaf) return;
          layoutRaf = requestAnimationFrame(() => {
            layoutRaf = 0;
            layoutDeskIcons();
            layoutLaunchpad();
            stackWidgets();
          });
        };

        layoutDeskIcons();
        layoutLaunchpad();
        window.addEventListener("resize", relayout);
        window.addEventListener("orientationchange", relayout);

        // 桌面端自动打开文章窗口作为欢迎；手机上先让人看到图标
        if (window.innerWidth > 720) {
          window.setTimeout(() => openApp("posts"), 420);
        }

        /* ---------------- Guandao OS 1.3 · Beyond the Desktop ---------------- */
        let api13Ref: any = null;
        try {
          const api13 = initOs13({
            os,
            windows,
            openApp,
            closeWin,
            pushNotif,
            readState: () => readState() as unknown as Record<string, unknown>,
            writeState,
            renderDock,
            readDock,
            saveDock,
            APPS,
            APP_ICON,
            widgets: {
              ids: WIDGET_IDS,
              titles: WIDGET_TITLES,
              desc: WIDGET_DESC,
              on: widgetOn,
              setEnabled: setWidgetEnabled,
              renderAll: renderAllWidgets,
              read: readWidgets,
              write: (all) => {
                try {
                  localStorage.setItem(WIDGET_KEY, JSON.stringify(all));
                } catch {
                  /* 忽略 */
                }
              },
              stack: stackWidgets,
            },
          });
          (window as unknown as { GOS13?: unknown }).GOS13 = api13;
          api13Ref = api13;
          // 旧的「下一张壁纸」菜单动作交给 1.3 的壁纸引擎
          document.querySelectorAll<HTMLElement>('[data-menu-action="wallpaper"]').forEach((btn) => {
            btn.dataset.wallNext = "1";
          });
          document.addEventListener(
            "click",
            (e) => {
              const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-menu-action="wallpaper"]');
              if (!btn) return;
              e.preventDefault();
              e.stopPropagation();
              api13.nextWallpaper();
            },
            true,
          );
        } catch (err) {
          console.error("[Guandao OS 1.3]", err);
        }

        /* ---------------- Guandao OS 1.4 · Ecosystem Evolution ----------------
           生态层只拿这里暴露的少量能力，窗口 / 通知 / 组件 / 外观全部复用现有实现，
           避免出现第二套互不兼容的窗口管理。 */
        let boot14: any = null;
        try {
          const api13 = api13Ref;
          const notifKey = "guandao.os.notif.v1";

          /** 勿扰模式：通知照常入库，但直接标为已读，不亮红点也不打扰 */
          const dndOn = () => {
            try {
              return Boolean(JSON.parse(localStorage.getItem("guandao.os14.prefs.v1") || "{}").dnd);
            } catch {
              return false;
            }
          };

          const buildShortcut = (id: string, title: string, glyph: string) => {
            const btn = document.createElement("button");
            btn.className = "desk-icon";
            btn.type = "button";
            btn.dataset.app = id;
            btn.innerHTML = `<span class="di-glyph ${glyph || "di-folder"}"></span><span class="di-label">${escapeHtml(title)}</span>`;
            return btn;
          };

          const ctx14 = {
            os,
            windows,
            desk: document.getElementById("desk") as HTMLElement,
            openApp,
            closeWin,
            focusWin,
            openSettings: (tab?: string) => api13?.openSettings(tab),
            pushNotif: (n: { icon: string; title: string; body: string }) => {
              pushNotif(n);
              if (!dndOn()) return;
              try {
                const list = JSON.parse(localStorage.getItem(notifKey) || "[]");
                if (list[0]) list[0].read = true;
                localStorage.setItem(notifKey, JSON.stringify(list));
                window.dispatchEvent(new CustomEvent("guandao:notif-change"));
              } catch {
                /* 忽略 */
              }
            },
            toast: (msg: string) => api13?.toast?.(msg),
            escapeHtml,
            registerApp,
            unregisterApp: (id: string) => {
              delete APPS[id];
              delete APP_ICON[id];
            },
            APPS,
            APP_ICON,
            readState,
            writeState,
            dock: { read: readDock, save: saveDock, render: renderDock },
            widgets: {
              ids: WIDGET_IDS,
              titles: WIDGET_TITLES,
              desc: WIDGET_DESC,
              on: widgetOn,
              setEnabled: setWidgetEnabled,
              render: renderWidget,
              renderAll: renderAllWidgets,
              stack: stackWidgets,
              register: registerWidget,
              state: readWidgets,
            },
            api13,
            setDockFilter: (fn: ((id: string) => boolean) | null) => {
              dockFilter = fn;
              renderDock();
            },
            setLaunchGuard: (fn: (id: string) => boolean) => {
              APP_GUARD.blocked = fn;
              APP_GUARD.onBlocked = () => {
                openApp("appcenter");
              };
            },
            onBeforeClose: (cb: (win: HTMLElement) => void) => beforeCloseHooks.push(cb),
            buildShortcut,
            relayoutIcons: () => {
              layoutDeskIcons();
              layoutLaunchpad();
              stackWidgets();
            },
            restoreWindows: (map: Record<string, unknown>, ids: string[]) =>
              boot14 ? boot14.sys.restoreWindows(map, ids) : Promise.resolve(),
            closeAllWindows: () => boot14?.sys.closeAppAll(),
            /* 2.0 Window Manager 需要的窗口级能力：直接复用 1.x 已验证的实现，
               不在 Core 里另写一套拖动 / 缩放 / 贴靠。 */
            shellOps: {
              minimize: (win: HTMLElement) => minimizeWin(win),
              restore: (win: HTMLElement) => restoreWin(win),
              maximize: (win: HTMLElement) => toggleMaximize(win),
              moveToSpace: (win: HTMLElement, space: number) => {
                win.dataset.space = String(space);
                switchSpace(space);
                refreshSpaceVisibility();
              },
            },
          };

          boot14 = initOs14(ctx14 as never);
          (window as unknown as { GOS14_READY?: boolean }).GOS14_READY = true;

          /* 2.2 清理死代码后：notes / calendar / files / music 不再有静态 APPS 条目，
             它们只由 os14 在上一行注册。开机时那次 openFromHash() 早于这里，
             所以再跑一次，保证 #notes 这类直达链接仍然能打开应用（对已开窗口是聚焦，幂等）。 */
          openFromHash();

          // 深链：移动端「在桌面版管理设备」等入口用 /?app=devices 直接打开对应应用
          try {
            const requested = new URLSearchParams(location.search).get("app");
            if (requested && /^[a-z0-9-]{1,40}$/.test(requested)) {
              window.setTimeout(() => {
                if (ctx14.APPS[requested]) ctx14.openApp(requested);
              }, 700);
            }
          } catch {
            /* 忽略 */
          }
        } catch (err) {
          console.error("[Guandao OS 1.4]", err);
        }
      })();

      try {
        initAccount();
      } catch (err) {
        console.error("[Guandao Account]", err);
      }
    </script>

  </body>
</html>
