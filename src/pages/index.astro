      /* Dock 下方的运行指示点 */
      .dock-item {
        position: relative;
      }

      .dock-item.has-open::after,
      .dock-item.has-hidden::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -5px;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        transform: translateX(-50%);
      }

      .dock-item.has-open::after {
        background: rgba(255, 255, 255, 0.42);
      }

      .dock-item.has-hidden::after {
        background: #8fa6ff;
      }

      /* ---------------- 响应式 ---------------- */

      @media (max-width: 720px) {
        .desk-icons {
          display: flex;
          flex-direction: row;
          flex-wrap: wrap;
          top: 10px;
          left: 10px;
          right: 10px;
          gap: 6px;
        }

        .desk-icon {
          width: 58px;
          padding: 6px 2px;
        }

        .di-glyph {
          width: 30px;
          height: 30px;
        }

        .di-label {
          font-size: 10px;
        }

        .window {
          left: 8px !important;
          right: 8px;
          width: auto !important;
          max-width: none;
          max-height: calc(100dvh - 190px);
        }

        .finder {
          grid-template-columns: 1fr;
        }

        .finder-side {
          display: none;
        }

        .dock {
          gap: 6px;
          padding: 7px 10px;
          border-radius: 16px;
          max-width: calc(100vw - 20px);
          overflow-x: auto;
          overflow-y: hidden;
          scrollbar-width: none;
        }

        .dock::-webkit-scrollbar {
          display: none;
        }

        .dock-item {
          width: 38px;
          height: 38px;
        }

        .desk-pet {
          right: 10px;
          bottom: 78px;
          width: 64px;
          height: 92px;
          z-index: 8;
        }

        .ach-grid {
          grid-template-columns: 1fr;
        }

        .toast-stack {
          right: 10px;
          bottom: calc(86px + env(safe-area-inset-bottom, 0px));
        }

        .desk-hint {
          display: none;
        }
      }
