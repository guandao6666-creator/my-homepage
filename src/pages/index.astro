        position: absolute;
        inset: 11px 5px 6px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.88);
      }

      /* 图标：人 */
      .di-person {
        background: linear-gradient(180deg, #9bb0d8 0%, #5f7398 100%);
      }
      .di-person::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 7px;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .di-person::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 6px;
        width: 20px;
        height: 12px;
        border-radius: 10px 10px 3px 3px;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }

      /* 图标：终端 */
      .di-term {
        background: linear-gradient(180deg, #2f3444 0%, #171a24 100%);
        border: 1px solid rgba(255, 255, 255, 0.14);
      }
      .di-term::before {
        content: ">_";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 13px;
        color: #7ef0b0;
      }

      /* 图标：唱片 */
      .di-music {
        background: linear-gradient(140deg, #ff9ec2 0%, #a83f74 100%);
      }
      .di-music::before {
        content: "";
        position: absolute;
        inset: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
      }
      .di-music::after {
        content: "";
        position: absolute;
        inset: 15px;
        border-radius: 50%;
        background: #a83f74;
      }

      /* 图标：奖杯 */
      .di-ach {
        background: linear-gradient(160deg, #ffd479 0%, #d1902a 100%);
      }
      .di-ach::before {
        content: "";
        position: absolute;
        left: 9px;
        top: 7px;
        width: 16px;
        height: 15px;
        border-radius: 0 0 9px 9px;
        background: rgba(255, 255, 255, 0.94);
      }
      .di-ach::after {
        content: "";
        position: absolute;
        left: 13px;
        bottom: 7px;
        width: 8px;
        height: 7px;
        border-radius: 0 0 2px 2px;
        background: rgba(255, 255, 255, 0.94);
      }

      /* 图标：水母 */
      .di-tank {
        background: linear-gradient(160deg, #66d6ff 0%, #1a72b8 100%);
      }
      .di-tank::before {
        content: "";
        position: absolute;
        left: 8px;
        top: 8px;
        width: 18px;
        height: 13px;
        border-radius: 9px 9px 5px 5px;
        background: rgba(255, 255, 255, 0.92);
      }
      .di-tank::after {
        content: "";
        position: absolute;
        left: 12px;
        top: 21px;
        width: 10px;
        height: 7px;
        border-radius: 0 0 6px 6px;
        background: rgba(255, 255, 255, 0.72);
      }

      /* 图标：头像墙 */
      .di-wall {
        background: linear-gradient(160deg, #ffb47a 0%, #d9603a 100%);
      }
      .di-wall::before {
        content: "";
        position: absolute;
        inset: 7px;
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.95) 3.2px, transparent 3.6px);
        background-size: 10px 10px;
      }

      /* 图标：柱状排行 */
      .di-rank {
        background: linear-gradient(160deg, #8ee6a8 0%, #2f9a5e 100%);
      }
      .di-rank::before {
        content: "";
        position: absolute;
        left: 8px;
        bottom: 8px;
        width: 5px;
        height: 8px;
        border-radius: 1px;
        background: rgba(255, 255, 255, 0.95);
        box-shadow:
          7px -5px 0 rgba(255, 255, 255, 0.95),
          14px -11px 0 rgba(255, 255, 255, 0.95);
      }

      /* 图标：礼物盒 */
      .di-draw {
        background: linear-gradient(160deg, #ff7a86 0%, #c02848 100%);
      }
      .di-draw::before {
        content: "";
        position: absolute;
        inset: 12px 6px 6px;
        border-radius: 2px;
        background:
          linear-gradient(#c02848, #c02848) center / 4px 100% no-repeat,
          linear-gradient(#c02848, #c02848) center / 100% 4px no-repeat,
          rgba(255, 255, 255, 0.94);
      }
      .di-draw::after {
        content: "";
        position: absolute;
        left: 4px;
        right: 4px;
        top: 8px;
        height: 4px;
        border-radius: 1px;
        background: rgba(255, 255, 255, 0.94);
      }

      /* 图标：投票箱 */
      .di-vote {
        background: linear-gradient(160deg, #a78bfa 0%, #6d28d9 100%);
      }
      .di-vote::before {
        content: "";
        position: absolute;
        left: 7px;
        top: 13px;
        width: 20px;
        height: 12px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.94);
      }
      .di-vote::after {
        content: "";
        position: absolute;
        left: 11px;
        top: 9px;
        width: 12px;
        height: 3px;
        border-radius: 1px;
        background: #6d28d9;
      }

      /* 图标：树洞 */
      .di-hole {
        background: linear-gradient(160deg, #a8bf85 0%, #3f5230 100%);
      }
      .di-hole::before {
        content: "";
        position: absolute;
        left: 9px;
        top: 10px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: radial-gradient(circle at 38% 32%, #2a1f16 0%, #0f0a06 78%);
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.85);
      }

      /* 图标：电视机 */
      .di-tv {
        background: linear-gradient(160deg, #7dd3fc 0%, #0369a1 100%);
      }
      .di-tv::before {
        content: "";
        position: absolute;
        inset: 11px 5px 7px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.94);
      }
      .di-tv::after {
        content: "";
        position: absolute;
        left: 8px;
        right: 8px;
        top: 14px;
        bottom: 10px;
        border-radius: 1px;
        background: #0369a1;
      }

      /* 图标：网络 */
      .di-net {
        background: linear-gradient(160deg, #f0abfc 0%, #7e22ce 100%);
      }
      .di-net::before {
        content: "";
        position: absolute;
        left: 9px;
        top: 9px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        box-shadow:
          9px 5px 0 rgba(255, 255, 255, 0.95),
          2px 13px 0 rgba(255, 255, 255, 0.95);
      }
      .di-net::after {
        content: "";
        position: absolute;
        left: 11px;
        top: 12px;
        width: 11px;
        height: 9px;
        border-top: 1.5px solid rgba(255, 255, 255, 0.45);
        border-right: 1.5px solid rgba(255, 255, 255, 0.45);
        transform: skewY(-32deg);
      }

      /* 图标：齿轮 */
      .di-gear {
        background: linear-gradient(180deg, #a9b4c9 0%, #6b7688 100%);
      }
      .di-gear::before {
        content: "";
        position: absolute;
        inset: 9px;
        border-radius: 50%;
        border: 3px solid rgba(255, 255, 255, 0.9);
      }
      .di-gear::after {
        content: "";
        position: absolute;
        inset: 15px;
        border-radius: 50%;
        background: rgba(40, 44, 56, 0.9);
      }

      /* 图标：房子 */
      .di-home {
        background: linear-gradient(180deg, #8fd8a8 0%, #3f9a68 100%);
      }
      .di-home::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 7px;
        width: 16px;
        height: 16px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%) rotate(45deg);
        border-radius: 2px;
      }
      .di-home::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 6px;
        width: 16px;
        height: 11px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%);
        border-radius: 0 0 3px 3px;
      }

      .desk-hint {
        position: absolute;
        left: 50%;
        bottom: 110px;
        transform: translateX(-50%);
        margin: 0;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.36);
        transition: opacity 0.4s ease;
      }

      /* ---------------- 桌面宠物 ---------------- */

      .desk-pet {
        position: absolute;
        right: 26px;
        bottom: 100px;
        z-index: 24;
        width: 86px;
        height: 122px;
        cursor: grab;
        touch-action: none;
        transition: transform 0.2s ease;
      }

      .desk-pet:hover {
        transform: translateY(-3px);
      }

      .desk-pet.is-dragging {
        cursor: grabbing;
        transition: none;
      }

      .pet-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.55));
      }

      .pet-say {
        position: absolute;
        right: 8px;
        bottom: calc(100% + 4px);
        max-width: 156px;
        margin: 0;
        padding: 6px 10px;
        border-radius: 10px 10px 2px 10px;
        background: #f5f7fc;
        box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.7);
        font-size: 11.5px;
        line-height: 1.5;
        color: #171a22;
        white-space: nowrap;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        pointer-events: none;
      }

      .pet-say.show {
        opacity: 1;
        transform: none;
      }

      .desk-hint.is-gone {
        opacity: 0;
      }

      /* ---------------- 窗口 ---------------- */

      .windows {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .window {
        position: absolute;
        display: flex;
        flex-direction: column;
        border-radius: 12px;
        overflow: hidden;
        pointer-events: auto;
        background: var(--os-panel);
        backdrop-filter: blur(26px) saturate(1.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 32px 70px -26px rgba(0, 0, 0, 0.8);
        transition: transform 0.18s ease, opacity 0.18s ease;
        animation: winIn 0.22s ease-out;
      }

      .window.is-front {
        border-color: rgba(255, 255, 255, 0.18);
      }

      .window.is-dragging {
        transition: none;
      }

      .window.is-closing {
        transform: scale(0.94);
        opacity: 0;
      }

      .window.is-minimized {
        pointer-events: none;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.6, 1), opacity 0.3s ease;
      }

      @keyframes winIn {
        from {
          transform: scale(0.96) translateY(8px);
          opacity: 0;
        }
        to {
          transform: none;
          opacity: 1;
        }
      }

      .titlebar {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 38px;
        padding: 0 12px;
        background: rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        cursor: grab;
      }

      .is-dragging .titlebar {
        cursor: grabbing;
      }

      .dots {
        display: flex;
        gap: 7px;
      }

      .dot {
        width: 11px;
        height: 11px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        cursor: pointer;
      }

      .dot-close {
        background: #ff5f57;
      }
      .dot-min {
        background: #febc2e;
      }
      .dot-max {
        background: #28c840;
      }

      .win-title {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.72);
      }

      .win-body {
        flex: 1;
        min-height: 0;
        overflow: auto;
        overscroll-behavior: contain;
      }

      /* ---------------- Finder ---------------- */

      .finder {
        display: grid;
        grid-template-columns: 148px minmax(0, 1fr);
        height: 100%;
      }

      .finder-side {
        padding: 14px 12px;
        background: rgba(255, 255, 255, 0.04);
        border-right: 1px solid rgba(255, 255, 255, 0.06);
      }

      .side-title {
        margin: 12px 0 6px;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.36);
      }

      .side-title:first-child {
        margin-top: 0;
      }

      .side-item {
        display: block;
        padding: 6px 9px;
        border-radius: 7px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.62);
      }

      .side-item.is-active {
        background: rgba(111, 140, 255, 0.24);
        color: #fff;
      }

      .finder-files {
        padding: 8px;
        overflow: auto;
      }

      .file-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 9px;
        color: inherit;
        text-decoration: none;
        transition: background-color 0.16s ease;
      }

      .file-row:hover {
        background: rgba(255, 255, 255, 0.08);
      }

      .file-icon {
        width: 26px;
        height: 30px;
        flex: none;
        border-radius: 3px;
        background: linear-gradient(180deg, #ffffff 0%, #d9dfea 100%);
        position: relative;
      }

      .file-icon::after {
        content: "";
        position: absolute;
        left: 5px;
        right: 5px;
        top: 9px;
        height: 2px;
        background: rgba(70, 84, 110, 0.45);
        box-shadow: 0 5px 0 rgba(70, 84, 110, 0.3), 0 10px 0 rgba(70, 84, 110, 0.2);
      }

      .file-main {
        min-width: 0;
        display: grid;
        gap: 3px;
      }

      .file-name {
        font-size: 13px;
        color: #f2f5fa;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .file-meta {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.42);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .file-index {
        margin-left: auto;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.28);
      }

      .finder-empty {
        padding: 24px 12px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.45);
      }

      /* ---------------- 关于 ---------------- */

      .about {
        padding: 24px 26px;
        font-size: 13px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.72);
      }

      .about-kicker {
        margin: 0 0 4px;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.38);
      }

      .about h2 {
        margin: 0 0 12px;
        font-size: 22px;
        color: #fff;
      }

      .about p {
        margin: 0 0 10px;
      }

      .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .about-links a {
        font-size: 12.5px;
        color: #9fb4ff;
        text-decoration: none;
      }

      .about-links a:hover {
        text-decoration: underline;
      }

      /* ---------------- 终端 ---------------- */

      .term {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: rgba(8, 10, 16, 0.82);
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 12.5px;
      }

      .term-out {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 14px 16px 6px;
        line-height: 1.7;
      }

      .term-line {
        margin: 0 0 2px;
        color: rgba(232, 240, 255, 0.82);
        white-space: pre-wrap;
      }

      .term-muted {
        color: rgba(232, 240, 255, 0.42);
      }

      .term-echo {
        color: #7ef0b0;
      }

      .term-error {
        color: #ff8f8f;
      }

      .term-input-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 16px 14px;
      }

      .term-prompt {
        color: #7ef0b0;
      }

      .term-input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: none;
        color: #eef1f7;
        font: inherit;
        outline: none;
        caret-color: #7ef0b0;
      }

      /* ---------------- 设置 ---------------- */

      .settings {
        padding: 20px 22px;
      }

      .wall-picks {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
      }

      .dock-picker {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 7px 12px;
        margin-bottom: 8px;
      }

      .dock-opt {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.72);
        cursor: pointer;
      }

      .dock-opt:hover {
        color: #fff;
      }

      .dock-opt input {
        width: 13px;
        height: 13px;
        accent-color: #6f8cff;
        cursor: pointer;
      }

      .settings-tip {
        margin: 0 0 18px;
        font-size: 10.5px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.34);
      }

      .wall-pick {
        flex: 1;
        padding: 9px 0;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.72);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .wall-pick:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      .wall-pick.is-active {
        border-color: var(--os-accent);
        background: rgba(111, 140, 255, 0.22);
        color: #fff;
      }

      .settings-note {
        margin: 0;
        font-size: 12px;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.46);
      }

      /* ---------------- 音乐 ---------------- */

      .music {
        display: grid;
        gap: 12px;
        padding: 18px 20px 20px;
      }

      .music-cover {
        position: relative;
        height: 88px;
        border-radius: 10px;
        overflow: hidden;
        background: linear-gradient(135deg, #6f8cff 0%, #b06eff 100%);
      }

      .cover-disc {
        position: absolute;
        right: 16px;
        top: 50%;
        width: 62px;
        height: 62px;
        margin-top: -31px;
        border-radius: 50%;
        background: radial-gradient(circle, #161922 0 16%, #262b38 16% 42%, #161922 42% 100%);
        animation: discSpin 9s linear infinite;
      }

      .music-title {
        margin: 0;
        font-size: 15px;
        color: #fff;
      }

      .music-sub {
        margin: 2px 0 0;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.45);
      }

      .music-bar {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .music-play {
        flex: none;
        width: 36px;
        height: 36px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 50%;
        background: rgba(111, 140, 255, 0.26);
        color: #fff;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .music-play:hover {
        background: rgba(111, 140, 255, 0.44);
      }

      .music-wave {
        flex: 1;
        min-width: 0;
        height: 42px;
      }

      .music-note {
        margin: 0;
        font-size: 11px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.42);
      }

      .music-step {
        flex: none;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        padding: 0;
        border: 0;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.66);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
        transition: background-color 0.18s ease, color 0.18s ease;
      }

      .music-step:hover {
        background: rgba(255, 255, 255, 0.16);
        color: #fff;
      }

      .music-list {
        max-height: 152px;
        margin: 14px 0 0;
        padding: 0;
        overflow: auto;
        list-style: none;
        display: grid;
        gap: 2px;
      }

      .music-row {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 9px;
        border-radius: 7px;
        cursor: pointer;
        transition: background-color 0.15s ease;
      }

      .music-row:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .music-row.is-current {
        background: rgba(111, 140, 255, 0.16);
      }

      .music-row-no {
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.3);
      }

      .music-row.is-playing .music-row-no {
        color: #8fa6ff;
      }

      .music-row-name {
        flex: 1;
        overflow: hidden;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.78);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .music-row.is-current .music-row-name {
        color: #fff;
      }

      @keyframes discSpin {
        to {
          transform: rotate(360deg);
        }
      }

      /* ---------------- 成就 ---------------- */

      .ach-wrap {
        padding: 18px 20px 20px;
      }

      .ach-head {
        margin: 0 0 14px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .ach-head b {
        font-size: 15px;
        color: #ffd479;
      }

      .ach-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .ach {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 11px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
      }

      .ach.is-got {
        border-color: rgba(255, 212, 121, 0.32);
        background: rgba(255, 212, 121, 0.08);
      }

      .ach-mark {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        flex: none;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.07);
        font-family: var(--font-serif);
        font-size: 14px;
        color: rgba(255, 255, 255, 0.42);
      }

      .ach.is-got .ach-mark {
        background: linear-gradient(150deg, #ffd479, #d1902a);
        color: #3a2606;
      }

      .ach-body {
        display: grid;
        gap: 2px;
        min-width: 0;
      }

      .ach-name {
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.5);
      }

      .ach.is-got .ach-name {
        color: #fff;
      }

      .ach-desc {
        overflow: hidden;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.3);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* ---------------- 成就提示 ---------------- */

      .toast-stack {
        position: fixed;
        right: 18px;
        bottom: calc(96px + env(safe-area-inset-bottom, 0px));
        z-index: 500;
        display: grid;
        gap: 8px;
        pointer-events: none;
      }

      .toast {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 196px;
        padding: 10px 14px 10px 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        background: rgba(26, 29, 38, 0.94);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(18px);
        opacity: 0;
        transform: translateX(24px) scale(0.96);
        transition: opacity 0.3s ease, transform 0.36s cubic-bezier(0.2, 0.9, 0.3, 1.2);
      }

      .toast.is-in {
        opacity: 1;
        transform: none;
      }

      .toast-mark {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        flex: none;
        border-radius: 9px;
        background: linear-gradient(150deg, #ffd479, #d1902a);
        font-family: var(--font-serif);
        font-size: 15px;
        color: #3a2606;
      }

      .toast-body {
        display: grid;
        gap: 2px;
      }

      .toast-kicker {
        font-size: 10px;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.4);
      }

      .toast-name {
        font-size: 13px;
        color: #fff;
      }

      /* ---------------- 水族箱 ---------------- */

      .tank {
        position: relative;
        height: 100%;
        overflow: hidden;
        cursor: pointer;
        --phase-speed: 1;
        --phase-bright: 1;
        --phase-saturate: 1;
        background: linear-gradient(180deg, #0a2f45 0%, #0e4762 48%, #071e2c 100%);
        transition: background 1.4s ease;
      }

      /* 清晨：水偏青，醒得快（时长倍率 <1 代表更快） */
      .tank[data-phase="dawn"] {
        background: linear-gradient(180deg, #0d3d4c 0%, #1a6478 48%, #0a2b36 100%);
        --phase-speed: 0.85;
        --phase-bright: 1.06;
      }

      /* 白天：常态 */
      .tank[data-phase="day"] {
        background: linear-gradient(180deg, #0a2f45 0%, #0e4762 48%, #071e2c 100%);
        --phase-speed: 1;
      }

      /* 傍晚：水偏紫，慢下来 */
      .tank[data-phase="dusk"] {
        background: linear-gradient(180deg, #321a4a 0%, #4d2760 48%, #1b0d28 100%);
        --phase-speed: 1.35;
        --phase-bright: 0.86;
        --phase-saturate: 0.82;
      }

      /* 深夜：熄灯，游得最慢 */
      .tank[data-phase="night"] {
        background: linear-gradient(180deg, #061622 0%, #0a2a3c 48%, #04101a 100%);
        --phase-speed: 2.1;
        --phase-bright: 0.66;
        --phase-saturate: 0.72;
      }

      .tank::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(120, 220, 255, 0.16), transparent 30%);
        pointer-events: none;
      }

      .bubbles {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .bubble {
        position: absolute;
        bottom: -14px;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: radial-gradient(circle at 32% 30%, rgba(255, 255, 255, 0.95), rgba(130, 215, 255, 0.3));
        animation: bubbleRise var(--dur) linear infinite;
        animation-delay: var(--delay);
      }

      @keyframes bubbleRise {
        to {
          transform: translateY(-520px);
          opacity: 0;
        }
      }

      .tank-floor {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 46px;
        background: radial-gradient(58% 100% at 50% 100%, rgba(36, 104, 104, 0.5), transparent 70%);
        pointer-events: none;
      }

      .fish-layer {
        position: absolute;
        inset: 0;
      }

      .fish {
        position: absolute;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background-image: var(--bg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow:
          0 0 0 2px rgba(180, 230, 255, 0.32),
          0 10px 22px -8px rgba(0, 0, 0, 0.65);
        animation-name: driftSoft;
        animation-duration: calc(var(--base-dur, 11s) * var(--phase-speed, 1));
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        animation-delay: var(--delay);
        filter: brightness(var(--phase-bright, 1)) saturate(var(--phase-saturate, 1));
        transition: filter 1.2s ease;
      }

      /* 按性格给每条不同的游法 */
      .fish[data-ai="chatgpt"] {
        --base-dur: 11s;
        animation-name: driftSoft;
      }
      .fish[data-ai="deepseek"] {
        --base-dur: 13s;
        animation-name: driftDeep;
      }
      .fish[data-ai="claude"] {
        --base-dur: 12s;
        animation-name: driftWide;
      }
      .fish[data-ai="grok"] {
        --base-dur: 9s;
        animation-name: dashAround;
        animation-direction: normal;
      }
      .fish[data-ai="gemini"] {
        --base-dur: 14s;
        animation-name: orbitPath;
        animation-direction: normal;
      }
      .fish[data-ai="wenxin"] {
        --base-dur: 19s;
        animation-name: driftSlow;
      }
      .fish[data-ai="qwen"] {
        --base-dur: 15s;
        animation-name: glideDiagonal;
      }

      .fish::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: linear-gradient(150deg, rgba(255, 255, 255, 0.26), transparent 46%);
        pointer-events: none;
      }

      /* ChatGPT：不紧不慢地上下浮 */
      @keyframes driftSoft {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(16px, -20px);
        }
      }

      /* DeepSeek：喜欢沉在下面，偶尔上来 */
      @keyframes driftDeep {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(26px, 24px);
        }
      }

      /* Claude：稳稳地横着走 */
      @keyframes driftWide {
        from {
          transform: translate(-16px, 2px);
        }
        to {
          transform: translate(16px, -12px);
        }
      }

      /* 文心：动得很轻，像懒得动 */
      @keyframes driftSlow {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(7px, -10px);
        }
      }

      /* Grok：横冲直撞 */
      @keyframes dashAround {
        0% {
          transform: translate(0, 0);
        }
        28% {
          transform: translate(104px, -32px);
        }
        52% {
          transform: translate(-64px, 38px);
        }
        78% {
          transform: translate(72px, 16px);
        }
        100% {
          transform: translate(0, 0);
        }
      }

      /* Gemini：绕着圈转 */
      @keyframes orbitPath {
        0% {
          transform: translate(0, 0);
        }
        25% {
          transform: translate(32px, -18px);
        }
        50% {
          transform: translate(0, -36px);
        }
        75% {
          transform: translate(-32px, -18px);
        }
        100% {
          transform: translate(0, 0);
        }
      }

      /* 千问：斜着滑，像摇扇子 */
      @keyframes glideDiagonal {
        from {
          transform: translate(0, 0);
        }
        to {
          transform: translate(-24px, -18px);
        }
      }

      .fish-name {
        position: absolute;
        left: 50%;
        bottom: -15px;
        transform: translateX(-50%);
        font-size: 9px;
        letter-spacing: 0.02em;
        color: rgba(215, 238, 255, 0.5);
        white-space: nowrap;
        pointer-events: none;
      }

      .food {
        position: absolute;
        width: 6px;
        height: 6px;
        margin: -3px 0 0 -3px;
        border-radius: 50%;
        background: #ffd479;
        box-shadow: 0 0 8px rgba(255, 212, 121, 0.85);
        animation: foodSink 0.82s ease-in forwards;
        pointer-events: none;
      }

      @keyframes foodSink {
        to {
          transform: translateY(24px);
          opacity: 0.35;
        }
      }

      .heart {
        position: absolute;
        left: 50%;
        top: -10px;
        font-size: 14px;
        color: #ff8fb1;
        pointer-events: none;
        animation: heartUp 1.7s ease-out forwards;
      }

      /* 深夜的瞌睡泡 */
      .zzz {
        position: absolute;
        right: -2px;
        top: -8px;
        font-family: var(--font-serif);
        font-size: 12px;
        font-weight: 600;
        color: rgba(190, 225, 255, 0.75);
        pointer-events: none;
        animation: zzzFloat 3s ease-out forwards;
      }

      @keyframes zzzFloat {
        0% {
          opacity: 0;
          transform: translate(0, 0) scale(0.7);
        }
        22% {
          opacity: 1;
        }
        100% {
          opacity: 0;
          transform: translate(9px, -28px) scale(1.1);
        }
      }

      @keyframes heartUp {
        0% {
          opacity: 0;
          transform: translate(-50%, 0) scale(0.6);
        }
        25% {
          opacity: 1;
          transform: translate(-50%, -10px) scale(1);
        }
        100% {
          opacity: 0;
          transform: translate(-50%, -40px) scale(1.1);
        }
      }

      .tank-hint {
        position: absolute;
        left: 50%;
        bottom: 12px;
        transform: translateX(-50%);
        margin: 0;
        font-size: 10.5px;
        color: rgba(200, 235, 255, 0.42);
        white-space: nowrap;
        pointer-events: none;
      }

      /* ---------------- 访客墙 ---------------- */

      .wall {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 20px 18px;
      }

      .wall-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
      }

      .wall-count {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .wall-add {
        margin-left: auto;
        padding: 7px 14px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 8px;
        background: rgba(111, 140, 255, 0.22);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .wall-add:hover {
        background: rgba(111, 140, 255, 0.38);
      }

      .wall-grid {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
        align-content: start;
        gap: 10px;
        overflow: auto;
      }

      .wall-item {
        display: grid;
        justify-items: center;
        gap: 6px;
        padding: 8px 4px;
        border-radius: 10px;
        transition: background-color 0.18s ease;
      }

      .wall-item:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .wall-item img {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.14);
        object-fit: cover;
      }

      .wall-item span {
        max-width: 78px;
        overflow: hidden;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.62);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .wall-empty {
        grid-column: 1 / -1;
        margin: 0;
        padding: 30px 0;
        font-size: 12.5px;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
      }

      .wall-form {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .wall-form[hidden] {
        display: none;
      }

      .wall-name {
        flex: 1;
        min-width: 140px;
        padding: 8px 10px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        outline: none;
      }

      .wall-name:focus {
        border-color: rgba(111, 140, 255, 0.6);
      }

      .wall-pick {
        max-width: 168px;
        overflow: hidden;
        padding: 8px 12px;
        border: 1px dashed rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.66);
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: pointer;
      }

      .wall-pick:hover {
        border-color: rgba(111, 140, 255, 0.5);
        color: #fff;
      }

      .wall-submit {
        padding: 8px 16px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(150deg, #6f8cff, #9b6bff);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .wall-submit:disabled {
        opacity: 0.6;
        cursor: default;
      }

      .wall-note {
        min-height: 16px;
        margin: 8px 0 0;
        font-size: 11px;
        color: rgba(255, 212, 121, 0.85);
      }

      /* ---------------- 排行榜 ---------------- */

      .rank {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 18px 14px;
      }

      .rank-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }

      .rank-status {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .rank-join {
        margin-left: auto;
        padding: 7px 14px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 8px;
        background: rgba(142, 230, 168, 0.18);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .rank-join:hover:not(:disabled) {
        background: rgba(142, 230, 168, 0.32);
      }

      .rank-join:disabled {
        cursor: default;
        opacity: 0.72;
      }

      .rank-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 4px;
        overflow: auto;
      }

      .rank-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: 8px;
      }

      .rank-row.is-top {
        background: rgba(255, 212, 121, 0.08);
      }

      .rank-no {
        width: 20px;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.32);
      }

      .rank-row.is-top .rank-no {
        color: #ffd479;
      }

      .rank-name {
        flex: 1;
        overflow: hidden;
        font-size: 12.5px;
        color: #f2f5fa;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .rank-time {
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.5);
      }

      .rank-empty {
        margin: 0;
        padding: 26px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
      }

      .rank-note {
        margin: 10px 0 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.32);
      }

      /* ---------------- 每日抽奖 ---------------- */

      .draw {
        display: grid;
        align-content: center;
        justify-items: center;
        gap: 16px;
        height: 100%;
        padding: 20px;
      }

      .draw-card {
        display: grid;
        place-items: center;
        width: 148px;
        height: 186px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 14px;
        background: linear-gradient(160deg, rgba(111, 140, 255, 0.28), rgba(155, 107, 255, 0.16));
        box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.8);
        transition: background 0.4s ease, border-color 0.4s ease;
      }

      .draw-card.is-shaking {
        animation: drawShake 0.12s linear infinite;
      }

      .draw-card.is-bonus {
        border-color: rgba(255, 212, 121, 0.5);
        background: linear-gradient(160deg, rgba(255, 212, 121, 0.34), rgba(209, 144, 42, 0.18));
      }

      @keyframes drawShake {
        0%,
        100% {
          transform: rotate(-1.6deg) translateY(0);
        }
        50% {
          transform: rotate(1.6deg) translateY(-3px);
        }
      }

      .draw-mark {
        font-family: var(--font-serif);
        font-size: 44px;
        line-height: 1;
        color: rgba(255, 255, 255, 0.85);
      }

      .draw-text {
        max-width: 320px;
        margin: 0;
        font-size: 13px;
        line-height: 1.9;
        color: rgba(255, 255, 255, 0.78);
        text-align: center;
      }

      .draw-btn {
        padding: 10px 22px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(150deg, #6f8cff, #9b6bff);
        color: #fff;
        font: inherit;
        font-size: 13px;
        cursor: pointer;
      }

      .draw-btn:disabled {
        cursor: default;
        opacity: 0.55;
      }

      /* ---------------- 民主议会 ---------------- */

      .council {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 20px 14px;
      }

      .council-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 12px;
      }

      .council-status {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
      }

      .council-tip {
        margin-left: auto;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.3);
      }

      .council-retry {
        padding: 3px 10px;
        border: 1px solid rgba(167, 139, 250, 0.42);
        border-radius: 6px;
        background: rgba(167, 139, 250, 0.16);
        color: #d9c9ff;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .council-retry:hover {
        background: rgba(167, 139, 250, 0.3);
      }

      .council-retry[hidden] {
        display: none;
      }

      .council-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 16px;
        overflow: auto;
        padding-right: 6px;
      }

      .council-list::-webkit-scrollbar {
        width: 6px;
      }

      .council-list::-webkit-scrollbar-thumb {
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.14);
      }

      .council-list::-webkit-scrollbar-track {
        background: transparent;
      }

      .council-item {
        display: grid;
        gap: 7px;
      }

      .council-title {
        margin: 0;
        font-size: 13px;
        color: #fff;
      }

      .council-opts {
        display: grid;
        gap: 5px;
      }

      .council-opt {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        overflow: hidden;
        padding: 9px 11px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.03);
        color: inherit;
        font: inherit;
        font-size: 12px;
        text-align: left;
        cursor: pointer;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }

      .council-opt:not(:disabled):hover {
        border-color: rgba(167, 139, 250, 0.5);
        background: rgba(167, 139, 250, 0.1);
      }

      .council-opt:disabled {
        cursor: default;
      }

      .council-bar {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        background: linear-gradient(90deg, rgba(167, 139, 250, 0.32), rgba(109, 40, 217, 0.22));
        transition: width 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
      }

      .council-opt.is-mine {
        border-color: rgba(167, 139, 250, 0.6);
      }

      .council-opt.is-mine .council-bar {
        background: linear-gradient(90deg, rgba(167, 139, 250, 0.5), rgba(109, 40, 217, 0.36));
      }

      .council-label {
        position: relative;
        flex: 1;
        overflow: hidden;
        color: rgba(255, 255, 255, 0.85);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .council-num {
        position: relative;
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.45);
      }

      .council-opt.is-mine .council-num {
        color: #d9c9ff;
      }

      .council-meta {
        margin: 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.34);
      }

      .council-empty {
        margin: 0;
        padding: 40px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
      }

      /* ---------------- 匿名树洞 ---------------- */

      .hole {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 14px 18px 10px;
      }

      .hole-top {
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      }

      .hole-topic-label {
        margin: 0 0 4px;
        font-size: 10px;
        letter-spacing: 0.14em;
        color: rgba(255, 255, 255, 0.32);
      }

      .hole-topic {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 15px;
        color: #ffd479;
      }

      .hole-form {
        display: grid;
        gap: 6px;
        margin: 12px 0;
      }

      .hole-input {
        width: 100%;
        min-height: 56px;
        max-height: 140px;
        padding: 9px 11px;
        resize: vertical;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.04);
        color: #eef1f7;
        font: inherit;
        font-size: 12.5px;
        line-height: 1.7;
        outline: none;
      }

      .hole-input:focus {
        border-color: rgba(168, 191, 133, 0.6);
      }

      .hole-form-bar {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .hole-count {
        font-size: 10.5px;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.3);
      }

      .hole-send {
        margin-left: auto;
        padding: 7px 16px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(150deg, #7f9e5a, #4a6b34);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .hole-send:disabled {
        cursor: default;
        opacity: 0.5;
      }

      .hole-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 10px;
        overflow: auto;
        padding-right: 4px;
      }

      .hole-item {
        position: relative;
        padding: 11px 13px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
      }

      .hole-item.is-featured {
        border-color: rgba(255, 212, 121, 0.3);
        background: rgba(255, 212, 121, 0.05);
      }

      .hole-badge {
        position: absolute;
        top: -6px;
        right: 10px;
        padding: 2px 7px;
        border-radius: 4px;
        background: linear-gradient(150deg, #ffd479, #d19a2e);
        color: #3a2a08;
        font-size: 9px;
        font-weight: 600;
      }

      .hole-text {
        margin: 0 0 8px;
        font-size: 12.5px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.86);
        white-space: pre-wrap;
        word-break: break-word;
      }

      .hole-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.34);
      }

      .hole-nick {
        color: rgba(168, 191, 133, 0.9);
      }

      .hole-reply-toggle {
        margin-left: auto;
        padding: 2px 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 5px;
        background: none;
        color: rgba(255, 255, 255, 0.5);
        font: inherit;
        font-size: 10.5px;
        cursor: pointer;
      }

      .hole-reply-toggle:hover {
        border-color: rgba(255, 255, 255, 0.25);
        color: #fff;
      }

      .hole-replies {
        display: grid;
        gap: 7px;
        margin-top: 10px;
        padding-top: 9px;
        border-top: 1px dashed rgba(255, 255, 255, 0.08);
      }

      .hole-reply {
        font-size: 11.5px;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.7);
      }

      .hole-reply-nick {
        margin-right: 6px;
        color: rgba(168, 191, 133, 0.85);
      }

      .hole-reply-empty {
        margin: 0;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.28);
      }

      .hole-reply-form {
        display: flex;
        gap: 6px;
      }

      .hole-reply-input {
        flex: 1;
        min-width: 0;
        padding: 6px 9px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.04);
        color: #eef1f7;
        font: inherit;
        font-size: 11.5px;
        outline: none;
      }

      .hole-reply-form button {
        padding: 6px 12px;
        border: 0;
        border-radius: 6px;
        background: rgba(168, 191, 133, 0.3);
        color: #d9e8c2;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .hole-empty {
        margin: 0;
        padding: 40px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.35);
        text-align: center;
      }

      .hole-status {
        min-height: 14px;
        margin: 6px 0 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.32);
      }

      /* ---------------- 新闻联播 ---------------- */

      .news {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 18px 12px;
      }

      .news-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .news-avatar {
        width: 46px;
        height: 58px;
        object-fit: contain;
        filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.45));
      }

      .news-name {
        margin: 0 0 3px;
        font-family: var(--font-serif);
        font-size: 15px;
        color: #fff;
      }

      .news-date {
        margin: 0;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.42);
      }

      .news-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 13px;
        overflow: auto;
        padding: 14px 2px 8px;
      }

      .news-item {
        display: grid;
        gap: 5px;
        opacity: 0;
        animation: newsIn 0.5s ease forwards;
      }

      @keyframes newsIn {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      .news-tag {
        justify-self: start;
        padding: 1px 7px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.08);
        font-size: 9.5px;
        color: rgba(255, 255, 255, 0.5);
      }

      .news-text {
        margin: 0;
        font-size: 12.5px;
        line-height: 1.9;
        color: rgba(255, 255, 255, 0.82);
      }

      .news-foot {
        margin: 6px 0 0;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 10px;
        color: rgba(255, 255, 255, 0.28);
        text-align: right;
      }

      /* ---------------- 社会网络 ---------------- */

      .social {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 14px 18px 10px;
      }

      .social-me {
        margin-bottom: 14px;
      }

      .social-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid rgba(240, 171, 252, 0.22);
        border-radius: 12px;
        background: linear-gradient(150deg, rgba(240, 171, 252, 0.13), rgba(126, 34, 206, 0.09));
      }

      .social-face {
        flex: none;
        width: 52px;
        height: 66px;
        object-fit: contain;
      }

      .social-info {
        flex: 1;
        min-width: 0;
      }

      .social-name {
        margin: 0 0 3px;
        font-size: 14px;
        color: #fff;
      }

      .social-bio {
        margin: 0 0 5px;
        overflow: hidden;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.55);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .social-meta {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.4);
      }

      .social-role {
        padding: 1px 6px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.62);
      }

      .social-edit {
        flex: none;
        padding: 5px 12px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 7px;
        background: none;
        color: rgba(255, 255, 255, 0.7);
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .social-edit:hover {
        border-color: rgba(240, 171, 252, 0.5);
        color: #fff;
      }

      .social-card-btns {
        display: grid;
        gap: 5px;
        flex: none;
      }

      .social-edit.is-quiet {
        border-color: transparent;
        color: rgba(255, 255, 255, 0.4);
        font-size: 10px;
      }

      .auth-form {
        display: grid;
        gap: 8px;
        padding: 14px 16px;
        border: 1px solid rgba(240, 171, 252, 0.26);
        border-radius: 12px;
        background: rgba(240, 171, 252, 0.07);
      }

      .auth-title {
        margin: 0;
        font-size: 14px;
        color: #fff;
      }

      .auth-note {
        margin: 0 0 2px;
        font-size: 10.5px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.42);
      }

      .auth-bar {
        display: flex;
        gap: 8px;
        margin-top: 2px;
      }

      .auth-btn {
        flex: 1;
        padding: 7px 0;
        border: 0;
        border-radius: 7px;
        background: linear-gradient(150deg, #c084fc, #7e22ce);
        color: #fff;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .auth-btn.is-ghost {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.72);
      }

      .auth-btn:disabled {
        cursor: default;
        opacity: 0.5;
      }

      .auth-msg {
        min-height: 14px;
        margin: 2px 0 0;
        font-size: 10.5px;
        color: #ffb4b4;
      }

      .hole-auth,
      .council-auth {
        margin-bottom: 12px;
      }

      .hole-auth:empty,
      .council-auth:empty {
        display: none;
      }

      .hole-auth-tip {
        margin: 8px 0 0;
        font-size: 10.5px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.4);
      }

      .social-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 10px;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.42);
      }

      .social-tip {
        margin-left: auto;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.28);
      }

      .social-list {
        flex: 1;
        min-height: 0;
        display: grid;
        align-content: start;
        gap: 7px;
        overflow: auto;
        padding-right: 4px;
      }

      .social-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 11px;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.03);
      }

      .social-row-face {
        flex: none;
        width: 32px;
        height: 40px;
        object-fit: contain;
      }

      .social-row-info {
        flex: 1;
        min-width: 0;
      }

      .social-row-name {
        margin: 0 0 2px;
        font-size: 12px;
        color: #fff;
      }

      .social-row-bio {
        margin: 0;
        overflow: hidden;
        font-size: 10.5px;
        color: rgba(255, 255, 255, 0.4);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .social-row-role {
        flex: none;
        font-size: 9.5px;
        color: rgba(255, 255, 255, 0.35);
      }

      .social-follow {
        flex: none;
        padding: 4px 11px;
        border: 1px solid rgba(240, 171, 252, 0.4);
        border-radius: 6px;
        background: rgba(240, 171, 252, 0.14);
        color: #f3d9ff;
        font: inherit;
        font-size: 10.5px;
        cursor: pointer;
      }

      .social-follow.is-on {
        border-color: rgba(255, 255, 255, 0.14);
        background: transparent;
        color: rgba(255, 255, 255, 0.45);
      }

      .social-form {
        display: grid;
        gap: 8px;
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
      }

      .social-picks {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .social-pick {
        width: 38px;
        height: 46px;
        padding: 2px;
        border: 1px solid transparent;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
      }

      .social-pick img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .social-pick.is-on {
        border-color: rgba(240, 171, 252, 0.7);
        background: rgba(240, 171, 252, 0.15);
      }

      .social-input {
        padding: 7px 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.04);
        color: #eef1f7;
        font: inherit;
        font-size: 12px;
        outline: none;
      }

      .social-input:focus {
        border-color: rgba(240, 171, 252, 0.6);
      }

      .social-form-bar {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
      }

      .social-cancel {
        padding: 6px 14px;
        border: 0;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.07);
        color: rgba(255, 255, 255, 0.6);
        font: inherit;
        font-size: 11.5px;
        cursor: pointer;
      }

      .social-save {
        padding: 6px 16px;
        border: 0;
        border-radius: 7px;
        background: linear-gradient(150deg, #c084fc, #7e22ce);
        color: #fff;
        font: inherit;
        font-size: 11.5px;
        cursor: pointer;
      }

      .social-empty {
        margin: 0;
        padding: 40px 0;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.35);
        text-align: center;
      }

      /* ---------------- 关机画面 ---------------- */

      .power-screen {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: #000;
        opacity: 0;
        transition: opacity 0.55s ease;
        cursor: pointer;
      }

      /* display: grid 会盖掉 [hidden] 的默认样式，这里补回来 */
      .power-screen[hidden],
      .power-menu[hidden] {
        display: none;
      }

      .power-screen.is-on {
        opacity: 1;
      }

      .power-inner {
        display: grid;
        justify-items: center;
        gap: 18px;
      }

      .power-logo {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border-radius: 15px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        font-family: var(--font-serif);
        font-size: 27px;
        color: #fff;
        opacity: 0;
        transform: scale(0.9);
        transition: opacity 0.4s 0.25s ease, transform 0.5s 0.25s cubic-bezier(0.2, 0.9, 0.3, 1.3);
      }

      .power-screen.is-on .power-logo {
        opacity: 1;
        transform: none;
      }

      .power-hint {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.42);
      }

      /* ---------------- 开机动画 ---------------- */

      .boot {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: grid;
        place-items: center;
        background: #05060a;
        transition: opacity 0.55s ease, visibility 0s 0.55s;
      }

      .boot.is-done {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .boot-inner {
        display: grid;
        justify-items: center;
        gap: 20px;
      }

      .boot-logo {
        display: grid;
        place-items: center;
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: linear-gradient(150deg, #6f8cff, #b06eff);
        box-shadow: 0 18px 40px -16px rgba(111, 140, 255, 0.6);
        font-family: var(--font-serif);
        font-size: 29px;
        color: #fff;
        animation: bootLogo 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.25) both;
      }

      .boot-track {
        width: 152px;
        height: 3px;
        border-radius: 2px;
        background: rgba(255, 255, 255, 0.12);
        overflow: hidden;
      }

      .boot-bar {
        display: block;
        width: 0;
        height: 100%;
        border-radius: 2px;
        background: linear-gradient(90deg, #6f8cff, #b06eff);
        /* 用 CSS 动画而不是 JS 设宽度，脚本晚到也不影响进度条起步 */
        animation: bootFill 1.2s 0.15s cubic-bezier(0.3, 0.8, 0.4, 1) forwards;
      }

      @keyframes bootFill {
        to {
          width: 100%;
        }
      }

      .boot-text {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.05em;
        color: rgba(255, 255, 255, 0.45);
        transition: color 0.3s ease;
      }

      .boot-text.is-ready {
        color: rgba(255, 255, 255, 0.82);
      }

      @keyframes bootLogo {
        from {
          opacity: 0;
          transform: scale(0.86);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      /* ---------------- Dock ---------------- */

      .dock {
        position: absolute;
        left: 50%;
        bottom: calc(14px + env(safe-area-inset-bottom, 0px));
        transform: translateX(-50%);
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 13px;
        border-radius: 18px;
        background: rgba(20, 22, 30, 0.55);
        backdrop-filter: blur(22px) saturate(1.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
      }

      .dock-item {
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 12px;
        background: none;
        cursor: pointer;
        transition: transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.4);
      }

      .dock-item:hover {
        transform: translateY(-8px) scale(1.12);
      }

      .dock-glyph {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 12px;
        position: relative;
      }

      .dock-glyph.di-folder::before,
      .dock-glyph.di-folder::after,
      .dock-glyph.di-person::before,
      .dock-glyph.di-person::after,
      .dock-glyph.di-music::before,
      .dock-glyph.di-music::after,
      .dock-glyph.di-ach::before,
      .dock-glyph.di-ach::after,
      .dock-glyph.di-tank::before,
      .dock-glyph.di-tank::after,
      .dock-glyph.di-wall::before,
      .dock-glyph.di-rank::before,
      .dock-glyph.di-draw::before,
      .dock-glyph.di-draw::after,
      .dock-glyph.di-vote::before,
      .dock-glyph.di-vote::after,
      .dock-glyph.di-hole::before,
      .dock-glyph.di-tv::before,
      .dock-glyph.di-tv::after,
      .dock-glyph.di-net::before,
      .dock-glyph.di-gear::before,
      .dock-glyph.di-gear::after,
      .dock-glyph.di-home::before,
      .dock-glyph.di-home::after {
        content: "";
        position: absolute;
      }

      .dock-glyph.di-folder::before {
        left: 5px;
        top: 9px;
        width: 19px;
        height: 6px;
        border-radius: 2px 2px 0 0;
        background: rgba(255, 255, 255, 0.55);
      }
      .dock-glyph.di-folder::after {
        inset: 14px 6px 8px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.88);
      }
      .dock-glyph.di-person::before {
        left: 50%;
        top: 9px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-person::after {
        left: 50%;
        bottom: 8px;
        width: 26px;
        height: 15px;
        border-radius: 13px 13px 4px 4px;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-term::before {
        content: ">_";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: ui-monospace, Consolas, monospace;
        font-size: 17px;
        color: #7ef0b0;
      }
      .dock-glyph.di-music {
        background: linear-gradient(140deg, #ff9ec2 0%, #a83f74 100%);
      }
      .dock-glyph.di-music::before {
        inset: 9px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
      }
      .dock-glyph.di-music::after {
        inset: 17px;
        border-radius: 50%;
        background: #a83f74;
      }

      .dock-glyph.di-ach {
        background: linear-gradient(160deg, #ffd479 0%, #d1902a 100%);
      }
      .dock-glyph.di-ach::before {
        left: 13px;
        top: 10px;
        width: 20px;
        height: 19px;
        border-radius: 0 0 11px 11px;
        background: rgba(255, 255, 255, 0.94);
      }
      .dock-glyph.di-ach::after {
        left: 18px;
        bottom: 9px;
        width: 10px;
        height: 9px;
