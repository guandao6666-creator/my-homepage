---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Icon from "../components/Icon.astro";
import { SITE, HOME_LATEST, formatShortDate } from "../lib/site";
import { getAllPosts, collectTags } from "../lib/posts";

const posts = await getAllPosts();
const tags = collectTags(posts).slice(0, 8);
const featured = posts.filter((post) => post.featured).slice(0, 2);
const hero = featured.length ? featured : posts.slice(0, 2);
const latest = posts.filter((post) => !hero.includes(post)).slice(0, HOME_LATEST);
const lastUpdated = posts[0]?.pubDate;
const totalMinutes = posts.reduce((sum, post) => sum + post.minutes, 0);
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy rise">
        <span class="eyebrow">Est. {SITE.startYear} · 独立写作</span>
        <h1>
          写下来，<br />
          <em>才算真的想清楚。</em>
        </h1>
        <p class="lede">
          你好，我是{SITE.author}，大连理工大学的学生，河南固始人。
          喜欢骑行，正在用 AI 搭自己的网站——这里记录我的日常、学习，和一些还没想透的问题。
        </p>

        <div class="hero-actions">
          <a class="btn btn--solid" href="/blog/">
            开始阅读
            <Icon name="arrow-right" size={15} />
          </a>
          <a class="btn" href="/about/">关于我</a>
        </div>

        {posts.length > 0 ? (
          <dl class="stats">
            <div>
              <dt>文章</dt>
              <dd>{posts.length}<span>篇</span></dd>
            </div>
            <div>
              <dt>标签</dt>
              <dd>{collectTags(posts).length}<span>个</span></dd>
            </div>
            <div>
              <dt>阅读时长</dt>
              <dd>{totalMinutes}<span>分钟</span></dd>
            </div>
          </dl>
        ) : (
          <p class="hero-hint">
            第一批文章正在路上。想先认识我，可以看 <a href="/about/">关于我</a>。
          </p>
        )}
      </div>

      <aside class="hero-aside rise" style="animation-delay:.12s">
        <div class="now-card">
          <div class="now-head">
            <span class="dot-live" aria-hidden="true"></span>
            此刻在做
          </div>
          <ul class="now-list">
            <li>
              <span class="now-tag">在做</span>
              用 AI 搭自己的博客和各种网站，边做边学。
            </li>
            <li>
              <span class="now-tag">在学</span>
              AI，还在很前面的阶段，欢迎指导。
            </li>
            <li>
              <span class="now-tag">在骑</span>
              骑行总里程已过 4000 公里，有空就想找条新路线。
            </li>
          </ul>
          {lastUpdated && (
            <p class="now-foot">
              最近更新 · {formatShortDate(lastUpdated)}
            </p>
          )}
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ FEATURED ============ -->
  {hero.length > 0 && (
    <section class="section featured">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow">精选</span>
            <h2>值得先读的两篇</h2>
          </div>
          <a class="more" href="/blog/">
            全部文章
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div class="featured-grid">
          {hero.map((post) => (
            <PostCard post={post} variant="card" eager />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ LATEST ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">近期</span>
          <h2>最新写下的</h2>
        </div>
        <a class="more" href="/blog/">
          查看归档
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="post-list">
        {latest.map((post, i) => (
          <PostCard post={post} index={i} />
        ))}
        {latest.length === 0 && (
          <p class="empty">
            {posts.length === 0 ? (
              "还没有文章。第一篇正在路上，写完就会出现在这里。"
            ) : (
              <>还没有更多文章，去 <a href="/blog/">文章归档</a> 看看。</>
            )}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ============ TAGS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="tag-band">
        <div class="tag-band-copy">
          <span class="eyebrow">主题</span>
          <h2>沿着兴趣往下挖</h2>
          <p>文章按主题归档，点开任意标签就能看到同一线索下的全部内容。</p>
        </div>
        <div class="tag-cloud">
          {tags.map((tag) => (
            <a class="tag-chip" href={`/tags/${encodeURIComponent(tag.tag)}/`}>
              <span>{tag.tag}</span>
              <em>{tag.count}</em>
            </a>
          ))}
          <a class="tag-chip tag-chip--ghost" href="/tags/">
            全部标签
            <Icon name="arrow-right" size={13} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT TEASER ============ -->
  <section class="section">
    <div class="wrap">
      <div class="about-teaser">
        <div class="about-mark" aria-hidden="true">管</div>
        <div class="about-copy">
          <span class="eyebrow">关于</span>
          <h2>一个喜欢把东西做出来的人</h2>
          <p>
            在豫南的固始长大，现在在大连读书。喜欢长途骑行，也在研究 AI——
            喜欢亲手做过之后才真正理解的感觉。
          </p>
          <a class="btn" href="/about/">读完整介绍 <Icon name="arrow-right" size={14} /></a>
        </div>
        <ul class="about-facts">
          <li><span>坐标</span>大连 · 在校学生</li>
          <li><span>家乡</span>河南固始</li>
          <li><span>爱好</span>骑行 · AI 建站</li>
          <li><span>邮箱</span>{SITE.email}</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    padding: 74px 0 40px;
    overflow: hidden;
  }

  .hero::after {
    content: "";
    position: absolute;
    top: -160px;
    right: -120px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
    filter: blur(10px);
    z-index: -1;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: 56px;
    align-items: start;
  }

  .hero h1 {
    margin: 18px 0 0;
    font-size: clamp(38px, 5.4vw, 64px);
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--accent);
    position: relative;
    padding-bottom: 0.04em;
  }

  .hero h1 em::after {
    content: "";
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    bottom: 0.02em;
    height: 0.09em;
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent) 42%, transparent);
  }

  .lede {
    margin: 22px 0 0;
    max-width: 33em;
    font-size: 16px;
    line-height: 1.95;
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .stats {
    display: flex;
    gap: 34px;
    margin: 42px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .hero-hint {
    margin: 38px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
    max-width: 34em;
  }

  .hero-hint a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .stats dt {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stats dd {
    margin: 6px 0 0;
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stats dd span {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--muted);
    margin-left: 4px;
    letter-spacing: 0;
  }

  /* ---------------- now card ---------------- */
  .now-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 22px 24px 20px;
    box-shadow: var(--shadow-sm);
  }

  .now-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .dot-live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #45a06a;
    box-shadow: 0 0 0 3px color-mix(in srgb, #45a06a 22%, transparent);
    animation: pulse 2.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .now-list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .now-list li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 10px;
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--ink-2);
  }

  .now-tag {
    font-size: 11px;
    color: var(--accent-ink);
    background: var(--accent-wash);
    border-radius: 5px;
    text-align: center;
    height: 21px;
    line-height: 21px;
    margin-top: 2px;
  }

  .now-foot {
    margin: 20px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    color: var(--muted);
  }

  /* ---------------- section head ---------------- */
  .featured {
    padding-top: 20px;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .section-head h2 {
    margin-top: 10px;
    font-size: clamp(24px, 3vw, 30px);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), gap 0.2s var(--ease);
  }

  .more:hover {
    color: var(--accent);
    gap: 10px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .post-list {
    border-bottom: 1px solid var(--line);
  }

  .empty {
    padding: 30px 0;
    color: var(--muted);
    font-size: 14px;
  }

  .empty a {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }

  /* ---------------- tags ---------------- */
  .tag-band {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 44px;
    padding: 40px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .tag-band-copy h2 {
    margin: 10px 0 12px;
    font-size: 26px;
  }

  .tag-band-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.85;
    max-width: 26em;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-content: start;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-sunk);
    font-size: 13.5px;
    color: var(--ink-2);
    transition: all 0.22s var(--ease);
  }

  .tag-chip em {
    font-style: normal;
    font-size: 10px;
    line-height: 1;
    padding: 3px 5px;
    border-radius: 999px;
    color: var(--muted);
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-family: var(--font-mono);
  }

  .tag-chip:hover {
    background: var(--accent-wash);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent-ink);
    transform: translateY(-1px);
  }

  .tag-chip--ghost {
    background: transparent;
    border-style: dashed;
    color: var(--muted);
  }

  /* ---------------- about teaser ---------------- */
  .about-teaser {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 260px;
    gap: 34px;
    align-items: start;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }

  .about-mark {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 1;
    color: var(--accent);
    opacity: 0.25;
    user-select: none;
  }

  .about-copy h2 {
    margin: 10px 0 14px;
    font-size: 26px;
  }

  .about-copy p {
    margin: 0 0 22px;
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.95;
    max-width: 34em;
  }

  .about-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    font-size: 13px;
  }

  .about-facts li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--line);
    color: var(--ink-2);
  }

  .about-facts span {
    color: var(--muted);
    font-size: 11.5px;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .tag-band,
    .about-teaser {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .about-mark {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding-top: 44px;
    }
    .featured-grid {
      grid-template-columns: 1fr;
    }
    .tag-band {
      padding: 26px 22px;
    }
    .stats {
      gap: 24px;
    }
    .stats dd {
      font-size: 24px;
    }
  }
</style>
