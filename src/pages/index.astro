---
const projects = [
  {
    title: "个人博客",
    description: "记录学习、生活、技术探索与日常思考。",
    tag: "Writing",
  },
  {
    title: "创意实验室",
    description: "尝试网页开发、AI 工具与有趣的小项目。",
    tag: "Experiments",
  },
  {
    title: "学习档案",
    description: "整理课程笔记、实践经验和阶段性成果。",
    tag: "Learning",
  },
];

const skills = ["Astro", "Markdown", "AI 工具", "持续学习"];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f4" />
    <meta
      name="description"
      content="个人主页与博客，记录学习、创作和生活。"
    />
    <title>我的个人空间 · Home</title>
    <style>
      :root {
        font-family: Inter, "PingFang SC", "Microsoft YaHei", sans-serif;
        color: #20221f;
        background: #f7f7f4;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        --muted: #777b72;
        --line: #e5e6df;
        --green: #416b50;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      a { color: inherit; text-decoration: none; }
      button { font: inherit; }

      .wrap {
        width: min(1080px, calc(100% - 40px));
        margin: 0 auto;
      }

      header {
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }

      .brand span { color: var(--green); }

      nav { display: flex; align-items: center; gap: 28px; }
      nav a { color: var(--muted); font-size: 14px; }
      nav a:hover { color: var(--green); }

      #theme {
        border: 1px solid var(--line);
        background: transparent;
        padding: 8px 12px;
        border-radius: 20px;
        cursor: pointer;
      }

      .hero {
        padding: 100px 0 86px;
        display: grid;
        grid-template-columns: 1.5fr 0.8fr;
        gap: 60px;
        align-items: center;
      }

      .eyebrow {
        color: var(--green);
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 700;
      }

      h1 {
        font-size: clamp(42px, 6vw, 70px);
        line-height: 1.13;
        letter-spacing: -3px;
        margin: 20px 0;
      }

      h1 span { color: var(--green); }
      .intro {
        color: var(--muted);
        line-height: 2;
        max-width: 540px;
        font-size: 16px;
      }

      .actions { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }

      .btn {
        display: inline-flex;
        align-items: center;
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 14px;
        border: 1px solid var(--line);
      }

      .btn.primary { background: #202820; color: white; border-color: #202820; }
      .btn:hover { transform: translateY(-2px); }

      .portrait {
        aspect-ratio: 4 / 5;
        border-radius: 180px 180px 18px 18px;
        background: linear-gradient(145deg, #dce5d8, #a9bea9);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }

      .portrait::before {
        content: "";
        width: 190px;
        height: 190px;
        border-radius: 50%;
        background: #f4f1df;
        position: absolute;
        top: 16%;
        right: -18%;
      }

      .portrait .symbol {
        font-size: 100px;
        position: relative;
        z-index: 1;
      }

      .portrait small {
        position: absolute;
        bottom: 24px;
        left: 22px;
        color: #344c39;
        letter-spacing: 2px;
      }

      section { padding: 60px 0; border-top: 1px solid var(--line); }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 28px;
      }

      h2 { font-size: 28px; margin: 8px 0 0; letter-spacing: -1px; }
      .hint { color: var(--muted); font-size: 13px; }

      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

      .card {
        padding: 24px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        min-height: 180px;
        transition: transform .2s, box-shadow .2s;
      }

      .card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px #2028200b; }
      .tag { color: var(--green); font-size: 11px; letter-spacing: 1px; }
      .card h3 { font-size: 18px; margin: 22px 0 10px; }
      .card p { font-size: 13px; line-height: 1.9; color: var(--muted); margin: 0; }

      .about {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: start;
      }

      .about p { color: var(--muted); line-height: 2; font-size: 14px; }
      .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
      .chip { padding: 8px 12px; border: 1px solid var(--line); border-radius: 20px; font-size: 12px; }

      .contact {
        background: #e9eee5;
        border-radius: 14px;
        padding: 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .contact p { color: #687568; font-size: 14px; line-height: 1.8; }

      footer {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 28px 0;
        color: var(--muted);
        font-size: 12px;
      }

      body.dark {
        background: #171a17;
        color: #ecefe8;
        --muted: #a5aca1;
        --line: #343a33;
        --green: #a5c7a5;
      }

      body.dark .card { background: #202520; }
      body.dark .btn.primary { background: #dce8d8; color: #202820; }
      body.dark .contact { background: #252e25; }
      body.dark .contact p { color: #bdc9ba; }
      body.dark .portrait { background: linear-gradient(145deg, #455849, #293b2e); }
      body.dark .portrait::before { background: #d8dfd1; }

      @media (max-width: 700px) {
        .wrap { width: min(100% - 32px, 540px); }
        header { height: 66px; }
        nav { gap: 12px; }
        nav a { font-size: 12px; }
        .hero { grid-template-columns: 1fr; padding: 64px 0; gap: 30px; }
        h1 { letter-spacing: -2px; }
        .portrait { max-width: 260px; margin: 0 auto; width: 100%; }
        .grid { grid-template-columns: 1fr; }
        .about { grid-template-columns: 1fr; gap: 20px; }
        .section-head { align-items: start; flex-direction: column; }
        .contact { align-items: start; flex-direction: column; }
        footer { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="#">MY<span>.</span>SPACE</a>
        <nav aria-label="主导航">
          <a href="#projects">项目</a>
          <a href="#about">关于</a>
          <a href="#contact">联系</a>
          <button id="theme" type="button" aria-label="切换深色模式">◐</button>
        </nav>
      </header>

      <main>
        <section class="hero" style="border-top: 0">
          <div>
            <div class="eyebrow">A LITTLE SPACE OF MY OWN</div>
            <h1>你好，世界。<br />这里是<span>我的空间。</span></h1>
            <p class="intro">
              一个记录学习、探索与生活的个人角落。保持好奇，持续创造，
              把每一个微小的想法变成真实的作品。
            </p>
            <div class="actions">
              <a class="btn primary" href="#projects">探索我的项目 ↗</a>
              <a class="btn" href="#about">认识一下我</a>
            </div>
          </div>
          <div class="portrait" aria-label="个人头像占位图">
            <div class="symbol">✳</div>
            <small>KEEP EXPLORING</small>
          </div>
        </section>

        <section id="projects">
          <div class="section-head">
            <div>
              <div class="eyebrow">SELECTED WORK</div>
              <h2>正在探索的事</h2>
            </div>
            <span class="hint">一些想法，一些实践。</span>
          </div>
          <div class="grid">
            {projects.map((project) => (
              <article class="card">
                <span class="tag">{project.tag}</span>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="about">
          <div class="about">
            <div>
              <div class="eyebrow">A LITTLE ABOUT ME</div>
              <h2>关于我</h2>
            </div>
            <div>
              <p>
                我喜欢学习新知识，也喜欢把想法付诸实践。
                这个网站会慢慢收录我的项目、学习笔记和日常记录。
              </p>
              <p>
                这里的内容会持续更新。欢迎浏览，也欢迎交流。
              </p>
              <div class="chips">
                {skills.map((skill) => <span class="chip">{skill}</span>)}
              </div>
            </div>
          </div>
        </section>

        <section id="contact">
          <div class="contact">
            <div>
              <div class="eyebrow">LET'S CONNECT</div>
              <h2>保持联系</h2>
              <p>如果你对我的项目或文章感兴趣，欢迎与我交流。</p>
            </div>
            <a class="btn primary" href="mailto:hello@example.com">发送邮件 ↗</a>
          </div>
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} My Space</span>
        <span>用好奇心探索世界。</span>
      </footer>
    </div>

    <script>
      const button = document.querySelector("#theme");
      button?.addEventListener("click", () => {
        document.body.classList.toggle("dark");
      });
    </script>
  </body>
</html>