        /* Dock 的 backdrop-filter 会生成独立合成层，visibility 盖不住它 */
        display: none;
      }

      /* ---------------- 壁纸 ---------------- */

      .wallpaper {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(1100px 760px at 18% 12%, rgba(122, 86, 190, 0.55), transparent 62%),
