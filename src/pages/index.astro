---
import "../styles/global.css";
import { existsSync, readdirSync } from "node:fs";
import { join } from "node:path";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();

// 扫 public/music 下的音频，文件名当歌名
const musicDir = join(process.cwd(), "public", "music");
const trackFiles = existsSync(musicDir)
  ? readdirSync(musicDir)
      .filter((name) => /\.(mp3|m4a|ogg|wav|flac)$/i.test(name))
      .sort((a, b) => a.localeCompare(b, "zh"))
  : [];

// 构建时把议会数据抓下来内联进页面：
// 国内访问 supabase.co 经常挂住，运行时再拉会一直转圈。
// 构建在 GitHub / Cloudflare 跑，那边网络是通的。
const sbUrlBuild = import.meta.env.PUBLIC_SUPABASE_URL;
const sbKeyBuild = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

let councilSeed: { polls: unknown[]; counts: Record<string, Record<string, number>>; builtAt: number } = {
  polls: [],
  counts: {},
  builtAt: 0,
};

if (sbUrlBuild && sbKeyBuild) {
  try {
    const headers = { apikey: sbKeyBuild, Authorization: `Bearer ${sbKeyBuild}` };
    const [pRes, vRes] = await Promise.all([
      fetch(`${sbUrlBuild}/rest/v1/polls?select=id,title,kind,options&active=eq.true&order=created_at.asc`, {
        headers,
      }),
      fetch(`${sbUrlBuild}/rest/v1/votes?select=poll_id,option_index`, { headers }),
    ]);

    if (pRes.ok && vRes.ok) {
      const polls = (await pRes.json()) as unknown[];
      const votes = (await vRes.json()) as Array<{ poll_id: string; option_index: number }>;

      const counts: Record<string, Record<string, number>> = {};
      for (const v of votes) {
        counts[v.poll_id] ??= {};
        counts[v.poll_id][v.option_index] = (counts[v.poll_id][v.option_index] ?? 0) + 1;
      }

      councilSeed = { polls, counts, builtAt: Date.now() };
    }
  } catch {
    /* 构建时连不上就留空，前端会退回运行时请求 */
  }
}

const data = {
  posts: posts.map((post) => ({
    title: post.title,
    href: `/blog/${post.slug}/`,
    date: post.pubDate.toISOString().slice(0, 10),
    tags: post.tags,
    minutes: post.minutes,
  })),
  tracks: trackFiles.map((file) => ({
    src: `/music/${encodeURIComponent(file)}`,
    title: file.replace(/\.[^.]+$/, ""),
  })),
  site: {
    author: "管道",
    host: "guandao.xin",
  },
  council: councilSeed,
  // anon key 放前端是 Supabase 的正常用法，真正的权限由 RLS 兜
  // 生产环境走 /sb 同源反代（functions/sb/[[path]].js），避开国内直连 supabase.co 超时
  supabase: {
    url: import.meta.env.DEV ? (import.meta.env.PUBLIC_SUPABASE_URL ?? "") : "/sb",
    key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "",
  },
};
