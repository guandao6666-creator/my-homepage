---
import "../styles/global.css";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();

const data = {
  posts: posts.map((post) => ({
    title: post.title,
    href: `/blog/${post.slug}/`,
    date: post.pubDate.toISOString().slice(0, 10),
    tags: post.tags,
    minutes: post.minutes,
  })),
  site: {
    author: "管道",
    host: "guandao.xin",
  },
  // anon key 放前端是 Supabase 的正常用法，真正的权限由 RLS 兜
  supabase: {
    url: import.meta.env.PUBLIC_SUPABASE_URL ?? "",
    key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "",
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guandao OS · 管道</title>
    <meta name="description" content="把博客做成一个可以拖窗口的桌面。点「回博客」进入普通版。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <noscript>
      <style>
        .boot {
          display: none !important;
        }
      </style>
      <p style="padding: 24px; color: #eef1f7; font-size: 14px">
        这个桌面需要 JavaScript 才能运行。
        <a href="/home/" style="color: #9fb4ff">直接看博客 →</a>
      </p>
    </noscript>

    <div class="boot" id="boot">
      <div class="boot-inner">
        <span class="boot-logo">管</span>
        <div class="boot-track"><span class="boot-bar" id="boot-bar"></span></div>
        <p class="boot-text" id="boot-text">正在加载管道的数字世界……</p>
      </div>
    </div>

    <script is:inline>
      // 主脚本万一来不及执行，6 秒后也必须放人进桌面
      setTimeout(function () {
        var boot = document.getElementById("boot");
        if (boot) boot.style.display = "none";
      }, 6000);
    </script>

    <div class="os" id="os" data-wall="nebula">
      <div class="wallpaper"></div>

      <header class="menubar">
        <span class="mb-brand">Guandao OS</span>
        <nav class="mb-menu">
          <span>文件</span>
          <span>编辑</span>
          <span>视图</span>
          <span>窗口</span>
        </nav>
        <div class="mb-status">
          <span class="mb-dot"></span>
          <span id="mb-time">--:--</span>
          <button class="mb-power" id="mb-power" type="button" aria-label="电源">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3v9" stroke-linecap="round" />
              <path d="M6.5 6.6a8 8 0 1 0 11 0" stroke-linecap="round" />
            </svg>
          </button>
          <div class="power-menu" id="power-menu" hidden>
            <button type="button" data-power="restart">重新启动</button>
            <button type="button" data-power="shutdown">关机</button>
          </div>
        </div>
      </header>

      <main class="desk" id="desk">
        <div class="desk-icons">
          <button class="desk-icon" type="button" data-app="posts">
            <span class="di-glyph di-folder"></span>
            <span class="di-label">文章</span>
          </button>
          <button class="desk-icon" type="button" data-app="about">
            <span class="di-glyph di-person"></span>
            <span class="di-label">关于</span>
          </button>
          <button class="desk-icon" type="button" data-app="music">
            <span class="di-glyph di-music"></span>
            <span class="di-label">音乐</span>
          </button>
          <button class="desk-icon" type="button" data-app="terminal">
            <span class="di-glyph di-term"></span>
            <span class="di-label">终端</span>
          </button>
          <button class="desk-icon" type="button" data-app="achievements">
            <span class="di-glyph di-ach"></span>
            <span class="di-label">成就</span>
          </button>
          <button class="desk-icon" type="button" data-app="aquarium">
            <span class="di-glyph di-tank"></span>
            <span class="di-label">水族箱</span>
          </button>
          <button class="desk-icon" type="button" data-app="visitors">
            <span class="di-glyph di-wall"></span>
            <span class="di-label">访客墙</span>
          </button>
          <a class="desk-icon" href="/home/">
            <span class="di-glyph di-home"></span>
            <span class="di-label">回博客</span>
          </a>
        </div>

        <div class="windows" id="windows"></div>

        <div class="desk-pet" id="desk-pet" title="摸摸">
          <p class="pet-say" id="pet-say"></p>
          <img class="pet-img" src="/pet/whale-girl.webp" alt="" draggable="false" />
        </div>

        <p class="desk-hint" id="desk-hint">双击图标，或从下方程序坞打开</p>
      </main>

      <footer class="dock" id="dock">        <button class="dock-item" type="button" data-app="posts" title="文章">
          <span class="dock-glyph di-folder"></span>
        </button>
        <button class="dock-item" type="button" data-app="about" title="关于">
          <span class="dock-glyph di-person"></span>
        </button>
        <button class="dock-item" type="button" data-app="music" title="音乐">
          <span class="dock-glyph di-music"></span>
        </button>
        <button class="dock-item" type="button" data-app="terminal" title="终端">
          <span class="dock-glyph di-term"></span>
        </button>
        <button class="dock-item" type="button" data-app="achievements" title="成就">
          <span class="dock-glyph di-ach"></span>
        </button>
        <button class="dock-item" type="button" data-app="aquarium" title="水族箱">
          <span class="dock-glyph di-tank"></span>
        </button>
        <button class="dock-item" type="button" data-app="visitors" title="访客墙">
          <span class="dock-glyph di-wall"></span>
        </button>
        <button class="dock-item" type="button" data-app="settings" title="设置">
          <span class="dock-glyph di-gear"></span>
        </button>
        <span class="dock-sep"></span>
        <a class="dock-item dock-link" href="/home/" title="回到博客">
          <span class="dock-glyph di-home"></span>
        </a>
      </footer>
    </div>

    <div class="toast-stack" id="toast-stack"></div>

    <div class="power-screen" id="power-screen" hidden>
      <div class="power-inner">
        <span class="power-logo">管</span>
        <p class="power-hint" id="power-hint"></p>
      </div>
    </div>

    <script is:inline define:vars={{ OS_DATA: data }}>
      window.__OS__ = OS_DATA;
    </script>

    <script>
      (() => {
        /* ---------------- 开机动画 ---------------- */

        const boot = document.getElementById("boot");
        const bootBar = document.getElementById("boot-bar");
        const bootText = document.getElementById("boot-text");

        if (boot && bootBar && bootText) {
          let booted = false;

          const finishBoot = () => {
            if (booted) return;
            booted = true;
            boot.classList.add("is-done");
            window.setTimeout(() => boot.remove(), 650);
          };

          window.setTimeout(() => {
            bootText.textContent = "加载完成";
            bootText.classList.add("is-ready");
          }, 1400);

          window.setTimeout(finishBoot, 1900);

          // 急着进去可以点一下跳过
          boot.addEventListener("click", finishBoot);
        }

        const DATA = window.__OS__;
        if (!DATA) return;

        const os = document.getElementById("os");
        const windows = document.getElementById("windows");
        const hint = document.getElementById("desk-hint");
        if (!os || !windows || !hint) return;

        let zTop = 10;
        let cascade = 0;

        /* ---------------- 状态持久化 ---------------- */

        const STATE_KEY = "guandao.os.state.v1";

        interface WinState {
          left: number;
          top: number;
          minimized: boolean;
        }

        const readState = (): { wall?: string; windows?: Record<string, WinState> } => {
          try {
            return JSON.parse(localStorage.getItem(STATE_KEY) || "{}");
          } catch {
            return {};
          }
        };

        const writeState = (patch: Record<string, unknown>) => {
          try {
            localStorage.setItem(STATE_KEY, JSON.stringify({ ...readState(), ...patch }));
          } catch {
            /* 隐私模式写不进去，忽略即可 */
          }
        };

        const saveWindows = () => {
          const map: Record<string, WinState> = {};
          windows.querySelectorAll<HTMLElement>(".window").forEach((win) => {
            const app = win.dataset.app;
            if (!app) return;
            map[app] = {
              left: win.offsetLeft,
              top: win.offsetTop,
              minimized: win.classList.contains("is-minimized"),
            };
          });
          writeState({ windows: map });
        };

        /* ---------------- 成就 ---------------- */

        const ACH_KEY = "guandao.os.ach.v1";

        interface AchState {
          unlocked: Record<string, number>;
          visits: number;
          petClicks: number;
          apps: string[];
          reads: number;
        }

        interface Achievement {
          id: string;
          mark: string;
          name: string;
          desc: string;
        }

        const ACHIEVEMENTS: Achievement[] = [
          { id: "first", mark: "初", name: "第一位访客", desc: "第一次推开这扇门" },
          { id: "night", mark: "夜", name: "深夜探索者", desc: "凌晨还在这里逛" },
          { id: "dawn", mark: "晨", name: "赶早的人", desc: "天没亮就来了" },
          { id: "roam", mark: "游", name: "桌面漫游者", desc: "每个应用都打开过一遍" },
          { id: "hack", mark: ">_", name: "终端黑客", desc: "在终端敲下第一条命令" },
          { id: "music", mark: "♪", name: "音乐鉴赏家", desc: "听过「白饭时间」" },
          { id: "rice", mark: "饭", name: "白饭信徒", desc: "戳了鲸鲸十次" },
          { id: "power", mark: "关", name: "关机达人", desc: "认真把它关掉过一次" },
          { id: "regular", mark: "常", name: "常客", desc: "来过五次以上" },
          { id: "reader", mark: "读", name: "考古学家", desc: "翻过三篇文章" },
        ];

        const readAch = (): AchState => {
          try {
            const raw = JSON.parse(localStorage.getItem(ACH_KEY) || "{}");
            return {
              unlocked: raw.unlocked ?? {},
              visits: raw.visits ?? 0,
              petClicks: raw.petClicks ?? 0,
              apps: raw.apps ?? [],
              reads: raw.reads ?? 0,
            };
          } catch {
            return { unlocked: {}, visits: 0, petClicks: 0, apps: [], reads: 0 };
          }
        };

        const saveAch = (state: AchState) => {
          try {
            localStorage.setItem(ACH_KEY, JSON.stringify(state));
          } catch {
            /* 写不进去就算了 */
          }
        };

        const toastStack = document.getElementById("toast-stack");

        const showToast = (ach: Achievement) => {
          if (!toastStack) return;

          const el = document.createElement("div");
          el.className = "toast";

          const mark = document.createElement("span");
          mark.className = "toast-mark";
          mark.textContent = ach.mark;

          const body = document.createElement("span");
          body.className = "toast-body";

          const kicker = document.createElement("span");
          kicker.className = "toast-kicker";
          kicker.textContent = "解锁成就";

          const name = document.createElement("span");
          name.className = "toast-name";
          name.textContent = ach.name;

          body.append(kicker, name);
          el.append(mark, body);
          toastStack.appendChild(el);

          window.requestAnimationFrame(() => el.classList.add("is-in"));
          window.setTimeout(() => {
            el.classList.remove("is-in");
            window.setTimeout(() => el.remove(), 420);
          }, 3200);
        };

        const unlock = (id: string, silent = false) => {
          const state = readAch();
          if (state.unlocked[id]) return false;

          const ach = ACHIEVEMENTS.find((item) => item.id === id);
          if (!ach) return false;

          state.unlocked[id] = Date.now();
          saveAch(state);
          if (!silent) showToast(ach);
          return true;
        };

        /* ---------------- 窗口内容 ---------------- */

        const escapeHtml = (text: string) =>
          String(text).replace(
            /[&<>"]/g,
            (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch] as string,
          );

        const renderPosts = () => {
          const rows = DATA.posts
            .map(
              (post, index) => `
              <a class="file-row" href="${post.href}">
                <span class="file-icon"></span>
                <span class="file-main">
                  <span class="file-name">${escapeHtml(post.title)}</span>
                  <span class="file-meta">${post.date} · ${post.minutes} 分钟 · ${post.tags.map(escapeHtml).join(" / ")}</span>
                </span>
                <span class="file-index">${String(index + 1).padStart(2, "0")}</span>
              </a>`,
            )
            .join("");

          return `
            <div class="finder">
              <aside class="finder-side">
                <p class="side-title">位置</p>
                <span class="side-item is-active">全部文章</span>
                <span class="side-item">${DATA.posts.length} 篇</span>
                <p class="side-title">关于</p>
                <span class="side-item">${DATA.site.host}</span>
              </aside>
              <div class="finder-files">${rows || '<p class="finder-empty">还没有文章。</p>'}</div>
            </div>`;
        };

        const renderAbout = () => `
          <div class="about">
            <p class="about-kicker">关于这个站</p>
            <h2>${DATA.site.author}</h2>
            <p>
              大连理工大学智能制造专业在读。喜欢骑车、写代码，以及把学到的东西记下来。
            </p>
            <p>
              这个桌面是博客的另一种打开方式：文章、终端、设置都在窗口里。想要正常阅读，右下角的房子可以回到普通版。
            </p>
            <div class="about-links">
              <a href="/about/">关于页 →</a>
              <a href="/blog/">全部文章 →</a>
              <a href="/uses/">我用什么 →</a>
            </div>
          </div>`;

        const renderTerminal = () => `
          <div class="term">
            <div class="term-out" id="term-out">
              <p class="term-line term-muted">Guandao OS 1.0 · 输入 help 看可用命令</p>
            </div>
            <label class="term-input-row">
              <span class="term-prompt">~ $</span>
              <input class="term-input" id="term-input" type="text" autocomplete="off" spellcheck="false" />
            </label>
          </div>`;

        const renderSettings = () => `
          <div class="settings">
            <p class="side-title">壁纸</p>
            <div class="wall-picks">
              <button class="wall-pick is-active" type="button" data-wall="nebula">星云</button>
              <button class="wall-pick" type="button" data-wall="dusk">暮色</button>
              <button class="wall-pick" type="button" data-wall="deep">深海</button>
            </div>
            <p class="side-title">关于系统</p>
            <p class="settings-note">Guandao OS · 用 Astro 静态生成，没有框架，窗口拖动是原生的 pointer 事件。</p>
          </div>`;

        const renderMusic = () => `
          <div class="music">
            <div class="music-cover"><span class="cover-disc"></span></div>
            <div class="music-meta">
              <p class="music-title">白饭时间</p>
              <p class="music-sub">Guandao OS · 现场合成</p>
            </div>
            <div class="music-bar">
              <button class="music-play" id="music-play" type="button" aria-label="播放">▶</button>
              <canvas class="music-wave" id="music-wave" width="280" height="42"></canvas>
            </div>
            <p class="music-note">
              声音是 Web Audio 现场合成的四个和弦，没有音频文件，所以加载不花时间。
            </p>
          </div>`;

        const renderAchievements = () => {
          const state = readAch();

          const rows = ACHIEVEMENTS.map((ach) => {
            const got = Boolean(state.unlocked[ach.id]);
            return `
              <div class="ach ${got ? "is-got" : "is-locked"}">
                <span class="ach-mark">${got ? ach.mark : "?"}</span>
                <span class="ach-body">
                  <span class="ach-name">${got ? ach.name : "未解锁"}</span>
                  <span class="ach-desc">${got ? ach.desc : "继续逛逛看"}</span>
                </span>
              </div>`;
          }).join("");

          const count = ACHIEVEMENTS.filter((ach) => state.unlocked[ach.id]).length;

          return `
            <div class="ach-wrap">
              <p class="ach-head">已解锁 <b>${count}</b> / ${ACHIEVEMENTS.length}</p>
              <div class="ach-grid">${rows}</div>
            </div>`;
        };

        /* ---------------- 水族箱 ---------------- */

        const AI_FISH = [
          { id: "chatgpt", name: "ChatGPT" },
          { id: "deepseek", name: "DeepSeek" },
          { id: "claude", name: "Claude" },
          { id: "grok", name: "Grok" },
          { id: "gemini", name: "Gemini" },
          { id: "wenxin", name: "文心一言" },
          { id: "qwen", name: "千问" },
        ];

        const PHASE_TEXT: Record<string, string> = {
          dawn: "天刚亮，它们醒过来了 · 点水里投喂",
          day: "点水里投喂 · 七只都在",
          dusk: "日头下去了，游得慢些",
          night: "熄灯了，它们都安静下来",
        };

        /** 按时辰算当前档位 */
        const phaseNow = () => {
          const hour = new Date().getHours();
          if (hour >= 5 && hour < 9) return "dawn";
          if (hour >= 9 && hour < 17) return "day";
          if (hour >= 17 && hour < 21) return "dusk";
          return "night";
        };

        const renderAquarium = () => {
          const phase = phaseNow();

          const fish = AI_FISH.map(
            (ai, i) => `
              <div class="fish" data-ai="${ai.id}"
                style="--bg: url(/aquarium/${ai.id}.webp); --delay: ${-i * 1.3}s; left: ${5 + i * 12.5}%; top: ${16 + (i % 3) * 24}%">
                <span class="fish-name">${ai.name}</span>
              </div>`,
          ).join("");

          const bubbles = Array.from(
            { length: 10 },
            (_, i) =>
              `<span class="bubble" style="--size: ${4 + (i % 3) * 3}px; --dur: ${9 + i * 1.3}s; --delay: ${-i * 1.6}s; left: ${6 + i * 9}%"></span>`,
          ).join("");

          return `
            <div class="tank" id="tank" data-phase="${phase}">
              <div class="bubbles">${bubbles}</div>
              <div class="tank-floor"></div>
              <div class="fish-layer" id="fish-layer">${fish}</div>
              <p class="tank-hint" id="tank-hint">${PHASE_TEXT[phase]}</p>
            </div>`;
        };

        const initAquarium = (win: HTMLElement) => {
          const tank = win.querySelector("#tank") as HTMLElement | null;
          const layer = win.querySelector("#fish-layer");
          const hint = win.querySelector("#tank-hint");
          if (!tank || !layer || !hint) return;

          let fed = 0;

          tank.addEventListener("click", (event) => {
            const rect = tank.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;

            const food = document.createElement("span");
            food.className = "food";
            food.style.left = `${x}px`;
            food.style.top = `${y}px`;
            tank.appendChild(food);

            window.setTimeout(() => {
              food.remove();

              const fishes = Array.from(layer.querySelectorAll<HTMLElement>(".fish"));
              const target = fishes[Math.floor(Math.random() * fishes.length)];

              if (target) {
                const heart = document.createElement("span");
                heart.className = "heart";
                heart.textContent = "♥";
                target.appendChild(heart);
                window.setTimeout(() => heart.remove(), 1700);
              }

              fed += 1;
              hint.textContent =
                fed >= 6 ? "吃饱了，谢谢你" : `投喂了 ${fed} 次 · 它们很开心`;
            }, 820);
          });

          // 页面开着跨过时段时，自己跟着换档
          const watcher = window.setInterval(() => {
            if (!document.body.contains(tank)) {
              window.clearInterval(watcher);
              return;
            }
            const next = phaseNow();
            if (tank.dataset.phase === next) return;
            tank.dataset.phase = next;
            hint.textContent = PHASE_TEXT[next];
          }, 60_000);

          // 深夜随机冒一个瞌睡泡
          const zzzTimer = window.setInterval(() => {
            if (!document.body.contains(tank)) {
              window.clearInterval(zzzTimer);
              return;
            }
            if (tank.dataset.phase !== "night") return;

            const fishes = Array.from(layer.querySelectorAll<HTMLElement>(".fish"));
            const target = fishes[Math.floor(Math.random() * fishes.length)];
            if (!target) return;

            const z = document.createElement("span");
            z.className = "zzz";
            z.textContent = Math.random() > 0.45 ? "z" : "Z";
            target.appendChild(z);
            window.setTimeout(() => z.remove(), 3100);
          }, 2300);
        };

        /* ---------------- 访客墙 ---------------- */

        const renderVisitors = () => `
          <div class="wall">
            <div class="wall-head">
              <span class="wall-count" id="wall-count">正在加载…</span>
              <button class="wall-add" id="wall-add" type="button">留下我的头像</button>
            </div>
            <div class="wall-grid" id="wall-grid"></div>
            <form class="wall-form" id="wall-form" hidden>
              <input class="wall-name" id="wall-name" maxlength="16" placeholder="你的名字，最多 16 字" />
              <label class="wall-pick">
                <input type="file" id="wall-file" accept="image/*" hidden />
                <span id="wall-file-label">选一张图</span>
              </label>
              <button class="wall-submit" id="wall-submit" type="submit">上传</button>
            </form>
            <p class="wall-note" id="wall-note"></p>
          </div>`;

        const initVisitors = (win: HTMLElement) => {
          const grid = win.querySelector("#wall-grid");
          const countEl = win.querySelector("#wall-count");
          const addBtn = win.querySelector("#wall-add");
          const form = win.querySelector("#wall-form") as HTMLFormElement | null;
          const nameInput = win.querySelector("#wall-name") as HTMLInputElement | null;
          const fileInput = win.querySelector("#wall-file") as HTMLInputElement | null;
          const fileLabel = win.querySelector("#wall-file-label");
          const submitBtn = win.querySelector("#wall-submit") as HTMLButtonElement | null;
          const note = win.querySelector("#wall-note");

          if (!grid || !countEl || !form || !nameInput || !fileInput || !submitBtn || !note) return;

          const sb = DATA.supabase as { url?: string; key?: string } | undefined;
          const ready = Boolean(sb?.url && sb?.key);

          const setNote = (text: string) => {
            note.textContent = text;
          };

          const renderList = (list: Array<{ name: string; avatar_url: string }>) => {
            if (!list.length) {
              countEl.textContent = "还没有人";
              grid.innerHTML = '<p class="wall-empty">墙还是空的，来做第一个。</p>';
              return;
            }
            countEl.textContent = `${list.length} 位访客`;
            grid.innerHTML = list
              .map(
                (v) => `
                  <div class="wall-item">
                    <img src="${escapeHtml(v.avatar_url)}" alt="" />
                    <span>${escapeHtml(v.name)}</span>
                  </div>`,
              )
              .join("");
          };

          const loadWall = async () => {
            if (!ready) {
              countEl.textContent = "未连接";
              grid.innerHTML =
                '<p class="wall-empty">云端还没接上，需要先在 Supabase 执行 visitors.sql。</p>';
              return;
            }

            try {
              const res = await fetch(
                `${sb!.url}/rest/v1/visitor_avatars?select=name,avatar_url&order=created_at.desc&limit=60`,
                { headers: { apikey: sb!.key!, Authorization: `Bearer ${sb!.key}` } },
              );
              if (!res.ok) throw new Error(String(res.status));
              renderList(await res.json());
            } catch {
              countEl.textContent = "读取失败";
              grid.innerHTML = '<p class="wall-empty">读取失败，可能是表还没建。</p>';
            }
          };

          const compress = (file: File) =>
            new Promise<Blob>((resolve, reject) => {
              const img = new Image();
              img.onload = () => {
                const size = 240;
                const canvas = document.createElement("canvas");
                canvas.width = size;
                canvas.height = size;
                const ctx = canvas.getContext("2d");
                if (!ctx) return reject(new Error("no ctx"));

                const side = Math.min(img.width, img.height);
                ctx.drawImage(
                  img,
                  (img.width - side) / 2,
                  (img.height - side) / 2,
                  side,
                  side,
                  0,
                  0,
                  size,
                  size,
                );

                canvas.toBlob(
                  (blob) => (blob ? resolve(blob) : reject(new Error("blob"))),
                  "image/webp",
                  0.86,
                );
              };
              img.onerror = () => reject(new Error("img"));
              img.src = URL.createObjectURL(file);
            });

          addBtn?.addEventListener("click", () => {
            form.hidden = !form.hidden;
            if (!form.hidden) nameInput.focus();
          });

          fileInput.addEventListener("change", () => {
            const file = fileInput.files?.[0];
            if (fileLabel) fileLabel.textContent = file ? file.name.slice(0, 18) : "选一张图";
          });

          form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!ready) {
              setNote("云端还没配好");
              return;
            }

            const name = nameInput.value.trim();
            const file = fileInput.files?.[0];

            if (name.length < 1 || name.length > 16) {
              setNote("名字写 1 到 16 个字");
              return;
            }
            if (!file) {
              setNote("先选一张图");
              return;
            }

            const lastKey = "guandao.wall.last";
            const last = Number(localStorage.getItem(lastKey) ?? 0);
            if (Date.now() - last < 86_400_000) {
              setNote("一天只能留一次，明天再来");
              return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = "上传中…";

            try {
              const blob = await compress(file);
              const key = `${crypto.randomUUID()}.webp`;

              const up = await fetch(`${sb!.url}/storage/v1/object/visitors/${key}`, {
                method: "POST",
                headers: {
                  apikey: sb!.key!,
                  Authorization: `Bearer ${sb!.key}`,
                  "Content-Type": "image/webp",
                  "x-upsert": "false",
                },
                body: blob,
              });
              if (!up.ok) throw new Error(`upload ${up.status}`);

              const publicUrl = `${sb!.url}/storage/v1/object/public/visitors/${key}`;

              const ins = await fetch(`${sb!.url}/rest/v1/visitor_avatars`, {
                method: "POST",
                headers: {
                  apikey: sb!.key!,
                  Authorization: `Bearer ${sb!.key}`,
                  "Content-Type": "application/json",
                  Prefer: "return=minimal",
                },
                body: JSON.stringify({ name, avatar_url: publicUrl }),
              });
              if (!ins.ok) throw new Error(`insert ${ins.status}`);

              localStorage.setItem(lastKey, String(Date.now()));
              form.reset();
              form.hidden = true;
              if (fileLabel) fileLabel.textContent = "选一张图";
              setNote("已经挂上墙了");
              await loadWall();
            } catch {
              setNote("上传失败，稍后再试");
            } finally {
              submitBtn.disabled = false;
              submitBtn.textContent = "上传";
            }
          });

          void loadWall();
        };

        const APPS: Record<
          string,
          { title: string; width: number; height: number; body: () => string }
        > = {
          posts: { title: "文章", width: 660, height: 440, body: renderPosts },
          about: { title: "关于", width: 460, height: 380, body: renderAbout },
          music: { title: "音乐", width: 420, height: 340, body: renderMusic },
          terminal: { title: "终端", width: 560, height: 360, body: renderTerminal },
          settings: { title: "设置", width: 420, height: 320, body: renderSettings },
          achievements: { title: "成就", width: 540, height: 476, body: renderAchievements },
          aquarium: { title: "水族箱", width: 720, height: 480, body: renderAquarium },
          visitors: { title: "访客墙", width: 640, height: 460, body: renderVisitors },
        };

        /* ---------------- 窗口系统 ---------------- */

        const focusWin = (win: HTMLElement) => {
          win.style.zIndex = String(++zTop);
          windows.querySelectorAll(".window").forEach((el) => el.classList.toggle("is-front", el === win));
        };

        const closeWin = (win: HTMLElement) => {
          win.classList.add("is-closing");
          const dockItem = document.querySelector(`.dock-item[data-app="${win.dataset.app}"]`);
          dockItem?.classList.remove("has-open", "has-hidden");
          window.setTimeout(() => {
            win.remove();
            saveWindows();
          }, 180);
        };

        /** 缩到 Dock 图标里，图标下方亮一个小点 */
        const minimizeWin = (win: HTMLElement) => {
          const dockItem = document.querySelector<HTMLElement>(`.dock-item[data-app="${win.dataset.app}"]`);

          if (dockItem) {
            const rect = win.getBoundingClientRect();
            const target = dockItem.getBoundingClientRect();
            const dx = target.left + target.width / 2 - (rect.left + rect.width / 2);
            const dy = target.top + target.height / 2 - (rect.top + rect.height / 2);

            win.style.transformOrigin = "center center";
            win.style.transform = `translate(${dx}px, ${dy}px) scale(0.06)`;

            dockItem.classList.remove("has-open");
            dockItem.classList.add("has-hidden");
          }

          win.style.opacity = "0";
          win.classList.add("is-minimized");
          saveWindows();
        };

        const restoreWin = (win: HTMLElement) => {
          win.classList.remove("is-minimized");
          win.style.opacity = "1";

          // 下一帧再清 transform，才有从 Dock 弹回来的动画
          window.requestAnimationFrame(() => {
            win.style.transform = "";
          });

          const dockItem = document.querySelector(`.dock-item[data-app="${win.dataset.app}"]`);
          dockItem?.classList.remove("has-hidden");
          dockItem?.classList.add("has-open");

          focusWin(win);
          saveWindows();
        };

        const bindDrag = (win: HTMLElement) => {
          const bar = win.querySelector(".titlebar") as HTMLElement | null;
          if (!bar) return;

          let startX = 0;
          let startY = 0;
          let originX = 0;
          let originY = 0;

          const onMove = (event: PointerEvent) => {
            const maxX = window.innerWidth - 140;
            const maxY = window.innerHeight - 110;
            win.style.left = `${Math.max(-40, Math.min(maxX, originX + event.clientX - startX))}px`;
            win.style.top = `${Math.max(32, Math.min(maxY, originY + event.clientY - startY))}px`;
          };

          const onUp = () => {
            win.classList.remove("is-dragging");
            window.removeEventListener("pointermove", onMove);
            window.removeEventListener("pointerup", onUp);
            window.removeEventListener("pointercancel", onUp);
            saveWindows();
          };

          bar.addEventListener("pointerdown", (event) => {
            if ((event.target as HTMLElement).closest(".dot")) return;
            event.preventDefault();

            startX = event.clientX;
            startY = event.clientY;
            originX = win.offsetLeft;
            originY = win.offsetTop;

            win.classList.add("is-dragging");
            focusWin(win);

            // 挂在 window 上，指针移出窗口也能继续拖
            window.addEventListener("pointermove", onMove);
            window.addEventListener("pointerup", onUp);
            window.addEventListener("pointercancel", onUp);
          });
        };

        const openApp = (id: string) => {
          const app = APPS[id];
          if (!app) return;

          const existing = windows.querySelector(`.window[data-app="${id}"]`) as HTMLElement | null;
          if (existing) {
            if (existing.classList.contains("is-minimized")) restoreWin(existing);
            else focusWin(existing);
            return;
          }

          hint?.classList.add("is-gone");

          const win = document.createElement("div");
          win.className = "window";
          win.dataset.app = id;

          const offset = (cascade++ % 5) * 26;
          const narrow = window.innerWidth <= 720;
          const saved = readState().windows?.[id];

          win.style.width = `${app.width}px`;
          win.style.height = `${app.height}px`;

          if (narrow) {
            // 手机上位置固定，不要级联偏移，否则窗口会一路往下跑
            win.style.top = "110px";
          } else if (saved) {
            // 沿用上次的位置，越界就拉回可视范围
            win.style.left = `${Math.max(-40, Math.min(window.innerWidth - 140, saved.left))}px`;
            win.style.top = `${Math.max(32, Math.min(window.innerHeight - 110, saved.top))}px`;
          } else {
            win.style.left = `${Math.max(16, (window.innerWidth - app.width) / 2 + offset - 60)}px`;
            win.style.top = `${Math.max(52, 96 + offset)}px`;
          }

          win.innerHTML = `
            <div class="titlebar">
              <span class="dots">
                <button class="dot dot-close" type="button" aria-label="关闭"></button>
                <button class="dot dot-min" type="button" aria-label="收起"></button>
                <button class="dot dot-max" type="button" aria-label="置顶"></button>
              </span>
              <span class="win-title">${app.title}</span>
            </div>
            <div class="win-body">${app.body()}</div>`;

          windows.appendChild(win);
          focusWin(win);
          bindDrag(win);

          document.querySelector(`.dock-item[data-app="${id}"]`)?.classList.add("has-open");
          saveWindows();

          // 成就：记录打开过哪些应用，全部打开过就是「桌面漫游者」
          const achState = readAch();
          if (!achState.apps.includes(id)) {
            achState.apps.push(id);
            saveAch(achState);
          }
          const ALL_APPS = ["posts", "about", "music", "terminal", "settings", "achievements", "aquarium", "visitors"];
          if (ALL_APPS.every((app) => achState.apps.includes(app))) unlock("roam");

          win.querySelector(".dot-close")?.addEventListener("click", () => closeWin(win));
          win.querySelector(".dot-min")?.addEventListener("click", () => minimizeWin(win));
          win.querySelector(".dot-max")?.addEventListener("click", () => focusWin(win));
          win.addEventListener("pointerdown", () => focusWin(win));

          if (id === "terminal") initTerminal(win);
          if (id === "settings") initSettings(win);
          if (id === "music") initMusic(win);
          if (id === "aquarium") initAquarium(win);
          if (id === "visitors") initVisitors(win);
        };

        /* ---------------- 终端 ---------------- */

        const initTerminal = (win: HTMLElement) => {
          const out = win.querySelector("#term-out") as HTMLElement | null;
          const input = win.querySelector("#term-input") as HTMLInputElement | null;
          if (!out || !input) return;

          const print = (text: string, className = "") => {
            const line = document.createElement("p");
            line.className = `term-line ${className}`.trim();
            line.textContent = text;
            out.appendChild(line);
            out.scrollTop = out.scrollHeight;
          };

          const run = (raw: string) => {
            const cmd = raw.trim();
            if (!cmd) return;
            unlock("hack");
            print(`~ $ ${cmd}`, "term-echo");

            const [name, ...rest] = cmd.split(/\s+/);
            switch (name) {
              case "help":
                print("ls              列出文章");
                print("open <序号>     打开第 N 篇");
                print("whoami          我是谁");
                print("date            当前时间");
                print("clear           清空");
                print("exit            关掉终端");
                break;
              case "ls":
                DATA.posts.forEach((post, index) => print(`${String(index + 1).padStart(2, "0")}  ${post.title}`));
                break;
              case "open": {
                const index = Number(rest[0]) - 1;
                const post = DATA.posts[index];
                if (!post) {
                  print("没有这一篇，先用 ls 看看。", "term-error");
                  break;
                }
                print(`正在打开：${post.title}`);
                window.location.href = post.href;
                break;
              }
              case "whoami":
                print(`${DATA.site.author} · 大连理工大学 · 智能制造`);
                break;
              case "date":
                print(new Date().toLocaleString("zh-CN", { hour12: false }));
                break;
              case "clear":
                out.innerHTML = "";
                break;
              case "exit":
                closeWin(win);
                break;
              default:
                print(`未知命令：${name}，试试 help`, "term-error");
            }
          };

          input.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
              run(input.value);
              input.value = "";
            }
          });

          input.focus();
        };

        /* ---------------- 设置 ---------------- */

        const initSettings = (win: HTMLElement) => {
          win.querySelectorAll<HTMLButtonElement>(".wall-pick").forEach((button) => {
            button.addEventListener("click", () => {
              const wall = button.dataset.wall ?? "nebula";
              os.dataset.wall = wall;
              writeState({ wall });
              win.querySelectorAll(".wall-pick").forEach((el) => el.classList.toggle("is-active", el === button));
            });
          });
        };

        /* ---------------- 音乐 ---------------- */

        const initMusic = (win: HTMLElement) => {
          const btn = win.querySelector("#music-play") as HTMLButtonElement | null;
          const canvas = win.querySelector("#music-wave") as HTMLCanvasElement | null;
          if (!btn || !canvas) return;

          const g2d = canvas.getContext("2d");
          if (!g2d) return;

          let audio: { ctx: AudioContext; analyser: AnalyserNode; timer: number } | null = null;
          let raf = 0;

          // Am – F – C – G，四个和弦循环
          const CHORDS = [
            [220.0, 261.63, 329.63],
            [174.61, 220.0, 261.63],
            [261.63, 329.63, 392.0],
            [196.0, 246.94, 293.66],
          ];

          const draw = () => {
            if (!audio) return;
            raf = window.requestAnimationFrame(draw);

            const buf = new Uint8Array(audio.analyser.frequencyBinCount);
            audio.analyser.getByteFrequencyData(buf);

            const w = canvas.width;
            const h = canvas.height;
            g2d.clearRect(0, 0, w, h);

            const bars = 40;
            const bw = w / bars;

            // 没有音频设备时 analyser 全是 0，用正弦波兜底；有数据时取两者较大的
            const t = performance.now() / 620;

            for (let i = 0; i < bars; i += 1) {
              const raw = (buf[i * 2] ?? 0) / 255;
              const fallback = Math.abs(Math.sin(t + i * 0.34)) * 0.7 + 0.18;
              const v = Math.min(1, Math.max(raw, fallback));

              const bh = Math.max(3, v * h * 0.92);
              g2d.fillStyle = `rgba(150, 176, 255, ${0.34 + v * 0.55})`;
              g2d.fillRect(i * bw + 1, (h - bh) / 2, bw - 2, bh);
            }
          };

          const stop = () => {
            if (!audio) return;
            window.clearInterval(audio.timer);
            audio.ctx.close();
            audio = null;
            window.cancelAnimationFrame(raf);
            btn.textContent = "▶";
            g2d.clearRect(0, 0, canvas.width, canvas.height);
          };

          const start = () => {
            unlock("music");

            // 画布按实际显示尺寸铺开（物理像素），否则会被拉伸糊掉
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            const rect = canvas.getBoundingClientRect();
            canvas.width = Math.max(1, Math.round(rect.width * dpr));
            canvas.height = Math.max(1, Math.round(rect.height * dpr));

            const ac = new AudioContext();
            const master = ac.createGain();
            master.gain.value = 0.16;

            const analyser = ac.createAnalyser();
            analyser.fftSize = 128;

            master.connect(analyser);
            analyser.connect(ac.destination);

            let step = 0;
            const playChord = () => {
              const notes = CHORDS[step % CHORDS.length];
              const now = ac.currentTime;

              notes.forEach((freq, i) => {
                const osc = ac.createOscillator();
                const gain = ac.createGain();
                osc.type = i === 0 ? "sine" : "triangle";
                osc.frequency.value = freq;

                gain.gain.setValueAtTime(0.0001, now);
                gain.gain.linearRampToValueAtTime(0.1 / (i + 1.4), now + 0.7);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 3.4);

                osc.connect(gain);
                gain.connect(master);
                osc.start(now);
                osc.stop(now + 3.6);
              });

              step += 1;
            };

            playChord();
            const timer = window.setInterval(playChord, 2000);

            audio = { ctx: ac, analyser, timer };
            btn.textContent = "⏸";
            draw();
          };

          btn.addEventListener("click", () => {
            if (audio) stop();
            else start();
          });

          // 窗口关掉后别让声音继续响
          const watcher = window.setInterval(() => {
            if (document.body.contains(win)) return;
            stop();
            window.clearInterval(watcher);
          }, 800);
        };

        /* ---------------- 入口 ---------------- */

        document.querySelectorAll<HTMLElement>("[data-app]").forEach((trigger) => {
          const id = trigger.dataset.app;
          if (!id) return;
          if (trigger.classList.contains("desk-icon")) {
            trigger.addEventListener("dblclick", () => openApp(id));
            trigger.addEventListener("click", () => openApp(id));
          } else {
            trigger.addEventListener("click", () => openApp(id));
          }
        });

        /* ---------------- 桌面宠物 ---------------- */

        const pet = document.getElementById("desk-pet");
        const petSay = document.getElementById("pet-say");

        if (pet && petSay) {
          const LINES = [
            "别戳，在摸鱼",
            "今天吃白饭了吗",
            "我不是胖，是圆",
            "窗口可以拖，试试",
            "这个桌面还行吧",
          ];

          let sayTimer: number | undefined;
          let drag: { x: number; y: number; left: number; top: number; moved: boolean } | null = null;

          const say = (text: string) => {
            petSay.textContent = text;
            petSay.classList.add("show");
            window.clearTimeout(sayTimer);
            sayTimer = window.setTimeout(() => petSay.classList.remove("show"), 2400);
          };

          pet.addEventListener("pointerdown", (event) => {
            const rect = pet.getBoundingClientRect();
            const desk = pet.parentElement?.getBoundingClientRect();
            if (!desk) return;

            // 从 right/bottom 定位切成 left/top，后面才好拖
            pet.style.left = `${rect.left - desk.left}px`;
            pet.style.top = `${rect.top - desk.top}px`;
            pet.style.right = "auto";
            pet.style.bottom = "auto";

            drag = {
              x: event.clientX,
              y: event.clientY,
              left: rect.left - desk.left,
              top: rect.top - desk.top,
              moved: false,
            };
            pet.classList.add("is-dragging");
          });

          window.addEventListener("pointermove", (event) => {
            if (!drag) return;
            const dx = event.clientX - drag.x;
            const dy = event.clientY - drag.y;
            if (Math.abs(dx) + Math.abs(dy) > 4) drag.moved = true;
            if (!drag.moved) return;

            const maxX = window.innerWidth - 110;
            const maxY = window.innerHeight - 150;
            pet.style.left = `${Math.max(0, Math.min(maxX, drag.left + dx))}px`;
            pet.style.top = `${Math.max(34, Math.min(maxY, drag.top + dy))}px`;
          });

          window.addEventListener("pointerup", () => {
            if (drag && !drag.moved) {
              say(LINES[Math.floor(Math.random() * LINES.length)]);

              const ach = readAch();
              ach.petClicks += 1;
              saveAch(ach);
              if (ach.petClicks >= 10) unlock("rice");
            }
            pet.classList.remove("is-dragging");
            drag = null;
          });
        }

        // 成就：翻过三篇文章就记一笔（跳转前写入，来不及弹提示，静默解锁）
        windows.addEventListener("click", (event) => {
          const row = (event.target as HTMLElement).closest(".file-row");
          if (!row) return;

          const ach = readAch();
          ach.reads += 1;
          saveAch(ach);
          if (ach.reads >= 3) unlock("reader", true);
        });

        /* ---------------- 菜单栏时间 ---------------- */

        const mbTime = document.getElementById("mb-time");
        const pad = (n: number) => String(n).padStart(2, "0");

        const tickClock = () => {
          if (!mbTime) return;
          const now = new Date();
          mbTime.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
        };

        tickClock();
        window.setInterval(tickClock, 15_000);

        /* ---------------- 电源 ---------------- */

        const powerBtn = document.getElementById("mb-power");
        const powerMenu = document.getElementById("power-menu");
        const powerScreen = document.getElementById("power-screen");
        const powerHint = document.getElementById("power-hint");

        const setHint = (text: string) => {
          if (powerHint) powerHint.textContent = text;
        };

        const screenOn = () => {
          if (!powerScreen) return;
          powerScreen.hidden = false;
          window.requestAnimationFrame(() => powerScreen.classList.add("is-on"));
        };

        const shutdown = () => {
          unlock("power");
          setHint("");
          screenOn();
          window.setTimeout(() => {
            setHint("已关机 · 点一下开机");
            // 黑屏铺满后再藏起桌面，避免 Dock 的毛玻璃层叠上来透出轮廓
            os.classList.add("is-off");
          }, 700);
        };

        const restart = () => {
          setHint("正在重新启动…");
          screenOn();
          window.setTimeout(() => window.location.reload(), 1000);
        };

        powerBtn?.addEventListener("click", (event) => {
          event.stopPropagation();
          if (powerMenu) powerMenu.hidden = !powerMenu.hidden;
        });

        powerMenu?.querySelectorAll<HTMLButtonElement>("[data-power]").forEach((button) => {
          button.addEventListener("click", () => {
            if (powerMenu) powerMenu.hidden = true;
            if (button.dataset.power === "restart") restart();
            if (button.dataset.power === "shutdown") shutdown();
          });
        });

        document.addEventListener("click", () => {
          if (powerMenu) powerMenu.hidden = true;
        });

        powerScreen?.addEventListener("click", () => {
          os.classList.remove("is-off");
          powerScreen.classList.remove("is-on");
          window.setTimeout(() => {
            powerScreen.hidden = true;
            setHint("");
          }, 620);
        });

        // 恢复上次选的壁纸
        const savedWall = readState().wall;
        if (savedWall) os.dataset.wall = savedWall;

        /* ---------------- 成就初始化 ---------------- */

        // 等开机动画结束再弹，免得和 logo 叠在一起
        window.setTimeout(() => {
          const state = readAch();
          state.visits += 1;
          saveAch(state);

          unlock("first");

          const hour = new Date().getHours();
          if (hour < 5) unlock("night");
          else if (hour < 7) unlock("dawn");

          if (state.visits >= 5) unlock("regular");
        }, 2200);

        // 桌面端自动打开文章窗口作为欢迎；手机上先让人看到图标
        if (window.innerWidth > 720) {
          window.setTimeout(() => openApp("posts"), 420);
        }
      })();
    </script>

