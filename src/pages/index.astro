
---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f4" />
    <meta
      name="description"
      content="管道的个人主页与博客，记录大学学习、技术探索、创意项目与日常生活。"
    />
    <link rel="canonical" href="https://guandao.xin/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="管道的个人博客" />
    <meta property="og:title" content="管道的个人主页与博客" />
    <meta
      property="og:description"
      content="记录大学学习、技术探索、创意项目与日常生活。"
    />
    <meta property="og:url" content="https://guandao.xin/" />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="管道的个人主页与博客" />
    <meta
      name="twitter:description"
      content="记录大学学习、技术探索、创意项目与日常生活。"
    />

    <title>管道的个人主页与博客</title>
  </head>

  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="返回首页">
          <span class="brand-mark">G.</span>
          <span class="brand-name">GUANDAO<span class="brand-dot">.</span></span>
        </a>

        <nav class="main-nav" aria-label="主导航">
          <a href="/blog/">博客</a>
          <a href="#projects">项目</a>
          <a href="#about">关于</a>
          <button
            class="theme-toggle"
            id="theme"
            type="button"
            aria-label="切换深色模式"
            title="切换深色模式"
          >◐</button>
        </nav>
      </header>

      <main>
        <section class="hero">
          <div class="hero-copy">
            <div class="eyebrow">
              <span class="status-dot"></span>
              A LITTLE SPACE OF MY OWN
            </div>

            <h1>
              记录好奇，<br />
              <span class="hero-highlight">持续创造。</span>
            </h1>

            <p class="hero-description">
              你好，欢迎来到我的个人空间。这里记录学习中的新发现、
              技术探索的实践，以及那些值得认真对待的小小灵感。
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="/blog/">
                阅读我的文章 <span aria-hidden="true">↗</span>
              </a>
              <a class="button button-secondary" href="#projects">
                探索我的项目
              </a>
            </div>

            <div class="hero-note">
              <span class="note-line"></span>
              保持好奇，慢慢成为自己想成为的人。
            </div>
          </div>

          <div class="hero-art" aria-label="绿色植物与纸张构成的原创装饰插画" role="img">
            <div class="art-orbit orbit-one"></div>
            <div class="art-orbit orbit-two"></div>
            <div class="art-stamp">EST. 2026</div>

            <div class="art-paper">
              <div class="paper-top">
                <span>FIELD NOTES</span>
                <span>NO. 001</span>
              </div>
              <svg class="plant-art" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M151 265C151 216 146 170 151 116" stroke="#35583F" stroke-width="4" stroke-linecap="round"/>
                <path d="M149 218C117 195 97 171 86 137" stroke="#35583F" stroke-width="3" stroke-linecap="round"/>
                <path d="M151 190C183 167 204 139 212 105" stroke="#35583F" stroke-width="3" stroke-linecap="round"/>
                <path d="M149 160C122 137 115 112 120 85" stroke="#35583F" stroke-width="3" stroke-linecap="round"/>
                <path d="M151 133C170 112 178 88 174 62" stroke="#35583F" stroke-width="3" stroke-linecap="round"/>
                <path d="M87 138C53 131 39 106 44 79C72 83 92 102 87 138Z" fill="#8BA779"/>
                <path d="M86 137L49 88" stroke="#35583F" stroke-width="2"/>
                <path d="M211 106C239 99 254 76 249 51C224 57 207 78 211 106Z" fill="#B6C79B"/>
                <path d="M212 105L244 59" stroke="#35583F" stroke-width="2"/>
                <path d="M120 86C91 67 89 40 104 20C127 37 136 61 120 86Z" fill="#A2B98B"/>
                <path d="M120 85L108 29" stroke="#35583F" stroke-width="2"/>
                <path d="M174 63C194 42 193 20 177 6C159 25 158 46 174 63Z" fill="#6E9368"/>
                <path d="M174 62L178 13" stroke="#35583F" stroke-width="2"/>
                <path d="M150 220C180 206 206 214 216 239C191 254 166 246 150 220Z" fill="#C5D2B2"/>
                <path d="M151 220L207 237" stroke="#35583F" stroke-width="2"/>
                <path d="M148 195C120 177 95 185 84 207C104 226 132 221 148 195Z" fill="#6E9368"/>
                <path d="M146 196L92 207" stroke="#35583F" stroke-width="2"/>
                <path d="M111 270H191L181 285H121L111 270Z" fill="#D9C9A9"/>
                <path d="M124 270L130 230H172L178 270" fill="#E7DDC8" stroke="#B5A98E" stroke-width="2"/>
              </svg>
              <div class="paper-caption">
                <span>GROW AT YOUR OWN PACE</span>
                <span class="caption-star">✳</span>
              </div>
            </div>

            <div class="art-label label-top">LEARN &amp; EXPLORE</div>
            <div class="art-label label-bottom">MAKE THINGS REAL.</div>
          </div>
        </section>

        <div class="ticker" aria-label="个人兴趣">
          <span>学习 LEARNING</span>
          <span class="ticker-star">✳</span>
          <span>技术 TECHNOLOGY</span>
          <span class="ticker-star">✳</span>
          <span>创造 CREATIVITY</span>
          <span class="ticker-star">✳</span>
          <span>生活 LIFE</span>
        </div>

        <section class="section" id="projects">
          <div class="section-heading">
            <div>
              <p class="eyebrow">SELECTED WORK</p>
              <h2>正在探索的事<span class="heading-period">.</span></h2>
              <p class="section-description">把感兴趣的事情，一件件做出来。</p>
            </div>
            <span class="section-index">01 / PROJECTS</span>
          </div>

          <div class="project-grid">
            <a class="project-card project-featured" href="/blog/">
              <div class="project-card-top">
                <span class="project-tag">01 — WRITING</span>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="project-symbol symbol-book" aria-hidden="true">
                <svg viewBox="0 0 64 64" fill="none">
                  <path d="M10 14.5C19 11 27 13 32 18V52C26 47 18 46 10 49V14.5Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                  <path d="M54 14.5C45 11 37 13 32 18V52C38 47 46 46 54 49V14.5Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                  <path d="M17 23L25 25M17 30L25 32M39 25L47 23M39 32L47 30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <h3>个人博客</h3>
              <p>写下学习、生活与技术探索中的想法，让每一次思考都有迹可循。</p>
              <span class="project-link">进入博客 <span aria-hidden="true">→</span></span>
            </a>

            <article class="project-card">
              <div class="project-card-top">
                <span class="project-tag">02 — EXPERIMENTS</span>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="project-symbol symbol-spark" aria-hidden="true">✳</div>
              <h3>创意实验室</h3>
              <p>尝试网页开发、AI 工具和有趣的交互，把新点子变成能运行的作品。</p>
              <span class="project-status"><span></span>持续探索中</span>
            </article>

            <article class="project-card">
              <div class="project-card-top">
                <span class="project-tag">03 — LEARNING</span>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="project-symbol symbol-notes" aria-hidden="true">
                <svg viewBox="0 0 64 64" fill="none">
                  <rect x="15" y="9" width="35" height="46" rx="3" stroke="currentColor" stroke-width="2.2"/>
                  <path d="M23 22H42M23 30H42M23 38H36" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                  <path d="M10 17V49" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
              </div>
              <h3>学习档案</h3>
              <p>整理课程笔记、实践经验和阶段性成果，让学到的知识真正留下来。</p>
              <span class="project-status"><span></span>持续积累中</span>
            </article>
          </div>
        </section>

        <section class="section latest-section" id="latest-posts">
          <div class="section-heading">
            <div>
              <p class="eyebrow">LATEST WRITING</p>
              <h2>最近写了什么<span class="heading-period">.</span></h2>
              <p class="section-description">一些记录，一些思考，一些新的开始。</p>
            </div>
            <a class="text-link" href="/blog/">全部文章 <span aria-hidden="true">↗</span></a>
          </div>

          <div class="post-list">
            {posts.length > 0 ? posts.map((post, index) => (
              <a class="post-row" href={`/blog/${post.id}/`}>
                <span class="post-number">{String(index + 1).padStart(2, "0")}</span>
                <div class="post-main">
                  <span class="post-date">
                    {post.data.pubDate.toLocaleDateString("zh-CN", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </span>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <span class="post-arrow" aria-hidden="true">↗</span>
              </a>
            )) : (
              <div class="empty-posts">
                <span class="empty-icon">✳</span>
                <p>第一篇文章正在路上，敬请期待。</p>
              </div>
            )}
          </div>
        </section>

        <section class="about-section" id="about">
          <div class="about-intro">
            <p class="eyebrow">A LITTLE ABOUT ME</p>
            <h2>在学习中成长，<br /><span>在实践中发现。</span></h2>
          </div>
          <div class="about-content">
            <p>
              我喜欢学习新知识，也喜欢把想法付诸实践。
              这个网站是我的数字小角落，用来记录正在学习的事、
              正在尝试的项目，以及生活里值得记下的瞬间。
            </p>
            <p>
              不急着给一切下结论。保持好奇，持续积累，
              让每一个微小的进步都有被看见的机会。
            </p>
            <div class="skill-list" aria-label="兴趣与技术">
              <span>Astro</span>
              <span>Markdown</span>
              <span>AI 工具</span>
              <span>持续学习</span>
              <span>创意开发</span>
            </div>
          </div>
        </section>

        <section class="contact-section" id="contact">
          <div>
            <p class="eyebrow">KEEP IN TOUCH</p>
            <h2>好奇心，让我们保持联系<span>.</span></h2>
            <p>欢迎来看看我的文章，也欢迎交流有趣的想法。</p>
          </div>
          <a class="button button-light" href="/blog/">
            从文章开始 <span aria-hidden="true">↗</span>
          </a>
        </section>
      </main>

      <footer class="site-footer">
        <a class="footer-brand" href="/">GUANDAO<span>.</span></a>
        <p>用好奇心探索世界。</p>
        <span>© {new Date().getFullYear()} · MADE WITH CURIOSITY</span>
      </footer>
    </div>

    <script>
      const themeButton = document.querySelector<HTMLButtonElement>("#theme");
      const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      themeButton?.addEventListener("click", () => {
        const isDark = document.body.classList.toggle("dark");
        themeButton.setAttribute("aria-label", isDark ? "切换浅色模式" : "切换深色模式");
        themeButton.textContent = isDark ? "☼" : "◐";
        if (themeMeta) themeMeta.content = isDark ? "#19231c" : "#f7f7f4";
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #f7f7f4;
    --surface: #ffffff;
    --surface-soft: #eeefe7;
    --ink: #26372b;
    --muted: #747a70;
    --green: #426449;
    --green-deep: #2e4934;
    --green-soft: #e3e9dc;
    --line: #e2e4dc;
    --shadow: 0 18px 50px rgba(38, 55, 43, 0.07);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
    background: var(--paper);
  }

  :global(body) {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: Inter, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
    transition: background 0.25s ease, color 0.25s ease;
  }

  :global(body.dark) {
    color-scheme: dark;
    --paper: #19231c;
    --surface: #202c23;
    --surface-soft: #27352a;
    --ink: #edf0e7;
    --muted: #b1b9ad;
    --green: #b5c9a8;
    --green-deep: #d1dfc7;
    --green-soft: #344634;
    --line: #37453a;
    --shadow: 0 18px 50px rgba(0, 0, 0, 0.16);
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(button) {
    font: inherit;
  }

  .site-shell {
    width: min(1120px, calc(100% - 64px));
    margin: 0 auto;
  }

  .site-header {
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 39px;
    height: 39px;
    border-radius: 13px;
    background: var(--green-deep);
    color: var(--paper);
    font-family: Georgia, serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -2px;
  }

  .brand-name,
  .footer-brand {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2.1px;
  }

  .brand-dot,
  .footer-brand span {
    color: #8ca17d;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .main-nav > a {
    color: var(--muted);
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .main-nav > a:hover {
    color: var(--green);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 37px;
    height: 37px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .theme-toggle:hover {
    transform: rotate(18deg);
    border-color: var(--green);
  }

  .hero {
    min-height: 565px;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: 48px;
    padding: 66px 0 72px;
  }

  .eyebrow {
    margin: 0;
    color: var(--green);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2.1px;
    line-height: 1.7;
  }

  .hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot,
  .project-status span {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #83a276;
    box-shadow: 0 0 0 4px var(--green-soft);
  }

  .hero h1 {
    margin: 25px 0 20px;
    font-size: clamp(43px, 5.4vw, 68px);
    line-height: 1.24;
    letter-spacing: -3.5px;
    font-weight: 750;
  }

  .hero-highlight {
    color: var(--green);
  }

  .hero-description {
    max-width: 470px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 2.05;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 29px;
  }

  .button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 0 19px;
    border: 1px solid transparent;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 650;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--green-deep);
    color: #fff;
  }

  :global(body.dark) .button-primary {
    color: #19231c;
  }

  .button-primary:hover {
    background: var(--green);
  }

  .button-secondary {
    border-color: var(--line);
    color: var(--ink);
    background: var(--surface);
  }

  .button-secondary:hover {
    border-color: var(--green);
  }

  .hero-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 35px;
    color: var(--muted);
    font-size: 11px;
  }

  .note-line {
    width: 25px;
    height: 1px;
    background: #9aab8d;
  }

  .hero-art {
    min-height: 390px;
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .hero-art::before {
    content: "";
    position: absolute;
    z-index: -2;
    width: min(330px, 82%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--green-soft);
  }

  .art-orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid #a4b59a;
    border-radius: 50%;
    opacity: 0.7;
  }

  .orbit-one {
    width: 365px;
    height: 275px;
    transform: rotate(-27deg);
  }

  .orbit-two {
    width: 365px;
    height: 275px;
    transform: rotate(38deg);
  }

  .art-paper {
    width: 275px;
    padding: 17px 20px 13px;
    border: 1px solid #e2dfd0;
    background: #fbfaf5;
    color: #334b37;
    box-shadow: 0 24px 55px rgba(46, 73, 52, 0.15);
    transform: rotate(-4deg);
    transition: transform 0.35s ease;
  }

  .hero-art:hover .art-paper {
    transform: rotate(0deg) translateY(-4px);
  }

  .paper-top,
  .paper-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #77836d;
    font-size: 8px;
    font-weight: 750;
    letter-spacing: 1.1px;
  }

  .plant-art {
    display: block;
    width: 100%;
    height: 250px;
    margin: 6px auto 0;
  }

  .paper-caption {
    padding-top: 10px;
    border-top: 1px solid #e4e3d9;
    font-size: 7px;
  }

  .caption-star {
    font-size: 17px;
  }

  .art-stamp,
  .art-label {
    position: absolute;
    color: var(--green);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.4px;
  }

  .art-stamp {
    top: 37px;
    right: 9%;
    display: grid;
    place-items: center;
    width: 57px;
    height: 57px;
    border: 1px solid #a5b59b;
    border-radius: 50%;
    transform: rotate(12deg);
  }

  .label-top {
    top: 93px;
    left: 0;
    transform: rotate(-90deg) translateX(-100%);
    transform-origin: top left;
  }

  .label-bottom {
    right: 0;
    bottom: 59px;
    transform: rotate(90deg) translateX(100%);
    transform-origin: bottom right;
  }

  .ticker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 21px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 1.5px;
  }

  .ticker-star {
    color: #8ca17d;
    font-size: 16px;
  }

  .section {
    padding: 105px 0 30px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 31px;
  }

  .section-heading h2,
  .about-intro h2,
  .contact-section h2 {
    margin: 10px 0 0;
    font-size: clamp(28px, 3.6vw, 39px);
    line-height: 1.4;
    letter-spacing: -1.5px;
  }

  .heading-period,
  .contact-section h2 span {
    color: #91a582;
  }

  .section-description {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .section-index {
    padding-bottom: 5px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1.3px;
    white-space: nowrap;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .project-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 23px 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
