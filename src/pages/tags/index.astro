---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getAllPosts, collectTags, tagHue } from "../../lib/posts";
import { SITE, formatShortDate } from "../../lib/site";

const posts = await getAllPosts();
const tags = collectTags(posts);
const max = Math.max(...tags.map((tag) => tag.count), 1);

const grouped = tags.map((tag) => ({
  ...tag,
  posts: posts.filter((post) => post.tags.includes(tag.tag)).slice(0, 3),
}));
---

<BaseLayout
  title="标签归档"
  description={`按主题浏览${SITE.author}的文章：共 ${tags.length} 个标签、${posts.length} 篇文章。`}
  canonical="/tags/"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Topics · {tags.length} 个标签</span>
      <h1>标签归档</h1>
      <p class="page-lede">
        一篇文章可能属于多个主题。标签不做层级，只做线索——顺着任意一个往下走，都能找到同一类思考。
      </p>
    </div>
  </section>

  <div class="wrap">
    {tags.length === 0 ? (
      <p class="tags-empty">
        还没有打过标签——等第一批文章发出来，这里会自动按主题归类。
      </p>
    ) : (
      <>
        <div class="cloud">
          {tags.map((tag) => (
            <a
              class="cloud-tag"
              href={`/tags/${encodeURIComponent(tag.tag)}/`}
              style={`--weight:${0.9 + (tag.count / max) * 0.85}; --hue:${tagHue(tag.tag)}`}
            >
              {tag.tag}
              <em>{tag.count}</em>
            </a>
          ))}
        </div>

        <div class="tag-grid">
          {grouped.map((tag) => (
        <section class="tag-card" id={`tag-${tag.tag}`}>
          <header>
            <a class="tag-name" href={`/tags/${encodeURIComponent(tag.tag)}/`}>
              <span class="tag-dot" style={`--hue:${tagHue(tag.tag)}`} aria-hidden="true"></span>
              {tag.tag}
            </a>
            <span class="tag-count">{tag.count} 篇</span>
          </header>

          <ul>
            {tag.posts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}/`}>
                  <span class="t">{post.title}</span>
                  <span class="d">{formatShortDate(post.pubDate)}</span>
                </a>
              </li>
            ))}
          </ul>

          {tag.count > 3 && (
            <a class="tag-more" href={`/tags/${encodeURIComponent(tag.tag)}/`}>
              查看全部 {tag.count} 篇
              <Icon name="arrow-right" size={12} />
            </a>
          )}
        </section>
      ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 58px 0 30px;
    border-bottom: 1px solid var(--line);
  }

  .page-head h1 {
    margin: 14px 0 12px;
    font-size: clamp(34px, 5vw, 46px);
    letter-spacing: -0.03em;
  }

  .page-lede {
    margin: 0;
    max-width: 42em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.9;
  }

  .tags-empty {
    margin: 0;
    padding: 46px 0 8px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.95;
    color: var(--muted);
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 34px 0 40px;
  }

  .cloud-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 8px 15px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: hsl(var(--hue) 30% 96%);
    color: hsl(var(--hue) 30% 26%);
    font-size: calc(13px * var(--weight));
    transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
  }

  [data-theme="dark"] .cloud-tag {
    background: hsl(var(--hue) 18% 16%);
    color: hsl(var(--hue) 30% 80%);
    border-color: hsl(var(--hue) 18% 26%);
  }

  .cloud-tag em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10.5px;
    opacity: 0.6;
  }

  .cloud-tag:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }

  .tag-card {
    padding: 22px 22px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: 90px;
  }

  .tag-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--line);
  }

  .tag-name {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 600;
  }

  .tag-name:hover {
    color: var(--accent-ink);
  }

  .tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: hsl(var(--hue) 45% 55%);
    box-shadow: 0 0 0 3px hsl(var(--hue) 45% 55% / 0.16);
  }

  .tag-count {
    font-size: 11.5px;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .tag-card ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }

  .tag-card li + li {
    border-top: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
  }

  .tag-card li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 0;
    font-size: 13.5px;
    color: var(--ink-2);
    transition: color 0.2s var(--ease);
  }

  .tag-card li a:hover {
    color: var(--accent-ink);
  }

  .tag-card .t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-card .d {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }

  .tag-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 14px;
    font-size: 12px;
    color: var(--accent-ink);
  }

  @media (max-width: 720px) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
