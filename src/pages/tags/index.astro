---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getAllPosts, collectTags, tagHue } from "../../lib/posts";
import { SITE, formatShortDate } from "../../lib/site";
import "../../styles/blog-pixel.css";

const posts = await getAllPosts();
const tags = collectTags(posts);
const max = Math.max(...tags.map((tag) => tag.count), 1);

const grouped = tags.map((tag) => ({
  ...tag,
  posts: posts.filter((post) => post.tags.includes(tag.tag)).slice(0, 3),
}));
---

<BaseLayout
  title="标签归档"
  description={`按主题浏览${SITE.author}的文章：共 ${tags.length} 个标签、${posts.length} 篇文章。`}
  canonical="/tags/"
>
  <div class="blog-pixel">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Topics · {tags.length} 个标签</span>
      <h1>标签归档</h1>
      <p class="page-lede">
        一篇文章可能属于多个主题。标签不做层级，只做线索——顺着任意一个往下走，都能找到同一类思考。
      </p>
    </div>
  </section>

  <div class="wrap">
    {tags.length === 0 ? (
      <p class="tags-empty">
        还没有打过标签——等第一批文章发出来，这里会自动按主题归类。
      </p>
    ) : (
      <>
        <div class="cloud">
          {tags.map((tag) => (
            <a
              class="cloud-tag"
              href={`/tags/${encodeURIComponent(tag.tag)}/`}
              style={`--weight:${0.9 + (tag.count / max) * 0.85}; --hue:${tagHue(tag.tag)}`}
            >
              {tag.tag}
              <em>{tag.count}</em>
            </a>
          ))}
        </div>

        <div class="tag-grid">
          {grouped.map((tag) => (
        <section class="tag-card" id={`tag-${tag.tag}`}>
          <header>
            <a class="tag-name" href={`/tags/${encodeURIComponent(tag.tag)}/`}>
              <span class="tag-dot" style={`--hue:${tagHue(tag.tag)}`} aria-hidden="true"></span>
              {tag.tag}
            </a>
            <span class="tag-count">{tag.count} 篇</span>
          </header>

          <ul>
            {tag.posts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}/`}>
                  <span class="t">{post.title}</span>
                  <span class="d">{formatShortDate(post.pubDate)}</span>
                </a>
              </li>
            ))}
          </ul>

          {tag.count > 3 && (
            <a class="tag-more" href={`/tags/${encodeURIComponent(tag.tag)}/`}>
              查看全部 {tag.count} 篇
              <Icon name="arrow-right" size={12} />
            </a>
          )}
        </section>
      ))}
        </div>
      </>
    )}
  </div>
  </div>
</BaseLayout>

<style>
  .tags-empty {
    margin: 0;
    padding: 44px 0 8px;
    font-size: 14px;
    line-height: 1.95;
    color: var(--px-faint);
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    padding: 30px 0 38px;
  }

  .cloud-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px 6px;
    font-family: var(--px-pix);
    font-size: calc(11px * var(--weight));
    line-height: 1.5;
    color: var(--px-soft);
    background: var(--px-panel-2);
    box-shadow: inset 2px 2px 0 0 var(--px-slot-lo);
    transition: color 0.15s linear, background-color 0.15s linear;
  }

  .cloud-tag::before {
    content: "";
    width: 6px;
    height: 6px;
    background: hsl(var(--hue) 65% 62%);
  }

  .cloud-tag em {
    font-style: normal;
    font-size: 10px;
    color: var(--px-faint);
  }

  .cloud-tag:hover {
    color: #1d1503;
    background: var(--px-gold);
  }

  .cloud-tag:hover em {
    color: #2a1d02;
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
    padding-top: 30px;
    border-top: 4px dashed #142a5c;
  }

  .tag-card {
    padding: 20px 22px 18px;
    background: var(--px-paper);
    color: var(--px-paper-text);
    box-shadow: var(--px-paper-frame);
    scroll-margin-top: 90px;
  }

  .tag-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--px-paper-line);
  }

  .tag-name {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--px-hand);
    font-size: 19px;
    font-weight: 600;
    color: var(--px-paper-ink);
  }

  .tag-name:hover {
    color: #7a4d13;
  }

  .tag-dot {
    width: 8px;
    height: 8px;
    background: hsl(var(--hue) 55% 52%);
    box-shadow: 0 0 0 2px hsl(var(--hue) 55% 52% / 0.18);
  }

  .tag-count {
    font-family: var(--px-pix);
    font-size: 11px;
    color: var(--px-paper-soft);
  }

  .tag-card ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .tag-card li + li {
    border-top: 1px dashed var(--px-paper-line);
  }

  .tag-card li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 0;
    font-size: 13.5px;
    color: #4a3f27;
    transition: color 0.15s linear;
  }

  .tag-card li a:hover {
    color: #7a4d13;
  }

  .tag-card .t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-card .d {
    flex: none;
    font-family: var(--px-pix);
    font-size: 10.5px;
    color: var(--px-paper-soft);
  }

  .tag-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 12px;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #8a5a1c;
  }

  .tag-more:hover {
    color: var(--px-paper-ink);
  }

  @media (max-width: 720px) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
