---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getAllPosts, collectTags, postsWithTag, tagHue } from "../../lib/posts";
import { SITE } from "../../lib/site";
import "../../styles/blog-pixel.css";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const tags = collectTags(posts);
  return tags.map((tag) => ({
    params: { tag: tag.tag },
    props: { tag: tag.tag, count: tag.count },
  }));
}

const { tag, count } = Astro.props;
const all = await getAllPosts();
const posts = postsWithTag(all, tag);
const hue = tagHue(tag);
const siblings = collectTags(all).filter((item) => item.tag !== tag).slice(0, 8);
---

<BaseLayout
  title={`标签：${tag}`}
  description={`${SITE.author}关于「${tag}」的全部文章，共 ${posts.length} 篇。`}
  canonical={`/tags/${encodeURIComponent(tag)}/`}
>
  <div class="blog-pixel">
  <section class="page-head tag-hero" style={`--hue:${hue}`}>
    <div class="wrap">
      <nav class="crumb" aria-label="面包屑">
        <a href="/home/">首页</a><span>/</span><a href="/tags/">标签</a><span>/</span><span>{tag}</span>
      </nav>
      <span class="eyebrow">Tag</span>
      <h1>{tag}</h1>
      <p>共 {count} 篇文章与这个主题相关。</p>
    </div>
  </section>

  <div class="wrap">
    <div class="post-list">
      {posts.map((post, i) => (
        <PostCard post={post} index={i} />
      ))}
    </div>

    <div class="siblings">
      <span class="siblings-label">其他主题</span>
      {siblings.map((item) => (
        <a class="pill" href={`/tags/${encodeURIComponent(item.tag)}/`}>
          {item.tag}<em>{item.count}</em>
        </a>
      ))}
      <a class="pill" href="/tags/">全部 →</a>
    </div>
  </div>
  </div>
</BaseLayout>

<style>
  .tag-hero {
    position: relative;
    overflow: hidden;
  }

  .tag-hero::before {
    content: "";
    position: absolute;
    top: -90px;
    left: -70px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, hsl(var(--hue) 60% 60% / 0.16), transparent 70%);
    pointer-events: none;
  }

  .tag-hero p {
    margin: 0;
    color: var(--px-soft);
    font-size: 14px;
  }

  .siblings {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 34px;
  }

  .siblings-label {
    margin-right: 6px;
    font-family: var(--px-pix);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--px-faint);
  }
</style>
