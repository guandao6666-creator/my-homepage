---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { PROJECTS } from "../lib/projects";
import { SITE } from "../lib/site";
import "../styles/blog-pixel.css";

const total = PROJECTS.length;
const tags = [...new Set(PROJECTS.flatMap((item) => item.tags))];
---

<BaseLayout
  title="作品"
  description={`${SITE.author}做过的项目：${PROJECTS.map((item) => item.title).join("、")}。`}
  canonical="/projects/"
>
  <div class="blog-pixel">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Projects · {total} 个</span>
      <h1>做过的东西</h1>
      <p class="page-lede">
        大多是边学边做，做完才发现哪里还能更好。留在这里，是为了看得见自己的进度。
      </p>
    </div>
  </section>

  <div class="wrap">
    <div class="filters" aria-label="技术栈筛选" role="group">
      <button class="chip is-active" type="button" data-proj-tag="all" aria-pressed="true">
        全部 ({total})
      </button>
      {tags.map((tag) => (
        <button class="chip" type="button" data-proj-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))}
    </div>

    <div class="grid" id="projects-grid">
      {PROJECTS.map((item) => {
        const Wrapper = item.href ? "a" : "div";
        // 站内作品直接跳转，站外才新开标签
        const isExternal = Boolean(item.href && /^https?:/i.test(item.href));
        return (
          <Wrapper
            class:list={["card", { "card--link": Boolean(item.href) }]}
            data-proj-tags={item.tags.join("|")}
            href={item.href}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener" : undefined}
          >
            <div class="card-top">
              <span class="year">{item.year}</span>
              {item.status && <span class="status">{item.status}</span>}
            </div>
            <h2>{item.title}</h2>
            <p>{item.summary}</p>
            <div class="card-foot">
              <div class="tags">
                {item.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              {item.href && (
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-up-right" size={15} />
                </span>
              )}
            </div>
          </Wrapper>
        );
      })}
    </div>

    <p class="more-note">
      更多尝试还在本地跑着，等稳定了再放上来。想聊其中某一个，<a href="/about/">写信给我</a>。
    </p>
  </div>
  </div>
</BaseLayout>

<script>
  (() => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-proj-tag]")];
    const cards = [...document.querySelectorAll<HTMLElement>("#projects-grid [data-proj-tags]")];
    if (!buttons.length || !cards.length) return;

    const apply = (tag: string) => {
      buttons.forEach((btn) => {
        const active = btn.dataset.projTag === tag;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-pressed", active ? "true" : "false");
      });
      cards.forEach((card) => {
        const list = (card.dataset.projTags || "").split("|");
        card.hidden = tag !== "all" && !list.includes(tag);
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => apply(btn.dataset.projTag || "all"));
    });
  })();
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding: 26px 0 28px;
  }

  .chip {
    padding: 5px 9px 4px;
    border: 0;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--px-cyan);
    background: var(--px-panel-2);
    box-shadow: inset 2px 2px 0 0 var(--px-slot-lo);
    cursor: pointer;
    transition: background-color 0.14s linear, color 0.14s linear;
  }

  .chip:hover {
    color: var(--px-gold);
  }

  .chip.is-active {
    background: var(--px-gold);
    color: #161822;
    box-shadow: none;
  }

  .card[hidden] {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 24px 26px 22px;
    background: var(--px-paper);
    color: var(--px-paper-text);
    box-shadow: var(--px-paper-frame);
    transition: transform 0.16s steps(2, end), background-color 0.16s linear;
  }

  .card--link:hover {
    transform: translateY(-3px);
    background: var(--px-paper-2);
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .year {
    font-family: var(--px-pix);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: #8fc3ff;
  }

  .status {
    padding: 2px 7px 1px;
    font-family: var(--px-pix);
    font-size: 10px;
    color: #2a1d02;
    background: var(--px-gold);
    box-shadow: inset 0 -2px 0 0 var(--px-gold-dark);
  }

  .card h2 {
    margin: 12px 0 10px;
    font-family: var(--px-hand);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: 0.02em;
    color: var(--px-paper-ink);
    transition: color 0.16s linear;
  }

  .card--link:hover h2 {
    color: #7a4d13;
  }

  .card p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.85;
    color: #c2d4f2;
  }

  .card-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 20px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    padding: 3px 8px 2px;
    font-family: var(--px-pix);
    font-size: 10.5px;
    color: #8fc3ff;
    background: #16316f;
    box-shadow: inset 2px 2px 0 0 #0b1d4a;
  }

  .go {
    flex: none;
    color: #7fe6ff;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.16s linear, transform 0.16s steps(2, end);
  }

  .card--link:hover .go {
    opacity: 1;
    transform: none;
  }

  .more-note {
    margin: 40px 0 0;
    padding-top: 22px;
    border-top: 4px dashed #142a5c;
    font-size: 13.5px;
    line-height: 1.95;
    color: var(--px-faint);
  }

  .more-note a {
    color: var(--px-cyan);
    border-bottom: 1px dashed rgba(127, 230, 255, 0.45);
    padding-bottom: 1px;
  }

  .more-note a:hover {
    color: #fff;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
