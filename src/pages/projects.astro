---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { PROJECTS } from "../lib/projects";
import { SITE } from "../lib/site";

const total = PROJECTS.length;
const tags = [...new Set(PROJECTS.flatMap((item) => item.tags))];
---

<BaseLayout
  title="作品"
  description={`${SITE.author}做过的项目：${PROJECTS.map((item) => item.title).join("、")}。`}
  canonical="/projects/"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Projects · {total} 个</span>
      <h1>做过的东西</h1>
      <p class="page-lede">
        大多是边学边做，做完才发现哪里还能更好。留在这里，是为了看得见自己的进度。
      </p>
    </div>
  </section>

  <div class="wrap">
    <div class="filters" aria-label="技术栈">
      {tags.map((tag) => (
        <span class="chip">{tag}</span>
      ))}
    </div>

    <div class="grid">
      {PROJECTS.map((item) => {
        const Wrapper = item.href ? "a" : "div";
        return (
          <Wrapper
            class:list={["card", { "card--link": Boolean(item.href) }]}
            href={item.href}
            target={item.href ? "_blank" : undefined}
            rel={item.href ? "noopener" : undefined}
          >
            <div class="card-top">
              <span class="year">{item.year}</span>
              {item.status && <span class="status">{item.status}</span>}
            </div>
            <h2>{item.title}</h2>
            <p>{item.summary}</p>
            <div class="card-foot">
              <div class="tags">
                {item.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              {item.href && (
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-up-right" size={15} />
                </span>
              )}
            </div>
          </Wrapper>
        );
      })}
    </div>

    <p class="more-note">
      更多尝试还在本地跑着，等稳定了再放上来。想聊其中某一个，<a href="/about/">写信给我</a>。
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 58px 0 34px;
    border-bottom: 1px solid var(--line);
  }

  .page-head h1 {
    margin: 14px 0 12px;
    font-size: clamp(34px, 5vw, 46px);
    letter-spacing: -0.03em;
  }

  .page-lede {
    margin: 0;
    max-width: 40em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.9;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding: 26px 0 30px;
  }

  .chip {
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-sunk);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 26px 26px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .card--link:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .year {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  .status {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-size: 10.5px;
  }

  .card h2 {
    margin: 12px 0 10px;
    font-size: 21px;
    line-height: 1.45;
  }

  .card p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--muted);
  }

  .card-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 20px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    padding: 2px 9px;
    border-radius: 6px;
    background: var(--surface-sunk);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-2);
  }

  .go {
    flex: none;
    color: var(--muted);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), color 0.25s var(--ease);
  }

  .card--link:hover .go {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }

  .more-note {
    margin: 40px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
  }

  .more-note a {
    color: var(--accent-ink);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding-bottom: 1px;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
