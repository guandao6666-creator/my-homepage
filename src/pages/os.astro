---
import "../styles/global.css";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();

const data = {
  posts: posts.map((post) => ({
    title: post.title,
    href: `/blog/${post.slug}/`,
    date: post.pubDate.toISOString().slice(0, 10),
    tags: post.tags,
    minutes: post.minutes,
  })),
  site: {
    author: "管道",
    host: "guandao.xin",
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guandao OS</title>
    <meta name="description" content="把博客做成一个可以拖窗口的桌面。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="os" id="os" data-wall="nebula">
      <div class="wallpaper"></div>

      <header class="menubar">
        <span class="mb-brand">Guandao OS</span>
        <nav class="mb-menu">
          <span>文件</span>
          <span>编辑</span>
          <span>视图</span>
          <span>窗口</span>
        </nav>
        <div class="mb-status">
          <span class="mb-dot"></span>
          <span id="mb-time">--:--</span>
        </div>
      </header>

      <main class="desk" id="desk">
        <div class="desk-icons">
          <button class="desk-icon" type="button" data-app="posts">
            <span class="di-glyph di-folder"></span>
            <span class="di-label">文章</span>
          </button>
          <button class="desk-icon" type="button" data-app="about">
            <span class="di-glyph di-person"></span>
            <span class="di-label">关于</span>
          </button>
          <button class="desk-icon" type="button" data-app="terminal">
            <span class="di-glyph di-term"></span>
            <span class="di-label">终端</span>
          </button>
        </div>

        <div class="windows" id="windows"></div>

        <p class="desk-hint" id="desk-hint">双击图标，或从下方程序坞打开</p>
      </main>

      <footer class="dock" id="dock">
        <button class="dock-item" type="button" data-app="posts" title="文章">
          <span class="dock-glyph di-folder"></span>
        </button>
        <button class="dock-item" type="button" data-app="about" title="关于">
          <span class="dock-glyph di-person"></span>
        </button>
        <button class="dock-item" type="button" data-app="terminal" title="终端">
          <span class="dock-glyph di-term"></span>
        </button>
        <button class="dock-item" type="button" data-app="settings" title="设置">
          <span class="dock-glyph di-gear"></span>
        </button>
        <span class="dock-sep"></span>
        <a class="dock-item dock-link" href="/" title="回到普通版">
          <span class="dock-glyph di-home"></span>
        </a>
      </footer>
    </div>

    <script is:inline define:vars={{ OS_DATA: data }}>
      window.__OS__ = OS_DATA;
    </script>

    <script>
      (() => {
        const DATA = window.__OS__;
        if (!DATA) return;

        const os = document.getElementById("os");
        const windows = document.getElementById("windows");
        const hint = document.getElementById("desk-hint");
        if (!os || !windows || !hint) return;

        let zTop = 10;
        let cascade = 0;

        /* ---------------- 窗口内容 ---------------- */

        const escapeHtml = (text: string) =>
          String(text).replace(
            /[&<>"]/g,
            (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch] as string,
          );

        const renderPosts = () => {
          const rows = DATA.posts
            .map(
              (post, index) => `
              <a class="file-row" href="${post.href}">
                <span class="file-icon"></span>
                <span class="file-main">
                  <span class="file-name">${escapeHtml(post.title)}</span>
                  <span class="file-meta">${post.date} · ${post.minutes} 分钟 · ${post.tags.map(escapeHtml).join(" / ")}</span>
                </span>
                <span class="file-index">${String(index + 1).padStart(2, "0")}</span>
              </a>`,
            )
            .join("");

          return `
            <div class="finder">
              <aside class="finder-side">
                <p class="side-title">位置</p>
                <span class="side-item is-active">全部文章</span>
                <span class="side-item">${DATA.posts.length} 篇</span>
                <p class="side-title">关于</p>
                <span class="side-item">${DATA.site.host}</span>
              </aside>
              <div class="finder-files">${rows || '<p class="finder-empty">还没有文章。</p>'}</div>
            </div>`;
        };

        const renderAbout = () => `
          <div class="about">
            <p class="about-kicker">关于这个站</p>
            <h2>${DATA.site.author}</h2>
            <p>
              大连理工大学智能制造专业在读。喜欢骑车、写代码，以及把学到的东西记下来。
            </p>
            <p>
              这个桌面是博客的另一种打开方式：文章、终端、设置都在窗口里。想要正常阅读，右下角的房子可以回到普通版。
            </p>
            <div class="about-links">
              <a href="/about/">关于页 →</a>
              <a href="/blog/">全部文章 →</a>
              <a href="/uses/">我用什么 →</a>
            </div>
          </div>`;

        const renderTerminal = () => `
          <div class="term">
            <div class="term-out" id="term-out">
              <p class="term-line term-muted">Guandao OS 1.0 · 输入 help 看可用命令</p>
            </div>
            <label class="term-input-row">
              <span class="term-prompt">~ $</span>
              <input class="term-input" id="term-input" type="text" autocomplete="off" spellcheck="false" />
            </label>
          </div>`;

        const renderSettings = () => `
          <div class="settings">
            <p class="side-title">壁纸</p>
            <div class="wall-picks">
              <button class="wall-pick is-active" type="button" data-wall="nebula">星云</button>
              <button class="wall-pick" type="button" data-wall="dusk">暮色</button>
              <button class="wall-pick" type="button" data-wall="deep">深海</button>
            </div>
            <p class="side-title">关于系统</p>
            <p class="settings-note">Guandao OS · 用 Astro 静态生成，没有框架，窗口拖动是原生的 pointer 事件。</p>
          </div>`;

        const APPS: Record<
          string,
          { title: string; width: number; height: number; body: () => string }
        > = {
          posts: { title: "文章", width: 660, height: 440, body: renderPosts },
          about: { title: "关于", width: 460, height: 380, body: renderAbout },
          terminal: { title: "终端", width: 560, height: 360, body: renderTerminal },
          settings: { title: "设置", width: 420, height: 320, body: renderSettings },
        };

        /* ---------------- 窗口系统 ---------------- */

        const focusWin = (win: HTMLElement) => {
          win.style.zIndex = String(++zTop);
          windows.querySelectorAll(".window").forEach((el) => el.classList.toggle("is-front", el === win));
        };

        const closeWin = (win: HTMLElement) => {
          win.classList.add("is-closing");
          window.setTimeout(() => win.remove(), 180);
        };

        const bindDrag = (win: HTMLElement) => {
          const bar = win.querySelector(".titlebar") as HTMLElement | null;
          if (!bar) return;

          let startX = 0;
          let startY = 0;
          let originX = 0;
          let originY = 0;

          const onMove = (event: PointerEvent) => {
            const maxX = window.innerWidth - 140;
            const maxY = window.innerHeight - 110;
            win.style.left = `${Math.max(-40, Math.min(maxX, originX + event.clientX - startX))}px`;
            win.style.top = `${Math.max(32, Math.min(maxY, originY + event.clientY - startY))}px`;
          };

          const onUp = () => {
            win.classList.remove("is-dragging");
            window.removeEventListener("pointermove", onMove);
            window.removeEventListener("pointerup", onUp);
            window.removeEventListener("pointercancel", onUp);
          };

          bar.addEventListener("pointerdown", (event) => {
            if ((event.target as HTMLElement).closest(".dot")) return;
            event.preventDefault();

            startX = event.clientX;
            startY = event.clientY;
            originX = win.offsetLeft;
            originY = win.offsetTop;

            win.classList.add("is-dragging");
            focusWin(win);

            // 挂在 window 上，指针移出窗口也能继续拖
            window.addEventListener("pointermove", onMove);
            window.addEventListener("pointerup", onUp);
            window.addEventListener("pointercancel", onUp);
          });
        };

        const openApp = (id: string) => {
          const app = APPS[id];
          if (!app) return;

          const existing = windows.querySelector(`.window[data-app="${id}"]`) as HTMLElement | null;
          if (existing) {
            focusWin(existing);
            return;
          }

          hint?.classList.add("is-gone");

          const win = document.createElement("div");
          win.className = "window";
          win.dataset.app = id;

          const offset = (cascade++ % 5) * 26;
          win.style.width = `${app.width}px`;
          win.style.height = `${app.height}px`;
          win.style.left = `${Math.max(16, (window.innerWidth - app.width) / 2 + offset - 60)}px`;
          win.style.top = `${Math.max(52, 96 + offset)}px`;

          win.innerHTML = `
            <div class="titlebar">
              <span class="dots">
                <button class="dot dot-close" type="button" aria-label="关闭"></button>
                <button class="dot dot-min" type="button" aria-label="收起"></button>
                <button class="dot dot-max" type="button" aria-label="置顶"></button>
              </span>
              <span class="win-title">${app.title}</span>
            </div>
            <div class="win-body">${app.body()}</div>`;

          windows.appendChild(win);
          focusWin(win);
          bindDrag(win);

          win.querySelector(".dot-close")?.addEventListener("click", () => closeWin(win));
          win.querySelector(".dot-min")?.addEventListener("click", () => closeWin(win));
          win.querySelector(".dot-max")?.addEventListener("click", () => focusWin(win));
          win.addEventListener("pointerdown", () => focusWin(win));

          if (id === "terminal") initTerminal(win);
          if (id === "settings") initSettings(win);
        };

        /* ---------------- 终端 ---------------- */

        const initTerminal = (win: HTMLElement) => {
          const out = win.querySelector("#term-out") as HTMLElement | null;
          const input = win.querySelector("#term-input") as HTMLInputElement | null;
          if (!out || !input) return;

          const print = (text: string, className = "") => {
            const line = document.createElement("p");
            line.className = `term-line ${className}`.trim();
            line.textContent = text;
            out.appendChild(line);
            out.scrollTop = out.scrollHeight;
          };

          const run = (raw: string) => {
            const cmd = raw.trim();
            if (!cmd) return;
            print(`~ $ ${cmd}`, "term-echo");

            const [name, ...rest] = cmd.split(/\s+/);
            switch (name) {
              case "help":
                print("ls              列出文章");
                print("open <序号>     打开第 N 篇");
                print("whoami          我是谁");
                print("date            当前时间");
                print("clear           清空");
                print("exit            关掉终端");
                break;
              case "ls":
                DATA.posts.forEach((post, index) => print(`${String(index + 1).padStart(2, "0")}  ${post.title}`));
                break;
              case "open": {
                const index = Number(rest[0]) - 1;
                const post = DATA.posts[index];
                if (!post) {
                  print("没有这一篇，先用 ls 看看。", "term-error");
                  break;
                }
                print(`正在打开：${post.title}`);
                window.location.href = post.href;
                break;
              }
              case "whoami":
                print(`${DATA.site.author} · 大连理工大学 · 智能制造`);
                break;
              case "date":
                print(new Date().toLocaleString("zh-CN", { hour12: false }));
                break;
              case "clear":
                out.innerHTML = "";
                break;
              case "exit":
                closeWin(win);
                break;
              default:
                print(`未知命令：${name}，试试 help`, "term-error");
            }
          };

          input.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
              run(input.value);
              input.value = "";
            }
          });

          input.focus();
        };

        /* ---------------- 设置 ---------------- */

        const initSettings = (win: HTMLElement) => {
          win.querySelectorAll<HTMLButtonElement>(".wall-pick").forEach((button) => {
            button.addEventListener("click", () => {
              const wall = button.dataset.wall ?? "nebula";
              os.dataset.wall = wall;
              win.querySelectorAll(".wall-pick").forEach((el) => el.classList.toggle("is-active", el === button));
            });
          });
        };

        /* ---------------- 入口 ---------------- */

        document.querySelectorAll<HTMLElement>("[data-app]").forEach((trigger) => {
          const id = trigger.dataset.app;
          if (!id) return;
          if (trigger.classList.contains("desk-icon")) {
            trigger.addEventListener("dblclick", () => openApp(id));
            trigger.addEventListener("click", () => openApp(id));
          } else {
            trigger.addEventListener("click", () => openApp(id));
          }
        });

        /* ---------------- 菜单栏时间 ---------------- */

        const mbTime = document.getElementById("mb-time");
        const pad = (n: number) => String(n).padStart(2, "0");

        const tickClock = () => {
          if (!mbTime) return;
          const now = new Date();
          mbTime.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
        };

        tickClock();
        window.setInterval(tickClock, 15_000);

        // 打开文章窗口作为欢迎
        window.setTimeout(() => openApp("posts"), 420);
      })();
    </script>

    <style is:global>
      :root {
        --os-fg: #eef1f7;
        --os-dim: rgba(238, 241, 247, 0.56);
        --os-line: rgba(255, 255, 255, 0.1);
        --os-panel: rgba(28, 31, 40, 0.72);
        --os-accent: #6f8cff;
      }

      body {
        margin: 0;
        overflow: hidden;
        background: #0b0d14;
        color: var(--os-fg);
        font-family: system-ui, -apple-system, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .os {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        user-select: none;
      }

      /* ---------------- 壁纸 ---------------- */

      .wallpaper {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(1100px 760px at 18% 12%, rgba(122, 86, 190, 0.55), transparent 62%),
          radial-gradient(900px 700px at 84% 82%, rgba(48, 96, 190, 0.45), transparent 58%),
          linear-gradient(158deg, #14111f 0%, #1a1730 46%, #0c101c 100%);
        transition: background 0.6s ease;
      }

      .os[data-wall="dusk"] .wallpaper {
        background:
          radial-gradient(1000px 700px at 22% 16%, rgba(220, 128, 96, 0.45), transparent 60%),
          radial-gradient(880px 660px at 82% 78%, rgba(122, 66, 140, 0.42), transparent 58%),
          linear-gradient(160deg, #1d1620 0%, #2a1b28 48%, #140d18 100%);
      }

      .os[data-wall="deep"] .wallpaper {
        background:
          radial-gradient(1000px 720px at 24% 14%, rgba(34, 120, 150, 0.5), transparent 60%),
          radial-gradient(900px 700px at 80% 80%, rgba(22, 78, 120, 0.45), transparent 58%),
          linear-gradient(160deg, #08131c 0%, #0c2230 46%, #060e16 100%);
      }

      /* ---------------- 菜单栏 ---------------- */

      .menubar {
        position: relative;
        z-index: 40;
        display: flex;
        align-items: center;
        gap: 20px;
        height: 30px;
        padding: 0 16px;
        background: rgba(12, 14, 22, 0.5);
        backdrop-filter: blur(18px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 12px;
      }

      .mb-brand {
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      .mb-menu {
        display: flex;
        gap: 16px;
        color: var(--os-dim);
      }

      .mb-status {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--os-dim);
        font-variant-numeric: tabular-nums;
      }

      .mb-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6ee7a8;
        box-shadow: 0 0 8px rgba(110, 231, 168, 0.8);
      }

      /* ---------------- 桌面 ---------------- */

      .desk {
        position: absolute;
        inset: 30px 0 0;
      }

      .desk-icons {
        position: absolute;
        top: 24px;
        left: 22px;
        display: grid;
        gap: 16px;
      }

      .desk-icon {
        width: 74px;
        display: grid;
        justify-items: center;
        gap: 6px;
        padding: 8px 4px;
        border: 0;
        border-radius: 10px;
        background: none;
        color: inherit;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .desk-icon:hover {
        background: rgba(255, 255, 255, 0.08);
      }

      .di-glyph {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        position: relative;
      }

      .di-label {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.82);
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
      }

      /* 图标：文件夹 */
      .di-folder {
        background: linear-gradient(180deg, #7fa6ff 0%, #4a6df0 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
      }
      .di-folder::before {
        content: "";
        position: absolute;
        left: 4px;
        top: 7px;
        width: 15px;
        height: 5px;
        border-radius: 2px 2px 0 0;
        background: rgba(255, 255, 255, 0.55);
      }
      .di-folder::after {
        content: "";
        position: absolute;
        inset: 11px 5px 6px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.88);
      }

      /* 图标：人 */
      .di-person {
        background: linear-gradient(180deg, #9bb0d8 0%, #5f7398 100%);
      }
      .di-person::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 7px;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .di-person::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 6px;
        width: 20px;
        height: 12px;
        border-radius: 10px 10px 3px 3px;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }

      /* 图标：终端 */
      .di-term {
        background: linear-gradient(180deg, #2f3444 0%, #171a24 100%);
        border: 1px solid rgba(255, 255, 255, 0.14);
      }
      .di-term::before {
        content: ">_";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 13px;
        color: #7ef0b0;
      }

      /* 图标：齿轮 */
      .di-gear {
        background: linear-gradient(180deg, #a9b4c9 0%, #6b7688 100%);
      }
      .di-gear::before {
        content: "";
        position: absolute;
        inset: 9px;
        border-radius: 50%;
        border: 3px solid rgba(255, 255, 255, 0.9);
      }
      .di-gear::after {
        content: "";
        position: absolute;
        inset: 15px;
        border-radius: 50%;
        background: rgba(40, 44, 56, 0.9);
      }

      /* 图标：房子 */
      .di-home {
        background: linear-gradient(180deg, #8fd8a8 0%, #3f9a68 100%);
      }
      .di-home::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 7px;
        width: 16px;
        height: 16px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%) rotate(45deg);
        border-radius: 2px;
      }
      .di-home::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 6px;
        width: 16px;
        height: 11px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%);
        border-radius: 0 0 3px 3px;
      }

      .desk-hint {
        position: absolute;
        left: 50%;
        bottom: 110px;
        transform: translateX(-50%);
        margin: 0;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.36);
        transition: opacity 0.4s ease;
      }

      .desk-hint.is-gone {
        opacity: 0;
      }

      /* ---------------- 窗口 ---------------- */

      .windows {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .window {
        position: absolute;
        display: flex;
        flex-direction: column;
        border-radius: 12px;
        overflow: hidden;
        pointer-events: auto;
        background: var(--os-panel);
        backdrop-filter: blur(26px) saturate(1.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 32px 70px -26px rgba(0, 0, 0, 0.8);
        transition: transform 0.18s ease, opacity 0.18s ease;
        animation: winIn 0.22s ease-out;
      }

      .window.is-front {
        border-color: rgba(255, 255, 255, 0.18);
      }

      .window.is-dragging {
        transition: none;
      }

      .window.is-closing {
        transform: scale(0.94);
        opacity: 0;
      }

      @keyframes winIn {
        from {
          transform: scale(0.96) translateY(8px);
          opacity: 0;
        }
        to {
          transform: none;
          opacity: 1;
        }
      }

      .titlebar {
        display: flex;
        align-items: center;
        gap: 10px;
        height: 38px;
        padding: 0 12px;
        background: rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        cursor: grab;
      }

      .is-dragging .titlebar {
        cursor: grabbing;
      }

      .dots {
        display: flex;
        gap: 7px;
      }

      .dot {
        width: 11px;
        height: 11px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        cursor: pointer;
      }

      .dot-close {
        background: #ff5f57;
      }
      .dot-min {
        background: #febc2e;
      }
      .dot-max {
        background: #28c840;
      }

      .win-title {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.72);
      }

      .win-body {
        flex: 1;
        min-height: 0;
        overflow: auto;
        overscroll-behavior: contain;
      }

      /* ---------------- Finder ---------------- */

      .finder {
        display: grid;
        grid-template-columns: 148px minmax(0, 1fr);
        height: 100%;
      }

      .finder-side {
        padding: 14px 12px;
        background: rgba(255, 255, 255, 0.04);
        border-right: 1px solid rgba(255, 255, 255, 0.06);
      }

      .side-title {
        margin: 12px 0 6px;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.36);
      }

      .side-title:first-child {
        margin-top: 0;
      }

      .side-item {
        display: block;
        padding: 6px 9px;
        border-radius: 7px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.62);
      }

      .side-item.is-active {
        background: rgba(111, 140, 255, 0.24);
        color: #fff;
      }

      .finder-files {
        padding: 8px;
        overflow: auto;
      }

      .file-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 9px;
        color: inherit;
        text-decoration: none;
        transition: background-color 0.16s ease;
      }

      .file-row:hover {
        background: rgba(255, 255, 255, 0.08);
      }

      .file-icon {
        width: 26px;
        height: 30px;
        flex: none;
        border-radius: 3px;
        background: linear-gradient(180deg, #ffffff 0%, #d9dfea 100%);
        position: relative;
      }

      .file-icon::after {
        content: "";
        position: absolute;
        left: 5px;
        right: 5px;
        top: 9px;
        height: 2px;
        background: rgba(70, 84, 110, 0.45);
        box-shadow: 0 5px 0 rgba(70, 84, 110, 0.3), 0 10px 0 rgba(70, 84, 110, 0.2);
      }

      .file-main {
        min-width: 0;
        display: grid;
        gap: 3px;
      }

      .file-name {
        font-size: 13px;
        color: #f2f5fa;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .file-meta {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.42);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .file-index {
        margin-left: auto;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.28);
      }

      .finder-empty {
        padding: 24px 12px;
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.45);
      }

      /* ---------------- 关于 ---------------- */

      .about {
        padding: 24px 26px;
        font-size: 13px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.72);
      }

      .about-kicker {
        margin: 0 0 4px;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.38);
      }

      .about h2 {
        margin: 0 0 12px;
        font-size: 22px;
        color: #fff;
      }

      .about p {
        margin: 0 0 10px;
      }

      .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .about-links a {
        font-size: 12.5px;
        color: #9fb4ff;
        text-decoration: none;
      }

      .about-links a:hover {
        text-decoration: underline;
      }

      /* ---------------- 终端 ---------------- */

      .term {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: rgba(8, 10, 16, 0.82);
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 12.5px;
      }

      .term-out {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 14px 16px 6px;
        line-height: 1.7;
      }

      .term-line {
        margin: 0 0 2px;
        color: rgba(232, 240, 255, 0.82);
        white-space: pre-wrap;
      }

      .term-muted {
        color: rgba(232, 240, 255, 0.42);
      }

      .term-echo {
        color: #7ef0b0;
      }

      .term-error {
        color: #ff8f8f;
      }

      .term-input-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 16px 14px;
      }

      .term-prompt {
        color: #7ef0b0;
      }

      .term-input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: none;
        color: #eef1f7;
        font: inherit;
        outline: none;
        caret-color: #7ef0b0;
      }

      /* ---------------- 设置 ---------------- */

      .settings {
        padding: 20px 22px;
      }

      .wall-picks {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
      }

      .wall-pick {
        flex: 1;
        padding: 9px 0;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.72);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .wall-pick:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      .wall-pick.is-active {
        border-color: var(--os-accent);
        background: rgba(111, 140, 255, 0.22);
        color: #fff;
      }

      .settings-note {
        margin: 0;
        font-size: 12px;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.46);
      }

      /* ---------------- Dock ---------------- */

      .dock {
        position: absolute;
        left: 50%;
        bottom: 14px;
        transform: translateX(-50%);
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 13px;
        border-radius: 18px;
        background: rgba(20, 22, 30, 0.55);
        backdrop-filter: blur(22px) saturate(1.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.8);
      }

      .dock-item {
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 12px;
        background: none;
        cursor: pointer;
        transition: transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.4);
      }

      .dock-item:hover {
        transform: translateY(-8px) scale(1.12);
      }

      .dock-glyph {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 12px;
        position: relative;
      }

      .dock-glyph.di-folder::before,
      .dock-glyph.di-folder::after,
      .dock-glyph.di-person::before,
      .dock-glyph.di-person::after,
      .dock-glyph.di-gear::before,
      .dock-glyph.di-gear::after,
      .dock-glyph.di-home::before,
      .dock-glyph.di-home::after {
        content: "";
        position: absolute;
      }

      .dock-glyph.di-folder::before {
        left: 5px;
        top: 9px;
        width: 19px;
        height: 6px;
        border-radius: 2px 2px 0 0;
        background: rgba(255, 255, 255, 0.55);
      }
      .dock-glyph.di-folder::after {
        inset: 14px 6px 8px;
        border-radius: 3px;
        background: rgba(255, 255, 255, 0.88);
      }
      .dock-glyph.di-person::before {
        left: 50%;
        top: 9px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-person::after {
        left: 50%;
        bottom: 8px;
        width: 26px;
        height: 15px;
        border-radius: 13px 13px 4px 4px;
        background: rgba(255, 255, 255, 0.9);
        transform: translateX(-50%);
      }
      .dock-glyph.di-term::before {
        content: ">_";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: ui-monospace, Consolas, monospace;
        font-size: 17px;
        color: #7ef0b0;
      }
      .dock-glyph.di-gear::before {
        inset: 11px;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.9);
      }
      .dock-glyph.di-gear::after {
        inset: 19px;
        border-radius: 50%;
        background: rgba(40, 44, 56, 0.92);
      }
      .dock-glyph.di-home::before {
        left: 50%;
        top: 9px;
        width: 21px;
        height: 21px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%) rotate(45deg);
        border-radius: 3px;
      }
      .dock-glyph.di-home::after {
        left: 50%;
        bottom: 8px;
        width: 21px;
        height: 14px;
        background: rgba(255, 255, 255, 0.92);
        transform: translateX(-50%);
        border-radius: 0 0 4px 4px;
      }

      .dock-sep {
        width: 1px;
        height: 30px;
        margin: 0 2px;
        background: rgba(255, 255, 255, 0.14);
      }

      .dock-link {
        display: block;
      }

      /* ---------------- 响应式 ---------------- */

      @media (max-width: 720px) {
        .desk-icons {
          display: none;
        }

        .window {
          left: 8px !important;
          right: 8px;
          width: auto !important;
          max-width: none;
        }

        .finder {
          grid-template-columns: 1fr;
        }

        .finder-side {
          display: none;
        }

        .dock {
          gap: 6px;
          padding: 7px 10px;
          border-radius: 16px;
        }

        .dock-item {
          width: 38px;
          height: 38px;
        }

        .desk-hint {
          display: none;
        }
      }
    </style>
  </body>
</html>
