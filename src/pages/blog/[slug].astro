---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, render } from "astro:content";
import { getAllPosts, toPost, neighbours, relatedPosts, slugOf } from "../../lib/posts";
import { SITE, formatDate, isoDate, formatShortDate } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => data.draft !== true);
  return entries.map((entry) => ({
    params: { slug: slugOf(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const post = toPost(entry);
const { Content, headings } = await render(entry);

const all = await getAllPosts();
const { prev, next } = neighbours(all, post.slug);
const related = relatedPosts(all, post, 2);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const jsonLd = {
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  datePublished: isoDate(post.pubDate),
  dateModified: isoDate(post.updatedDate ?? post.pubDate),
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/blog/${post.slug}/` },
  keywords: post.tags.join(", "),
  image: post.cover ? new URL(post.cover, SITE.url).href : undefined,
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  canonical={`/blog/${post.slug}/`}
  type="article"
  image={post.cover}
  jsonLd={jsonLd}
>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <article class="article">
    <div class="wrap">
      <nav class="crumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span>/</span>
        <a href="/blog/">文章</a>
        <span>/</span>
        <span class="crumb-current">{post.tags[0] ?? "随笔"}</span>
      </nav>

      <header class="post-head">
        <div class="post-tags">
          {post.tags.map((tag) => (
            <a class="pill" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
          ))}
        </div>

        <h1>{post.title}</h1>
        <p class="post-desc">{post.description}</p>

        <div class="post-meta">
          <span class="author">
            <span class="avatar" aria-hidden="true">管</span>
            {SITE.author}
          </span>
          <span class="sep" />
          <time datetime={isoDate(post.pubDate)}>{formatDate(post.pubDate)}</time>
          <span class="sep" />
          <span>{post.minutes} 分钟阅读</span>
          {post.updatedDate && (
            <>
              <span class="sep" />
              <span>更新于 {formatShortDate(post.updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      <div class="article-layout">
        <div class="prose article-body">
          <Content />
        </div>

        {toc.length > 1 && (
          <aside class="toc" aria-label="文章目录">
            <p class="toc-title">本页目录</p>
            <ul>
              {toc.map((heading) => (
                <li class:list={[`d${heading.depth}`]}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
            <button class="copy-link" id="copy-link" type="button" data-copied="链接已复制">
              <Icon name="link" size={13} />
              复制本文链接
            </button>
          </aside>
        )}
      </div>

      <footer class="post-footer">
        <div class="post-end">
          <span aria-hidden="true">— 完 —</span>
        </div>

        <div class="post-actions">
          <div class="post-tags">
            {post.tags.map((tag) => (
              <a class="pill" href={`/tags/${encodeURIComponent(tag)}/`}>
                <Icon name="tag" size={11} />
                {tag}
              </a>
            ))}
          </div>
          <button class="btn" id="copy-link-2" type="button" data-copied="链接已复制">
            <Icon name="link" size={14} />
            分享
          </button>
        </div>

        <nav class="pager" aria-label="上下篇">
          {prev ? (
            <a class="pager-item" href={`/blog/${prev.slug}/`}>
              <span class="pager-label"><Icon name="chevron-left" size={13} /> 上一篇</span>
              <strong>{prev.title}</strong>
            </a>
          ) : (
            <span class="pager-item pager-item--empty">
              <span class="pager-label">已经是第一篇</span>
            </span>
          )}
          {next ? (
            <a class="pager-item pager-item--right" href={`/blog/${next.slug}/`}>
              <span class="pager-label">下一篇 <Icon name="chevron-right" size={13} /></span>
              <strong>{next.title}</strong>
            </a>
          ) : (
            <span class="pager-item pager-item--right pager-item--empty">
              <span class="pager-label">已经是最新一篇</span>
            </span>
          )}
        </nav>
      </footer>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <div class="related-head">
          <span class="eyebrow">继续阅读</span>
          <a href="/blog/">全部文章 →</a>
        </div>
        <div class="related-grid">
          {related.map((item) => (
            <a class="related-card" href={`/blog/${item.slug}/`}>
              <span class="related-date">{formatShortDate(item.pubDate)}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

<script is:inline>
  (() => {
    // 阅读进度
    const bar = document.getElementById("progress");
    const article = document.querySelector(".article-body");
    if (bar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.5;
        const scrolled = Math.min(Math.max(-rect.top + window.innerHeight * 0.25, 0), Math.max(total, 1));
        bar.style.transform = `scaleX(${scrolled / Math.max(total, 1)})`;
      };
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    }

    // 目录高亮
    const tocLinks = [...document.querySelectorAll(".toc a")];
    if (tocLinks.length) {
      const targets = tocLinks
        .map((link) => ({ link, el: document.querySelector(link.getAttribute("href")) }))
        .filter((item) => item.el);
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const match = targets.find((item) => item.el === entry.target);
            if (!match) continue;
            tocLinks.forEach((link) => link.classList.remove("active"));
            match.link.classList.add("active");
          }
        },
        { rootMargin: "-88px 0px -70% 0px", threshold: 0 },
      );
      targets.forEach((item) => observer.observe(item.el));
    }

    // 复制链接
    for (const id of ["copy-link", "copy-link-2"]) {
      const button = document.getElementById(id);
      if (!button) continue;
      button.addEventListener("click", async () => {
        const original = button.innerHTML;
        try {
          await navigator.clipboard.writeText(location.href);
          button.textContent = button.dataset.copied || "已复制";
          setTimeout(() => (button.innerHTML = original), 1800);
        } catch {
          button.textContent = "复制失败";
          setTimeout(() => (button.innerHTML = original), 1800);
        }
      });
    }
  })();
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    z-index: 60;
    opacity: 0.75;
  }

  .article {
    padding-top: 26px;
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--muted);
    padding: 8px 0 0;
  }

  .crumb a:hover {
    color: var(--accent);
  }

  .crumb-current {
    color: var(--ink-2);
  }

  .post-head {
    max-width: 760px;
    padding: 34px 0 30px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .post-head h1 {
    font-size: clamp(30px, 4.6vw, 46px);
    letter-spacing: -0.028em;
    line-height: 1.28;
  }

  .post-desc {
    margin: 16px 0 0;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--muted);
    max-width: 40em;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-family: var(--font-serif);
    font-size: 11px;
  }

  .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: 60px;
    align-items: start;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }

  .article-body {
    max-width: 700px;
    min-width: 0;
  }

  .article-body :global(.heading-anchor) {
    margin-left: 8px;
    color: var(--accent);
    opacity: 0;
    font-weight: 400;
    text-decoration: none;
    border: 0;
    transition: opacity 0.2s var(--ease);
  }

  .article-body :global(h2:hover .heading-anchor),
  .article-body :global(h3:hover .heading-anchor) {
    opacity: 0.6;
  }

  /* ---------------- toc ---------------- */
  .toc {
    position: sticky;
    top: 92px;
    font-size: 12.5px;
    padding-top: 6px;
  }

  .toc-title {
    margin: 0 0 12px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .toc li a {
    display: block;
    padding: 5px 0 5px 13px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--muted);
    line-height: 1.55;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .toc li.d3 a {
    padding-left: 24px;
    font-size: 12px;
  }

  .toc li a:hover {
    color: var(--ink);
  }

  .toc li a.active {
    color: var(--accent-ink);
    border-left-color: var(--accent);
  }

  .copy-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    padding: 6px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 11.5px;
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }

  .copy-link:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  /* ---------------- footer ---------------- */
  .post-end {
    text-align: center;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.2em;
    padding: 40px 0 30px;
  }

  .post-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-top: 26px;
  }

  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .pager-item:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    transform: translateY(-2px);
  }

  .pager-item--right {
    text-align: right;
    align-items: flex-end;
  }

  .pager-item--empty {
    opacity: 0.55;
  }

  .pager-item--empty:hover {
    transform: none;
    border-color: var(--line);
  }

  .pager-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .pager-item strong {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.55;
  }

  /* ---------------- related ---------------- */
  .related {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }

  .related-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    font-size: 13px;
  }

  .related-head a {
    color: var(--muted);
  }

  .related-head a:hover {
    color: var(--accent);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .related-card {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .related-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .related-card h3 {
    margin: 9px 0 8px;
    font-size: 17px;
    line-height: 1.5;
  }

  .related-card p {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1000px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .toc {
      display: none;
    }
    .article-body {
      max-width: 100%;
    }
  }

  @media (max-width: 620px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-item--right {
      text-align: left;
      align-items: flex-start;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
</BaseLayout>
