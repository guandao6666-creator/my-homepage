---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import Comments from "../../components/Comments.astro";
import { getCollection, render } from "astro:content";
import {
  getAllPosts,
  toPost,
  neighbours,
  relatedPosts,
  slugOf,
  seriesInfo,
  ogImagePath,
} from "../../lib/posts";
import { SITE, formatDate, isoDate, formatShortDate } from "../../lib/site";
import "../../styles/blog-pixel.css";

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => data.draft !== true);
  return entries.map((entry) => ({
    params: { slug: slugOf(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const post = toPost(entry);
const { Content, headings } = await render(entry);

const all = await getAllPosts();
const { prev, next } = neighbours(all, post.slug);
const related = relatedPosts(all, post, 2);
const series = seriesInfo(all, post);
// autolink 会在标题文本末尾追加一个 "#"，提取目录时去掉
const toc = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ ...heading, text: heading.text.replace(/\s*#\s*$/, "") }));

const jsonLd = {
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  datePublished: isoDate(post.pubDate),
  dateModified: isoDate(post.updatedDate ?? post.pubDate),
  author: { "@type": "Person", name: SITE.author, url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/blog/${post.slug}/` },
  keywords: post.tags.join(", "),
  image: post.cover ? new URL(post.cover, SITE.url).href : undefined,
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  canonical={`/blog/${post.slug}/`}
  type="article"
  image={post.cover}
  ogImage={ogImagePath(post.slug)}
  jsonLd={jsonLd}
>
  <div class="blog-pixel">
    <div class="progress" id="progress" aria-hidden="true"></div>

    <article class="px-article">
      <div class="wrap">
        <nav class="px-crumb" aria-label="面包屑">
          <a href="/home/">首页</a>
          <span>/</span>
          <a href="/blog/">文章</a>
          <span>/</span>
          <span class="px-crumb-now">{post.tags[0] ?? "随笔"}</span>
        </nav>

        <header class="px-head">
          <div class="px-tags">
            {post.tags.map((tag) => (
              <a class="px-chip" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))}
          </div>

          <h1>{post.title}</h1>
          <p class="px-head-desc">{post.description}</p>

          <div class="px-meta">
            <span class="px-meta-who">
              <span class="px-meta-avatar" aria-hidden="true">管</span>
              {SITE.author}
            </span>
            <span class="px-meta-item">
              <time datetime={isoDate(post.pubDate)}>{formatDate(post.pubDate)}</time>
            </span>
            <span class="px-meta-item">{post.minutes} 分钟阅读</span>
            {post.updatedDate && (
              <span class="px-meta-item">更新于 {formatShortDate(post.updatedDate)}</span>
            )}
            <button class="px-font-toggle" id="px-font-toggle" type="button" title="切换正文字号">
              字号：标准
            </button>
          </div>
        </header>

        <div class:list={["px-layout", { "px-layout--plain": toc.length <= 1 }]}>
          {toc.length > 1 && (
            <details class="px-toc-mobile">
              <summary>
                <span>本页目录</span>
                <em>{toc.length} 节</em>
              </summary>
              <ul>
                {toc.map((heading) => (
                  <li class:list={[`d${heading.depth}`]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )}

          <div class="px-sheet prose article-body">
            <Content />
          </div>

          {toc.length > 1 && (
            <aside class="px-toc" aria-label="文章目录">
              <p class="px-toc-title">INDEX</p>
              <ul>
                {toc.map((heading) => (
                  <li class:list={[`d${heading.depth}`]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
              <button class="px-copy" id="copy-link" type="button" data-copied="链接已复制">
                <Icon name="link" size={13} />
                复制链接
              </button>
            </aside>
          )}
        </div>

        <footer class="post-footer">
          <div class="px-end">
            <span aria-hidden="true">— 完 —</span>
          </div>

          <div class="px-actions">
            <div class="px-tags">
              {post.tags.map((tag) => (
                <a class="px-chip" href={`/tags/${encodeURIComponent(tag)}/`}>
                  <Icon name="tag" size={11} />
                  {tag}
                </a>
              ))}
            </div>
            <div class="px-actions-btns">
              <button
                class="px-btn like-btn"
                id="post-like"
                type="button"
                data-like="post"
                data-id={post.slug}
                aria-pressed="false"
              >
                <span class="like-heart" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21.2l7.7-7.7 1.1-1a5.5 5.5 0 0 0 0-7.9Z"/></svg>
                </span>
                <span class="like-count">0</span>
                <span class="like-label">喜欢</span>
              </button>
              <button class="px-btn px-btn--ghost" id="copy-link-2" type="button" data-copied="链接已复制">
                <Icon name="link" size={14} />
                分享
              </button>
            </div>
          </div>

          <nav class="px-pager" aria-label="上下篇">
            {prev ? (
              <a class="px-pager-item" data-prev-post href={`/blog/${prev.slug}/`}>
                <span class="px-pager-label"><Icon name="chevron-left" size={13} /> 上一篇</span>
                <strong>{prev.title}</strong>
              </a>
            ) : (
              <span class="px-pager-item px-pager-item--empty">
                <span class="px-pager-label">已经是第一篇</span>
              </span>
            )}
            {next ? (
              <a class="px-pager-item px-pager-item--right" data-next-post href={`/blog/${next.slug}/`}>
                <span class="px-pager-label">下一篇 <Icon name="chevron-right" size={13} /></span>
                <strong>{next.title}</strong>
              </a>
            ) : (
              <span class="px-pager-item px-pager-item--right px-pager-item--empty">
                <span class="px-pager-label">已经是最新一篇</span>
              </span>
            )}
          </nav>
        </footer>

        {series && (
          <section class="px-series">
            <div class="px-series-head">
              <span class="px-tag">系列</span>
              <span class="px-series-count">共 {series.total} 篇 · 第 {series.index + 1} 篇</span>
            </div>
            <h2>
              <a href={`/series/${encodeURIComponent(series.name)}/`}>{series.name}</a>
            </h2>
            <ol class="px-series-list">
              {series.posts.map((item, i) => (
                <li class:list={["px-series-item", { current: item.slug === post.slug }]}>
                  <a href={`/blog/${item.slug}/`}>
                    <span class="px-series-num">{String(i + 1).padStart(2, "0")}</span>
                    <span class="px-series-title">{item.title}</span>
                    {item.slug === post.slug && <span class="px-series-now">正在读</span>}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        <div class="px-comments">
          <Comments slug={post.slug} />
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="px-related">
        <div class="wrap">
          <div class="px-related-head">
            <span>继续阅读</span>
            <a href="/blog/">全部文章 →</a>
          </div>
          <div class="px-related-grid">
            {related.map((item) => (
              <a class="px-related-card" href={`/blog/${item.slug}/`}>
                <span class="px-related-date">{formatShortDate(item.pubDate)}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

<script is:inline>
  (() => {
    // 阅读进度
    const bar = document.getElementById("progress");
    const article = document.querySelector(".px-sheet");
    if (bar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.5;
        const scrolled = Math.min(Math.max(-rect.top + window.innerHeight * 0.25, 0), Math.max(total, 1));
        bar.style.transform = `scaleX(${scrolled / Math.max(total, 1)})`;
      };
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    }

    // 目录高亮
    const tocLinks = [...document.querySelectorAll(".px-toc a")];
    if (tocLinks.length) {
      const targets = tocLinks
        .map((link) => ({ link, el: document.querySelector(link.getAttribute("href")) }))
        .filter((item) => item.el);
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const match = targets.find((item) => item.el === entry.target);
            if (!match) continue;
            tocLinks.forEach((link) => link.classList.remove("active"));
            match.link.classList.add("active");
          }
        },
        { rootMargin: "-88px 0px -70% 0px", threshold: 0 },
      );
      targets.forEach((item) => observer.observe(item.el));
    }

    // 移动端目录：点完一项就收起来，别让展开的目录挡在正文前面
    const mobileToc = document.querySelector(".px-toc-mobile");
    if (mobileToc) {
      mobileToc.addEventListener("click", (event) => {
        if (event.target.closest("a")) mobileToc.removeAttribute("open");
      });
    }

    // 复制链接
    for (const id of ["copy-link", "copy-link-2"]) {
      const button = document.getElementById(id);
      if (!button) continue;
      button.addEventListener("click", async () => {
        const original = button.innerHTML;
        try {
          await navigator.clipboard.writeText(location.href);
          button.textContent = button.dataset.copied || "已复制";
          setTimeout(() => (button.innerHTML = original), 1800);
        } catch {
          button.textContent = "复制失败";
          setTimeout(() => (button.innerHTML = original), 1800);
        }
      });
    }

    /* ---------------- 图片点击放大 ---------------- */
    const body = document.querySelector(".px-sheet");
    if (body) {
      const overlay = document.createElement("div");
      overlay.className = "lightbox";
      overlay.hidden = true;
      const big = document.createElement("img");
      big.alt = "";
      overlay.append(big);
      document.body.append(overlay);

      const close = () => {
        overlay.hidden = true;
        document.body.style.overflow = "";
      };

      body.addEventListener("click", (event) => {
        const img = event.target.closest("img");
        if (!img) return;
        big.src = img.currentSrc || img.src;
        big.alt = img.alt || "";
        overlay.hidden = false;
        document.body.style.overflow = "hidden";
      });

      overlay.addEventListener("click", close);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !overlay.hidden) close();
      });
    }

    /* ---------------- 代码块复制 ---------------- */
    for (const button of document.querySelectorAll("[data-code-copy]")) {
      const block = button.closest(".code-block");
      const code = block?.querySelector("pre code") ?? block?.querySelector("pre");
      if (!code) continue;

      button.addEventListener("click", async () => {
        // 用 innerText：Shiki 把代码拆成一堆 span，textContent 会丢掉渲染换行
        const source = code.innerText.replace(/\n$/, "");
        try {
          await navigator.clipboard.writeText(source);
          button.textContent = "已复制";
          button.dataset.copied = "1";
        } catch {
          button.textContent = "复制失败";
        }
        setTimeout(() => {
          button.textContent = "复制";
          delete button.dataset.copied;
        }, 1600);
      });
    }
  })();
</script>

<script>
  // 阅读字号切换（持久化到 localStorage）+ 键盘 [ / ] 切换上下篇
  (() => {
    const KEY = "guandao.reader.fontsize";
    const sheet = document.querySelector<HTMLElement>(".px-sheet");
    const btn = document.getElementById("px-font-toggle");
    const apply = (large: boolean) => {
      if (sheet) sheet.style.fontSize = large ? "1.09rem" : "";
      if (btn) btn.textContent = large ? "字号：偏大" : "字号：标准";
    };
    let large = false;
    try {
      large = localStorage.getItem(KEY) === "large";
    } catch {}
    apply(large);
    btn?.addEventListener("click", () => {
      large = !large;
      try {
        localStorage.setItem(KEY, large ? "large" : "normal");
      } catch {}
      apply(large);
    });

    document.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const el = document.activeElement as HTMLElement | null;
      if (el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable)) return;
      if (e.key === "[") {
        const prev = document.querySelector<HTMLAnchorElement>("[data-prev-post]");
        if (prev) prev.click();
      } else if (e.key === "]") {
        const next = document.querySelector<HTMLAnchorElement>("[data-next-post]");
        if (next) next.click();
      }
    });
  })();
</script>

<style>
  .px-font-toggle {
    margin-left: auto;
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .px-font-toggle:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
  }
</style>
</BaseLayout>
