---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Icon from "../../components/Icon.astro";
import { getAllPosts, collectTags } from "../../lib/posts";
import { SITE } from "../../lib/site";

const posts = await getAllPosts();
const tags = collectTags(posts);
const years = [...new Set(posts.map((p) => new Date(p.pubDate).getUTCFullYear()))].sort((a, b) => b - a);

const jsonLd = {
  "@type": "Blog",
  name: `${SITE.name} · 文章归档`,
  url: `${SITE.url}/blog/`,
  blogPost: posts.slice(0, 20).map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    datePublished: new Date(post.pubDate).toISOString(),
    url: `${SITE.url}/blog/${post.slug}/`,
  })),
};
---

<BaseLayout
  title="文章归档"
  description={`${SITE.author}的全部文章，共 ${posts.length} 篇，涵盖技术实践、学习笔记与生活思考。`}
  canonical="/blog/"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Archive · {posts.length} 篇</span>
      <h1>全部文章</h1>
      <p class="page-lede">
        按时间倒序排列。关键词会同时匹配标题、摘要、标签和正文，也可以用标签快速缩小范围。
      </p>
    </div>
  </section>

  <div class="wrap">
    <div class="toolbar">
      <label class="search">
        <Icon name="search" size={16} />
        <input
          type="search"
          id="post-search"
          placeholder="搜索标题、正文或标签…"
          autocomplete="off"
          aria-label="搜索文章"
        />
        <kbd>/</kbd>
      </label>

      <div class="filters" id="tag-filters" role="group" aria-label="按标签筛选">
        <button class="filter is-active" data-tag="" type="button">全部</button>
        {tags.map((tag) => (
          <button class="filter" data-tag={tag.tag} type="button">
            {tag.tag}
            <em>{tag.count}</em>
          </button>
        ))}
      </div>
    </div>

    <p class="result-line">
      <span id="result-count">{posts.length}</span> 篇文章
      <span class="hint" id="filter-hint"></span>
    </p>

    <div class="post-list" id="post-list">
      {posts.map((post, i) => (
        <div
          class="post-item"
          data-slug={post.slug}
          data-search={`${post.title} ${post.description} ${post.tags.join(" ")}`.toLowerCase()}
          data-tags={post.tags.join("|")}
        >
          <PostCard post={post} index={i} />
          <p class="hit-snippet" hidden></p>
        </div>
      ))}
    </div>

    <div class="empty-state" id="empty-state" hidden>
      {posts.length === 0 ? (
        <>
          <p>这里还没有文章。第一篇正在路上，可以先看看 <a href="/about/">关于我</a>。</p>
        </>
      ) : (
        <>
          <p>没有匹配的文章。</p>
          <button class="btn" id="clear-filters" type="button">清除筛选条件</button>
        </>
      )}
    </div>

    {years.length > 0 && (
      <div class="year-note">
        <span>归档年份</span>
        {years.map((year) => <em>{year}</em>)}
      </div>
    )}
  </div>


<script is:inline>
  (() => {
    const input = document.getElementById("post-search");
    const filters = document.getElementById("tag-filters");
    const items = [...document.querySelectorAll(".post-item")];
    const counter = document.getElementById("result-count");
    const hint = document.getElementById("filter-hint");
    const empty = document.getElementById("empty-state");
    const clear = document.getElementById("clear-filters");
    if (!input || !filters) return;

    let activeTag = "";
    let query = "";
    /** null 表示索引还没到，此时退回服务端预渲染的 data-search 字段 */
    let index = null;

    const baseOrder = new Map(items.map((el, i) => [el, i]));
    const normalize = (value) => (value || "").toLowerCase();
    const termsOf = (value) => normalize(value).split(/\s+/).filter(Boolean);
    const escapeHtml = (text) =>
      String(text).replace(
        /[&<>"]/g,
        (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch],
      );
    const escapeRegExp = (text) => text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    /** 标题 > 标签 > 摘要 > 正文；多个关键词之间取「并且」 */
    function scoreEntry(entry, terms) {
      if (!entry) return 0;
      const title = normalize(entry.title);
      const description = normalize(entry.description);
      const tags = normalize((entry.tags || []).join(" "));
      const body = normalize(entry.body);

      let total = 0;
      for (const term of terms) {
        let score = 0;
        if (title.includes(term)) score += 14;
        if (tags.includes(term)) score += 8;
        if (description.includes(term)) score += 5;
        if (body.includes(term)) score += 2;
        if (!score) return 0;
        total += score;
      }
      return total;
    }

    /** 截一段正文命中的上下文，关键词包成 <mark> */
    function snippetFor(entry, terms) {
      if (!entry || !entry.body) return "";
      const body = entry.body;
      const lower = body.toLowerCase();

      let pos = -1;
      let hit = "";
      for (const term of terms) {
        const found = lower.indexOf(term);
        if (found === -1) continue;
        if (pos === -1 || found < pos) {
          pos = found;
          hit = term;
        }
      }
      if (pos === -1) return "";

      const start = Math.max(0, pos - 30);
      const end = Math.min(body.length, pos + hit.length + 46);
      let html = escapeHtml(
        (start > 0 ? "…" : "") + body.slice(start, end) + (end < body.length ? "…" : ""),
      );
      for (const term of terms) {
        if (!term) continue;
        const pattern = new RegExp(escapeRegExp(escapeHtml(term)), "gi");
        html = html.replace(pattern, (match) => `<mark>${match}</mark>`);
      }
      return html;
    }

    const legacyMatch = (item, terms) => {
      const haystack = item.dataset.search || "";
      return terms.every((term) => haystack.includes(term));
    };

    const apply = () => {
      const terms = termsOf(query);

      let visible = 0;
      for (const item of items) {
        const tags = (item.dataset.tags || "").split("|").filter(Boolean);
        const matchTag = !activeTag || tags.includes(activeTag);

        let show = matchTag;
        let score = 0;
        if (show && terms.length) {
          const entry = index && index.find((row) => row.slug === item.dataset.slug);
          if (entry) {
            score = scoreEntry(entry, terms);
            show = score > 0;
          } else {
            show = legacyMatch(item, terms);
          }
        }

        item.hidden = !show;
        item.style.order = terms.length ? String(-score) : String(baseOrder.get(item) ?? 0);

        const box = item.querySelector(".hit-snippet");
        if (box) {
          const entry = index && index.find((row) => row.slug === item.dataset.slug);
          const snippet = terms.length && show && entry ? snippetFor(entry, terms) : "";
          box.innerHTML = snippet;
          box.hidden = !snippet;
        }

        if (show) visible += 1;
      }

      counter.textContent = String(visible);
      empty.hidden = visible !== 0;
      hint.textContent =
        activeTag || query
          ? `· 已筛选${activeTag ? `「${activeTag}」` : ""}${query ? ` 关键词「${query}」` : ""}${terms.length ? "（含正文）" : ""}`
          : "";
    };

    input.addEventListener("input", () => {
      query = input.value.trim().toLowerCase();
      apply();
    });

    filters.addEventListener("click", (event) => {
      const button = event.target.closest(".filter");
      if (!button) return;
      activeTag = button.dataset.tag || "";
      for (const chip of filters.querySelectorAll(".filter")) {
        chip.classList.toggle("is-active", chip === button);
      }
      apply();
    });

    clear?.addEventListener("click", () => {
      input.value = "";
      query = "";
      activeTag = "";
      for (const chip of filters.querySelectorAll(".filter")) {
        chip.classList.toggle("is-active", chip.dataset.tag === "");
      }
      apply();
      input.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== input) {
        event.preventDefault();
        input.focus();
      }
    });

    // 索引不大，进页面就预取；失败也不影响搜索，还有 data-search 兜底
    fetch("/search-index.json")
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then((data) => {
        if (!Array.isArray(data)) return;
        index = data;
        if (query) apply();
      })
      .catch(() => undefined);

    // 首次进入就先算一遍：没有文章时直接显示空状态
    apply();
  })();
</script>

<style>
  .page-head {
    padding: 58px 0 34px;
    border-bottom: 1px solid var(--line);
  }

  .page-head h1 {
    margin: 14px 0 12px;
    font-size: clamp(34px, 5vw, 46px);
    letter-spacing: -0.03em;
  }

  .page-lede {
    margin: 0;
    max-width: 40em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.9;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding: 26px 0 4px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: 1 1 260px;
    max-width: 340px;
    padding: 0 12px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .search:focus-within {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13.5px;
    color: var(--ink);
    outline: none;
    padding: 0;
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .search kbd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 5px;
    color: var(--muted);
    background: var(--surface-sunk);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    flex: 1 1 auto;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }

  .filter em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    padding: 3px 5px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 9%, transparent);
    opacity: 0.8;
  }

  .filter:hover {
    color: var(--ink);
    background: var(--surface-sunk);
  }

  .filter.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  [data-theme="dark"] .filter.is-active {
    background: var(--accent-wash);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    color: var(--accent-ink);
  }

  .result-line {
    margin: 18px 0 0;
    font-size: 12.5px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .result-line .hint {
    margin-left: 6px;
    color: var(--accent-ink);
  }

  /* flex 列 + order：搜索命中时按相关度重排，不改 DOM 顺序 */
  .post-list {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
    border-bottom: 1px solid var(--line);
  }

  .hit-snippet {
    margin: -12px 0 20px 52px;
    padding: 2px 0 2px 12px;
    border-left: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }

  .hit-snippet mark {
    padding: 0 2px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--ink);
  }

  .empty-state {
    padding: 48px 0;
    text-align: center;
    color: var(--muted);
  }

  .empty-state p {
    margin: 0 0 16px;
  }

  .year-note {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 34px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  .year-note span {
    text-transform: uppercase;
    font-size: 10.5px;
    letter-spacing: 0.16em;
  }

  .year-note em {
    font-style: normal;
    font-family: var(--font-mono);
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  @media (max-width: 640px) {
    .page-head {
      padding-top: 40px;
    }
    .search {
      max-width: none;
      flex-basis: 100%;
    }
    .hit-snippet {
      margin-left: 0;
    }
  }
</style>
</BaseLayout>
