---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PixelFish from "../../components/PixelFish.astro";
import Icon from "../../components/Icon.astro";
import { getAllPosts, collectTags } from "../../lib/posts";
import { SITE, formatShortDate } from "../../lib/site";
import "../../styles/blog-pixel.css";

const posts = await getAllPosts();
const tags = collectTags(posts);
const years = [...new Set(posts.map((p) => new Date(p.pubDate).getUTCFullYear()))].sort((a, b) => b - a);
const latestYear = years[0] ?? new Date().getFullYear();

const jsonLd = {
  "@type": "Blog",
  name: `${SITE.name} · 文章归档`,
  url: `${SITE.url}/blog/`,
  blogPost: posts.slice(0, 20).map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    datePublished: new Date(post.pubDate).toISOString(),
    url: `${SITE.url}/blog/${post.slug}/`,
  })),
};
---

<BaseLayout
  title="文章归档"
  description={`${SITE.author}的全部文章，共 ${posts.length} 篇，涵盖技术实践、学习笔记与生活思考。`}
  canonical="/blog/"
  jsonLd={jsonLd}
>
  <div class="blog-pixel">
    <section class="px-sea">
      <div class="wrap px-hero">
        <div>
          <p class="px-kick">
            <span class="px-tag">ARCHIVE</span>
            <span>共 {posts.length} 篇 · {tags.length} 个标签</span>
          </p>
          <h1>全部文章</h1>
          <p class="px-hero-lede">
            按时间倒序排列。关键词会同时匹配标题、摘要、标签和正文，也可以用标签快速缩小范围。
          </p>
          <div class="px-hero-stats">
            <span class="px-stat"><b>{posts.length}</b> 篇文章</span>
            <span class="px-stat"><b>{tags.length}</b> 个标签</span>
            <span class="px-stat"><b>{latestYear}</b> 写到今天</span>
          </div>
        </div>

        <div class="px-tank" aria-hidden="true">
          <div class="px-tank-water">
            <PixelFish class="px-tank-fish" />
            <PixelFish class="px-tank-fish px-tank-fish--small" body="#7fe6ff" edge="#0b1d4a" />
            <span class="px-bubble"></span>
            <span class="px-bubble"></span>
            <span class="px-bubble"></span>
            <div class="px-tank-sand"></div>
          </div>
          <p class="px-tank-cap">TANK · {posts.length} POSTS</p>
        </div>
      </div>
    </section>

    <div class="px-seabed" aria-hidden="true"></div>

    <div class="wrap px-main">
      <div class="px-toolbar">
        <label class="px-search">
          <Icon name="search" size={16} />
          <input
            type="search"
            id="post-search"
            placeholder="搜索标题、正文或标签…"
            autocomplete="off"
            aria-label="搜索文章"
          />
          <kbd>/</kbd>
        </label>

        <div class="px-filters" id="tag-filters" role="group" aria-label="按标签筛选">
          <button class="px-filter is-active" data-tag="" type="button">全部</button>
          {tags.map((tag) => (
            <button class="px-filter" data-tag={tag.tag} type="button">
              {tag.tag}
              <em>{tag.count}</em>
            </button>
          ))}
        </div>
      </div>

      <p class="px-result">
        <span id="result-count">{posts.length}</span> 篇文章
        <span class="px-hint" id="filter-hint"></span>
      </p>

      <div class="px-list" id="post-list">
        {posts.map((post, i) => (
          <div
            class="post-item"
            data-slug={post.slug}
            data-search={`${post.title} ${post.description} ${post.tags.join(" ")}`.toLowerCase()}
            data-tags={post.tags.join("|")}
          >
            <a class="px-post" href={`/blog/${post.slug}/`}>
              <span class="px-post-no">{String(i + 1).padStart(2, "0")}</span>
              <div class="px-post-meta">
                <time datetime={post.pubDate.toISOString()}>{formatShortDate(post.pubDate)}</time>
                <span class="px-post-dot" />
                <span>{post.minutes} 分钟</span>
                <span class="cmt" data-cmt={post.slug} hidden />
                <span class="lks" data-likes={post.slug} hidden />
                {post.featured && <span class="px-post-pin">推荐</span>}
              </div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="px-post-tags">
                {post.tags.slice(0, 3).map((tag) => <span class="px-chip">{tag}</span>)}
              </div>
              <span class="px-post-more">阅读全文 →</span>
            </a>
            <p class="hit-snippet px-hit" hidden></p>
          </div>
        ))}
      </div>

      <div class="px-empty" id="empty-state" hidden>
        {posts.length === 0 ? (
          <>
            <p>这条鱼还没吐出一个字。第一篇正在路上，可以先看看 <a href="/about/">关于我</a>。</p>
          </>
        ) : (
          <>
            <p>没有匹配的文章。</p>
            <button class="btn" id="clear-filters" type="button">清除筛选条件</button>
          </>
        )}
      </div>

      {years.length > 0 && (
        <div class="px-years">
          <span>ARCHIVE YEARS</span>
          {years.map((year) => <em>{year}</em>)}
        </div>
      )}
    </div>
  </div>


<script is:inline>
  (() => {
    const input = document.getElementById("post-search");
    const filters = document.getElementById("tag-filters");
    const items = [...document.querySelectorAll(".post-item")];
    const counter = document.getElementById("result-count");
    const hint = document.getElementById("filter-hint");
    const empty = document.getElementById("empty-state");
    const clear = document.getElementById("clear-filters");
    if (!input || !filters) return;

    let activeTag = "";
    let query = "";
    /** null 表示索引还没到，此时退回服务端预渲染的 data-search 字段 */
    let index = null;

    const baseOrder = new Map(items.map((el, i) => [el, i]));
    const normalize = (value) => (value || "").toLowerCase();
    const termsOf = (value) => normalize(value).split(/\s+/).filter(Boolean);
    /**
     * 2.3：与 src/lib/html.ts 的 escapeHtml **保持同一语义**（5 字符 + null 安全）。
     *
     * 为什么这里必须保留本地副本：本页用的是 <script is:inline>，
     * 内联脚本不能使用 ESM import；改成模块脚本又会改变 CSP 内联哈希。
     * 改转义规则时两边必须同步，见 docs/architecture/HTML-SECURITY.md §6。
     */
    const escapeHtml = (text) => {
      if (text === null || text === undefined) return "";
      return String(text).replace(/[&<>"']/g, (ch) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[ch]);
    };
    const escapeRegExp = (text) => text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    /** 标题 > 标签 > 摘要 > 正文；多个关键词之间取「并且」 */
    function scoreEntry(entry, terms) {
      if (!entry) return 0;
      const title = normalize(entry.title);
      const description = normalize(entry.description);
      const tags = normalize((entry.tags || []).join(" "));
      const body = normalize(entry.body);

      let total = 0;
      for (const term of terms) {
        let score = 0;
        if (title.includes(term)) score += 14;
        if (tags.includes(term)) score += 8;
        if (description.includes(term)) score += 5;
        if (body.includes(term)) score += 2;
        if (!score) return 0;
        total += score;
      }
      return total;
    }

    /** 截一段正文命中的上下文，关键词包成 <mark> */
    function snippetFor(entry, terms) {
      if (!entry || !entry.body) return "";
      const body = entry.body;
      const lower = body.toLowerCase();

      let pos = -1;
      let hit = "";
      for (const term of terms) {
        const found = lower.indexOf(term);
        if (found === -1) continue;
        if (pos === -1 || found < pos) {
          pos = found;
          hit = term;
        }
      }
      if (pos === -1) return "";

      const start = Math.max(0, pos - 30);
      const end = Math.min(body.length, pos + hit.length + 46);
      let html = escapeHtml(
        (start > 0 ? "…" : "") + body.slice(start, end) + (end < body.length ? "…" : ""),
      );
      for (const term of terms) {
        if (!term) continue;
        const pattern = new RegExp(escapeRegExp(escapeHtml(term)), "gi");
        html = html.replace(pattern, (match) => `<mark>${match}</mark>`);
      }
      return html;
    }

    const legacyMatch = (item, terms) => {
      const haystack = item.dataset.search || "";
      return terms.every((term) => haystack.includes(term));
    };

    const apply = () => {
      const terms = termsOf(query);

      let visible = 0;
      for (const item of items) {
        const tags = (item.dataset.tags || "").split("|").filter(Boolean);
        const matchTag = !activeTag || tags.includes(activeTag);

        let show = matchTag;
        let score = 0;
        if (show && terms.length) {
          const entry = index && index.find((row) => row.slug === item.dataset.slug);
          if (entry) {
            score = scoreEntry(entry, terms);
            show = score > 0;
          } else {
            show = legacyMatch(item, terms);
          }
        }

        item.hidden = !show;
        item.style.order = terms.length ? String(-score) : String(baseOrder.get(item) ?? 0);

        const box = item.querySelector(".hit-snippet");
        if (box) {
          const entry = index && index.find((row) => row.slug === item.dataset.slug);
          const snippet = terms.length && show && entry ? snippetFor(entry, terms) : "";
          box.innerHTML = snippet;
          box.hidden = !snippet;
        }

        if (show) visible += 1;
      }

      counter.textContent = String(visible);
      empty.hidden = visible !== 0;
      hint.textContent =
        activeTag || query
          ? `· 已筛选${activeTag ? `「${activeTag}」` : ""}${query ? ` 关键词「${query}」` : ""}${terms.length ? "（含正文）" : ""}`
          : "";
    };

    input.addEventListener("input", () => {
      query = input.value.trim().toLowerCase();
      apply();
    });

    filters.addEventListener("click", (event) => {
      const button = event.target.closest(".px-filter");
      if (!button) return;
      activeTag = button.dataset.tag || "";
      for (const chip of filters.querySelectorAll(".px-filter")) {
        chip.classList.toggle("is-active", chip === button);
      }
      apply();
    });

    clear?.addEventListener("click", () => {
      input.value = "";
      query = "";
      activeTag = "";
      for (const chip of filters.querySelectorAll(".px-filter")) {
        chip.classList.toggle("is-active", chip.dataset.tag === "");
      }
      apply();
      input.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== input) {
        event.preventDefault();
        input.focus();
      }
    });

    // 索引不大，进页面就预取；失败也不影响搜索，还有 data-search 兜底
    fetch("/search-index.json")
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then((data) => {
        if (!Array.isArray(data)) return;
        index = data;
        if (query) apply();
      })
      .catch(() => undefined);

    // 首次进入就先算一遍：没有文章时直接显示空状态
    apply();
  })();
</script>
</BaseLayout>
