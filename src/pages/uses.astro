---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { USES } from "../lib/uses";
import { SITE } from "../lib/site";
import "../styles/blog-pixel.css";

const totalItems = USES.reduce((sum, group) => sum + group.items.length, 0);
---

<BaseLayout
  title="我用什么"
  description={`${SITE.author}日常使用的工具与装备：${USES.map((group) => group.title).join("、")}。`}
  canonical="/uses/"
>
  <div class="blog-pixel">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Uses · {totalItems} 项</span>
      <h1>我用什么</h1>
      <p class="page-lede">
        工具会换，记下来是为了以后回看自己是怎么变的。每条写的是「为什么用它」，不是参数表。
      </p>
    </div>
  </section>

  <div class="wrap">
    <div class="uses-bar">
      <div class="uses-pills" role="group" aria-label="分类筛选">
        <button class="uses-pill is-active" type="button" data-uses-group="all" aria-pressed="true">
          全部 ({totalItems})
        </button>
        {USES.map((group) => (
          <button class="uses-pill" type="button" data-uses-group={group.title} aria-pressed="false">
            {group.title} ({group.items.length})
          </button>
        ))}
      </div>
      <input
        id="uses-search"
        class="uses-search"
        type="search"
        placeholder="搜索工具或装备…"
        autocomplete="off"
        aria-label="搜索工具或装备"
      />
    </div>

    <div class="groups">
      {USES.map((group) => (
        <section class="group" data-uses-section={group.title}>
          <div class="group-head">
            <h2>{group.title}</h2>
            {group.caption && <p>{group.caption}</p>}
          </div>

          <ul class="items">
            {group.items.map((item) => (
              <li data-uses-item data-uses-text={`${item.name} ${item.note} ${group.title}`.toLowerCase()}>
                <div class="item-name">
                  {item.href ? <a href={item.href}>{item.name}</a> : item.name}
                </div>
                <p class="item-note">{item.note}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="uses-empty" id="uses-empty" hidden>没有匹配的工具或装备。</p>
    </div>

    <p class="foot-note">
      这张页面没有固定更新周期，换工具的时候顺手改一笔。
      骑行的具体记录在 <a href="/cycling/">骑行页</a>，做过的东西在 <a href="/projects/">作品页</a>。
    </p>

    <a class="back" href="/about/">
      关于我
      <Icon name="arrow-right" size={13} />
    </a>
  </div>
  </div>
</BaseLayout>

<script>
  (() => {
    const pills = [...document.querySelectorAll<HTMLButtonElement>("[data-uses-group]")];
    const input = document.getElementById("uses-search") as HTMLInputElement | null;
    const sections = [...document.querySelectorAll<HTMLElement>("[data-uses-section]")];
    const emptyEl = document.getElementById("uses-empty");
    if (!sections.length) return;

    let activeGroup = "all";
    const filter = () => {
      const q = (input?.value ?? "").trim().toLowerCase();
      let shown = 0;
      for (const sec of sections) {
        const groupMatch = activeGroup === "all" || sec.dataset.usesSection === activeGroup;
        let secShown = 0;
        for (const item of sec.querySelectorAll<HTMLElement>("[data-uses-item]")) {
          const match = groupMatch && (!q || (item.dataset.usesText || "").includes(q));
          item.hidden = !match;
          if (match) secShown++;
        }
        sec.hidden = secShown === 0;
        shown += secShown;
      }
      if (emptyEl) emptyEl.hidden = shown > 0;
    };

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        activeGroup = pill.dataset.usesGroup || "all";
        pills.forEach((p) => {
          const on = p === pill;
          p.classList.toggle("is-active", on);
          p.setAttribute("aria-pressed", on ? "true" : "false");
        });
        filter();
      });
    });
    input?.addEventListener("input", filter);
  })();
</script>

<style>
  .uses-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 24px 0 6px;
  }

  .uses-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .uses-pill {
    padding: 5px 10px 4px;
    border: 0;
    font-family: var(--px-pix);
    font-size: 11px;
    color: var(--px-cyan);
    background: var(--px-panel-2);
    box-shadow: inset 2px 2px 0 0 var(--px-slot-lo);
    cursor: pointer;
    transition: background-color 0.14s linear, color 0.14s linear;
  }

  .uses-pill:hover {
    color: var(--px-gold);
  }

  .uses-pill.is-active {
    background: var(--px-gold);
    color: #161822;
    box-shadow: none;
  }

  .uses-search {
    min-width: 190px;
    padding: 7px 10px;
    border: 2px solid var(--px-slot-lo, #1c2c52);
    background: var(--px-panel-2);
    color: var(--px-ink, #fff);
    font: inherit;
    font-size: 13px;
    outline: none;
  }

  .uses-search:focus {
    border-color: var(--px-gold);
  }

  .uses-empty {
    padding: 36px 0;
    color: var(--px-faint);
    font-size: 14px;
  }

  .group[hidden],
  [data-uses-item][hidden] {
    display: none;
  }

  .groups {
    padding-top: 12px;
  }

  .group {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 44px;
    padding: 32px 0;
    border-bottom: 4px dashed #142a5c;
  }

  .group-head h2 {
    font-family: var(--px-hand);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .group-head p {
    margin: 8px 0 0;
    font-family: var(--px-pix);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--px-faint);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .items li + li {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed #142a5c;
  }

  .item-name {
    position: relative;
    padding-left: 14px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--px-ink);
  }

  /* 每个条目前面一枚像素方块 */
  .item-name::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    background: var(--px-gold);
  }

  .item-name a {
    color: var(--px-cyan);
    border-bottom: 1px dashed rgba(127, 230, 255, 0.45);
  }

  .item-name a:hover {
    color: #fff;
    border-bottom-color: #fff;
  }

  .item-note {
    margin: 6px 0 0;
    max-width: 42em;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--px-soft);
  }

  .foot-note {
    margin: 34px 0 0;
    font-size: 13px;
    line-height: 1.95;
    color: var(--px-faint);
  }

  .foot-note a {
    color: var(--px-cyan);
    border-bottom: 1px dashed rgba(127, 230, 255, 0.45);
    padding-bottom: 1px;
  }

  .foot-note a:hover {
    color: #fff;
  }

  @media (max-width: 720px) {
    .group {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 26px 0;
    }
    .group-head p {
      margin-top: 4px;
    }
  }
</style>
