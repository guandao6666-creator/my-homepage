---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { USES } from "../lib/uses";
import { SITE } from "../lib/site";
import "../styles/blog-pixel.css";

const totalItems = USES.reduce((sum, group) => sum + group.items.length, 0);
---

<BaseLayout
  title="我用什么"
  description={`${SITE.author}日常使用的工具与装备：${USES.map((group) => group.title).join("、")}。`}
  canonical="/uses/"
>
  <div class="blog-pixel">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Uses · {totalItems} 项</span>
      <h1>我用什么</h1>
      <p class="page-lede">
        工具会换，记下来是为了以后回看自己是怎么变的。每条写的是「为什么用它」，不是参数表。
      </p>
    </div>
  </section>

  <div class="wrap">
    <div class="groups">
      {USES.map((group) => (
        <section class="group">
          <div class="group-head">
            <h2>{group.title}</h2>
            {group.caption && <p>{group.caption}</p>}
          </div>

          <ul class="items">
            {group.items.map((item) => (
              <li>
                <div class="item-name">
                  {item.href ? <a href={item.href}>{item.name}</a> : item.name}
                </div>
                <p class="item-note">{item.note}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="foot-note">
      这张页面没有固定更新周期，换工具的时候顺手改一笔。
      骑行的具体记录在 <a href="/cycling/">骑行页</a>，做过的东西在 <a href="/projects/">作品页</a>。
    </p>

    <a class="back" href="/about/">
      关于我
      <Icon name="arrow-right" size={13} />
    </a>
  </div>
  </div>
</BaseLayout>

<style>
  .groups {
    padding-top: 12px;
  }

  .group {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 44px;
    padding: 32px 0;
    border-bottom: 4px dashed #142a5c;
  }

  .group-head h2 {
    font-family: var(--px-hand);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .group-head p {
    margin: 8px 0 0;
    font-family: var(--px-pix);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--px-faint);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .items li + li {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed #142a5c;
  }

  .item-name {
    position: relative;
    padding-left: 14px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--px-ink);
  }

  /* 每个条目前面一枚像素方块 */
  .item-name::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    background: var(--px-gold);
  }

  .item-name a {
    color: var(--px-cyan);
    border-bottom: 1px dashed rgba(127, 230, 255, 0.45);
  }

  .item-name a:hover {
    color: #fff;
    border-bottom-color: #fff;
  }

  .item-note {
    margin: 6px 0 0;
    max-width: 42em;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--px-soft);
  }

  .foot-note {
    margin: 34px 0 0;
    font-size: 13px;
    line-height: 1.95;
    color: var(--px-faint);
  }

  .foot-note a {
    color: var(--px-cyan);
    border-bottom: 1px dashed rgba(127, 230, 255, 0.45);
    padding-bottom: 1px;
  }

  .foot-note a:hover {
    color: #fff;
  }

  @media (max-width: 720px) {
    .group {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 26px 0;
    }
    .group-head p {
      margin-top: 4px;
    }
  }
</style>
