---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/site";
---

<BaseLayout
  title="碎片"
  description={`${SITE.author}的碎片记录：短句、随想、路上的见闻，不成篇的那种。`}
  canonical="/notes/"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Notes</span>
      <h1>碎片</h1>
      <p class="page-lede">
        不成篇的那种。一句话、一个念头、路上看见的东西，随手记下来。
      </p>
    </div>
  </section>

  <div class="wrap">
    <div class="feed" id="note-feed">
      <p class="state" id="note-state">正在读取…</p>
    </div>

    <noscript>
      <p class="state">这个页面需要 JavaScript 才能读取笔记。</p>
    </noscript>

    <a class="back" href="/blog/">
      读长文
      <Icon name="arrow-right" size={13} />
    </a>
  </div>
</BaseLayout>

<script>
  import { cloudConfig, listCloudNotes, type CloudNote } from "../lib/cloud";

  (() => {
    const feed = document.getElementById("note-feed");
    const state = document.getElementById("note-state");
    if (!feed || !state) return;

    const escapeHtml = (text: string) =>
      String(text).replace(
        /[&<>"]/g,
        (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch] as string,
      );

    /** 纯文本 + 自动识别链接 */
    const renderBody = (text: string) =>
      escapeHtml(text).replace(
        /(https?:\/\/[^\s<]+)/g,
        '<a href="$1" target="_blank" rel="noopener">$1</a>',
      );

    const pad = (n: number) => String(n).padStart(2, "0");

    const dayLabel = (date: Date, now: Date) => {
      const sameYear = date.getFullYear() === now.getFullYear();
      const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
      const diffDays = Math.round((startOfDay(now) - startOfDay(date)) / 86_400_000);

      if (diffDays === 0) return "今天";
      if (diffDays === 1) return "昨天";
      if (diffDays < 7) return `${diffDays} 天前`;
      return sameYear
        ? `${pad(date.getMonth() + 1)}.${pad(date.getDate())}`
        : `${date.getFullYear()}.${pad(date.getMonth() + 1)}.${pad(date.getDate())}`;
    };

    const render = (notes: CloudNote[]) => {
      if (!notes.length) {
        feed.innerHTML =
          '<p class="state">还没有记过。想到什么就写一句，不用凑成一篇文章。</p>';
        return;
      }

      const now = new Date();
      let lastDay = "";

      feed.innerHTML = notes
        .map((note) => {
          const date = new Date(note.created_at);
          const dayKey = date.toDateString();
          const showDay = dayKey !== lastDay;
          lastDay = dayKey;

          const day = showDay ? dayLabel(date, now) : "";
          const clock = `${pad(date.getHours())}:${pad(date.getMinutes())}`;

          return `
            <article class="note">
              <time class="note-time" datetime="${date.toISOString()}">
                <span class="day">${day}</span>
                <span class="clock">${clock}</span>
              </time>
              <p class="note-body">${renderBody(note.body)}</p>
            </article>`;
        })
        .join("");
    };

    if (!cloudConfig()) {
      state.textContent = "还没有连接云端数据库，笔记功能暂不可用。";
      return;
    }

    listCloudNotes(60)
      .then(render)
      .catch(() => {
        state.textContent = "读取失败，刷新试试。";
      });
  })();
</script>

<style>
  .page-head {
    padding: 58px 0 30px;
    border-bottom: 1px solid var(--line);
  }

  .page-head h1 {
    margin: 14px 0 12px;
    font-size: clamp(34px, 5vw, 46px);
    letter-spacing: -0.03em;
  }

  .page-lede {
    margin: 0;
    max-width: 38em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.9;
  }

  .feed {
    padding-top: 12px;
    min-height: 120px;
  }

  .state {
    margin: 0;
    padding: 34px 0;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
  }

  /* 笔记条目是 JS 渲染的，拿不到 scoped 属性，只能全局 */
  :global(.note) {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr);
    gap: 22px;
    padding: 20px 0;
    border-bottom: 1px dashed var(--line);
  }

  :global(.note-time) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  :global(.note-time .day) {
    color: var(--ink-2);
    font-size: 11.5px;
  }

  :global(.note-time .clock) {
    opacity: 0.65;
  }

  :global(.note-body) {
    margin: 0;
    font-size: 15px;
    line-height: 1.95;
    color: var(--ink-2);
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  :global(.note-body a) {
    color: var(--accent-ink);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    word-break: break-all;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 34px;
    font-size: 13px;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .back:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 620px) {
    :global(.note) {
      grid-template-columns: 58px minmax(0, 1fr);
      gap: 14px;
    }
    :global(.note-body) {
      font-size: 14.5px;
    }
  }
</style>
