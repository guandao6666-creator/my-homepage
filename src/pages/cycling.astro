---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { CYCLING } from "../lib/cycling";
import { SITE } from "../lib/site";
import "../styles/blog-pixel.css";

const maxKm = Math.max(...CYCLING.years.map((item) => item.km), 1);
const totalYears = CYCLING.years.reduce((sum, item) => sum + item.km, 0);
const yearsSpan = new Date().getFullYear() - CYCLING.startedYear + 1;
---

<BaseLayout
  title="骑行"
  description={`${SITE.author}的骑行记录：累计 ${CYCLING.totalKm}+ 公里，爱车${CYCLING.bike}，常驻${CYCLING.base}。`}
  canonical="/cycling/"
>
  <div class="blog-pixel">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Cycling · {CYCLING.totalKm}+ km</span>
      <h1>骑过的路</h1>
      <p class="page-lede">{CYCLING.intro}</p>
    </div>
  </section>

  <div class="wrap">
    <!-- 总里程 -->
    <section class="odo">
      <div class="odo-main">
        <span class="odo-num">
          {CYCLING.totalKm.toLocaleString("en-US")}<em>+</em>
        </span>
        <span class="odo-unit">公里</span>
      </div>
      <p class="odo-note">
        从 {CYCLING.startedYear} 年算起，第 {yearsSpan} 个年头。
        {totalYears > 0 && `其中 ${totalYears.toLocaleString("en-US")} 公里有分年记录。`}
      </p>
    </section>

    <!-- 三个指标 -->
    <dl class="metrics">
      <div>
        <dt>单次最远</dt>
        <dd>{CYCLING.longestKm}<span>km</span></dd>
      </div>
      <div>
        <dt>爱车</dt>
        <dd class="word">{CYCLING.bike.replace(/^喜德盛\s*/, "")}</dd>
      </div>
      <div>
        <dt>常驻</dt>
        <dd class="word">{CYCLING.base}</dd>
      </div>
    </dl>

    <!-- 分年里程 -->
    {CYCLING.years.length > 0 && (
      <section class="panel">
        <div class="panel-head">
          <h2>每年骑了多少</h2>
          <span class="panel-meta">{CYCLING.years.length} 个年度</span>
        </div>
        <div class="bars">
          {CYCLING.years.map((item) => (
            <div class="bar-row">
              <span class="bar-year">{item.year}</span>
              <div class="bar-track">
                <div class="bar-fill" style={`width:${Math.max((item.km / maxKm) * 100, 2)}%`}></div>
              </div>
              <span class="bar-km">{item.km.toLocaleString("en-US")} km</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 车与装备 -->
    <section class="rig">
      <div class="rig-card">
        <span class="eyebrow">车</span>
        <h2>{CYCLING.bike}</h2>
        <p>
          公路车，碳架，主要用来跑长途和爬坡。
          百公里那一次骑完之后，才真正明白补给和节奏比腿更重要。
        </p>
      </div>

      <div class="rig-side">
        <h3>随车装备</h3>
        <ul class="kit">
          {CYCLING.kit.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 照片墙 -->
    {CYCLING.gallery.length > 0 ? (
      <section class="panel">
        <div class="panel-head">
          <h2>路上的照片</h2>
        </div>
        <div class="gallery">
          {CYCLING.gallery.map((photo) => (
            <figure>
              <img src={photo.src} alt={photo.caption ?? "骑行照片"} loading="lazy" decoding="async" />
              {photo.caption && <figcaption>{photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    ) : (
      <p class="trail-note">
        更多的路线和照片还在整理，等下次骑完再往这里放。
      </p>
    )}

    <a class="back" href="/about/">
      关于我
      <Icon name="arrow-right" size={13} />
    </a>
  </div>
  </div>
</BaseLayout>

<style>
  /* ---------- 总里程：像自行车码表 ---------- */
  .odo {
    padding: 44px 0 32px;
  }

  .odo-main {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 12px;
  }

  .odo-num {
    font-family: var(--px-pix);
    font-size: clamp(58px, 11.5vw, 118px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--px-gold);
    text-shadow: 3px 3px 0 #1f4cb3, 6px 6px 0 var(--px-edge);
    font-variant-numeric: tabular-nums;
  }

  .odo-num em {
    margin-left: 4px;
    font-style: normal;
    font-size: 0.42em;
    color: var(--px-cyan);
    vertical-align: 0.35em;
    text-shadow: none;
  }

  .odo-unit {
    font-family: var(--px-pix);
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--px-faint);
  }

  .odo-note {
    margin: 22px 0 0;
    font-size: 13px;
    line-height: 1.9;
    color: var(--px-soft);
  }

  /* ---------- 三个指标 ---------- */
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    background: none;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }

  .metrics > div {
    padding: 16px 18px 15px;
    background: rgba(7, 22, 54, 0.6);
    box-shadow: var(--px-frame-2);
  }

  .metrics dt {
    font-family: var(--px-pix);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--px-faint);
  }

  .metrics dd {
    margin: 10px 0 0;
    font-family: var(--px-hand);
    font-size: 30px;
    line-height: 1;
    color: #fff;
  }

  .metrics dd span {
    margin-left: 5px;
    font-family: var(--px-pix);
    font-size: 11.5px;
    color: var(--px-faint);
  }

  .metrics dd.word {
    font-size: 22px;
    letter-spacing: 0;
  }

  /* ---------- 通用面板 ---------- */
  .panel {
    margin-top: 44px;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 4px dashed #142a5c;
  }

  .panel-head h2 {
    font-family: var(--px-hand);
    font-size: 23px;
    font-weight: 600;
    color: #fff;
  }

  .panel-meta {
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--px-faint);
  }

  /* ---------- 分年柱状图 ---------- */
  .bars {
    display: grid;
    gap: 14px;
    padding-top: 22px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 92px;
    align-items: center;
    gap: 14px;
  }

  .bar-year {
    font-family: var(--px-pix);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--px-soft);
  }

  .bar-track {
    height: 12px;
    background: var(--px-slot-lo);
    box-shadow: inset 2px 2px 0 0 #020818;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #2f63d6, #7fe6ff);
    box-shadow: inset 0 -3px 0 0 rgba(2, 8, 24, 0.35);
  }

  .bar-km {
    text-align: right;
    font-family: var(--px-pix);
    font-size: 12px;
    color: var(--px-cyan);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 车与装备 ---------- */
  .rig {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 24px;
    margin-top: 44px;
  }

  .rig-card {
    padding: 24px 26px 22px;
    background: var(--px-paper);
    color: var(--px-paper-text);
    box-shadow: var(--px-paper-frame);
  }

  .rig-card .eyebrow {
    color: #7fe6ff;
  }

  .rig-card .eyebrow::before {
    background: #7fe6ff;
  }

  .rig-card h2 {
    margin: 12px 0 10px;
    font-family: var(--px-hand);
    font-size: 26px;
    font-weight: 600;
    color: var(--px-paper-ink);
  }

  .rig-card p {
    margin: 0;
    max-width: 32em;
    font-size: 14px;
    line-height: 1.95;
    color: #c2d4f2;
  }

  .rig-side {
    padding: 22px 22px 20px;
    background: rgba(7, 22, 54, 0.5);
    box-shadow: inset 0 0 0 2px #142a5c;
  }

  .rig-side h3 {
    font-family: var(--px-pix);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--px-cyan);
  }

  .kit {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kit li {
    padding: 5px 9px 4px;
    font-family: var(--px-pix);
    font-size: 11.5px;
    color: var(--px-soft);
    background: var(--px-panel-2);
    box-shadow: inset 2px 2px 0 0 var(--px-slot-lo);
  }

  /* ---------- 照片 ---------- */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding-top: 24px;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 0;
    box-shadow: 0 0 0 4px var(--px-edge), 0 0 0 8px rgba(241, 230, 200, 0.12);
  }

  .gallery figcaption {
    margin-top: 12px;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--px-faint);
  }

  .trail-note {
    margin: 44px 0 0;
    padding: 20px 22px;
    background: rgba(7, 22, 54, 0.45);
    box-shadow: inset 0 0 0 2px #142a5c;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--px-soft);
  }

  @media (max-width: 760px) {
    .metrics {
      grid-template-columns: 1fr;
    }
    .rig {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bar-row {
      grid-template-columns: 44px minmax(0, 1fr) 76px;
      gap: 10px;
    }
  }
</style>
