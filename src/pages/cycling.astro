---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { CYCLING } from "../lib/cycling";
import { SITE } from "../lib/site";

const maxKm = Math.max(...CYCLING.years.map((item) => item.km), 1);
const totalYears = CYCLING.years.reduce((sum, item) => sum + item.km, 0);
const yearsSpan = new Date().getFullYear() - CYCLING.startedYear + 1;
---

<BaseLayout
  title="骑行"
  description={`${SITE.author}的骑行记录：累计 ${CYCLING.totalKm}+ 公里，爱车${CYCLING.bike}，常驻${CYCLING.base}。`}
  canonical="/cycling/"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Cycling · {CYCLING.totalKm}+ km</span>
      <h1>骑过的路</h1>
      <p class="page-lede">{CYCLING.intro}</p>
    </div>
  </section>

  <div class="wrap">
    <!-- 总里程 -->
    <section class="odo">
      <div class="odo-main">
        <span class="odo-num">
          {CYCLING.totalKm.toLocaleString("en-US")}<em>+</em>
        </span>
        <span class="odo-unit">公里</span>
      </div>
      <p class="odo-note">
        从 {CYCLING.startedYear} 年算起，第 {yearsSpan} 个年头。
        {totalYears > 0 && `其中 ${totalYears.toLocaleString("en-US")} 公里有分年记录。`}
      </p>
    </section>

    <!-- 三个指标 -->
    <dl class="metrics">
      <div>
        <dt>单次最远</dt>
        <dd>{CYCLING.longestKm}<span>km</span></dd>
      </div>
      <div>
        <dt>爱车</dt>
        <dd class="word">{CYCLING.bike.replace(/^喜德盛\s*/, "")}</dd>
      </div>
      <div>
        <dt>常驻</dt>
        <dd class="word">{CYCLING.base}</dd>
      </div>
    </dl>

    <!-- 分年里程 -->
    {CYCLING.years.length > 0 && (
      <section class="panel">
        <div class="panel-head">
          <h2>每年骑了多少</h2>
          <span class="panel-meta">{CYCLING.years.length} 个年度</span>
        </div>
        <div class="bars">
          {CYCLING.years.map((item) => (
            <div class="bar-row">
              <span class="bar-year">{item.year}</span>
              <div class="bar-track">
                <div class="bar-fill" style={`width:${Math.max((item.km / maxKm) * 100, 2)}%`}></div>
              </div>
              <span class="bar-km">{item.km.toLocaleString("en-US")} km</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 车与装备 -->
    <section class="rig">
      <div class="rig-card">
        <span class="eyebrow">车</span>
        <h2>{CYCLING.bike}</h2>
        <p>
          公路车，碳架，主要用来跑长途和爬坡。
          百公里那一次骑完之后，才真正明白补给和节奏比腿更重要。
        </p>
      </div>

      <div class="rig-side">
        <h3>随车装备</h3>
        <ul class="kit">
          {CYCLING.kit.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 照片墙 -->
    {CYCLING.gallery.length > 0 ? (
      <section class="panel">
        <div class="panel-head">
          <h2>路上的照片</h2>
        </div>
        <div class="gallery">
          {CYCLING.gallery.map((photo) => (
            <figure>
              <img src={photo.src} alt={photo.caption ?? "骑行照片"} loading="lazy" decoding="async" />
              {photo.caption && <figcaption>{photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    ) : (
      <p class="trail-note">
        更多的路线和照片还在整理，等下次骑完再往这里放。
      </p>
    )}

    <a class="back" href="/about/">
      关于我
      <Icon name="arrow-right" size={13} />
    </a>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 58px 0 34px;
    border-bottom: 1px solid var(--line);
  }

  .page-head h1 {
    margin: 14px 0 12px;
    font-size: clamp(34px, 5vw, 48px);
    letter-spacing: -0.03em;
  }

  .page-lede {
    margin: 0;
    max-width: 42em;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.95;
  }

  /* ---------- 总里程 ---------- */
  .odo {
    padding: 48px 0 34px;
  }

  .odo-main {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 12px;
  }

  .odo-num {
    font-family: var(--font-serif);
    font-size: clamp(64px, 13vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .odo-num em {
    font-style: normal;
    font-size: 0.42em;
    color: var(--accent);
    margin-left: 4px;
    vertical-align: 0.35em;
  }

  .odo-unit {
    font-size: 15px;
    color: var(--muted);
    letter-spacing: 0.08em;
  }

  .odo-note {
    margin: 20px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  /* ---------- 指标 ---------- */
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .metrics > div {
    padding: 20px 22px;
    background: var(--surface);
  }

  .metrics dt {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .metrics dd {
    margin: 8px 0 0;
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .metrics dd span {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--muted);
    margin-left: 5px;
  }

  .metrics dd.word {
    font-size: 21px;
    letter-spacing: 0;
  }

  /* ---------- 通用面板 ---------- */
  .panel {
    margin-top: 46px;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .panel-head h2 {
    font-size: 22px;
  }

  .panel-meta {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  /* ---------- 分年柱状图 ---------- */
  .bars {
    padding-top: 22px;
    display: grid;
    gap: 14px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 84px;
    align-items: center;
    gap: 14px;
  }

  .bar-year {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .bar-track {
    height: 10px;
    border-radius: 999px;
    background: var(--surface-sunk);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0.72;
  }

  .bar-km {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 车与装备 ---------- */
  .rig {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 46px;
  }

  .rig-card {
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .rig-card h2 {
    margin: 12px 0 12px;
    font-size: 26px;
  }

  .rig-card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.95;
    color: var(--muted);
    max-width: 32em;
  }

  .rig-side {
    padding: 26px 24px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }

  .rig-side h3 {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kit {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kit li {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-sunk);
    font-size: 12.5px;
    color: var(--ink-2);
  }

  /* ---------- 照片 ---------- */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding-top: 20px;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }

  .gallery figcaption {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }

  .trail-note {
    margin: 46px 0 0;
    padding: 22px 24px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 34px;
    font-size: 13px;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .back:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 760px) {
    .metrics {
      grid-template-columns: 1fr;
    }
    .rig {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bar-row {
      grid-template-columns: 44px minmax(0, 1fr) 72px;
      gap: 10px;
    }
  }
</style>
