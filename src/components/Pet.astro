---
/**
 * 角落里的鲸鲸。
 *
 * 形象是 DeepSeek 蓝鲸（社区口中的「大肥鱼」）的 Q 版二创：
 * 蓝色渐变长发、呆毛、鲸鱼耳鳍与尾巴、深蓝连衣裙配白围裙。
 * 同人性质，非官方授权，仅作个人站点装饰。
 */
---

<div class="pet" id="pet">
  <p class="pet-bubble" id="pet-bubble" role="status" aria-live="polite"></p>

  <button class="pet-btn" id="pet-btn" type="button" aria-label="摸摸鲸鲸">
    <img
      class="pet-img"
      src="/pet/whale-girl.webp"
      alt=""
      width="320"
      height="320"
      decoding="async"
      fetchpriority="low"
      draggable="false"
    />
  </button>
</div>

<script>
  (() => {
    const pet = document.getElementById("pet");
    const btn = document.getElementById("pet-btn");
    const bubble = document.getElementById("pet-bubble");
    if (!pet || !btn || !bubble) return;

    const LINES = [
      "别戳，在摸鱼",
      "叫我鲸鲸就好",
      "今天吃白饭了吗",
      "我不是胖，是圆",
      "写完再来找我玩",
      "困了，眯一会儿",
      "又摸鱼？带我一个",
      "这一口，是白饭的味道",
    ];

    let bubbleTimer: number | undefined;
    let clickCount = 0;
    let clickTimer: number | undefined;
    let idleTimer: number | undefined;

    const say = (text: string, ms = 2400) => {
      bubble.textContent = text;
      bubble.classList.add("show");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => bubble.classList.remove("show"), ms);
    };

    const popBubbles = (count = 7) => {
      for (let i = 0; i < count; i += 1) {
        const dot = document.createElement("span");
        dot.className = "pet-particle";
        dot.style.left = `${26 + Math.random() * 48}%`;
        dot.style.setProperty("--dx", `${(Math.random() - 0.5) * 54}px`);
        dot.style.setProperty("--dur", `${0.7 + Math.random() * 0.6}s`);
        dot.style.setProperty("--delay", `${Math.random() * 0.12}s`);
        pet.appendChild(dot);
        window.setTimeout(() => dot.remove(), 1600);
      }
    };

    btn.addEventListener("click", () => {
      pet.classList.add("is-happy");
      window.setTimeout(() => pet.classList.remove("is-happy"), 680);
      popBubbles();

      // 连着戳会被"凶"
      clickCount += 1;
      window.clearTimeout(clickTimer);
      clickTimer = window.setTimeout(() => {
        clickCount = 0;
      }, 2600);

      if (clickCount >= 5) {
        clickCount = 0;
        say("再戳就吃掉你的白饭");
        return;
      }

      say(LINES[Math.floor(Math.random() * LINES.length)]);
    });

    // 一分钟没人理就打瞌睡
    const resetIdle = () => {
      pet.classList.remove("is-sleepy");
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        pet.classList.add("is-sleepy");
        say("Zzz…", 3200);
      }, 60_000);
    };

    ["mousemove", "scroll", "keydown", "touchstart"].forEach((name) =>
      window.addEventListener(name, resetIdle, { passive: true }),
    );
    resetIdle();
  })();
</script>

<style>
  .pet {
    position: fixed;
    right: 20px;
    bottom: 14px;
    z-index: 60;
    width: 98px;
    height: 140px;
  }

  .pet-btn {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    animation: petFloat 4.2s ease-in-out infinite;
    transform-origin: 50% 92%;
    transition: transform 0.32s var(--ease);
  }

  .pet-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 10px 16px rgba(26, 38, 88, 0.26));
    transition: filter 0.3s var(--ease);
    user-select: none;
    -webkit-user-drag: none;
  }

  .pet-btn:hover {
    transform: translateY(-3px) rotate(-2deg);
  }

  .pet-btn:hover .pet-img {
    filter: drop-shadow(0 14px 22px rgba(26, 38, 88, 0.34));
  }

  .pet-bubble {
    position: absolute;
    right: 8px;
    bottom: calc(100% + 4px);
    max-width: 172px;
    margin: 0;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 13px 13px 3px 13px;
    background: var(--surface);
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(5px) scale(0.96);
    transform-origin: bottom right;
    transition: opacity 0.22s var(--ease), transform 0.22s var(--ease);
    pointer-events: none;
    box-shadow: 0 6px 16px -8px rgba(26, 38, 88, 0.28);
  }

  .pet-bubble.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* 粒子由脚本创建，拿不到 scoped 属性 */
  :global(.pet-particle) {
    position: absolute;
    bottom: 46%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(98, 128, 255, 0.5);
    pointer-events: none;
    animation: petPop var(--dur, 0.8s) ease-out var(--delay, 0s) forwards;
  }

  .pet.is-happy .pet-btn {
    animation: petHappy 0.68s var(--ease);
  }

  .pet.is-sleepy .pet-btn {
    animation: petFloat 6.6s ease-in-out infinite;
  }

  .pet.is-sleepy .pet-img {
    filter: drop-shadow(0 8px 14px rgba(26, 38, 88, 0.18)) saturate(0.85) brightness(0.97);
  }

  @keyframes petFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes petHappy {
    0% {
      transform: translateY(0) scale(1) rotate(0deg);
    }
    26% {
      transform: translateY(-15px) scale(1.08, 0.92) rotate(-4deg);
    }
    52% {
      transform: translateY(0) scale(0.95, 1.05) rotate(3deg);
    }
    76% {
      transform: translateY(-4px) scale(1.02, 0.98) rotate(-1deg);
    }
    100% {
      transform: translateY(0) scale(1) rotate(0deg);
    }
  }

  @keyframes petPop {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.75;
    }
    100% {
      transform: translate(var(--dx, 0), -48px) scale(0.3);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .pet {
      right: 11px;
      bottom: 10px;
      width: 76px;
      height: 108px;
    }
    .pet-bubble {
      font-size: 11.5px;
      max-width: 144px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pet-btn {
      animation: none;
    }
  }
</style>
