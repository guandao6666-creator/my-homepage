---
import { formatShortDate } from "../lib/site";
import { coverGradient, type Post } from "../lib/posts";
import Icon from "./Icon.astro";

interface Props {
  post: Post;
  variant?: "row" | "card";
  index?: number;
  eager?: boolean;
}

const { post, variant = "row", index, eager = false } = Astro.props;
const href = `/blog/${post.slug}/`;
const gradient = coverGradient(post);
---

{
  variant === "card" ? (
    <article class="card">
      <a class="card-link" href={href}>
        <div class="thumb" style={`--cover: ${gradient}`}>
          {post.cover ? (
            <img src={post.cover} alt="" loading={eager ? "eager" : "lazy"} />
          ) : (
            <span class="thumb-glyph" aria-hidden="true">
              {post.tags[0] ?? "随笔"}
            </span>
          )}
        </div>
        <div class="card-body">
          <div class="card-meta">
            <time datetime={post.pubDate.toISOString()}>{formatShortDate(post.pubDate)}</time>
            <span class="sep" />
            <span>{post.minutes} 分钟</span>
            <span class="cmt" data-cmt={post.slug} hidden></span>
            <span class="lks" data-likes={post.slug} hidden></span>
          </div>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
          <span class="card-cta">
            阅读全文
            <Icon name="arrow-right" size={14} />
          </span>
        </div>
      </a>
    </article>
  ) : (
    <article class="row">
      <a class="row-link" href={href}>
        {typeof index === "number" && <span class="row-index">{String(index + 1).padStart(2, "0")}</span>}
        <div class="row-main">
          <div class="row-meta">
            <time datetime={post.pubDate.toISOString()}>{formatShortDate(post.pubDate)}</time>
            <span class="sep" />
            <span>{post.minutes} 分钟</span>
            <span class="cmt" data-cmt={post.slug} hidden></span>
            <span class="lks" data-likes={post.slug} hidden></span>
            {post.featured && <span class="pin">推荐</span>}
          </div>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
          <div class="row-tags">
            {post.tags.slice(0, 3).map((tag) => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>
        <span class="row-arrow" aria-hidden="true">
          <Icon name="arrow-up-right" size={16} />
        </span>
      </a>
    </article>
  )
}

<style>
  /* ---------------- row ---------------- */
  .row {
    border-top: 1px solid var(--line);
  }

  .row-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding: 26px 8px 26px 4px;
    transition: background-color 0.25s var(--ease);
  }

  .row-link:hover {
    background: color-mix(in srgb, var(--surface-sunk) 60%, transparent);
  }

  .row-index {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    padding-top: 5px;
    letter-spacing: 0.06em;
  }

  .row-main {
    min-width: 0;
  }

  .row-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }

  .pin {
    margin-left: 2px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-size: 10.5px;
    letter-spacing: 0.04em;
  }

  /* 留言数 / 点赞数：由 BaseLayout 的脚本填充，0 时保持 hidden */
  .cmt,
  .lks {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }

  .cmt::before,
  .lks::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }

  .row h3 {
    margin: 9px 0 7px;
    font-size: 20.5px;
    line-height: 1.45;
    transition: color 0.2s var(--ease);
  }

  .row-link:hover h3 {
    color: var(--accent-ink);
  }

  .row p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 13px;
  }

  .row-arrow {
    color: var(--muted);
    padding-top: 4px;
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), color 0.25s var(--ease);
  }

  .row-link:hover .row-arrow {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }

  /* ---------------- card ---------------- */
  .card {
    min-width: 0;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .card-link:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
  }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--cover);
    overflow: hidden;
    isolation: isolate;
  }

  .thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.5) 1px, transparent 0);
    background-size: 14px 14px;
    opacity: 0.4;
    mix-blend-mode: soft-light;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .card-link:hover .thumb img {
    transform: scale(1.04);
  }

  .thumb-glyph {
    position: absolute;
    inset: auto auto 14px 18px;
    font-family: var(--font-serif);
    font-size: 26px;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 12px rgba(30, 40, 28, 0.35);
    letter-spacing: 0.04em;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--muted);
  }

  .card h3 {
    font-size: 19px;
    line-height: 1.45;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 12.5px;
    color: var(--accent-ink);
  }

  .card-link:hover .card-cta {
    gap: 10px;
  }

  @media (max-width: 600px) {
    .row-link {
      grid-template-columns: 1fr auto;
      gap: 12px;
      padding: 22px 4px;
    }
    .row-index {
      display: none;
    }
    .row h3 {
      font-size: 18.5px;
    }
    .row-arrow {
      opacity: 1;
      transform: none;
    }
  }
</style>
