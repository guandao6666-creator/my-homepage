---
import { formatShortDate } from "../lib/site";
import { coverGradient, type Post } from "../lib/posts";
import Icon from "./Icon.astro";

interface Props {
  post: Post;
  variant?: "row" | "card";
  index?: number;
  eager?: boolean;
}

const { post, variant = "row", index, eager = false } = Astro.props;
const href = `/blog/${post.slug}/`;
const gradient = coverGradient(post);
---

{
  variant === "card" ? (
    <article class="card">
      <a class="card-link" href={href}>
        <div class="thumb" style={`--cover: ${gradient}`}>
          {post.cover ? (
            <img src={post.cover} alt="" loading={eager ? "eager" : "lazy"} />
          ) : (
            <span class="thumb-glyph" aria-hidden="true">
              {post.tags[0] ?? "随笔"}
            </span>
          )}
        </div>
        <div class="card-body">
          <div class="card-meta">
            <time datetime={post.pubDate.toISOString()}>{formatShortDate(post.pubDate)}</time>
            <span class="sep" />
            <span>{post.minutes} 分钟</span>
            <span class="cmt" data-cmt={post.slug} hidden></span>
            <span class="lks" data-likes={post.slug} hidden></span>
          </div>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
          <span class="card-cta">
            阅读全文
            <Icon name="arrow-right" size={14} />
          </span>
        </div>
      </a>
    </article>
  ) : (
    <article class="row">
      <a class="row-link" href={href}>
        {typeof index === "number" && <span class="row-index">{String(index + 1).padStart(2, "0")}</span>}
        <div class="row-main">
          <div class="row-meta">
            <time datetime={post.pubDate.toISOString()}>{formatShortDate(post.pubDate)}</time>
            <span class="sep" />
            <span>{post.minutes} 分钟</span>
            <span class="cmt" data-cmt={post.slug} hidden></span>
            <span class="lks" data-likes={post.slug} hidden></span>
            {post.featured && <span class="pin">推荐</span>}
          </div>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
          <div class="row-tags">
            {post.tags.slice(0, 3).map((tag) => (
              <span class="pill">{tag}</span>
            ))}
          </div>
        </div>
        <span class="row-arrow" aria-hidden="true">
          <Icon name="arrow-up-right" size={16} />
        </span>
      </a>
    </article>
  )
}

<style>
  /* 博客内统一用「纸页」卡片：四向硬描边 + 内侧斜面，无圆角 */
  .row {
    background: var(--px-paper);
    box-shadow: var(--px-paper-frame);
    transition: transform 0.16s steps(2, end), background-color 0.16s linear;
  }

  .row:hover {
    transform: translateY(-3px);
    background: var(--px-paper-2);
  }

  .row-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding: 24px 28px 22px;
  }

  .row-index {
    padding-top: 3px;
    font-family: var(--px-pix);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #7c93c4;
  }

  .row-main {
    min-width: 0;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--px-pix);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--px-paper-soft);
  }

  .row-meta time {
    color: #8fc3ff;
  }

  .sep {
    width: 4px;
    height: 4px;
    background: currentColor;
    opacity: 0.5;
  }

  .pin {
    padding: 2px 6px 1px;
    font-family: var(--px-pix);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: #a4331f;
    box-shadow: 0 0 0 1px #c0573f;
  }

  /* 留言数 / 点赞数：由 BaseLayout 的脚本填充，0 时保持 hidden */
  .cmt,
  .lks {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--px-paper-soft);
  }

  .cmt::before,
  .lks::before {
    content: "";
    width: 4px;
    height: 4px;
    background: currentColor;
    opacity: 0.5;
  }

  .row h3 {
    margin: 11px 0 8px;
    font-family: var(--px-hand);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: 0.02em;
    color: var(--px-paper-ink);
    transition: color 0.16s linear;
  }

  .row:hover h3 {
    color: #7a4d13;
  }

  .row p {
    margin: 0;
    color: #c2d4f2;
    font-size: 14px;
    line-height: 1.85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row p:empty {
    display: none;
  }

  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .row-tags .pill {
    padding: 4px 8px 3px;
    border: 0;
    border-radius: 0;
    font-family: var(--px-pix);
    font-size: 11.5px;
    color: #8fc3ff;
    background: #16316f;
    box-shadow: inset 2px 2px 0 0 #0b1d4a;
  }

  .row-arrow {
    padding-top: 4px;
    color: #7fe6ff;
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.16s linear, transform 0.16s steps(2, end);
  }

  .row:hover .row-arrow {
    opacity: 1;
    transform: none;
  }

  /* ---------------- card ---------------- */
  .card {
    min-width: 0;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--px-paper);
    box-shadow: var(--px-paper-frame);
    transition: transform 0.16s steps(2, end), background-color 0.16s linear;
  }

  .card-link:hover {
    transform: translateY(-3px);
    background: var(--px-paper-2);
  }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--cover);
    overflow: hidden;
    isolation: isolate;
    border-bottom: 4px solid var(--px-edge);
  }

  .thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.45) 1px, transparent 0);
    background-size: 16px 16px;
    opacity: 0.35;
    mix-blend-mode: soft-light;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s steps(6, end);
  }

  .card-link:hover .thumb img {
    transform: scale(1.04);
  }

  .thumb-glyph {
    position: absolute;
    inset: auto auto 14px 18px;
    z-index: 1;
    font-family: var(--px-hand);
    font-size: 26px;
    color: #fff;
    text-shadow: 2px 2px 0 var(--px-edge);
    letter-spacing: 0.06em;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--px-pix);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--px-paper-soft);
  }

  .card h3 {
    font-family: var(--px-hand);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--px-paper-ink);
    transition: color 0.16s linear;
  }

  .card-link:hover h3 {
    color: #7a4d13;
  }

  .card p {
    margin: 0;
    color: #c2d4f2;
    font-size: 13.5px;
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card p:empty {
    display: none;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 12px;
    font-family: var(--px-pix);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: #7fe6ff;
  }

  .card-link:hover .card-cta {
    gap: 10px;
    color: var(--px-paper-ink);
  }

  @media (max-width: 600px) {
    .row-link {
      grid-template-columns: 1fr auto;
      gap: 12px;
      padding: 20px 18px;
    }
    .row-index {
      display: none;
    }
    .row h3 {
      font-size: 20px;
    }
    .row-arrow {
      opacity: 1;
      transform: none;
    }
  }
</style>
