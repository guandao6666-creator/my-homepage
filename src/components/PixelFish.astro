---
/**
 * 8-bit 像素鱼。
 * 造型是逐像素手排的（19×11 网格），确保放大后每个方块都是硬边，
 * 不依赖位图素材，也不会在 Retina 屏上糊掉。
 */
interface Props {
  /** 鱼身颜色 */
  body?: string;
  /** 描边颜色 */
  edge?: string;
  class?: string;
}

const { body = "#3f8cff", edge = "#0b1d4a", class: className } = Astro.props;

/** [x, y, width, tone] —— tone: e=描边 b=鱼身 w=眼睛高光 */
const rects: [number, number, number, string][] = [
  [0, 1, 1, "e"],
  [0, 2, 4, "e"],
  [11, 2, 4, "e"],
  [0, 3, 1, "e"],
  [1, 3, 3, "b"],
  [4, 3, 3, "e"],
  [9, 3, 2, "e"],
  [11, 3, 4, "b"],
  [15, 3, 2, "e"],
  [0, 4, 1, "e"],
  [1, 4, 6, "b"],
  [7, 4, 2, "e"],
  [9, 4, 3, "b"],
  [12, 4, 1, "w"],
  [13, 4, 4, "b"],
  [17, 4, 1, "e"],
  [0, 5, 1, "e"],
  [1, 5, 12, "b"],
  [13, 5, 1, "e"],
  [14, 5, 3, "b"],
  [17, 5, 1, "e"],
  [0, 6, 1, "e"],
  [1, 6, 6, "b"],
  [7, 6, 1, "e"],
  [8, 6, 9, "b"],
  [17, 6, 1, "e"],
  [0, 7, 1, "e"],
  [1, 7, 3, "b"],
  [4, 7, 3, "e"],
  [8, 7, 1, "e"],
  [9, 7, 8, "b"],
  [17, 7, 1, "e"],
  [0, 8, 4, "e"],
  [9, 8, 2, "e"],
  [11, 8, 4, "b"],
  [15, 8, 2, "e"],
  [0, 9, 1, "e"],
  [11, 9, 4, "e"],
];

const tone = (key: string) => (key === "b" ? body : key === "w" ? "#ffffff" : edge);
---

<svg
  class={className}
  viewBox="0 0 19 11"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {rects.map(([x, y, w, key]) => <rect x={x} y={y} width={w} height="1" fill={tone(key)} />)}
</svg>
