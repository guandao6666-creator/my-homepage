---
import { cloudConfig } from "../lib/cloud";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const cloud = cloudConfig();
---

<section
  class="comments"
  id="comments"
  data-slug={slug}
  data-url={cloud?.url ?? ""}
  data-key={cloud?.anonKey ?? ""}
>
  <div class="comments-head">
    <div>
      <span class="eyebrow">留言</span>
      <h2>说点什么</h2>
    </div>
    <span class="comments-count" id="comments-count"></span>
  </div>

  {cloud ? (
    <form class="comment-form" id="comment-form" novalidate>
      <div class="comment-identity" id="comment-identity">
        <span class="comment-who" id="comment-who">游客留言 · 不用注册</span>
        <button class="comment-link" id="comment-auth-toggle" type="button">登录</button>
      </div>

      <div class="login-box" id="login-box" hidden>
        <div class="login-fields">
          <input id="login-email" type="email" placeholder="邮箱" autocomplete="email" />
          <input id="login-pass" type="password" placeholder="密码（至少 6 位）" autocomplete="current-password" />
        </div>
        <div class="login-actions">
          <span class="login-hint" id="login-hint">没有账号就点「注册」，不用去邮箱验证</span>
          <span class="login-tools">
            <button type="button" id="login-do">登录</button>
            <button type="button" id="login-signup">注册</button>
          </span>
        </div>
      </div>

      <div class="comment-fields">
        <input
          class="comment-author"
          id="c-author"
          name="author"
          maxlength="24"
          placeholder="你的昵称"
          autocomplete="nickname"
          required
        />
        <textarea
          class="comment-body"
          id="c-body"
          name="body"
          rows="3"
          maxlength="800"
          placeholder="想到什么就说什么，不用注册，也不填邮箱。"
          required
        ></textarea>
      </div>

      <div class="comment-actions">
        <span class="comment-hint" id="comment-hint">最多 800 字，留言会直接公开</span>
        <button class="btn btn--solid" id="comment-submit" type="submit">发送</button>
      </div>

      <!-- 蜜罐：正常人看不见，填了就当成机器人 -->
      <div class="comment-hp" aria-hidden="true">
        <label for="c-website">网站</label>
        <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </form>
  ) : (
    <p class="comments-note">还没有连接云端数据库，留言功能暂不可用。</p>
  )}

  <ul class="comment-list" id="comment-list"></ul>
  <p class="comments-empty" id="comments-empty" hidden>还没有留言，来说第一句吧。</p>
</section>

<!-- 评论项和回复表单都是 JS 动态创建的，拿不到 Astro 的 scoped 属性，只能用全局样式 -->
<style is:global>
  .comments {
    max-width: 700px;
    margin: 0;
    padding: 44px 0 8px;
    border-top: 1px solid var(--line);
  }

  .comments-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .comments-head h2 {
    margin-top: 8px;
    font-size: 22px;
  }

  .comments-count {
    font-size: 12.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .comment-form {
    margin-top: 22px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .comment-fields {
    display: grid;
    gap: 10px;
  }

  /* ---------- 身份 / 登录 ---------- */

  .comment-identity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 12px;
    color: var(--muted);
  }

  .comment-who em {
    font-style: normal;
    color: var(--ink);
    font-weight: 600;
  }

  .comment-link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--accent-ink);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .login-box {
    margin-bottom: 12px;
    padding: 12px;
    border: 1px dashed var(--line-strong);
    border-radius: 10px;
    background: var(--paper);
  }

  .login-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .login-fields input {
    flex: 1 1 160px;
    min-width: 0;
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px 10px;
  }

  .login-fields input:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .login-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 9px;
  }

  .login-hint {
    font-size: 11.5px;
    color: var(--muted);
  }

  .login-hint[data-tone="error"] {
    color: #a4443a;
  }

  .login-tools {
    display: flex;
    gap: 7px;
    flex: none;
  }

  .login-tools button {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--muted);
    cursor: pointer;
  }

  .login-tools button:first-child {
    border-color: transparent;
    background: var(--accent);
    color: #fff;
  }

  .login-tools button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* 登录用户留言的名片标记 */
  .comment-badge {
    margin-left: 6px;
    padding: 1px 5px;
    border-radius: 999px;
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-size: 10px;
    font-style: normal;
    font-weight: 500;
    vertical-align: 1px;
  }

  .comment-badge.is-owner {
    background: var(--accent);
    color: #fff;
  }

  .comment-author,
  .comment-body,
  .reply-author,
  .reply-body {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .comment-author {
    max-width: 220px;
    font-size: 13.5px;
  }

  .comment-body {
    font-size: 14px;
    line-height: 1.85;
    resize: vertical;
    min-height: 88px;
  }

  .comment-author:focus,
  .comment-body:focus,
  .reply-author:focus,
  .reply-body:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .comment-author::placeholder,
  .comment-body::placeholder,
  .reply-author::placeholder,
  .reply-body::placeholder {
    color: var(--muted);
  }

  .comment-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 12px;
  }

  .comment-hint {
    font-size: 12px;
    color: var(--muted);
  }

  .comment-hint[data-tone="error"] {
    color: #a4443a;
  }

  .comment-hint[data-tone="ok"] {
    color: var(--accent-ink);
  }

  #comment-submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .comment-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---------- 列表 ---------- */

  .comment-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .comment-item {
    padding: 20px 0;
    border-bottom: 1px dashed var(--line);
  }

  .comment-meta-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .comment-name {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--ink);
    font-weight: 600;
  }

  .comment-time {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  .comment-text {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--ink-2);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .comment-acts {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
  }

  .c-like,
  .comment-acts .c-reply {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }

  .c-like:hover,
  .comment-acts .c-reply:hover {
    color: var(--accent-ink);
  }

  .c-like svg {
    width: 13px;
    height: 13px;
    transition: transform 0.25s var(--ease);
  }

  .c-like[aria-pressed="true"] {
    color: #a4443a;
  }

  .c-like[aria-pressed="true"] svg {
    fill: currentColor;
    transform: scale(1.1);
  }

  .c-like[data-busy="true"] {
    opacity: 0.5;
    pointer-events: none;
  }

  .c-like-n {
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 回复 ---------- */

  .comment-replies {
    list-style: none;
    margin: 10px 0 0 2px;
    padding: 0 0 0 16px;
    border-left: 2px solid var(--line);
  }

  .comment-replies .comment-item {
    padding: 12px 0;
    border-bottom: 0;
  }

  .comment-replies .comment-item:last-child {
    padding-bottom: 0;
  }

  .comment-replies .comment-name {
    font-size: 14px;
  }

  .comment-replies .comment-text {
    font-size: 13.8px;
    margin-top: 6px;
  }

  .reply-form {
    margin: 12px 0 4px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .reply-form .reply-author {
    max-width: 180px;
    font-size: 13px;
    margin-bottom: 8px;
  }

  .reply-form .reply-body {
    font-size: 13.5px;
    line-height: 1.8;
    min-height: 62px;
    resize: vertical;
  }

  .reply-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 9px;
  }

  .reply-hint {
    font-size: 11.5px;
    color: var(--muted);
  }

  .reply-hint[data-tone="error"] {
    color: #a4443a;
  }

  .reply-tools {
    display: flex;
    gap: 8px;
  }

  .reply-tools button {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--muted);
    cursor: pointer;
  }

  .reply-tools button[type="submit"] {
    border-color: transparent;
    background: var(--accent);
    color: #fff;
  }

  .reply-tools button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .comments-empty,
  .comments-note {
    margin: 18px 0 0;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .comment-author {
      max-width: 100%;
    }
    .comment-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .comment-actions .btn {
      justify-content: center;
    }
  }
</style>

<script>
  import { loadSession, signIn, signUp, signOut, type Session } from "../lib/cloud";
  import { SITE } from "../lib/site";

  /** 站长自己的留言标「站长」，其他登录用户标「成员」 */
  const OWNER_ID = SITE.ownerUserId;

  (() => {
    const root = document.getElementById("comments");
    if (!root) return;

    const slug = root.dataset.slug || "";
    const base = (root.dataset.url || "").replace(/\/$/, "");
    const key = root.dataset.key || "";
    if (!base || !key) return;

    const form = document.getElementById("comment-form");
    const list = document.getElementById("comment-list");
    const empty = document.getElementById("comments-empty");
    const countEl = document.getElementById("comments-count");
    const hint = document.getElementById("comment-hint");
    const submitBtn = document.getElementById("comment-submit");
    const authorInput = document.getElementById("c-author");
    const bodyInput = document.getElementById("c-body");

    const headers = { apikey: key, "Content-Type": "application/json" };
    // 写操作要带登录凭证，否则 RLS 里 auth.uid() 是空的，带 user_id 的留言会被拒
    const writeHeaders = () =>
      session ? { ...headers, Authorization: `Bearer ${session.accessToken}` } : headers;
    const enc = (v) => encodeURIComponent(v);

    const VISITOR_KEY = "guandao.visitor";
    const LIKED_KEY = "guandao.liked";
    const NICK_KEY = "comment-author";

    const HEART =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21.2l7.7-7.7 1.1-1a5.5 5.5 0 0 0 0-7.9Z"/></svg>';

    let items = [];
    const likeCount = new Map();

    /* --------------------------- 登录状态 --------------------------- */

    const whoEl = document.getElementById("comment-who");
    const authToggle = document.getElementById("comment-auth-toggle");
    const loginBox = document.getElementById("login-box");
    const loginEmail = document.getElementById("login-email") as HTMLInputElement | null;
    const loginPass = document.getElementById("login-pass") as HTMLInputElement | null;
    const loginHint = document.getElementById("login-hint");
    const loginDo = document.getElementById("login-do") as HTMLButtonElement | null;
    const loginSignup = document.getElementById("login-signup") as HTMLButtonElement | null;

    let session: Session | null = loadSession();

    const nameFromSession = () => (session?.email ?? "").split("@")[0] ?? "";

    const setLoginHint = (text: string, tone?: string) => {
      if (!loginHint) return;
      loginHint.textContent = text;
      if (tone) loginHint.dataset.tone = tone;
      else delete loginHint.dataset.tone;
    };

    function renderIdentity() {
      if (!whoEl || !authToggle) return;
      whoEl.textContent = "";
      if (session) {
        const em = document.createElement("em");
        em.textContent = nameFromSession();
        whoEl.append("已登录 ", em, " · 留言带身份标记");
        authToggle.textContent = "退出";
        if (authorInput && !authorInput.value) authorInput.value = nameFromSession();
      } else {
        whoEl.textContent = "游客留言 · 不用注册";
        authToggle.textContent = "登录";
      }
    }

    async function doAuth(mode: "in" | "up") {
      const email = loginEmail?.value.trim() ?? "";
      const pass = loginPass?.value ?? "";
      if (!email || !pass) {
        setLoginHint("邮箱和密码都要填", "error");
        return;
      }
      if (passwordTooShort(pass)) {
        setLoginHint("密码至少 6 位", "error");
        return;
      }
      if (loginDo) loginDo.disabled = true;
      if (loginSignup) loginSignup.disabled = true;
      setLoginHint(mode === "in" ? "登录中…" : "注册中…");
      try {
        session = mode === "in" ? await signIn(email, pass) : await signUp(email, pass);
        if (loginBox) loginBox.hidden = true;
        if (loginPass) loginPass.value = "";
        setLoginHint("");
        renderIdentity();
      } catch (error) {
        setLoginHint(humanizeAuthError((error as Error).message), "error");
      } finally {
        if (loginDo) loginDo.disabled = false;
        if (loginSignup) loginSignup.disabled = false;
      }
    }

    const passwordTooShort = (pass: string) => pass.length < 6;

    const humanizeAuthError = (message: string) => {
      if (/already registered|already been registered/i.test(message)) return "这个邮箱注册过了，直接点「登录」";
      if (/invalid login credentials/i.test(message)) return "邮箱或密码不对";
      if (/password should be at least/i.test(message)) return "密码至少 6 位";
      if (/unable to validate email|invalid email/i.test(message)) return "邮箱格式不对";
      if (/rate limit|too many/i.test(message)) return "试太多次了，等一会儿再来";
      return message;
    };

    authToggle?.addEventListener("click", async () => {
      if (session) {
        await signOut();
        session = null;
        if (loginBox) loginBox.hidden = true;
        renderIdentity();
        return;
      }
      if (loginBox) loginBox.hidden = !loginBox.hidden;
      if (loginBox && !loginBox.hidden) loginEmail?.focus();
    });

    loginDo?.addEventListener("click", () => void doAuth("in"));
    loginSignup?.addEventListener("click", () => void doAuth("up"));
    loginPass?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        void doAuth("in");
      }
    });

    renderIdentity();

    /* --------------------------- 访客身份 --------------------------- */

    function visitorId() {
      try {
        let id = localStorage.getItem(VISITOR_KEY);
        if (!id) {
          id = crypto.randomUUID();
          localStorage.setItem(VISITOR_KEY, id);
        }
        return id;
      } catch {
        return "anon-" + Math.random().toString(36).slice(2, 12);
      }
    }

    const visitor = visitorId();

    function likedSet(): Set<string> {
      try {
        return new Set(JSON.parse(localStorage.getItem(LIKED_KEY) || "[]"));
      } catch {
        return new Set();
      }
    }

    function saveLiked(set: Set<string>) {
      try {
        localStorage.setItem(LIKED_KEY, JSON.stringify([...set]));
      } catch {
        /* 忽略 */
      }
    }

    const bump = (k: string, n: number) => likeCount.set(k, (likeCount.get(k) ?? 0) + n);

    /* ----------------------------- 渲染 ----------------------------- */

    const timeLabel = (iso: string) => {
      const diff = Date.now() - new Date(iso).getTime();
      const min = Math.floor(diff / 60000);
      if (min < 1) return "刚刚";
      if (min < 60) return `${min} 分钟前`;
      const hour = Math.floor(min / 60);
      if (hour < 24) return `${hour} 小时前`;
      const day = Math.floor(hour / 24);
      if (day < 30) return `${day} 天前`;
      const d = new Date(iso);
      return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
    };

    const setHint = (text: string, tone?: string) => {
      if (!hint) return;
      hint.textContent = text;
      if (tone) hint.dataset.tone = tone;
      else delete hint.dataset.tone;
    };

    function itemEl(c: any, replies: any[], withReply: boolean) {
      const li = document.createElement("li");
      li.className = "comment-item";
      li.dataset.id = c.id;

      const meta = document.createElement("div");
      meta.className = "comment-meta-row";
      const name = document.createElement("span");
      name.className = "comment-name";
      name.textContent = c.author;
      if (c.user_id) {
        const isOwner = c.user_id === OWNER_ID;
        const badge = document.createElement("em");
        badge.className = isOwner ? "comment-badge is-owner" : "comment-badge";
        badge.textContent = isOwner ? "站长" : "成员";
        name.append(badge);
      }
      const time = document.createElement("span");
      time.className = "comment-time";
      time.textContent = timeLabel(c.created_at);
      time.title = new Date(c.created_at).toLocaleString("zh-CN");
      meta.append(name, time);

      const text = document.createElement("p");
      text.className = "comment-text";
      text.textContent = c.body;

      const acts = document.createElement("div");
      acts.className = "comment-acts";

      const like = document.createElement("button");
      like.type = "button";
      like.className = "c-like";
      like.dataset.like = "comment";
      like.dataset.id = c.id;
      like.setAttribute("aria-pressed", "false");
      like.innerHTML = HEART + '<span class="c-like-n">0</span>';
      acts.append(like);

      if (withReply) {
        const reply = document.createElement("button");
        reply.type = "button";
        reply.className = "c-reply";
        reply.dataset.reply = c.id;
        reply.textContent = "回复";
        acts.append(reply);
      }

      li.append(meta, text, acts);

      if (replies.length) {
        const ul = document.createElement("ul");
        ul.className = "comment-replies";
        for (const r of replies) ul.append(itemEl(r, [], false));
        li.append(ul);
      }

      return li;
    }

    function render() {
      if (!list) return;
      list.textContent = "";

      const roots = items.filter((c) => !c.parent_id);
      const kids = new Map<string, any[]>();
      for (const c of items) {
        if (!c.parent_id) continue;
        if (!kids.has(c.parent_id)) kids.set(c.parent_id, []);
        kids.get(c.parent_id)!.push(c);
      }
      // 父留言被删掉的回复，提到顶层，别让它们消失
      for (const [pid, arr] of kids) {
        if (!roots.some((c) => c.id === pid)) roots.push(...arr);
      }

      for (const c of roots) list.append(itemEl(c, kids.get(c.id) ?? [], true));

      if (empty) empty.hidden = items.length > 0;
      if (countEl) countEl.textContent = items.length ? `${items.length} 条` : "";
    }

    /* ----------------------------- 点赞 ----------------------------- */

    function paintLikes() {
      const liked = likedSet();
      for (const btn of document.querySelectorAll<HTMLElement>("[data-like]")) {
        const k = `${btn.dataset.like}:${btn.dataset.id}`;
        const on = liked.has(k);
        btn.setAttribute("aria-pressed", on ? "true" : "false");
        const num = btn.querySelector(".like-count, .c-like-n");
        if (num) num.textContent = String(likeCount.get(k) ?? 0);
      }
    }

    async function like(btn: HTMLElement) {
      const type = btn.dataset.like ?? "";
      const id = btn.dataset.id ?? "";
      const k = `${type}:${id}`;
      const liked = likedSet();
      if (liked.has(k) || btn.dataset.busy === "true") return;

      btn.dataset.busy = "true";
      try {
        const res = await fetch(`${base}/rest/v1/likes`, {
          method: "POST",
          headers: { ...headers, Prefer: "return=minimal" },
          body: JSON.stringify([{ target_type: type, target_id: id, visitor }]),
        });
        // 409 = 这台设备已经赞过了（比如清过缓存又点了一次）
        if (!res.ok && res.status !== 409) throw new Error(String(res.status));
        if (res.ok) bump(k, 1);
        liked.add(k);
        saveLiked(liked);
        paintLikes();
      } catch {
        /* 静默失败，不要让点赞打断阅读 */
      } finally {
        delete btn.dataset.busy;
      }
    }

    /* ----------------------------- 回复 ----------------------------- */

    function closeReplyForms() {
      for (const f of document.querySelectorAll(".reply-form")) f.remove();
    }

    function openReply(parentId: string, host: HTMLElement) {
      closeReplyForms();

      const box = document.createElement("form");
      box.className = "reply-form";

      const author = document.createElement("input");
      author.className = "reply-author";
      author.maxLength = 24;
      author.placeholder = "你的昵称";
      author.autocomplete = "nickname";
      try {
        author.value = session ? nameFromSession() : localStorage.getItem(NICK_KEY) || "";
      } catch {
        author.value = session ? nameFromSession() : "";
      }

      const body = document.createElement("textarea");
      body.className = "reply-body";
      body.rows = 2;
      body.maxLength = 800;
      body.placeholder = "写下你的回复…";

      const actions = document.createElement("div");
      actions.className = "reply-actions";

      const status = document.createElement("span");
      status.className = "reply-hint";

      const tools = document.createElement("span");
      tools.className = "reply-tools";

      const cancel = document.createElement("button");
      cancel.type = "button";
      cancel.textContent = "取消";

      const send = document.createElement("button");
      send.type = "submit";
      send.textContent = "发送";
      send.disabled = false;

      tools.append(cancel, send);
      actions.append(status, tools);
      box.append(author, body, actions);

      cancel.addEventListener("click", () => box.remove());

      box.addEventListener("submit", async (event) => {
        event.preventDefault();
        const nick = author.value.trim();
        const content = body.value.trim();
        if (!nick || !content) {
          status.textContent = "昵称和内容都要填";
          status.dataset.tone = "error";
          return;
        }
        send.disabled = true;
        status.textContent = "发送中…";
        try {
          const res = await fetch(`${base}/rest/v1/comments`, {
            method: "POST",
            headers: { ...writeHeaders(), Prefer: "return=representation" },
            body: JSON.stringify([
              {
                post_slug: slug,
                author: nick,
                body: content,
                parent_id: parentId,
                user_id: session?.userId ?? null,
              },
            ]),
          });
          if (!res.ok) throw new Error(String(res.status));
          const [created] = await res.json();
          items = [...items, created];
          try {
            localStorage.setItem(NICK_KEY, nick);
          } catch {
            /* 忽略 */
          }
          render();
          paintLikes();
        } catch {
          status.textContent = "没发出去，稍后再试";
          status.dataset.tone = "error";
          send.disabled = false;
        }
      });

      host.after(box);
      body.focus();
    }

    /* ----------------------------- 交互 ----------------------------- */

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const likeBtn = target.closest("[data-like]") as HTMLElement | null;
      if (likeBtn) {
        event.preventDefault();
        void like(likeBtn);
        return;
      }
      const replyBtn = target.closest("[data-reply]") as HTMLElement | null;
      if (replyBtn) {
        event.preventDefault();
        const li = replyBtn.closest(".comment-item") as HTMLElement | null;
        if (li && replyBtn.dataset.reply) openReply(replyBtn.dataset.reply, repliesHost(li));
      }
    });

    // 回复框插在点赞/回复那行之后
    function repliesHost(li: HTMLElement) {
      return (li.querySelector(".comment-acts") as HTMLElement) ?? li;
    }

    /* ----------------------------- 加载 ----------------------------- */

    async function load() {
      try {
        const [cRes, lRes] = await Promise.all([
          fetch(
            `${base}/rest/v1/comments?post_slug=eq.${enc(slug)}&select=id,author,body,created_at,parent_id,user_id&order=created_at.asc&limit=300`,
            { headers },
          ),
          fetch(`${base}/rest/v1/likes?select=target_type,target_id&limit=5000`, { headers }),
        ]);
        if (cRes.ok) items = await cRes.json();
        if (lRes.ok) {
          const rows = await lRes.json();
          likeCount.clear();
          for (const row of rows) bump(`${row.target_type}:${row.target_id}`, 1);
        }
        render();
        paintLikes();
      } catch {
        setHint("留言加载失败，刷新试试", "error");
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!authorInput || !bodyInput || !submitBtn) return;

      const author = authorInput.value.trim();
      const body = bodyInput.value.trim();
      const trap = document.getElementById("c-website") as HTMLInputElement | null;

      if (trap && trap.value) {
        form.reset();
        setHint("已发送", "ok");
        return;
      }
      if (!author || !body) {
        setHint("昵称和内容都要填一下", "error");
        (!author ? authorInput : bodyInput).focus();
        return;
      }

      submitBtn.disabled = true;
      setHint("发送中…");
      try {
        const res = await fetch(`${base}/rest/v1/comments`, {
          method: "POST",
          headers: { ...writeHeaders(), Prefer: "return=representation" },
          body: JSON.stringify([
            { post_slug: slug, author, body, user_id: session?.userId ?? null },
          ]),
        });
        if (!res.ok) throw new Error(String(res.status));
        const [created] = await res.json();
        items = [...items, created];
        render();
        paintLikes();
        bodyInput.value = "";
        setHint("已发送，谢谢留言", "ok");
        try {
          localStorage.setItem(NICK_KEY, author);
        } catch {
          /* 忽略 */
        }
      } catch {
        setHint("没发出去，稍后再试", "error");
      } finally {
        submitBtn.disabled = false;
      }
    });

    try {
      // 登录了就用登录名，否则用上次留言记住的昵称
      const saved = session ? nameFromSession() : localStorage.getItem(NICK_KEY);
      if (saved && authorInput) authorInput.value = saved;
    } catch {
      /* 忽略 */
    }

    void load();
  })();
</script>
