---
import Icon from "./Icon.astro";
---

<dialog class="cmdk-dialog" id="cmdk-dialog" aria-label="全站快速搜索">
  <div class="cmdk-panel">
    <div class="cmdk-head">
      <Icon name="search" size={16} class="cmdk-ico" />
      <input
        id="cmdk-input"
        type="search"
        placeholder="搜索文章、标签、正文，或输入页面名…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
      />
      <kbd class="cmdk-esc">Esc</kbd>
    </div>
    <div class="cmdk-list" id="cmdk-list" role="listbox" aria-label="搜索结果"></div>
    <div class="cmdk-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>⌘K</kbd> / <kbd>Ctrl+K</kbd> 随时唤起</span>
    </div>
  </div>
</dialog>

<button
  class="back-top"
  id="back-to-top"
  type="button"
  aria-label="回到顶部"
  title="回到顶部"
  hidden
>
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5" />
    <path d="m5 12 7-7 7 7" />
  </svg>
</button>

<script>
  type SearchItem = {
    slug: string;
    title: string;
    description: string;
    tags: string[];
    date: string;
    body: string;
  };

  type Entry = {
    kind: "post" | "page";
    title: string;
    subtitle: string;
    href: string;
    meta: string;
  };

  const QUICK_PAGES: Entry[] = [
    { kind: "page", title: "博客首页", subtitle: "最新文章、状态与导航", href: "/home/", meta: "页面" },
    { kind: "page", title: "全部文章", subtitle: "按标签浏览与全文检索", href: "/blog/", meta: "页面" },
    { kind: "page", title: "碎片笔记", subtitle: "短句与日常想法时间流", href: "/notes/", meta: "页面" },
    { kind: "page", title: "骑行记录", subtitle: "总里程、装备与骑过的路", href: "/cycling/", meta: "页面" },
    { kind: "page", title: "作品集", subtitle: "个人项目与实验", href: "/projects/", meta: "页面" },
    { kind: "page", title: "我用什么", subtitle: "日常软件与硬件装备清单", href: "/uses/", meta: "页面" },
    { kind: "page", title: "归档时间轴", subtitle: "按年月查看所有文章", href: "/archive/", meta: "页面" },
    { kind: "page", title: "关于我", subtitle: "个人介绍与联系方式", href: "/about/", meta: "页面" },
    { kind: "page", title: "Guandao OS 桌面", subtitle: "切换到可交互桌面版", href: "/", meta: "桌面" },
  ];

  (() => {
    const dialog = document.getElementById("cmdk-dialog") as HTMLDialogElement | null;
    const input = document.getElementById("cmdk-input") as HTMLInputElement | null;
    const list = document.getElementById("cmdk-list");
    const trigger = document.getElementById("search-trigger");
    if (!dialog || !input || !list) return;

    let postsCache: SearchItem[] | null = null;
    let loading = false;
    let currentEntries: Entry[] = [];
    let activeIdx = 0;

    const snippetOf = (body: string, q: string): string => {
      const lower = body.toLowerCase();
      const idx = lower.indexOf(q);
      if (idx < 0) return "";
      const start = Math.max(0, idx - 24);
      const end = Math.min(body.length, idx + q.length + 52);
      return `${start > 0 ? "…" : ""}${body.slice(start, end)}${end < body.length ? "…" : ""}`;
    };

    const render = (entries: Entry[], emptyHint?: string) => {
      currentEntries = entries;
      activeIdx = 0;
      list.textContent = "";
      if (!entries.length) {
        const p = document.createElement("p");
        p.className = "cmdk-empty";
        p.textContent = emptyHint ?? "没有找到匹配的内容";
        list.appendChild(p);
        return;
      }
      entries.forEach((entry, index) => {
        const a = document.createElement("a");
        a.className = `cmdk-item${index === 0 ? " is-active" : ""}`;
        a.href = entry.href;
        a.setAttribute("role", "option");
        a.setAttribute("aria-selected", index === 0 ? "true" : "false");
        a.dataset.idx = String(index);

        const main = document.createElement("div");
        main.className = "cmdk-item-main";
        const title = document.createElement("strong");
        title.textContent = entry.title;
        const sub = document.createElement("span");
        sub.textContent = entry.subtitle;
        main.append(title, sub);

        const meta = document.createElement("em");
        meta.className = "cmdk-item-meta";
        meta.textContent = entry.meta;

        a.append(main, meta);
        a.addEventListener("mouseenter", () => setActive(index));
        list.appendChild(a);
      });
    };

    const setActive = (next: number) => {
      if (!currentEntries.length) return;
      activeIdx = (next + currentEntries.length) % currentEntries.length;
      const nodes = list.querySelectorAll<HTMLElement>(".cmdk-item");
      nodes.forEach((node, idx) => {
        const on = idx === activeIdx;
        node.classList.toggle("is-active", on);
        node.setAttribute("aria-selected", on ? "true" : "false");
        if (on) node.scrollIntoView({ block: "nearest" });
      });
    };

    const query = () => {
      const raw = input.value.trim().toLowerCase();
      const posts = postsCache ?? [];
      if (!raw) {
        const recent: Entry[] = posts.slice(0, 5).map((p) => ({
          kind: "post",
          title: p.title,
          subtitle: p.description || p.tags.join(" · "),
          href: `/blog/${encodeURIComponent(p.slug)}/`,
          meta: p.date,
        }));
        render([...recent, ...QUICK_PAGES.slice(0, 5)], loading ? "正在加载文章索引…" : undefined);
        return;
      }

      const matchedPosts: Entry[] = [];
      for (const p of posts) {
        const inTitle = p.title.toLowerCase().includes(raw);
        const inDesc = (p.description || "").toLowerCase().includes(raw);
        const inTags = p.tags.some((t) => t.toLowerCase().includes(raw));
        const inBody = p.body.toLowerCase().includes(raw);
        if (inTitle || inDesc || inTags || inBody) {
          const hit = inBody && !inTitle ? snippetOf(p.body, raw) : p.description || p.tags.join(" · ");
          matchedPosts.push({
            kind: "post",
            title: p.title,
            subtitle: hit,
            href: `/blog/${encodeURIComponent(p.slug)}/`,
            meta: p.date,
          });
        }
      }

      const matchedPages = QUICK_PAGES.filter(
        (pg) => pg.title.toLowerCase().includes(raw) || pg.subtitle.toLowerCase().includes(raw),
      );
      render([...matchedPosts.slice(0, 8), ...matchedPages.slice(0, 4)]);
    };

    const ensureIndex = async () => {
      if (postsCache || loading) return;
      loading = true;
      try {
        const res = await fetch("/search-index.json");
        if (res.ok) postsCache = (await res.json()) as SearchItem[];
      } catch {
        postsCache = [];
      } finally {
        loading = false;
        if (dialog.open) query();
      }
    };

    const openPalette = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.value = "";
      query();
      void ensureIndex();
      window.setTimeout(() => input.focus(), 10);
    };

    trigger?.addEventListener("click", openPalette);

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    input.addEventListener("input", query);
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIdx - 1);
      } else if (e.key === "Enter") {
        const chosen = currentEntries[activeIdx];
        if (chosen) {
          e.preventDefault();
          dialog.close();
          window.location.href = chosen.href;
        }
      }
    });

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else openPalette();
        return;
      }
      if (e.key === "/" && !dialog.open && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const el = document.activeElement as HTMLElement | null;
        const typing =
          el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable);
        if (!typing) {
          e.preventDefault();
          openPalette();
        }
      }
    });
  })();

  (() => {
    const btn = document.getElementById("back-to-top");
    if (!btn) return;
    let ticking = false;
    const sync = () => {
      ticking = false;
      btn.hidden = window.scrollY < 420;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(sync);
        }
      },
      { passive: true },
    );
    sync();
    btn.addEventListener("click", () => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    });
  })();
</script>

<style>
  .cmdk-dialog {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(580px, calc(100vw - 24px));
    width: 100%;
    margin: min(14vh, 110px) auto auto;
    overflow: visible;
  }

  .cmdk-dialog::backdrop {
    background: rgba(10, 12, 16, 0.48);
    backdrop-filter: blur(6px);
  }

  .cmdk-panel {
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 64px -20px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .cmdk-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }

  .cmdk-ico {
    color: var(--muted);
    flex: none;
  }

  .cmdk-head input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    outline: none;
  }

  .cmdk-esc,
  .cmdk-foot kbd {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 5px;
    border: 1px solid var(--line);
    background: var(--surface-sunk);
    color: var(--muted);
  }

  .cmdk-list {
    max-height: min(54vh, 420px);
    overflow-y: auto;
    padding: 8px;
    display: grid;
    gap: 2px;
  }

  .cmdk-list :global(.cmdk-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 9px;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.12s ease;
  }

  .cmdk-list :global(.cmdk-item.is-active) {
    background: var(--surface-sunk);
  }

  .cmdk-list :global(.cmdk-item-main) {
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  .cmdk-list :global(.cmdk-item-main strong) {
    font-size: 14px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmdk-list :global(.cmdk-item-main span) {
    font-size: 12.5px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmdk-list :global(.cmdk-item-meta) {
    font-style: normal;
    font-size: 11.5px;
    color: var(--muted);
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .cmdk-list :global(.cmdk-empty) {
    padding: 26px 12px;
    text-align: center;
    color: var(--muted);
    font-size: 13.5px;
    margin: 0;
  }

  .cmdk-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 9px 14px;
    border-top: 1px solid var(--line);
    background: var(--surface-sunk);
    font-size: 11.5px;
    color: var(--muted);
  }

  .cmdk-foot span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .back-top {
    position: fixed;
    right: 22px;
    bottom: 24px;
    z-index: 45;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    color: var(--ink-2);
    cursor: pointer;
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .back-top[hidden] {
    display: none;
  }

  .back-top:hover {
    transform: translateY(-2px);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
</style>
