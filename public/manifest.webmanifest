{
  "name": "Guandao OS",
  "short_name": "Guandao",
  "description": "管道的个人数字操作系统 · 笔记、任务、日程、云端文件与跨设备接力",
  "id": "/?source=pwa",
  "start_url": "/m/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070a11",
  "theme_color": "#070a11",
  "lang": "zh-CN",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "新建笔记",
      "short_name": "笔记",
      "url": "/m/?new=note",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "今天任务",
      "short_name": "任务",
      "url": "/m/?view=tasks",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "接力收件箱",
      "short_name": "接力",
      "url": "/m/?view=inbox",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
