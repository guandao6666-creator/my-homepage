# ------------------------------------------------------------------
# Guandao Account · 本地开发配置
#
# 复制为 .dev.vars 后填入真实值；.dev.vars 已被 .gitignore 忽略。
# 本地调试建议单独创建一个 GitHub OAuth App，回调地址填：
#   http://127.0.0.1:8787/api/auth/github/callback
#
# 生产环境不要使用这个文件，改用：
#   npx wrangler secret put GITHUB_CLIENT_ID
#   npx wrangler secret put GITHUB_CLIENT_SECRET
#   npx wrangler secret put APP_ORIGIN
#   npx wrangler secret put INITIAL_ADMIN_SETUP_TOKEN
# ------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:8787
INITIAL_ADMIN_SETUP_TOKEN=
# 可选：账号云端容量上限（字节），默认 5 GiB
# CLOUD_QUOTA_BYTES=5368709120
