{
  "name": "my-homepage",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "node scripts/sync-content.mjs",
    "walls": "node scripts/build-wallpapers.mjs",
    "qa:os13": "node scripts/os13-functional.mjs",
    "prebuild": "node scripts/sync-content.mjs --soft",
    "postbuild": "node scripts/gen-csp.mjs",
    "qa:os14": "node scripts/os14-qa.mjs",
    "qa:os14:full": "astro build && node scripts/os14-qa.mjs",
    "qa:community": "node scripts/qa-local-run.mjs community",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:link": "node scripts/link-d1.mjs",
    "db:migrate:local": "wrangler d1 migrations apply guandao-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply guandao-db --remote",
    "db:migrations:list": "wrangler d1 migrations list guandao-db --remote",
    "verify:cloudflare": "node scripts/verify-cloudflare.mjs",
    "qa:plugins": "node scripts/qa-local-run.mjs plugins",
    "qa:plugins:ui": "node scripts/plugins-ui-qa.mjs",
    "plugins:cli": "node cli/guandao.mjs",
    "qa:continuity": "node scripts/qa-local-run.mjs continuity",
    "qa:devices": "node scripts/qa-local-run.mjs devices",
    "qa:pairing-ttl": "node scripts/pairing-ttl-check.mjs",
    "qa:continuity:ui": "node scripts/continuity-ui-qa.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:csp": "node scripts/gen-csp.mjs --check",
    "check:html-security": "node scripts/check-html-security.mjs",
    "check:unused": "node scripts/check-unused.mjs",
    "check:astro": "astro check",
    "lint": "eslint worker scripts cli",
    "qa:os20": "playwright test tests/e2e/os20.spec.ts",
    "qa:sync": "node scripts/sync-qa.mjs",
    "qa:sync:ui": "node scripts/sync-client-qa.mjs",
    "qa:prod": "node scripts/prod-e2e.mjs",
    "qa:r2": "node scripts/r2-audit.mjs",
    "qa:cleanup-selftest": "node scripts/qa-cleanup-selftest.mjs",
    "qa:db-backup": "node scripts/db-backup-selftest.mjs",
    "qa:data-monitor": "node scripts/data-monitor-selftest.mjs",
    "qa:d1-backup": "node scripts/d1-backup-selftest.mjs",
    "qa:d1-recovery": "node scripts/d1-recovery-selftest.mjs",
    "qa:alerts": "node scripts/alert-delivery-check.mjs",
    "qa:prod-visual": "node scripts/prod-visual-check.mjs",
    "shots": "node scripts/visual-css-shots.mjs .shots/current",
    "shots:compare": "node scripts/compare-css-shots.mjs .shots/phase-2.1-before .shots/current",
    "qa:security-log": "node scripts/security-log-selftest.mjs",
    "security:test": "npm run qa:cleanup-selftest && npm run qa:db-backup && npm run qa:data-monitor && npm run qa:d1-backup && npm run qa:d1-recovery && npm run qa:security-log",
    "backup:status": "node scripts/backup-status.mjs",
    "verify:d1-backup": "node scripts/verify-d1-backup.mjs",
    "test:unit": "vitest run",
    "test:qa-cleanup": "node scripts/qa-cleanup-selftest.mjs",
    "test:e2e": "playwright test",
    "test": "npm run check:version && npm run check:migrations && npm run typecheck && npm run test:unit && npm run security:test",
    "verify": "npm run test && npm run check:unused && npm run check:astro && npm run check:html-security && npm run lint && npm run build && npm run check:csp"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4",
    "qrcode": "^1.5.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/qrcode": "^1.5.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "puppeteer-core": "^25.16.0",
    "satori": "^0.63.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.157.0"
  }
}
